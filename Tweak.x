UIKIT_EXTERN UIImage *_UICreateScreenUIImage(void);



// ==================== 翻译配置读写（100% 通用，绝不绑定单一平台） ====================
static BOOL agTransIsEnabled(void) {
    NSNumber *v = agReadOnlyPrefs()[@"AG_Trans_Enabled"];
    return v ? [v boolValue] : YES;
}

static CGFloat agTransFontSize(void) {
    NSNumber *v = agReadOnlyPrefs()[@"AG_Trans_FontSize"];
    CGFloat sz = v ? [v floatValue] : 16.0;
    return MAX(11.0, MIN(30.0, sz));
}

static NSString *agTransEndpoint(void) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *ep = [p[@"AG_Trans_Endpoint"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (!ep) ep = @"";
    while ([ep hasSuffix:@"/"]) ep = [ep substringToIndex:ep.length - 1];
    return ep;
}

static NSString *agTransAPIKey(void) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *k = [p[@"AG_Trans_APIKey"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    return k ?: @"";
}

static NSArray<NSDictionary *> *agTransCachedModels(void) {
    NSDictionary *p = agReadOnlyPrefs();
    NSArray *arr = p[@"AG_Trans_CachedModels"];
    if ([arr isKindOfClass:[NSArray class]] && arr.count > 0) {
        return arr;
    }
    return agVerifiedDefaultModelsForTab(AGConfigTabTranslation);
}

static NSString *agTransModel(void) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *m = [p[@"AG_Trans_Model"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (m && m.length > 0) return m;
    NSArray *list = agTransCachedModels();
    if (list.count > 0 && list.firstObject[@"id"]) return list.firstObject[@"id"];
    return @"";
}

static BOOL agTransIsHighAccuracyOCR(void) {
    NSDictionary *p = loadGeminiPrefs();
    NSNumber *val = p[@"AG_Trans_HighAccuracyOCR"];
    return val ? [val boolValue] : YES;
}

static NSTimeInterval agTransScrollDebounceTime(void) {
    NSDictionary *p = loadGeminiPrefs();
    NSNumber *val = p[@"AG_Trans_ScrollDebounceTime"];
    if (val && [val doubleValue] >= 0.15 && [val doubleValue] <= 2.0) {
        return [val doubleValue];
    }
    return 0.40;
}

static NSString *agSanitizeOpenAIEndpoint(NSString *raw) {
    NSString *ep = [raw stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    while ([ep hasSuffix:@"/"]) ep = [ep substringToIndex:ep.length - 1];
    if (![ep hasPrefix:@"http://"] && ![ep hasPrefix:@"https://"] && ep.length > 3) {
        ep = [NSString stringWithFormat:@"https://%@", ep];
    }
    if ([ep containsString:@"dashscope.aliyuncs.com"]) {
        if (![ep containsString:@"/compatible-mode/v1"]) {
            ep = [ep stringByAppendingString:@"/compatible-mode/v1"];
        }
    } else if ([ep containsString:@"open.bigmodel.cn"]) {
        if (![ep containsString:@"/api/paas/v4"]) {
            ep = [ep stringByAppendingString:@"/api/paas/v4"];
        }
    } else if ([ep containsString:@"volces.com"]) {
        if (![ep containsString:@"/api/v3"]) {
            ep = [ep stringByAppendingString:@"/api/v3"];
        }
    } else if ([ep containsString:@"api.moonshot.cn"]) {
        if (![ep containsString:@"/v1"]) {
            ep = [ep stringByAppendingString:@"/v1"];
        }
    }
    if (![ep hasSuffix:@"/chat/completions"]) {
        ep = [ep hasSuffix:@"/v1"] ? [NSString stringWithFormat:@"%@/chat/completions", ep] : [NSString stringWithFormat:@"%@/v1/chat/completions", ep];
    }
    return ep;
}


// 本地 0ms 瞬时高频口语词典垫底器（在等待云端 API 首字返回的 100ms 空窗期内提供 0 延迟视觉反馈）
static NSString *agInstantLocalPreviewForSegment(NSString *segment, NSInteger langIdx) {
    if (!segment || segment.length == 0) return @"";
    static NSDictionary<NSString *, NSString *> *sFastDictEn = nil;
    static NSDictionary<NSString *, NSString *> *sFastDictJa = nil;
    static NSDictionary<NSString *, NSString *> *sFastDictKo = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sFastDictEn = @{
            @"hello": @"你好", @"hi": @"嗨", @"welcome": @"欢迎", @"everyone": @"大家",
            @"today": @"今天", @"now": @"现在", @"here": @"这里", @"there": @"那里",
            @"this": @"这个", @"that": @"那个", @"what": @"什么", @"why": @"为什么",
            @"how": @"如何", @"when": @"何时", @"where": @"哪里", @"who": @"谁",
            @"because": @"因为", @"so": @"所以", @"but": @"但是", @"and": @"而且",
            @"actually": @"实际上", @"basically": @"基本上", @"literally": @"简直",
            @"important": @"重要", @"different": @"不同", @"example": @"例如",
            @"first": @"首先", @"second": @"其次", @"finally": @"最后",
            @"question": @"问题", @"answer": @"回答", @"problem": @"问题",
            @"system": @"系统", @"video": @"视频", @"audio": @"音频", @"model": @"模型",
            @"phone": @"手机", @"world": @"世界", @"time": @"时间", @"people": @"人们",
            @"think": @"认为", @"know": @"知道", @"want": @"想要", @"need": @"需要",
            @"look": @"看", @"see": @"看到", @"make": @"制作", @"use": @"使用",
            @"work": @"工作", @"good": @"好", @"great": @"棒", @"new": @"新",
            @"right": @"对", @"really": @"真的", @"very": @"非常", @"much": @"很多",
            @"thank": @"感谢", @"thanks": @"谢谢", @"please": @"请", @"sorry": @"抱歉"
        };
        sFastDictJa = @{
            @"こんにちは": @"你好", @"ありがとう": @"谢谢", @"すみません": @"抱歉", @"はい": @"是的",
            @"いいえ": @"不是", @"おはよう": @"早安", @"こんばんは": @"晚上好", @"すごい": @"厉害",
            @"ほんとう": @"真的吗", @"だいじょうぶ": @"没关系", @"なに": @"什么", @"どうして": @"为什么"
        };
        sFastDictKo = @{
            @"안녕하세요": @"你好", @"감사합니다": @"谢谢", @"죄송합니다": @"抱歉", @"네": @"是的",
            @"아니요": @"不是", @"진짜": @"真的吗", @"괜찮아요": @"没关系", @"대박": @"太棒了",
            @"무엇": @"什么", @"왜": @"为什么"
        };
    });

    NSDictionary<NSString *, NSString *> *curDict = (langIdx == 1) ? sFastDictJa : ((langIdx == 2) ? sFastDictKo : sFastDictEn);
    if (!curDict) return @"";

    NSArray<NSString *> *words = [[segment lowercaseString] componentsSeparatedByCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    NSMutableArray<NSString *> *hits = [NSMutableArray array];
    NSInteger startIdx = MAX(0, (NSInteger)words.count - 4);
    for (NSInteger i = startIdx; i < (NSInteger)words.count; i++) {
        NSString *w = [words[i] stringByTrimmingCharactersInSet:[NSCharacterSet punctuationCharacterSet]];
        if (w.length == 0) continue;
        NSString *zh = curDict[w];
        if (zh && ![hits.lastObject isEqualToString:zh]) {
            [hits addObject:zh];
        }
    }
    return hits.count > 0 ? [hits componentsJoinedByString:@"·"] : @"";
}

// ====== 最终确认替换块 2 开始（iOS 14-17 原生离线翻译 + 图层100%穿透不挡滑动 + 覆膜深浅/滑动延迟可调 + 直达设置） ======
#define AGSharedTransSessionRouter _UINetworkStreamSessionRouter

@interface UIApplication (AGPrefsURLRouter)
- (BOOL)applicationOpenURL:(NSURL *)url;
@end

static NSURLSessionDataTask *gActiveTransTask = nil;
static NSTimeInterval gActiveTransStartTime = 0;
static NSString *gPendingLatestSourceText = nil;
static void (^gPendingLatestTransCallback)(NSString *translatedText) = nil;
static NSUInteger gTransRequestSeq = 0;
static NSString *gLastTranslatedSourceSnapshot = nil;

static BOOL agUseNativeiOSTranslator(void) {
    NSNumber *val = agReadOnlyPrefs()[@"AG_Trans_UseNativeiOS"];
    return val ? [val boolValue] : YES; // 默认优先使用 iOS 原生离线翻译
}

static void agSetUseNativeiOSTranslator(BOOL useNative) {
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_Trans_UseNativeiOS"] = @(useNative);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
}

// 网页覆膜底色浓淡档位：0=清爽浅透(70%), 1=柔和自然(82%, 默认), 2=实心遮盖(94%)
static NSInteger agTransPatchStyleIndex(void) {
    NSNumber *val = agReadOnlyPrefs()[@"AG_Trans_PatchStyle"];
    if (!val) return 1;
    return MAX(0, MIN(2, [val integerValue]));
}

// 滑动停稳后触发重译的延迟档位对应秒数
static NSTimeInterval agCustomScrollDebounceSeconds(void) {
    NSNumber *val = agReadOnlyPrefs()[@"AG_Trans_ScrollDebounceTime"];
    if (val && [val doubleValue] >= 0.15 && [val doubleValue] <= 2.5) {
        return [val doubleValue];
    }
    return 0.50; // 默认 0.5 秒适中档
}

// 500 条容量 LRU 极速内存翻译缓存（滑动网页重译时已译段落 0ms 直接命中上屏）
static NSCache<NSString *, NSString *> *agSharedTranslationMemoryCache(void) {
    static NSCache<NSString *, NSString *> *sCache = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sCache = [[NSCache alloc] init];
        sCache.countLimit = 500;
    });
    return sCache;
}

static NSString *agPlainChineseLanguageNameForLocale(NSString *localeStr) {
    NSString *lower = [[localeStr ?: @"en" lowercaseString] stringByReplacingOccurrencesOfString:@"-" withString:@"_"];
    if ([lower hasPrefix:@"zh"]) return @"中文";
    if ([lower hasPrefix:@"en"]) return @"英语";
    if ([lower hasPrefix:@"ja"]) return @"日语";
    if ([lower hasPrefix:@"ko"]) return @"韩语";
    if ([lower hasPrefix:@"ru"]) return @"俄语";
    if ([lower hasPrefix:@"fr"]) return @"法语";
    if ([lower hasPrefix:@"de"]) return @"德语";
    if ([lower hasPrefix:@"es"]) return @"西班牙语";
    if ([lower hasPrefix:@"it"]) return @"意大利语";
    if ([lower hasPrefix:@"pt"]) return @"葡萄牙语";
    if ([lower hasPrefix:@"ar"]) return @"阿拉伯语";
    return @"外语";
}

// iOS 14 - iOS 17 原生 NaturalLanguage + 字符集特征自动识别外文语种
static NSString *agDetectSourceLocaleForText(NSString *text, NSString *preferredLocaleID) {
    if (preferredLocaleID.length > 0) {
        return [preferredLocaleID stringByReplacingOccurrencesOfString:@"-" withString:@"_"];
    }
    if (!text || text.length == 0) return @"en_US";

    for (NSUInteger i = 0; i < text.length; i++) {
        unichar c = [text characterAtIndex:i];
        if ((c >= 0x3040 && c <= 0x309F) || (c >= 0x30A0 && c <= 0x30FF)) return @"ja_JP";
        if (c >= 0xAC00 && c <= 0xD7AF) return @"ko_KR";
        if (c >= 0x0400 && c <= 0x04FF) return @"ru_RU";
        if (c >= 0x0600 && c <= 0x06FF) return @"ar_AE";
    }

    static Class sNLRecCls = Nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        dlopen("/System/Library/Frameworks/NaturalLanguage.framework/NaturalLanguage", RTLD_LAZY);
        sNLRecCls = objc_getClass("NLLanguageRecognizer");
    });
    if (sNLRecCls && [sNLRecCls respondsToSelector:sel_registerName("dominantLanguageForString:")]) {
        @try {
            NSString *lang = ((id(*)(id, SEL, id))objc_msgSend)(sNLRecCls, sel_registerName("dominantLanguageForString:"), text);
            if ([lang isKindOfClass:[NSString class]] && lang.length >= 2) {
                if ([lang hasPrefix:@"ja"]) return @"ja_JP";
                if ([lang hasPrefix:@"ko"]) return @"ko_KR";
                if ([lang hasPrefix:@"ru"]) return @"ru_RU";
                if ([lang hasPrefix:@"fr"]) return @"fr_FR";
                if ([lang hasPrefix:@"de"]) return @"de_DE";
                if ([lang hasPrefix:@"es"]) return @"es_ES";
                if ([lang hasPrefix:@"it"]) return @"it_IT";
                if ([lang hasPrefix:@"pt"]) return @"pt_BR";
                if ([lang hasPrefix:@"ar"]) return @"ar_AE";
            }
        } @catch (NSException *e) {}
    }
    return @"en_US";
}

// 扫描系统 MobileAsset 物理磁盘目录，毫秒级读取已下载的离线翻译语言包
static NSSet<NSString *> *agScanDiskInstalledOfflineTranslationPrefixes(void) {
    NSMutableSet<NSString *> *prefixes = [NSMutableSet set];
    NSFileManager *fm = [NSFileManager defaultManager];
    NSArray<NSString *> *assetDirs = @[
        @"/var/MobileAsset/AssetsV2/com_apple_MobileAsset_TranslationLanguageModels",
        @"/var/MobileAsset/AssetsV2/com_apple_MobileAsset_TranslationAssets",
        @"/var/MobileAsset/AssetsV2/com_apple_MobileAsset_Trial_Siri_SiriTranslation",
        @"/private/var/MobileAsset/AssetsV2/com_apple_MobileAsset_TranslationLanguageModels"
    ];
    NSArray<NSString *> *knownCodes = @[@"zh", @"en", @"ja", @"ko", @"ru", @"fr", @"de", @"es", @"it", @"pt", @"ar"];
    for (NSString *dir in assetDirs) {
        NSArray<NSString *> *subItems = [fm contentsOfDirectoryAtPath:dir error:nil];
        if (!subItems) continue;
        for (NSString *sub in subItems) {
            if (![sub hasSuffix:@".asset"]) continue;
            NSString *infoPath = [[dir stringByAppendingPathComponent:sub] stringByAppendingPathComponent:@"Info.plist"];
            NSDictionary *info = [NSDictionary dictionaryWithContentsOfFile:infoPath];
            if (![info isKindOfClass:[NSDictionary class]]) continue;
            NSString *desc = [[info description] lowercaseString];
            for (NSString *code in knownCodes) {
                if ([desc containsString:[NSString stringWithFormat:@"\"%@_", code]] ||
                    [desc containsString:[NSString stringWithFormat:@"\"%@-", code]] ||
                    [desc containsString:[NSString stringWithFormat:@"= %@;", code]] ||
                    [desc containsString:[NSString stringWithFormat:@"\"%@\"", code]]) {
                    [prefixes addObject:code];
                }
            }
        }
    }
    return prefixes;
}

// ==================== 🍎 iOS 14-17 原生 Translation.framework + 免Key破壁兜底核心引擎 ====================
static NSString *agExtractStringFromLTResult(id resultObj) {
    if (!resultObj) return nil;
    if ([resultObj isKindOfClass:[NSString class]]) return (NSString *)resultObj;
    if ([resultObj isKindOfClass:[NSAttributedString class]]) return [(NSAttributedString *)resultObj string];
    @try {
        SEL transSel = sel_registerName("translations");
        if ([resultObj respondsToSelector:transSel]) {
            NSArray *arr = ((id(*)(id, SEL))objc_msgSend)(resultObj, transSel);
            if ([arr isKindOfClass:[NSArray class]] && arr.count > 0) {
                id first = arr.firstObject;
                if ([first respondsToSelector:sel_registerName("formattedString")]) {
                    return ((id(*)(id, SEL))objc_msgSend)(first, sel_registerName("formattedString"));
                }
                if ([first respondsToSelector:sel_registerName("targetString")]) {
                    return ((id(*)(id, SEL))objc_msgSend)(first, sel_registerName("targetString"));
                }
            }
        }
        if ([resultObj respondsToSelector:sel_registerName("formattedString")]) {
            return ((id(*)(id, SEL))objc_msgSend)(resultObj, sel_registerName("formattedString"));
        }
    } @catch (NSException *e) {}
    return nil;
}

static void agTranslateWithKeylessWebFallback(NSString *sourceText, NSString *srcLocaleStr, void (^completion)(NSString *zhText, BOOL ok)) {
    NSString *cleanSrc = [sourceText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (cleanSrc.length == 0) {
        if (completion) completion(nil, NO);
        return;
    }
    NSString *cached = [agSharedTranslationMemoryCache() objectForKey:cleanSrc];
    if (cached.length > 0) {
        if (completion) completion(cached, YES);
        return;
    }
    NSString *encoded = [cleanSrc stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]];
    if (!encoded) {
        if (completion) completion(nil, NO);
        return;
    }
    NSString *urlStr = [NSString stringWithFormat:@"https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=zh-CN&dt=t&q=%@", encoded];
    NSURL *url = [NSURL URLWithString:urlStr];
    if (!url) {
        if (completion) completion(nil, NO);
        return;
    }
    NSString *proxy = agProxyForTab(AGConfigTabTranslation);
    static NSURLSession *sFreeSess = nil;
    static NSString *sLastProxy = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sFreeSess = agCreateSessionWithProxy(proxy, nil, nil);
        sLastProxy = [proxy ?: @"" copy];
    });
    if (![sLastProxy isEqualToString:(proxy ?: @"")]) {
        sFreeSess = agCreateSessionWithProxy(proxy, nil, nil);
        sLastProxy = [proxy ?: @"" copy];
    }

    NSMutableURLRequest *req = [NSMutableURLRequest requestWithURL:url];
    req.timeoutInterval = 3.8;
    [req setValue:@"Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15" forHTTPHeaderField:@"User-Agent"];
    [[sFreeSess dataTaskWithRequest:req completionHandler:^(NSData *data, NSURLResponse *resp, NSError *err) {
        if (err || !data) {
            dispatch_async(dispatch_get_main_queue(), ^{ if (completion) completion(nil, NO); });
            return;
        }
        id arr = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
        NSMutableString *joined = [NSMutableString string];
        if ([arr isKindOfClass:[NSArray class]] && [arr count] > 0 && [arr[0] isKindOfClass:[NSArray class]]) {
            for (id seg in (NSArray *)arr[0]) {
                if ([seg isKindOfClass:[NSArray class]] && [seg count] > 0 && [seg[0] isKindOfClass:[NSString class]]) {
                    [joined appendString:seg[0]];
                }
            }
        }
        NSString *finalZh = [joined stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if (finalZh.length > 0) {
            [agSharedTranslationMemoryCache() setObject:finalZh forKey:cleanSrc];
        }
        dispatch_async(dispatch_get_main_queue(), ^{
            if (completion) completion(finalZh.length > 0 ? finalZh : nil, finalZh.length > 0);
        });
    }] resume];
}

static NSMutableSet<NSString *> *agRemindedMissingOfflineLocales(void) {
    static NSMutableSet<NSString *> *sSet = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{ sSet = [NSMutableSet set]; });
    return sSet;
}

static void agRawLTTranslatorInvoke(NSString *sourceText, NSString *srcLocaleStr, BOOL forceOffline, void (^completion)(NSString *zhText, NSError *error)) {
    NSString *cleanSrc = [sourceText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (cleanSrc.length == 0) {
        if (completion) completion(nil, nil);
        return;
    }

    static id sSharedLTTranslator = nil;
    static Class sLTParaReqCls = Nil;
    static Class sLTTextReqCls = Nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        dlopen("/System/Library/PrivateFrameworks/Translation.framework/Translation", RTLD_LAZY);
        Class transCls = objc_getClass("_LTTranslator");
        sLTParaReqCls  = objc_getClass("_LTParagraphTranslationRequest");
        sLTTextReqCls  = objc_getClass("_LTTextTranslationRequest");
        if (transCls) {
            sSharedLTTranslator = [[transCls alloc] init];
        }
    });

    Class reqCls = sLTParaReqCls ?: sLTTextReqCls;
    if (!sSharedLTTranslator || !reqCls) {
        if (completion) completion(nil, [NSError errorWithDomain:@"AGLTNotFound" code:-100 userInfo:nil]);
        return;
    }

    NSString *normSrc = agDetectSourceLocaleForText(cleanSrc, srcLocaleStr);
    NSLocale *srcLoc = [NSLocale localeWithLocaleIdentifier:normSrc];
    NSLocale *dstLoc = [NSLocale localeWithLocaleIdentifier:@"zh_CN"];

    @try {
        SEL initSel = sel_registerName("initWithSourceLocale:targetLocale:");
        if (![reqCls instancesRespondToSelector:initSel]) {
            if (completion) completion(nil, [NSError errorWithDomain:@"AGLTMethodMissing" code:-101 userInfo:nil]);
            return;
        }
        id req = ((id(*)(id, SEL, id, id))objc_msgSend)([reqCls alloc], initSel, srcLoc, dstLoc);
        if (!req) {
            if (completion) completion(nil, [NSError errorWithDomain:@"AGLTInitNil" code:-102 userInfo:nil]);
            return;
        }
        if ([req respondsToSelector:sel_registerName("setCensorSpeech:")]) {
            ((void(*)(id, SEL, BOOL))objc_msgSend)(req, sel_registerName("setCensorSpeech:"), NO);
        }
        if (forceOffline && [req respondsToSelector:sel_registerName("setForcedOfflineTranslation:")]) {
            ((void(*)(id, SEL, BOOL))objc_msgSend)(req, sel_registerName("setForcedOfflineTranslation:"), YES);
        }
        if ([req respondsToSelector:sel_registerName("setText:")]) {
            ((void(*)(id, SEL, id))objc_msgSend)(req, sel_registerName("setText:"), cleanSrc);
        } else if ([req respondsToSelector:sel_registerName("setSentence:")]) {
            ((void(*)(id, SEL, id))objc_msgSend)(req, sel_registerName("setSentence:"), cleanSrc);
        }

        __block BOOL done = NO;
        __block id holdReq = req;

        void (^finishOnce)(NSString *, NSError *) = ^(NSString *resStr, NSError *err) {
            @synchronized (req) {
                if (done) return;
                done = YES;
            }
            holdReq = nil;
            NSString *cleanRes = [resStr stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            dispatch_async(dispatch_get_main_queue(), ^{
                if (completion) completion(cleanRes.length > 0 ? cleanRes : nil, err);
            });
        };

        if ([req respondsToSelector:sel_registerName("setCompletionHandler:")]) {
            void (^compHandler)(id, NSError *) = ^(id result, NSError *error) {
                finishOnce(agExtractStringFromLTResult(result), error);
            };
            ((void(*)(id, SEL, id))objc_msgSend)(req, sel_registerName("setCompletionHandler:"), compHandler);
        } else if ([req respondsToSelector:sel_registerName("setTextTranslationHandler:")]) {
            void (^txtHandler)(NSAttributedString *, id, NSError *) = ^(NSAttributedString *attrStr, id result, NSError *error) {
                NSString *s = attrStr.string ?: agExtractStringFromLTResult(result);
                finishOnce(s, error);
            };
            ((void(*)(id, SEL, id))objc_msgSend)(req, sel_registerName("setTextTranslationHandler:"), txtHandler);
        }

        if ([sSharedLTTranslator respondsToSelector:sel_registerName("translate:")]) {
            ((void(*)(id, SEL, id))objc_msgSend)(sSharedLTTranslator, sel_registerName("translate:"), req);
        } else {
            finishOnce(nil, [NSError errorWithDomain:@"AGLTNoTranslateSel" code:-103 userInfo:nil]);
        }

        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            finishOnce(nil, [NSError errorWithDomain:@"AGLTTimeout" code:-104 userInfo:nil]);
        });
    } @catch (NSException *e) {
        if (completion) completion(nil, [NSError errorWithDomain:@"AGLTException" code:-105 userInfo:nil]);
    }
}

static void agTranslateWithNativeiOSFramework(NSString *sourceText, NSString *srcLocaleStr, BOOL forceOffline, void (^completion)(NSString *zhText, BOOL usedNative)) {
    NSString *cleanSrc = [sourceText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (cleanSrc.length == 0) {
        if (completion) completion(nil, NO);
        return;
    }

    NSString *cached = [agSharedTranslationMemoryCache() objectForKey:cleanSrc];
    if (cached.length > 0) {
        if (completion) completion(cached, YES);
        return;
    }

    NSString *detectedLocale = agDetectSourceLocaleForText(cleanSrc, srcLocaleStr);
    NSSet<NSString *> *diskPacks = agScanDiskInstalledOfflineTranslationPrefixes();
    NSString *langPrefix = (detectedLocale.length >= 2) ? [[detectedLocale substringToIndex:2] lowercaseString] : @"en";
    BOOL hasDiskOffline = ([diskPacks containsObject:@"zh"] && [diskPacks containsObject:langPrefix]);

    if (diskPacks.count > 0 && !hasDiskOffline) {
        NSString *langCn = agPlainChineseLanguageNameForLocale(detectedLocale);
        if (![agRemindedMissingOfflineLocales() containsObject:langCn]) {
            [agRemindedMissingOfflineLocales() addObject:langCn];
            dispatch_async(dispatch_get_main_queue(), ^{
                [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"💡 识别到【%@】未下离线包，已自动为您联网翻译", langCn]];
            });
        }
    }

    agRawLTTranslatorInvoke(cleanSrc, detectedLocale, NO, ^(NSString *zhText, NSError *error) {
        if (zhText.length > 0 && !error) {
            [agSharedTranslationMemoryCache() setObject:zhText forKey:cleanSrc];
            if (completion) completion(zhText, YES);
            return;
        }
        agTranslateWithKeylessWebFallback(cleanSrc, detectedLocale, ^(NSString *webZh, BOOL ok) {
            if (completion) completion(webZh, ok);
        });
    });
}

// ==================== 🩺 iOS 14-17 全语种大白话真机体检引擎 ====================
static NSString *gLatestNativeDiagShortSummary = @"⏳ 正在自动体检手机离线翻译与语音包状态...";
static NSString *gLatestNativeDiagDetailedReport = @"";

static void agRunNativeOfflineTranslationDiagnostics(void (^completion)(NSString *shortCardSummary, NSString *fullAlertReport, BOOL allCoreReady)) {
    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
        dlopen("/System/Library/PrivateFrameworks/Translation.framework/Translation", RTLD_LAZY);
        Class transCls = objc_getClass("_LTTranslator");
        Class reqCls   = objc_getClass("_LTParagraphTranslationRequest") ?: objc_getClass("_LTTextTranslationRequest");

        if (!transCls || !reqCls) {
            NSString *shortMsg = @"❌ 无法使用苹果离线翻译：未检测到系统自带「翻译」功能\n👉 原因：您的系统低于 iOS 14 或删掉了苹果自带的「翻译」App。";
            gLatestNativeDiagShortSummary = shortMsg;
            gLatestNativeDiagDetailedReport = shortMsg;
            dispatch_async(dispatch_get_main_queue(), ^{
                if (completion) completion(shortMsg, shortMsg, NO);
            });
            return;
        }

        NSArray<NSDictionary *> *speechLangs = @[
            @{@"id": @"en-US", @"name": @"英语", @"core": @YES},
            @{@"id": @"ja-JP", @"name": @"日语", @"core": @YES},
            @{@"id": @"ko-KR", @"name": @"韩语", @"core": @YES},
            @{@"id": @"ru-RU", @"name": @"俄语", @"core": @NO},
            @{@"id": @"fr-FR", @"name": @"法语", @"core": @NO},
            @{@"id": @"de-DE", @"name": @"德语", @"core": @NO},
            @{@"id": @"es-ES", @"name": @"西班牙语", @"core": @NO}
        ];
        BOOL anySpeechAvailable = NO;
        NSMutableArray<NSString *> *readyOfflineSpeech = [NSMutableArray array];
        NSMutableArray<NSString *> *missingCoreSpeech  = [NSMutableArray array];

        for (NSDictionary *item in speechLangs) {
            SFSpeechRecognizer *rec = [[SFSpeechRecognizer alloc] initWithLocale:[NSLocale localeWithLocaleIdentifier:item[@"id"]]];
            if (rec && rec.isAvailable) anySpeechAvailable = YES;
            BOOL onDev = NO;
            if (@available(iOS 13.0, *)) {
                if (rec && rec.supportsOnDeviceRecognition) onDev = YES;
            }
            if (onDev) {
                [readyOfflineSpeech addObject:item[@"name"]];
            } else if ([item[@"core"] boolValue]) {
                [missingCoreSpeech addObject:item[@"name"]];
            }
        }

        __block NSMutableSet<NSString *> *installedTransPrefixes = [NSMutableSet setWithSet:agScanDiskInstalledOfflineTranslationPrefixes()];

        dispatch_semaphore_t locSem = dispatch_semaphore_create(0);
        SEL instLocSel = sel_registerName("installedLocales:");
        if ([transCls respondsToSelector:instLocSel]) {
            @try {
                void (^locBlock)(NSArray<NSLocale *> *) = ^(NSArray<NSLocale *> *locales) {
                    if ([locales isKindOfClass:[NSArray class]]) {
                        for (NSLocale *l in locales) {
                            NSString *lid = [[l localeIdentifier] lowercaseString];
                            if (lid.length >= 2) [installedTransPrefixes addObject:[lid substringToIndex:2]];
                        }
                    }
                    dispatch_semaphore_signal(locSem);
                };
                ((void(*)(id, SEL, id))objc_msgSend)(transCls, instLocSel, locBlock);
                dispatch_semaphore_wait(locSem, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)));
            } @catch (NSException *e) {}
        }

        NSArray<NSDictionary *> *coreProbes = @[
            @{@"loc": @"en_US", @"prefix": @"en", @"name": @"英语", @"sample": @"Hello"},
            @{@"loc": @"ja_JP", @"prefix": @"ja", @"name": @"日语", @"sample": @"こんにちは"},
            @{@"loc": @"ko_KR", @"prefix": @"ko", @"name": @"韩语", @"sample": @"안녕하세요"}
        ];
        if (installedTransPrefixes.count == 0) {
            dispatch_group_t grp = dispatch_group_create();
            for (NSDictionary *p in coreProbes) {
                dispatch_group_enter(grp);
                agRawLTTranslatorInvoke(p[@"sample"], p[@"loc"], YES, ^(NSString *zhText, NSError *error) {
                    @synchronized (installedTransPrefixes) {
                        if (zhText.length > 0 && !error) {
                            [installedTransPrefixes addObject:@"zh"];
                            [installedTransPrefixes addObject:p[@"prefix"]];
                        }
                    }
                    dispatch_group_leave(grp);
                });
            }
            dispatch_group_wait(grp, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.8 * NSEC_PER_SEC)));
        }

        BOOL hasZh = [installedTransPrefixes containsObject:@"zh"];
        NSMutableArray<NSString *> *readyCoreTrans   = [NSMutableArray array];
        NSMutableArray<NSString *> *missingCoreTrans = [NSMutableArray array];
        for (NSDictionary *p in coreProbes) {
            if (hasZh && [installedTransPrefixes containsObject:p[@"prefix"]]) {
                [readyCoreTrans addObject:p[@"name"]];
            } else {
                [missingCoreTrans addObject:p[@"name"]];
            }
        }

        NSArray<NSDictionary *> *extTransLangs = @[
            @{@"prefix": @"ru", @"name": @"俄语"},
            @{@"prefix": @"fr", @"name": @"法语"},
            @{@"prefix": @"de", @"name": @"德语"},
            @{@"prefix": @"es", @"name": @"西班牙语"},
            @{@"prefix": @"it", @"name": @"意大利语"},
            @{@"prefix": @"pt", @"name": @"葡萄牙语"}
        ];
        NSMutableArray<NSString *> *readyExtTrans   = [NSMutableArray array];
        NSMutableArray<NSString *> *missingExtTrans = [NSMutableArray array];
        for (NSDictionary *ep in extTransLangs) {
            if (hasZh && [installedTransPrefixes containsObject:ep[@"prefix"]]) {
                [readyExtTrans addObject:ep[@"name"]];
            } else {
                [missingExtTrans addObject:ep[@"name"]];
            }
        }

        NSMutableString *shortSummary = [NSMutableString string];
        NSMutableString *detailReport = [NSMutableString string];
        BOOL allCoreReady = (hasZh && missingCoreTrans.count == 0 && anySpeechAvailable);

        if (!anySpeechAvailable) {
            [shortSummary appendString:@"❌ 听译无法识别声音：您手机的「启用听写」开关未打开！\n👉 请去手机《设置 -> 通用 -> 键盘》滑到最底下把「启用听写」打开。"];
        } else if (allCoreReady) {
            [shortSummary appendFormat:@"✅ 常用语种已全部就绪！【中文、%@】均可断网秒译\n", [readyCoreTrans componentsJoinedByString:@"、"]];
            if (missingExtTrans.count > 0) {
                [shortSummary appendFormat:@"💡 温馨提示：如需离线翻译【%@】等其他外语，可点下方「📥 去下载语言包」按需下载；未下载的语种在有网时也会自动帮您联网翻译。", [[missingExtTrans subarrayWithRange:NSMakeRange(0, MIN((NSUInteger)4, missingExtTrans.count))] componentsJoinedByString:@"、"]];
            } else {
                [shortSummary appendString:@"🌟 所有常用与扩展外语离线包均已完备，随时享受 0 延迟离线秒译！"];
            }
        } else if (readyCoreTrans.count > 0) {
            [shortSummary appendFormat:@"⚠️ 部分就绪：【%@】已可离线秒译，尚未下载【%@】离线包\n",
             [readyCoreTrans componentsJoinedByString:@"、"],
             [missingCoreTrans componentsJoinedByString:@"、"]];
            [shortSummary appendString:@"👉 未下载的语种有网时会自动帮您联网翻译；若想断网也能秒译，请点下方「📥 去下载语言包」跳转《设置 -> 翻译》勾选下载。"];
        } else {
            NSMutableArray *needDown = [NSMutableArray array];
            if (!hasZh) [needDown addObject:@"中文(简体)"];
            [needDown addObjectsFromArray:missingCoreTrans];
            [shortSummary appendFormat:@"⚠️ 尚未下载离线语言包：缺少【%@】\n👉 现在有网也能自动帮您免费翻译；若想断网 0 延迟秒出字幕，请点下方「📥 去下载语言包」跳转《设置 -> 翻译》下载。", [needDown componentsJoinedByString:@"、"]];
        }

        [detailReport appendString:@"【一、常用 4 语种离线翻译包状态】\n"];
        [detailReport appendFormat:@"• 🇨🇳 中文(简体)：%@\n", hasZh ? @"🟢 已下载就绪" : @"⚠️ 未下载 (必装！请去设置->翻译下载)"];
        for (NSDictionary *p in coreProbes) {
            BOOL ok = (hasZh && [installedTransPrefixes containsObject:p[@"prefix"]]);
            [detailReport appendFormat:@"• %@：%@\n", p[@"name"], ok ? @"🟢 已下载 (支持断网秒译)" : @"⚠️ 未下载 (有网时自动转在线翻译)"];
        }

        [detailReport appendString:@"\n【二、其他外语离线包状态 (按需下载)】\n"];
        if (readyExtTrans.count > 0) {
            [detailReport appendFormat:@"• 🟢 已下载：%@\n", [readyExtTrans componentsJoinedByString:@"、"]];
        }
        if (missingExtTrans.count > 0) {
            [detailReport appendFormat:@"• 💡 未下载：%@\n（平时不看这些语言无需下载；若需要看，有网会自动联网翻，也可去设置->翻译下载）\n", [missingExtTrans componentsJoinedByString:@"、"]];
        }

        [detailReport appendString:@"\n【三、听译离线语音识别包状态】\n"];
        if (!anySpeechAvailable) {
            [detailReport appendString:@"• ❌ 语音识别未开启：请前往《设置 -> 通用 -> 键盘》开启「启用听写」。\n"];
        } else {
            if (readyOfflineSpeech.count > 0) {
                [detailReport appendFormat:@"• 🟢 已支持芯片离线识别：%@\n", [readyOfflineSpeech componentsJoinedByString:@"、"]];
            }
            if (missingCoreSpeech.count > 0) {
                [detailReport appendFormat:@"• ⚠️ 尚未缓存离线语音包：%@ (系统会在连 Wi-Fi 听译时自动后台缓存)", [missingCoreSpeech componentsJoinedByString:@"、"]];
            }
        }

        gLatestNativeDiagShortSummary = [shortSummary copy];
        gLatestNativeDiagDetailedReport = [detailReport copy];

        dispatch_async(dispatch_get_main_queue(), ^{
            if (completion) completion(shortSummary, detailReport, allCoreReady);
        });
    });
}

@interface AGStreamTranslateDelegate : NSObject <NSURLSessionDataDelegate>
@property (nonatomic, copy) void (^onDelta)(NSString *accumulatedText);
@property (nonatomic, copy) void (^onCompletion)(void);
@property (nonatomic, strong) NSMutableString *buffer;
@property (nonatomic, strong) NSMutableString *streamText;
@end

@implementation AGStreamTranslateDelegate
- (instancetype)init {
    if (self = [super init]) {
        _buffer = [NSMutableString string];
        _streamText = [NSMutableString string];
    }
    return self;
}
- (void)URLSession:(NSURLSession *)session dataTask:(NSURLSessionDataTask *)dataTask didReceiveData:(NSData *)data {
    NSString *chunk = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
    if (!chunk) return;
    [self.buffer appendString:chunk];
    NSArray<NSString *> *lines = [self.buffer componentsSeparatedByString:@"\n"];
    BOOL hasNewText = NO;
    for (NSInteger i = 0; i < (NSInteger)lines.count - 1; i++) {
        NSString *line = [lines[i] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if ([line hasPrefix:@"data:"]) {
            NSString *jsonStr = [[line substringFromIndex:5] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            if ([jsonStr isEqualToString:@"[DONE]"]) continue;
            NSData *jData = [jsonStr dataUsingEncoding:NSUTF8StringEncoding];
            if (jData) {
                NSDictionary *dict = [NSJSONSerialization JSONObjectWithData:jData options:0 error:nil];
                NSString *delta = agExtractTextFromJSON(dict);
                if (delta.length > 0) {
                    [self.streamText appendString:delta];
                    hasNewText = YES;
                }
            }
        }
    }
    [self.buffer setString:lines.lastObject ?: @""];
    if (hasNewText && self.onDelta) {
        NSString *current = [self.streamText copy];
        dispatch_async(dispatch_get_main_queue(), ^{ if (self.onDelta) self.onDelta(current); });
    }
}
- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task didCompleteWithError:(NSError *)error {
    if (self.streamText.length == 0 && self.buffer.length > 0) {
        NSData *jData = [self.buffer dataUsingEncoding:NSUTF8StringEncoding];
        if (jData) {
            NSDictionary *dict = [NSJSONSerialization JSONObjectWithData:jData options:0 error:nil];
            NSString *reply = [agExtractTextFromJSON(dict) stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            if (reply.length > 0 && self.onDelta) {
                dispatch_async(dispatch_get_main_queue(), ^{ if (self.onDelta) self.onDelta(reply); });
            }
        }
    }
    if (self.onCompletion) {
        dispatch_async(dispatch_get_main_queue(), ^{ if (self.onCompletion) self.onCompletion(); });
    }
}
@end

@interface AGSharedTransSessionRouter : NSObject <NSURLSessionDataDelegate>
@property (nonatomic, strong) NSURLSession *pooledSession;
@property (nonatomic, copy) NSString *currentProxy;
@property (nonatomic, strong) NSMutableDictionary<NSNumber *, AGStreamTranslateDelegate *> *taskMap;
+ (instancetype)sharedRouter;
- (NSURLSessionDataTask *)startStreamTaskWithRequest:(NSURLRequest *)req proxy:(NSString *)proxy delegate:(AGStreamTranslateDelegate *)del;
- (NSURLSession *)sharedNonStreamSessionForProxy:(NSString *)proxy;
- (void)resetPool;
@end

@implementation AGSharedTransSessionRouter {
    os_unfair_lock _lock;
    NSURLSession *_nonStreamSession;
    NSString *_nonStreamProxy;
}
+ (instancetype)sharedRouter {
    static AGSharedTransSessionRouter *sRouter = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{ sRouter = [[self alloc] init]; });
    return sRouter;
}
- (instancetype)init {
    if (self = [super init]) {
        _lock = OS_UNFAIR_LOCK_INIT;
        _taskMap = [NSMutableDictionary dictionary];
        _currentProxy = @"";
        _nonStreamProxy = @"";
    }
    return self;
}
- (NSURLSessionDataTask *)startStreamTaskWithRequest:(NSURLRequest *)req proxy:(NSString *)proxy delegate:(AGStreamTranslateDelegate *)del {
    NSString *cleanProxy = [proxy ?: @"" stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    os_unfair_lock_lock(&_lock);
    if (!self.pooledSession || ![self.currentProxy isEqualToString:cleanProxy]) {
        if (self.pooledSession) [self.pooledSession finishTasksAndInvalidate];
        self.pooledSession = agCreateSessionWithProxy(cleanProxy, self, [NSOperationQueue mainQueue]);
        self.currentProxy = cleanProxy;
    }
    NSURLSessionDataTask *task = [self.pooledSession dataTaskWithRequest:req];
    if (task && del) self.taskMap[@(task.taskIdentifier)] = del;
    os_unfair_lock_unlock(&_lock);
    [task resume];
    return task;
}
- (NSURLSession *)sharedNonStreamSessionForProxy:(NSString *)proxy {
    NSString *cleanProxy = [proxy ?: @"" stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    os_unfair_lock_lock(&_lock);
    if (!_nonStreamSession || ![_nonStreamProxy isEqualToString:cleanProxy]) {
        if (_nonStreamSession) [_nonStreamSession finishTasksAndInvalidate];
        _nonStreamSession = agCreateSessionWithProxy(cleanProxy, nil, nil);
        _nonStreamProxy = [cleanProxy copy];
    }
    NSURLSession *sess = _nonStreamSession;
    os_unfair_lock_unlock(&_lock);
    return sess;
}
- (void)resetPool {
    os_unfair_lock_lock(&_lock);
    [self.taskMap removeAllObjects];
    os_unfair_lock_unlock(&_lock);
}
- (void)URLSession:(NSURLSession *)session dataTask:(NSURLSessionDataTask *)dataTask didReceiveData:(NSData *)data {
    os_unfair_lock_lock(&_lock);
    AGStreamTranslateDelegate *del = self.taskMap[@(dataTask.taskIdentifier)];
    os_unfair_lock_unlock(&_lock);
    if (del) [del URLSession:session dataTask:dataTask didReceiveData:data];
}
- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task didCompleteWithError:(NSError *)error {
    os_unfair_lock_lock(&_lock);
    AGStreamTranslateDelegate *del = self.taskMap[@(task.taskIdentifier)];
    [self.taskMap removeObjectForKey:@(task.taskIdentifier)];
    os_unfair_lock_unlock(&_lock);
    if (del) [del URLSession:session task:task didCompleteWithError:error];
}
@end

static void agResetRealtimeTranslationState(void) {
    gTransRequestSeq++;
    if (gActiveTransTask) {
        [gActiveTransTask cancel];
        gActiveTransTask = nil;
    }
    gActiveTransStartTime = 0;
    gPendingLatestSourceText = nil;
    gPendingLatestTransCallback = nil;
    gLastTranslatedSourceSnapshot = nil;
    [[AGSharedTransSessionRouter sharedRouter] resetPool];
}

@implementation AGScreenTranslationOverlay {
    NSUInteger _speechTaskGenID;
    NSTimeInterval _speechTaskStartTime;
    NSString *_committedTargetContext;
    NSTimeInterval _lastUIRenderTimestamp;
    BOOL _disableThinkingBudgetParam;
    BOOL _isNativeTransBusy;
    NSString *_pendingNativeText;
    BOOL _pendingNativeIsCommit;
}

+ (instancetype)sharedOverlay {
    static AGScreenTranslationOverlay *instance = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        CGRect bounds = [UIScreen mainScreen].bounds;
        UIWindowScene *scene = nil;
        if (@available(iOS 13.0, *)) {
            for (UIScene *s in [UIApplication sharedApplication].connectedScenes) {
                if ([s isKindOfClass:[UIWindowScene class]]) { scene = (UIWindowScene *)s; break; }
            }
        }
        instance = scene ? [[self alloc] initWithWindowScene:scene] : [[self alloc] initWithFrame:bounds];
        instance.frame = bounds;
        [instance setupOverlayUI];
    });
    return instance;
}

- (BOOL)pointInside:(CGPoint)point withEvent:(UIEvent *)event {
    if (self.hidden || self.alpha < 0.05 || !self.cropBoxView) return NO;
    CGPoint p = [self convertPoint:point toView:self.cropBoxView];
    return [self.cropBoxView pointInside:p withEvent:event];
}

- (BOOL)_canBecomeKeyWindow { return NO; }

- (NSString *)currentLocaleIdentifier {
    if (self.sourceLangIndex == 1) return @"ja-JP";
    if (self.sourceLangIndex == 2) return @"ko-KR";
    return @"en-US";
}

- (NSString *)currentLangShortTitle {
    if (self.sourceLangIndex == 1) return @"🇯🇵日语";
    if (self.sourceLangIndex == 2) return @"🇰🇷韩语";
    return @"🇺🇸英语";
}

- (void)setupOverlayUI {
    self.windowLevel = UIWindowLevelAlert + 520;
    self.backgroundColor = [UIColor clearColor];
    self.hidden = YES;
    self.isAudioTranslatingActive = NO;
    self.sourceLangIndex = 0;
    self.committedHistoryText = [NSMutableString string];
    self.pipelineTasksMap = [NSMutableDictionary dictionary];
    self.committedSourceContext = @"";
    _committedTargetContext = @"";
    self.lastTranslatedChunkText = @"";

    UIViewController *vc = [[UIViewController alloc] init];
    vc.view.backgroundColor = [UIColor clearColor];
    self.rootViewController = vc;

    if ([self.layer respondsToSelector:@selector(setHitTestsAsOpaque:)]) {
        [self.layer setHitTestsAsOpaque:NO];
    }
    if ([vc.view.layer respondsToSelector:@selector(setHitTestsAsOpaque:)]) {
        [vc.view.layer setHitTestsAsOpaque:NO];
    }

    AGDeviceMetrics m = agComputeDeviceMetrics();
    CGFloat initH = MAX(94.0, agTransFontSize() * 4.0 + 32.0);
    CGRect initFrame = CGRectMake(m.sideMargin, MAX(120.0, m.topSafeLimit + 50.0), m.screenW - m.sideMargin * 2.0, initH);

    self.cropBoxView = [[UIView alloc] initWithFrame:initFrame];
    self.cropBoxView.backgroundColor = [UIColor clearColor];
    self.cropBoxView.layer.cornerRadius = 20.0;
    self.cropBoxView.layer.shadowColor = [UIColor blackColor].CGColor;
    self.cropBoxView.layer.shadowRadius = 14.0;
    self.cropBoxView.layer.shadowOpacity = 0.45;
    self.cropBoxView.layer.shadowOffset = CGSizeMake(0, 4);
    [vc.view addSubview:self.cropBoxView];

    UIBlurEffect *subBlur = [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialDark];
    self.subtitleGlassBg = [[UIVisualEffectView alloc] initWithEffect:subBlur];
    self.subtitleGlassBg.layer.cornerRadius = 20.0;
    self.subtitleGlassBg.layer.masksToBounds = YES;
    [self.cropBoxView addSubview:self.subtitleGlassBg];

    self.liveOriginalPreviewLabel = [[UILabel alloc] init];
    self.liveOriginalPreviewLabel.textColor = [UIColor colorWithWhite:0.75 alpha:0.90];
    self.liveOriginalPreviewLabel.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightMedium];
    self.liveOriginalPreviewLabel.text = @"🎧 正在实时监听原声...";
    self.liveOriginalPreviewLabel.lineBreakMode = NSLineBreakByTruncatingHead;
    [self.subtitleGlassBg.contentView addSubview:self.liveOriginalPreviewLabel];

    self.translatedTextView = [[UITextView alloc] init];
    self.translatedTextView.backgroundColor = [UIColor clearColor];
    self.translatedTextView.textColor = [UIColor whiteColor];
    self.translatedTextView.font = [UIFont systemFontOfSize:agTransFontSize() weight:UIFontWeightBold];
    self.translatedTextView.textAlignment = NSTextAlignmentLeft;
    self.translatedTextView.editable = NO;
    self.translatedTextView.selectable = NO;
    self.translatedTextView.scrollEnabled = NO;
    self.translatedTextView.showsVerticalScrollIndicator = NO;
    self.translatedTextView.textContainerInset = UIEdgeInsetsMake(2, 8, 4, 8);
    self.translatedTextView.text = @"✨ 实时同传已就绪 (右上角可切换 🍎原生 / ☁️API)...";
    [self.subtitleGlassBg.contentView addSubview:self.translatedTextView];

    self.audioSourceToggleBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    self.audioSourceToggleBtn.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.16];
    self.audioSourceToggleBtn.layer.cornerRadius = 9.0;
    self.audioSourceToggleBtn.titleLabel.font = [UIFont boldSystemFontOfSize:10.0];
    [self.audioSourceToggleBtn addTarget:self action:@selector(toggleAudioSourceMode) forControlEvents:UIControlEventTouchUpInside];
    [self.subtitleGlassBg.contentView addSubview:self.audioSourceToggleBtn];
    [self refreshEngineToggleBtnUI];

    self.compactLangBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    self.compactLangBtn.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.16];
    self.compactLangBtn.layer.cornerRadius = 9.0;
    [self.compactLangBtn setTitle:@"🇺🇸英语" forState:UIControlStateNormal];
    [self.compactLangBtn setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
    self.compactLangBtn.titleLabel.font = [UIFont boldSystemFontOfSize:10.0];
    [self.compactLangBtn addTarget:self action:@selector(cycleSourceLanguage) forControlEvents:UIControlEventTouchUpInside];
    [self.subtitleGlassBg.contentView addSubview:self.compactLangBtn];

    self.compactCloseBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    self.compactCloseBtn.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.16];
    self.compactCloseBtn.layer.cornerRadius = 9.0;
    [self.compactCloseBtn setTitle:@"✕" forState:UIControlStateNormal];
    [self.compactCloseBtn setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
    self.compactCloseBtn.titleLabel.font = [UIFont boldSystemFontOfSize:10.5];
    [self.compactCloseBtn addTarget:self action:@selector(hideTranslatorFloatingBox) forControlEvents:UIControlEventTouchUpInside];
    [self.subtitleGlassBg.contentView addSubview:self.compactCloseBtn];

    self.resizeCornerHandle = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 24, 24)];
    self.resizeCornerHandle.backgroundColor = [UIColor colorWithRed:0.20 green:0.88 blue:1.00 alpha:0.90];
    self.resizeCornerHandle.layer.cornerRadius = 12.0;
    UILabel *gripLbl = [[UILabel alloc] initWithFrame:CGRectMake(0, 0, 24, 24)];
    gripLbl.text = @"↘";
    gripLbl.textColor = [UIColor blackColor];
    gripLbl.font = [UIFont boldSystemFontOfSize:12.0];
    gripLbl.textAlignment = NSTextAlignmentCenter;
    [self.resizeCornerHandle addSubview:gripLbl];
    [self.cropBoxView addSubview:self.resizeCornerHandle];

    UIPanGestureRecognizer *movePan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(handleMovePan:)];
    [self.cropBoxView addGestureRecognizer:movePan];

    UIPanGestureRecognizer *resizePan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(handleResizePan:)];
    [self.resizeCornerHandle addGestureRecognizer:resizePan];
    [movePan requireGestureRecognizerToFail:resizePan];

    [self applySavedFontSizeAndStyle];
    [self relayoutCropBoxSubviews];
}

- (void)refreshEngineToggleBtnUI {
    BOOL isNative = agUseNativeiOSTranslator();
    [self.audioSourceToggleBtn setTitle:(isNative ? @"🍎原生" : @"☁️API") forState:UIControlStateNormal];
    [self.audioSourceToggleBtn setTitleColor:(isNative ? [UIColor colorWithRed:0.35 green:0.96 blue:0.72 alpha:1.0] : [UIColor colorWithRed:1.00 green:0.82 blue:0.38 alpha:1.0]) forState:UIControlStateNormal];
}

- (void)toggleAudioSourceMode {
    BOOL nextMode = !agUseNativeiOSTranslator();
    agSetUseNativeiOSTranslator(nextMode);
    [self refreshEngineToggleBtnUI];
    NSString *tip = nextMode ? @"🍎 已切换至：iOS 系统自带原生离线翻译" : @"☁️ 已切换至：云端大模型 API 翻译";
    self.liveOriginalPreviewLabel.text = tip;
    [[AGGlobalActionPillWindow sharedPill] showActionPill:tip];
    if (self.latestPartialSegment.length >= 2) {
        [self dispatchMicroChunkTranslation:self.latestPartialSegment isCommitSlice:NO];
    }
}

- (void)cycleSourceLanguage {
    self.sourceLangIndex = (self.sourceLangIndex + 1) % 3;
    NSString *title = [self currentLangShortTitle];
    [self.compactLangBtn setTitle:title forState:UIControlStateNormal];
    [self resetAllTranslationHistoryAndUI];
    self.liveOriginalPreviewLabel.text = [NSString stringWithFormat:@"🎧 已切换为%@离线实时识别...", title];
    [self startZeroInterferenceInternalAudioTranslation];
}

- (void)appendCommittedTranslationSegment:(NSString *)seg {
    NSString *clean = [seg stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (clean.length == 0) return;
    [self.committedHistoryText setString:clean];
    _committedTargetContext = [clean copy];
}

- (void)renderCombinedSubtitleWithActiveTail:(NSString *)activeTail instantHint:(NSString *)instantHint {
    (void)instantHint;
    NSTimeInterval now = [[NSDate date] timeIntervalSince1970];
    if (activeTail.length > 0 && (now - _lastUIRenderTimestamp < 0.06)) return;
    _lastUIRenderTimestamp = now;

    NSString *line1 = [self.committedHistoryText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    NSString *line2 = [activeTail stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (line1.length == 0 && line2.length == 0) return;

    CGFloat baseSz = agTransFontSize();
    NSMutableParagraphStyle *para = [[NSMutableParagraphStyle alloc] init];
    para.lineSpacing = 4.0;
    para.lineBreakMode = NSLineBreakByWordWrapping;

    NSMutableAttributedString *attr = [[NSMutableAttributedString alloc] init];
    if (line1.length > 0 && line2.length > 0 && ![line1 isEqualToString:line2]) {
        [attr appendAttributedString:[[NSAttributedString alloc] initWithString:[NSString stringWithFormat:@"%@\n", line1]
                                                                     attributes:@{
            NSFontAttributeName: [UIFont systemFontOfSize:MAX(12.0, baseSz - 1.5) weight:UIFontWeightSemibold],
            NSForegroundColorAttributeName: [UIColor colorWithRed:0.78 green:0.86 blue:0.96 alpha:0.86],
            NSParagraphStyleAttributeName: para
        }]];
        [attr appendAttributedString:[[NSAttributedString alloc] initWithString:[NSString stringWithFormat:@"▸ %@", line2]
                                                                     attributes:@{
            NSFontAttributeName: [UIFont systemFontOfSize:baseSz weight:UIFontWeightBold],
            NSForegroundColorAttributeName: [UIColor whiteColor],
            NSParagraphStyleAttributeName: para
        }]];
    } else {
        NSString *single = line2.length > 0 ? line2 : line1;
        [attr appendAttributedString:[[NSAttributedString alloc] initWithString:[NSString stringWithFormat:@"▸ %@", single]
                                                                     attributes:@{
            NSFontAttributeName: [UIFont systemFontOfSize:baseSz weight:UIFontWeightBold],
            NSForegroundColorAttributeName: [UIColor whiteColor],
            NSParagraphStyleAttributeName: para
        }]];
    }

    if ([self.translatedTextView.attributedText.string isEqualToString:attr.string]) return;
    [UIView performWithoutAnimation:^{
        self.translatedTextView.attributedText = attr;
    }];
}

- (void)updateSubtitleDisplay:(NSString *)text {
    if (!text || text.length == 0) return;
    if ([self.translatedTextView.text isEqualToString:text]) return;
    [UIView performWithoutAnimation:^{
        self.translatedTextView.text = text;
        self.translatedTextView.font = [UIFont boldSystemFontOfSize:agTransFontSize()];
        self.translatedTextView.textColor = [UIColor whiteColor];
    }];
}

- (void)relayoutCropBoxSubviews {
    CGFloat w = self.cropBoxView.bounds.size.width;
    CGFloat h = self.cropBoxView.bounds.size.height;

    self.subtitleGlassBg.frame = self.cropBoxView.bounds;
    self.compactCloseBtn.frame = CGRectMake(w - 28, 6, 22, 19);
    self.compactLangBtn.frame = CGRectMake(w - 76, 6, 44, 19);
    self.audioSourceToggleBtn.frame = CGRectMake(w - 126, 6, 46, 19);
    self.liveOriginalPreviewLabel.frame = CGRectMake(12, 6, MAX(60.0, w - 140), 18);
    self.translatedTextView.frame = CGRectMake(4, 25, w - 28, MAX(32.0, h - 29));
    self.resizeCornerHandle.frame = CGRectMake(w - 24, h - 24, 24, 24);
    [self.cropBoxView bringSubviewToFront:self.resizeCornerHandle];
}

- (void)applySavedFontSizeAndStyle {
    dispatch_async(dispatch_get_main_queue(), ^{
        AGVisualTheme theme = agCurrentVisualTheme();
        CGFloat glassAlpha = agMainGlassOpacity();
        UIColor *borderCol = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.88];
        UIColor *bgCol = [UIColor colorWithRed:0.04 green:0.06 blue:0.18 alpha:glassAlpha * 0.95];
        if (theme == AGVisualThemeLightLuxury) {
            borderCol = [UIColor colorWithRed:0.98 green:0.85 blue:0.60 alpha:0.85];
            bgCol = [UIColor colorWithRed:0.08 green:0.06 blue:0.04 alpha:glassAlpha * 0.95];
        } else if (theme == AGVisualThemeMinimalist) {
            borderCol = [UIColor colorWithRed:0.75 green:0.92 blue:1.00 alpha:0.88];
            bgCol = [UIColor colorWithRed:0.06 green:0.11 blue:0.26 alpha:glassAlpha * 0.92];
        }
        self.subtitleGlassBg.layer.borderWidth = 1.3;
        self.subtitleGlassBg.layer.borderColor = borderCol.CGColor;
        self.subtitleGlassBg.contentView.backgroundColor = bgCol;
        self.translatedTextView.font = [UIFont boldSystemFontOfSize:agTransFontSize()];
        [self refreshEngineToggleBtnUI];
        [self relayoutCropBoxSubviews];
    });
}

- (void)handleMovePan:(UIPanGestureRecognizer *)pan {
    CGPoint trans = [pan translationInView:self.rootViewController.view];
    CGRect f = self.cropBoxView.frame;
    CGRect sb = [UIScreen mainScreen].bounds;
    AGDeviceMetrics m = agComputeDeviceMetrics();
    f.origin.x = MAX(4.0, MIN(sb.size.width - f.size.width - 4.0, f.origin.x + trans.x));
    f.origin.y = MAX(m.topSafeLimit, MIN(sb.size.height - f.size.height - 10.0, f.origin.y + trans.y));
    self.cropBoxView.frame = f;
    [pan setTranslation:CGPointZero inView:self.rootViewController.view];
}

- (void)handleResizePan:(UIPanGestureRecognizer *)pan {
    CGPoint trans = [pan translationInView:self.rootViewController.view];
    CGRect f = self.cropBoxView.frame;
    CGRect sb = [UIScreen mainScreen].bounds;
    AGDeviceMetrics m = agComputeDeviceMetrics();
    CGFloat minH = 68.0;
    CGFloat minW = m.isCompactPhone ? 180.0 : 200.0;
    f.size.width = MAX(minW, MIN(sb.size.width - f.origin.x - 6.0, f.size.width + trans.x));
    f.size.height = MAX(minH, MIN(sb.size.height * 0.65, f.size.height + trans.y));
    self.cropBoxView.frame = f;
    [self relayoutCropBoxSubviews];
    [pan setTranslation:CGPointZero inView:self.rootViewController.view];
}

- (void)resetAllTranslationHistoryAndUI {
    _speechTaskGenID++;
    _isNativeTransBusy = NO;
    _pendingNativeText = nil;
    if (self.speechTask) { [self.speechTask cancel]; self.speechTask = nil; }
    if (self.speechRequest) { [self.speechRequest endAudio]; self.speechRequest = nil; }
    for (NSNumber *tid in [self.pipelineTasksMap allKeys]) {
        NSURLSessionDataTask *t = self.pipelineTasksMap[tid][@"task"];
        if (t) [t cancel];
    }
    [self.pipelineTasksMap removeAllObjects];

    if (self.committedHistoryText) [self.committedHistoryText setString:@""];
    self.committedSourceContext = @"";
    _committedTargetContext = @"";
    self.lastRecognizedText = @"";
    self.lastTranslatedChunkText = @"";
    self.latestPartialSegment = @"";
    self.committedTranscriptLength = 0;
    self.highestDisplayedSeq = 0;
    self.queuedNextChunkText = nil;
    self.queuedNextChunkShouldCommit = NO;

    if (self.liveOriginalPreviewLabel) {
        NSString *engineTag = agUseNativeiOSTranslator() ? @"🍎原生离线" : @"☁️API模型";
        self.liveOriginalPreviewLabel.text = [NSString stringWithFormat:@"🎧 [%@] 正在实时监听%@...", engineTag, [self currentLangShortTitle]];
    }
    if (self.translatedTextView) {
        [self updateSubtitleDisplay:@"🎧 正在倾听并实时同传翻译..."];
    }
    agResetRealtimeTranslationState();
}

- (void)toggleTranslatorFloatingBox {
    if (self.hidden) [self showTranslatorFloatingBox];
    else [self hideTranslatorFloatingBox];
}

- (void)showTranslatorFloatingBox {
    if (!agTransIsEnabled()) return;
    self.isAudioTranslatingActive = YES;
    [self resetAllTranslationHistoryAndUI];
    [self applySavedFontSizeAndStyle];

    NSString *proxy = agProxyForTab(AGConfigTabTranslation);
    if (!self.transStreamSession) {
        self.transStreamSession = agCreateSessionWithProxy(proxy, self, [NSOperationQueue mainQueue]);
    }

    self.alpha = 0.0;
    self.hidden = NO;
    self.cropBoxView.transform = CGAffineTransformMakeScale(0.92, 0.92);
    [UIView animateWithDuration:0.25 delay:0 usingSpringWithDamping:0.80 initialSpringVelocity:0.8 options:UIViewAnimationOptionCurveEaseOut animations:^{
        self.alpha = 1.0;
        self.cropBoxView.transform = CGAffineTransformIdentity;
    } completion:nil];

    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.30 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (self.isAudioTranslatingActive && !self.hidden) {
            [self startZeroInterferenceInternalAudioTranslation];
        }
    });
}

- (void)hideTranslatorFloatingBox {
    self.isAudioTranslatingActive = NO;
    self.hidden = YES;
    self.alpha = 0.0;

    [self stopZeroInterferenceInternalAudioTranslation];
    [self resetAllTranslationHistoryAndUI];
    if (self.transStreamSession) {
        [self.transStreamSession invalidateAndCancel];
        self.transStreamSession = nil;
    }
}

#pragma mark - 👂 纯净零音损收音 + 苹果芯片本地离线识别

- (void)stopFallbackAudioEngineOnly {
    AVAudioEngine *eng = self.voiceFallbackEngine;
    self.voiceFallbackEngine = nil;
    if (eng) {
        @try {
            [eng.inputNode removeTapOnBus:0];
            [eng stop];
        } @catch (NSException *e) {}
    }
}

- (void)startZeroInterferenceInternalAudioTranslation {
    if (!self.isAudioTranslatingActive || self.hidden) return;

    [self.audioKeepAliveTimer invalidate];
    self.audioKeepAliveTimer = nil;
    [self.microDebounceTimer invalidate];
    self.microDebounceTimer = nil;
    [self stopFallbackAudioEngineOnly];

    _speechTaskGenID++;
    if (self.speechTask) { [self.speechTask cancel]; self.speechTask = nil; }
    if (self.speechRequest) { [self.speechRequest endAudio]; self.speechRequest = nil; }

    self.committedTranscriptLength = 0;
    self.latestPartialSegment = @"";
    self.lastRecognizedText = @"";
    self.lastTranslatedChunkText = @"";

    ensureSpringBoardTCCGranted();

    NSString *localeID = [self currentLocaleIdentifier];
    self.speechRecognizer = [[SFSpeechRecognizer alloc] initWithLocale:[NSLocale localeWithLocaleIdentifier:localeID]];
    if (!self.speechRecognizer || !self.speechRecognizer.isAvailable) {
        self.speechRecognizer = [[SFSpeechRecognizer alloc] init];
    }
    if (!self.speechRecognizer || !self.speechRecognizer.isAvailable) {
        [self updateSubtitleDisplay:@"⚠️ 手机「启用听写」未打开，请前往系统《设置 -> 通用 -> 键盘》底部打开「启用听写」"];
    }
    [self setupAndStartSpeechRecognitionTask];

    @try {
        AVAudioSession *sess = [AVAudioSession sharedInstance];
        [sess setCategory:AVAudioSessionCategoryPlayAndRecord
                     mode:AVAudioSessionModeDefault
                  options:AVAudioSessionCategoryOptionMixWithOthers | AVAudioSessionCategoryOptionDefaultToSpeaker | AVAudioSessionCategoryOptionAllowBluetoothA2DP | AVAudioSessionCategoryOptionAllowAirPlay
                    error:nil];
        [sess setActive:YES error:nil];

        AVAudioEngine *engine = [[AVAudioEngine alloc] init];
        AVAudioInputNode *inputNode = engine.inputNode;
        AVAudioFormat *tapFmt = [inputNode outputFormatForBus:0];
        if (!tapFmt || tapFmt.sampleRate <= 0 || tapFmt.channelCount == 0) {
            tapFmt = [inputNode inputFormatForBus:0];
        }
        if (!tapFmt || tapFmt.sampleRate <= 0) return;

        __weak typeof(self) weakSelf = self;
        [inputNode removeTapOnBus:0];
        [inputNode installTapOnBus:0 bufferSize:4096 format:tapFmt block:^(AVAudioPCMBuffer * _Nonnull buffer, AVAudioTime * _Nonnull when) {
            __strong typeof(weakSelf) sSelf = weakSelf;
            if (!sSelf || !sSelf.isAudioTranslatingActive || sSelf.hidden || !buffer || buffer.frameLength == 0) return;
            SFSpeechAudioBufferRecognitionRequest *req = sSelf.speechRequest;
            if (req) {
                @try { [req appendAudioPCMBuffer:buffer]; } @catch (NSException *e) {}
            }
        }];

        [engine prepare];
        NSError *startErr = nil;
        if ([engine startAndReturnError:&startErr] && !startErr) {
            self.voiceFallbackEngine = engine;
        }
    } @catch (NSException *e) {}
}

- (void)setupAndStartSpeechRecognitionTask {
    if (!self.isAudioTranslatingActive || self.hidden || !self.speechRecognizer) return;

    NSUInteger taskGen = ++_speechTaskGenID;
    _speechTaskStartTime = [[NSDate date] timeIntervalSince1970];

    if (self.speechRequest) { [self.speechRequest endAudio]; self.speechRequest = nil; }
    if (self.speechTask) { [self.speechTask cancel]; self.speechTask = nil; }

    self.speechRequest = [[SFSpeechAudioBufferRecognitionRequest alloc] init];
    self.speechRequest.shouldReportPartialResults = YES;
    self.speechRequest.taskHint = SFSpeechRecognitionTaskHintDictation;
    if (@available(iOS 13.0, *)) {
        if (self.speechRecognizer.supportsOnDeviceRecognition) {
            self.speechRequest.requiresOnDeviceRecognition = YES;
        }
    }
    if (@available(iOS 16.0, *)) {
        self.speechRequest.addsPunctuation = YES;
    }

    __weak typeof(self) weakSelf = self;
    self.speechTask = [self.speechRecognizer recognitionTaskWithRequest:self.speechRequest resultHandler:^(SFSpeechRecognitionResult * _Nullable result, NSError * _Nullable error) {
        dispatch_async(dispatch_get_main_queue(), ^{
            __strong typeof(weakSelf) strongSelf = weakSelf;
            if (!strongSelf || !strongSelf.isAudioTranslatingActive || strongSelf.hidden) return;
            if (taskGen != strongSelf->_speechTaskGenID) return;

            if (result) {
                NSString *fullText = result.bestTranscription.formattedString ?: @"";
                if (fullText.length > 0) {
                    if (fullText.length < strongSelf.committedTranscriptLength) {
                        strongSelf.committedTranscriptLength = (fullText.length < 15 && strongSelf.committedTranscriptLength > 30) ? 0 : fullText.length;
                    }
                    NSString *activeWindow = [fullText substringFromIndex:strongSelf.committedTranscriptLength];

                    BOOL isCJKSource = (strongSelf.sourceLangIndex != 0);
                    NSUInteger minPunctCutLen = isCJKSource ? 8 : 18;
                    NSUInteger softClauseLen  = isCJKSource ? 18 : 46;
                    NSUInteger hardClauseLen  = isCJKSource ? 32 : 76;

                    BOOL shouldCommitSlice = NO;
                    NSString *sliceToCommit = nil;

                    if (activeWindow.length >= minPunctCutLen) {
                        NSCharacterSet *endPunctSet = [NSCharacterSet characterSetWithCharactersInString:@".?!。？！"];
                        NSRange endPunctRange = [activeWindow rangeOfCharacterFromSet:endPunctSet
                                                                              options:NSBackwardsSearch
                                                                                range:NSMakeRange(minPunctCutLen - 4, activeWindow.length - (minPunctCutLen - 4))];
                        if (endPunctRange.location != NSNotFound) {
                            NSUInteger advance = endPunctRange.location + 1;
                            sliceToCommit = [[activeWindow substringToIndex:advance] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
                            strongSelf.committedTranscriptLength += advance;
                            activeWindow = [fullText substringFromIndex:strongSelf.committedTranscriptLength];
                            shouldCommitSlice = (sliceToCommit.length >= 2);
                        } else if (activeWindow.length >= softClauseLen) {
                            NSUInteger cutAdvance = 0;
                            NSCharacterSet *punctClauseSet = [NSCharacterSet characterSetWithCharactersInString:@",;，、"];
                            NSUInteger searchStart = isCJKSource ? 10 : 24;
                            NSRange pRange = [activeWindow rangeOfCharacterFromSet:punctClauseSet
                                                                           options:NSBackwardsSearch
                                                                             range:NSMakeRange(searchStart, activeWindow.length - searchStart)];
                            if (pRange.location != NSNotFound) {
                                cutAdvance = pRange.location + 1;
                            } else if (activeWindow.length >= hardClauseLen) {
                                if (isCJKSource) {
                                    cutAdvance = activeWindow.length;
                                } else {
                                    NSRange spaceRange = [activeWindow rangeOfString:@" " options:NSBackwardsSearch range:NSMakeRange(searchStart, activeWindow.length - searchStart)];
                                    cutAdvance = (spaceRange.location != NSNotFound) ? (spaceRange.location + 1) : activeWindow.length;
                                }
                            }
                            if (cutAdvance > 0) {
                                sliceToCommit = [[activeWindow substringToIndex:cutAdvance] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
                                strongSelf.committedTranscriptLength += cutAdvance;
                                activeWindow = [fullText substringFromIndex:strongSelf.committedTranscriptLength];
                                shouldCommitSlice = (sliceToCommit.length >= 2);
                            }
                        }
                    }

                    NSString *cleanSpoken = [activeWindow stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
                    NSString *previewOrig = cleanSpoken.length > 0 ? cleanSpoken : (sliceToCommit ?: @"");
                    if (previewOrig.length > 0) {
                        NSString *modeTag = agUseNativeiOSTranslator() ? @"🍎" : @"☁️";
                        strongSelf.liveOriginalPreviewLabel.text = [NSString stringWithFormat:@"%@ %@", modeTag, previewOrig];
                    }

                    if (shouldCommitSlice && sliceToCommit.length > 0) {
                        if (strongSelf.lastTranslatedChunkText.length > 0) {
                            [strongSelf appendCommittedTranslationSegment:strongSelf.lastTranslatedChunkText];
                            strongSelf.lastTranslatedChunkText = @"";
                            [strongSelf renderCombinedSubtitleWithActiveTail:nil instantHint:nil];
                        }
                        strongSelf.committedSourceContext = sliceToCommit;
                        strongSelf.lastRecognizedText = @"";
                        [strongSelf dispatchMicroChunkTranslation:sliceToCommit isCommitSlice:YES];

                        if ([[NSDate date] timeIntervalSince1970] - strongSelf->_speechTaskStartTime >= 50.0) {
                            strongSelf.committedTranscriptLength = 0;
                            [strongSelf setupAndStartSpeechRecognitionTask];
                            return;
                        }
                    }

                    if (cleanSpoken.length > 0) {
                        strongSelf.latestPartialSegment = cleanSpoken;
                        [strongSelf triggerMicroDebouncedStreamingTranslation];
                    }
                }
            }

            if (error || (result && result.isFinal)) {
                if (taskGen != strongSelf->_speechTaskGenID) return;
                if (error && strongSelf.speechRequest && strongSelf.speechRequest.requiresOnDeviceRecognition) {
                    strongSelf.speechRequest.requiresOnDeviceRecognition = NO;
                }
                if (strongSelf.lastTranslatedChunkText.length > 0) {
                    [strongSelf appendCommittedTranslationSegment:strongSelf.lastTranslatedChunkText];
                    strongSelf.lastTranslatedChunkText = @"";
                    [strongSelf renderCombinedSubtitleWithActiveTail:nil instantHint:nil];
                }
                strongSelf.committedTranscriptLength = 0;
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.45 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    if (strongSelf.isAudioTranslatingActive && !strongSelf.hidden && taskGen == strongSelf->_speechTaskGenID) {
                        [strongSelf setupAndStartSpeechRecognitionTask];
                    }
                });
            }
        });
    }];
}

- (void)triggerMicroDebouncedStreamingTranslation {
    if (!self.isAudioTranslatingActive || self.hidden || isDeviceCurrentlyLocked()) return;
    NSString *seg = self.latestPartialSegment;
    if (!seg || seg.length < 2 || [seg isEqualToString:self.lastRecognizedText]) return;

    [self.microDebounceTimer invalidate];
    NSTimeInterval delay = agUseNativeiOSTranslator() ? 0.16 : 0.32;
    self.microDebounceTimer = [NSTimer scheduledTimerWithTimeInterval:delay target:self selector:@selector(flushPendingSpeechSegmentTick) userInfo:nil repeats:NO];
}

- (void)flushPendingSpeechSegmentTick {
    if (!self.isAudioTranslatingActive || self.hidden || isDeviceCurrentlyLocked()) return;
    NSString *seg = self.latestPartialSegment;
    if (!seg || seg.length < 2 || [seg isEqualToString:self.lastRecognizedText]) return;

    self.lastRecognizedText = seg;
    self.lastSpeechTranslateTime = [[NSDate date] timeIntervalSince1970];
    [self dispatchMicroChunkTranslation:seg isCommitSlice:NO];
}

- (void)stopZeroInterferenceInternalAudioTranslation {
    self.isAudioTranslatingActive = NO;
    _speechTaskGenID++;
    _isNativeTransBusy = NO;
    _pendingNativeText = nil;
    [self.audioKeepAliveTimer invalidate];
    self.audioKeepAliveTimer = nil;
    [self.microDebounceTimer invalidate];
    self.microDebounceTimer = nil;
    [self.silentFallbackTimer invalidate];
    self.silentFallbackTimer = nil;
    [self stopFallbackAudioEngineOnly];

    agResetRealtimeTranslationState();

    if (self.speechRequest) { [self.speechRequest endAudio]; self.speechRequest = nil; }
    if (self.speechTask) { [self.speechTask cancel]; self.speechTask = nil; }
    self.speechRecognizer = nil;
}

#pragma mark - ⚡ 翻译调度：单飞防堵队列支持「🍎原生」与「☁️API」

- (void)dispatchMicroChunkTranslation:(NSString *)chunkText isCommitSlice:(BOOL)isCommit {
    if (!chunkText || chunkText.length < 2) return;

    if (agUseNativeiOSTranslator()) {
        if (_isNativeTransBusy && !isCommit) {
            _pendingNativeText = [chunkText copy];
            _pendingNativeIsCommit = NO;
            return;
        }
        _isNativeTransBusy = YES;
        NSUInteger seq = ++self.latestTranslationSeq;
        if (isCommit) self.highestDisplayedSeq = seq;

        __weak typeof(self) weakSelf = self;
        agTranslateWithNativeiOSFramework(chunkText, [self currentLocaleIdentifier], YES, ^(NSString *zhText, BOOL usedNative) {
            __strong typeof(weakSelf) sSelf = weakSelf;
            if (!sSelf || !sSelf.isAudioTranslatingActive || sSelf.hidden) return;
            sSelf->_isNativeTransBusy = NO;

            if (usedNative && zhText.length > 0) {
                if (isCommit) {
                    [sSelf appendCommittedTranslationSegment:zhText];
                    sSelf->_lastUIRenderTimestamp = 0;
                    [sSelf renderCombinedSubtitleWithActiveTail:sSelf.lastTranslatedChunkText instantHint:nil];
                } else if (seq >= sSelf.highestDisplayedSeq) {
                    sSelf.highestDisplayedSeq = seq;
                    sSelf.lastTranslatedChunkText = zhText;
                    sSelf->_lastUIRenderTimestamp = 0;
                    [sSelf renderCombinedSubtitleWithActiveTail:zhText instantHint:nil];
                }
            } else {
                [sSelf dispatchCloudAPIMicroChunkTranslation:chunkText isCommitSlice:isCommit seq:seq];
            }

            if (sSelf->_pendingNativeText.length >= 2) {
                NSString *nextStr = sSelf->_pendingNativeText;
                BOOL nextCommit = sSelf->_pendingNativeIsCommit;
                sSelf->_pendingNativeText = nil;
                sSelf->_pendingNativeIsCommit = NO;
                [sSelf dispatchMicroChunkTranslation:nextStr isCommitSlice:nextCommit];
            }
        });
        return;
    }

    NSUInteger seq = ++self.latestTranslationSeq;
    if (isCommit) self.highestDisplayedSeq = seq;
    [self dispatchCloudAPIMicroChunkTranslation:chunkText isCommitSlice:isCommit seq:seq];
}

- (void)dispatchCloudAPIMicroChunkTranslation:(NSString *)chunkText isCommitSlice:(BOOL)isCommit seq:(NSUInteger)seq {
    NSString *apiKey = agTransAPIKey();
    NSString *endpoint = agTransEndpoint();
    NSString *model = agTransModel();
    NSString *proxy = agProxyForTab(AGConfigTabTranslation);

    if (endpoint.length < 4 || apiKey.length < 4 || model.length == 0) {
        [self updateSubtitleDisplay:@"⚠️ ☁️API模式需配置翻译Key，或点右上角切回「🍎原生」免Key离线翻译"];
        return;
    }

    if (isCommit || self.pipelineTasksMap.count >= 1) {
        for (NSNumber *tid in [self.pipelineTasksMap allKeys]) {
            NSDictionary *info = self.pipelineTasksMap[tid];
            if (![info[@"isCommit"] boolValue]) {
                NSURLSessionDataTask *oldTask = info[@"task"];
                [self.pipelineTasksMap removeObjectForKey:tid];
                if (oldTask) [oldTask cancel];
            }
        }
    }

    if (!isCommit && self.pipelineTasksMap.count >= 2) {
        self.queuedNextChunkText = chunkText;
        self.queuedNextChunkShouldCommit = NO;
        return;
    }

    NSString *sysInstruction = @"你是专业的同声传译员。请结合上文语境，将【当前待译句子】直接翻译为自然通顺的简体中文口语字幕。只输出纯中文译文，绝不重复上文或解释。";
    NSString *userPrompt = chunkText;
    if (self.committedSourceContext.length > 0 && ![self.committedSourceContext isEqualToString:chunkText]) {
        userPrompt = [NSString stringWithFormat:@"[上句参考(切勿重复翻译): %@ -> %@]\n[当前待译句子]: %@",
                      self.committedSourceContext, (_committedTargetContext ?: @""), chunkText];
    }

    BOOL isGoogle = agIsGoogleNativeProtocol(endpoint, model);
    NSMutableURLRequest *req = nil;

    if (isGoogle) {
        NSString *baseEP = agSanitizeEndpoint(endpoint, AGConfigTabTranslation);
        NSString *fullM = [model hasPrefix:@"models/"] ? model : [NSString stringWithFormat:@"models/%@", model];
        NSString *urlStr = [NSString stringWithFormat:@"%@/v1beta/%@:streamGenerateContent?alt=sse&key=%@", baseEP, fullM, apiKey];
        req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
        req.HTTPMethod = @"POST";
        [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];
        NSMutableDictionary *genCfg = [@{ @"temperature": @0.1, @"maxOutputTokens": @120 } mutableCopy];
        NSString *lowerM = [fullM lowercaseString];
        if (!_disableThinkingBudgetParam && ([lowerM containsString:@"2.5"] || [lowerM containsString:@"3."]) && ![lowerM containsString:@"pro"]) {
            genCfg[@"thinkingConfig"] = @{ @"thinkingBudget": @0 };
        }
        NSDictionary *body = @{
            @"systemInstruction": @{ @"parts": @[ @{ @"text": sysInstruction } ] },
            @"contents": @[ @{ @"role": @"user", @"parts": @[ @{ @"text": userPrompt } ] } ],
            @"generationConfig": genCfg
        };
        req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
    } else {
        NSString *urlStr = agSanitizeOpenAIEndpoint(endpoint);
        req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
        req.HTTPMethod = @"POST";
        [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];
        [req setValue:[NSString stringWithFormat:@"Bearer %@", apiKey] forHTTPHeaderField:@"Authorization"];
        NSString *exactM = [model stringByReplacingOccurrencesOfString:@"models/" withString:@""];
        NSDictionary *body = @{
            @"model": exactM,
            @"messages": @[ @{ @"role": @"system", @"content": sysInstruction }, @{ @"role": @"user", @"content": userPrompt } ],
            @"temperature": @0.1, @"max_tokens": @120, @"stream": @YES
        };
        req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
    }
    req.timeoutInterval = 5.0;

    if (!self.transStreamSession) {
        self.transStreamSession = agCreateSessionWithProxy(proxy, self, [NSOperationQueue mainQueue]);
    }
    NSURLSessionDataTask *task = [self.transStreamSession dataTaskWithRequest:req];
    self.pipelineTasksMap[@(task.taskIdentifier)] = [@{
        @"task": task, @"seq": @(seq), @"isCommit": @(isCommit), @"sourceText": chunkText,
        @"streamBuf": [NSMutableString string], @"sseBuf": [NSMutableString string], @"rawData": [NSMutableData data]
    } mutableCopy];
    [task resume];
}

- (void)URLSession:(NSURLSession *)session dataTask:(NSURLSessionDataTask *)dataTask didReceiveData:(NSData *)data {
    NSMutableDictionary *ctx = self.pipelineTasksMap[@(dataTask.taskIdentifier)];
    if (!ctx || !data || data.length == 0) return;

    NSMutableData *rawData = ctx[@"rawData"];
    NSMutableString *sseBuf = ctx[@"sseBuf"];
    NSMutableString *streamBuf = ctx[@"streamBuf"];
    NSUInteger seq = [ctx[@"seq"] unsignedIntegerValue];
    BOOL isCommit = [ctx[@"isCommit"] boolValue];

    [rawData appendData:data];
    NSString *chunkStr = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
    if (!chunkStr) return;

    [sseBuf appendString:chunkStr];
    NSArray<NSString *> *lines = [sseBuf componentsSeparatedByString:@"\n"];

    BOOL hasDelta = NO;
    for (NSInteger i = 0; i < (NSInteger)lines.count - 1; i++) {
        NSString *line = [lines[i] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if ([line hasPrefix:@"data:"]) {
            NSString *jsonStr = [[line substringFromIndex:5] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            if ([jsonStr isEqualToString:@"[DONE]"]) continue;
            NSData *jData = [jsonStr dataUsingEncoding:NSUTF8StringEncoding];
            if (!jData) continue;
            NSDictionary *dict = [NSJSONSerialization JSONObjectWithData:jData options:0 error:nil];
            NSString *delta = agExtractTextFromJSON(dict);
            if (delta.length > 0) {
                [streamBuf appendString:delta];
                hasDelta = YES;
            }
        }
    }
    [sseBuf setString:lines.lastObject ?: @""];

    if (hasDelta && streamBuf.length > 0 && seq >= self.highestDisplayedSeq && !isCommit) {
        NSString *cleanPart = [streamBuf stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if (cleanPart.length >= 2) {
            self.highestDisplayedSeq = seq;
            self.lastTranslatedChunkText = cleanPart;
            [self renderCombinedSubtitleWithActiveTail:cleanPart instantHint:nil];
        }
    }
}

- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task didCompleteWithError:(NSError *)error {
    NSMutableDictionary *ctx = self.pipelineTasksMap[@(task.taskIdentifier)];
    if (!ctx) return;
    [self.pipelineTasksMap removeObjectForKey:@(task.taskIdentifier)];
    if (error && error.code == NSURLErrorCancelled) return;

    NSMutableString *streamBuf = ctx[@"streamBuf"];
    NSMutableData *rawData = ctx[@"rawData"];
    NSUInteger seq = [ctx[@"seq"] unsignedIntegerValue];
    BOOL isCommit = [ctx[@"isCommit"] boolValue];
    NSString *srcText = ctx[@"sourceText"] ?: @"";

    if (streamBuf.length == 0 && rawData.length > 0 && !error) {
        NSDictionary *json = [NSJSONSerialization JSONObjectWithData:rawData options:0 error:nil];
        if ([json isKindOfClass:[NSDictionary class]] && json[@"error"]) {
            NSString *errMsg = json[@"error"][@"message"] ?: @"API 响应异常";
            if (!_disableThinkingBudgetParam && [errMsg containsString:@"thinking"]) {
                _disableThinkingBudgetParam = YES;
                if (srcText.length > 0) [self dispatchCloudAPIMicroChunkTranslation:srcText isCommitSlice:isCommit seq:seq];
                return;
            }
            return;
        }
        NSString *fullReply = [agExtractTextFromJSON(json) stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if (fullReply.length > 0) [streamBuf setString:fullReply];
    }

    NSString *finalChunkZh = [streamBuf stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (finalChunkZh.length > 0) {
        if (isCommit) {
            [self appendCommittedTranslationSegment:finalChunkZh];
            _lastUIRenderTimestamp = 0;
            [self renderCombinedSubtitleWithActiveTail:self.lastTranslatedChunkText instantHint:nil];
        } else if (seq >= self.highestDisplayedSeq) {
            self.highestDisplayedSeq = seq;
            self.lastTranslatedChunkText = finalChunkZh;
            _lastUIRenderTimestamp = 0;
            [self renderCombinedSubtitleWithActiveTail:finalChunkZh instantHint:nil];
        }
    }

    if (self.queuedNextChunkText.length > 0) {
        NSString *nextTxt = self.queuedNextChunkText;
        BOOL nextCommit = self.queuedNextChunkShouldCommit;
        self.queuedNextChunkText = nil;
        self.queuedNextChunkShouldCommit = NO;
        self.lastSpeechTranslateTime = [[NSDate date] timeIntervalSince1970];
        [self dispatchMicroChunkTranslation:nextTxt isCommitSlice:nextCommit];
    }
}

@end

// ==================== 网页/全屏原位覆膜就地翻译管理器（支持 🍎原生逐框并发 + ☁️API） ====================
static void agPerformCloudAPIGeneralTranslation(NSString *sourceText, void (^completion)(NSString *translatedText, NSError *error)) {
    NSString *apiKey = agTransAPIKey();
    NSString *endpoint = agTransEndpoint();
    NSString *model = agTransModel();
    NSString *proxy = agProxyForTab(AGConfigTabTranslation);

    if (endpoint.length < 4 || apiKey.length < 4 || model.length == 0) {
        if (completion) completion(nil, [NSError errorWithDomain:@"AGTrans" code:401 userInfo:@{NSLocalizedDescriptionKey: @"未配置翻译专属 API"}]);
        return;
    }

    NSString *prompt = [NSString stringWithFormat:@"你是一个专业的即时多语言翻译引擎。请将以下带有序号的外语文本直接翻译为自然流畅的简体中文。\n"
        @"1. 每一行必须严格对应翻译，格式保持：[序号] 中文翻译内容\n"
        @"2. 只输出中文翻译结果：\n%@", sourceText];

    NSURLSession *session = [[AGSharedTransSessionRouter sharedRouter] sharedNonStreamSessionForProxy:proxy];
    BOOL isGoogle = agIsGoogleNativeProtocol(endpoint, model);
    NSMutableURLRequest *req = nil;

    if (isGoogle) {
        NSString *baseEP = agSanitizeEndpoint(endpoint, AGConfigTabTranslation);
        NSString *fullM = [model hasPrefix:@"models/"] ? model : [NSString stringWithFormat:@"models/%@", model];
        NSString *urlStr = [NSString stringWithFormat:@"%@/v1beta/%@:generateContent?key=%@", baseEP, fullM, apiKey];
        req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
        req.HTTPMethod = @"POST";
        [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];
        NSMutableDictionary *genCfg = [@{ @"temperature": @0.1, @"maxOutputTokens": @1024 } mutableCopy];
        NSString *lowerM = [fullM lowercaseString];
        if (([lowerM containsString:@"2.5"] || [lowerM containsString:@"3."]) && ![lowerM containsString:@"pro"]) {
            genCfg[@"thinkingConfig"] = @{ @"thinkingBudget": @0 };
        }
        NSDictionary *body = @{ @"contents": @[ @{ @"role": @"user", @"parts": @[ @{ @"text": prompt } ] } ], @"generationConfig": genCfg };
        req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
    } else {
        NSString *urlStr = agSanitizeOpenAIEndpoint(endpoint);
        req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
        req.HTTPMethod = @"POST";
        [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];
        [req setValue:[NSString stringWithFormat:@"Bearer %@", apiKey] forHTTPHeaderField:@"Authorization"];
        NSString *exactM = [model stringByReplacingOccurrencesOfString:@"models/" withString:@""];
        NSDictionary *body = @{ @"model": exactM, @"messages": @[ @{ @"role": @"user", @"content": prompt } ], @"temperature": @0.1, @"max_tokens": @1024 };
        req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
    }
    req.timeoutInterval = 8.0;

    [[session dataTaskWithRequest:req completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
        dispatch_async(dispatch_get_main_queue(), ^{
            if (error || !data) {
                if (completion) completion(nil, error);
                return;
            }
            NSDictionary *json = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
            if ([json isKindOfClass:[NSDictionary class]] && json[@"error"]) {
                if (completion) completion(nil, [NSError errorWithDomain:@"AGTrans" code:500 userInfo:@{NSLocalizedDescriptionKey: json[@"error"][@"message"] ?: @"API报错"}]);
                return;
            }
            NSString *resultText = [[[GeminiAssistantManager sharedManager] extractTextFromDictionary:json] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            if (completion) completion(resultText, nil);
        });
    }] resume];
}
// ====== 最终确认替换块 2 结束 ======

typedef void *IOHIDEventSystemClientRef;
typedef void *IOHIDEventRef;
typedef void *IOHIDServiceRef;
typedef void (*IOHIDEventSystemClientEventCallback)(void *target, void *refcon, IOHIDServiceRef service, IOHIDEventRef event);

static IOHIDEventSystemClientRef s_inSituHIDClient = NULL;

static void agInSituHIDCallback(void *target, void *refcon, IOHIDServiceRef service, IOHIDEventRef event) {
    if (!event) return;
    AGInSituTranslationOverlay *overlay = [AGInSituTranslationOverlay sharedOverlay];
    if (!overlay || !overlay.isInSituActive) return;

    static uint32_t (*s_IOHIDEventGetType)(IOHIDEventRef) = NULL;
    static CFIndex (*s_IOHIDEventGetIntegerValue)(IOHIDEventRef, uint32_t) = NULL;
    static dispatch_once_t s_resolveToken;
    dispatch_once(&s_resolveToken, ^{
        void *h = dlopen(NULL, RTLD_GLOBAL | RTLD_LAZY);
        if (!h) h = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_GLOBAL | RTLD_LAZY);
        s_IOHIDEventGetType = (uint32_t (*)(IOHIDEventRef))dlsym(h, "IOHIDEventGetType");
        s_IOHIDEventGetIntegerValue = (CFIndex (*)(IOHIDEventRef, uint32_t))dlsym(h, "IOHIDEventGetIntegerValue");
    });

    if (!s_IOHIDEventGetType || !s_IOHIDEventGetIntegerValue) return;

    uint32_t type = s_IOHIDEventGetType(event);
    if (type == 11) {
        CFIndex touch = s_IOHIDEventGetIntegerValue(event, 0xB0009);
        CFIndex eventMask = s_IOHIDEventGetIntegerValue(event, 0xB0007);
        dispatch_async(dispatch_get_main_queue(), ^{
            [overlay handleGlobalTouchStateChanged:(touch > 0) eventMask:(uint32_t)eventMask];
        });
    }
}

static void initInSituGlobalTouchMonitor(void) {
    if (s_inSituHIDClient) return;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        void *h = dlopen(NULL, RTLD_GLOBAL | RTLD_LAZY);
        if (!h) h = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_GLOBAL | RTLD_LAZY);
        if (!h) return;

        IOHIDEventSystemClientRef (*createClient)(CFAllocatorRef) = (IOHIDEventSystemClientRef (*)(CFAllocatorRef))dlsym(h, "IOHIDEventSystemClientCreate");
        void (*scheduleWithRunLoop)(IOHIDEventSystemClientRef, CFRunLoopRef, CFStringRef) = (void (*)(IOHIDEventSystemClientRef, CFRunLoopRef, CFStringRef))dlsym(h, "IOHIDEventSystemClientScheduleWithRunLoop");
        void (*registerCallback)(IOHIDEventSystemClientRef, IOHIDEventSystemClientEventCallback, void *, void *) = (void (*)(IOHIDEventSystemClientRef, IOHIDEventSystemClientEventCallback, void *, void *))dlsym(h, "IOHIDEventSystemClientRegisterEventCallback");

        if (createClient && scheduleWithRunLoop && registerCallback) {
            s_inSituHIDClient = createClient(kCFAllocatorDefault);
            if (s_inSituHIDClient) {
                scheduleWithRunLoop(s_inSituHIDClient, CFRunLoopGetMain(), kCFRunLoopDefaultMode);
                registerCallback(s_inSituHIDClient, agInSituHIDCallback, NULL, NULL);
            }
        }
    });
}

@implementation AGInSituTranslationOverlay

+ (instancetype)sharedOverlay {
    static AGInSituTranslationOverlay *instance = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        CGRect bounds = [UIScreen mainScreen].bounds;
        UIWindowScene *scene = nil;
        if (@available(iOS 13.0, *)) {
            for (UIScene *s in [UIApplication sharedApplication].connectedScenes) {
                if ([s isKindOfClass:[UIWindowScene class]]) { scene = (UIWindowScene *)s; break; }
            }
        }
        instance = scene ? [[self alloc] initWithWindowScene:scene] : [[self alloc] initWithFrame:bounds];
        instance.frame = bounds;
        [instance setupInSituUI];
    });
    return instance;
}

- (BOOL)_canBecomeKeyWindow { return NO; }

- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    if (self.hidden || self.alpha < 0.05 || !self.revertPillView || self.revertPillView.hidden || self.revertPillView.alpha < 0.05) {
        return nil;
    }
    CGPoint p = [self convertPoint:point toView:self.revertPillView];
    if ([self.revertPillView pointInside:p withEvent:event]) {
        return [self.revertPillView hitTest:p withEvent:event] ?: self.revertPillView;
    }
    return nil;
}

- (void)setupInSituUI {
    self.windowLevel = UIWindowLevelAlert + 15;
    self.backgroundColor = [UIColor clearColor];
    self.hidden = YES;
    self.userInteractionEnabled = YES;
    self.impactHaptic = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleMedium];

    AGLockScreenRootViewController *rootVC = [[AGLockScreenRootViewController alloc] init];
    rootVC.view.backgroundColor = [UIColor clearColor];
    rootVC.view.userInteractionEnabled = YES;
    self.rootViewController = rootVC;

    // 关键核心修复：向系统 backboardd (CAWindowServer) 声明窗口底板与覆膜容器完全不拦截跨进程触控，100% 穿透给底层网页！
    if ([self.layer respondsToSelector:@selector(setHitTestsAsOpaque:)]) {
        [self.layer setHitTestsAsOpaque:NO];
    }
    if ([rootVC.view.layer respondsToSelector:@selector(setHitTestsAsOpaque:)]) {
        [rootVC.view.layer setHitTestsAsOpaque:NO];
    }

    self.patchContainerView = [[UIView alloc] initWithFrame:self.bounds];
    self.patchContainerView.backgroundColor = [UIColor clearColor];
    self.patchContainerView.userInteractionEnabled = NO;
    agDisableLayerHitTestingRecursively(self.patchContainerView.layer);
    [rootVC.view addSubview:self.patchContainerView];

    self.laserBeamView = [[UIView alloc] initWithFrame:CGRectMake(0, 0, self.bounds.size.width, 3.0)];
    CAGradientLayer *grad = [CAGradientLayer layer];
    grad.frame = self.laserBeamView.bounds;
    grad.colors = @[
        (id)[UIColor clearColor].CGColor,
        (id)[UIColor colorWithRed:0.69 green:0.32 blue:0.87 alpha:0.9].CGColor,
        (id)[UIColor colorWithRed:0.35 green:0.80 blue:1.00 alpha:0.9].CGColor,
        (id)[UIColor clearColor].CGColor
    ];
    grad.startPoint = CGPointMake(0, 0.5);
    grad.endPoint = CGPointMake(1, 0.5);
    [self.laserBeamView.layer addSublayer:grad];
    self.laserBeamView.alpha = 0.0;
    self.laserBeamView.userInteractionEnabled = NO;
    agDisableLayerHitTestingRecursively(self.laserBeamView.layer);
    [rootVC.view addSubview:self.laserBeamView];

    CGFloat pillW = 330.0;
    CGFloat pillH = 38.0;
    CGFloat screenW = self.bounds.size.width > 0 ? self.bounds.size.width : [UIScreen mainScreen].bounds.size.width;
    CGFloat screenH = self.bounds.size.height > 0 ? self.bounds.size.height : [UIScreen mainScreen].bounds.size.height;
    self.revertPillView = [[UIView alloc] initWithFrame:CGRectMake((screenW - pillW) / 2.0, screenH - pillH - 24.0, pillW, pillH)];
    self.revertPillView.backgroundColor = [UIColor colorWithRed:0.10 green:0.10 blue:0.14 alpha:0.92];
    self.revertPillView.layer.cornerRadius = pillH / 2.0;
    self.revertPillView.layer.borderWidth = 1.0;
    self.revertPillView.layer.borderColor = [UIColor colorWithRed:0.20 green:0.85 blue:0.35 alpha:0.6].CGColor;
    self.revertPillView.layer.shadowColor = [UIColor blackColor].CGColor;
    self.revertPillView.layer.shadowOpacity = 0.5;
    self.revertPillView.layer.shadowRadius = 12.0;
    self.revertPillView.layer.shadowOffset = CGSizeMake(0, 4);

    self.statusLabel = [[UILabel alloc] initWithFrame:CGRectMake(12, 0, 125, pillH)];
    self.statusLabel.text = agUseNativeiOSTranslator() ? @"🍎 原生跟随(点此切)" : @"☁️ API跟随(点此切)";
    self.statusLabel.textColor = [UIColor colorWithRed:0.25 green:0.88 blue:0.45 alpha:1.0];
    self.statusLabel.font = [UIFont boldSystemFontOfSize:11.0];
    self.statusLabel.adjustsFontSizeToFitWidth = YES;
    self.statusLabel.userInteractionEnabled = YES;
    UITapGestureRecognizer *modeTap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(toggleInSituEngineModeTapped)];
    [self.statusLabel addGestureRecognizer:modeTap];
    [self.revertPillView addSubview:self.statusLabel];

    UIView *sep1 = [[UIView alloc] initWithFrame:CGRectMake(140, 8, 1, 22)];
    sep1.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.18];
    [self.revertPillView addSubview:sep1];

    UIButton *rescanBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    rescanBtn.frame = CGRectMake(144, 0, 84, pillH);
    [rescanBtn setTitle:@"🔄 立即重译" forState:UIControlStateNormal];
    [rescanBtn setTitleColor:[UIColor colorWithRed:0.40 green:0.85 blue:1.0 alpha:1.0] forState:UIControlStateNormal];
    rescanBtn.titleLabel.font = [UIFont boldSystemFontOfSize:11.0];
    [rescanBtn addTarget:self action:@selector(manualRetranslateTapped) forControlEvents:UIControlEventTouchUpInside];
    [self.revertPillView addSubview:rescanBtn];

    UIView *sep2 = [[UIView alloc] initWithFrame:CGRectMake(232, 8, 1, 22)];
    sep2.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.18];
    [self.revertPillView addSubview:sep2];

    UIButton *revertBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    revertBtn.frame = CGRectMake(236, 0, 88, pillH);
    [revertBtn setTitle:@"还原原文 ↩️" forState:UIControlStateNormal];
    [revertBtn setTitleColor:[UIColor colorWithRed:1.0 green:0.35 blue:0.30 alpha:1.0] forState:UIControlStateNormal];
    revertBtn.titleLabel.font = [UIFont boldSystemFontOfSize:11.0];
    [revertBtn addTarget:self action:@selector(revertInSituTranslation) forControlEvents:UIControlEventTouchUpInside];
    [self.revertPillView addSubview:revertBtn];

    self.revertPillView.alpha = 0.0;
    self.revertPillView.transform = CGAffineTransformMakeTranslation(0, 50);
    [rootVC.view addSubview:self.revertPillView];

    initInSituGlobalTouchMonitor();
}

- (void)toggleInSituEngineModeTapped {
    [self.impactHaptic impactOccurred];
    BOOL nextNative = !agUseNativeiOSTranslator();
    agSetUseNativeiOSTranslator(nextNative);
    [[AGGlobalActionPillWindow sharedPill] showActionPill:(nextNative ? @"🍎 已切换为：iOS 原生离线翻译" : @"☁️ 已切换为：专属 API 大模型翻译")];
    [self performInSituRetranslateQuietly];
}

- (BOOL)pointInside:(CGPoint)point withEvent:(UIEvent *)event {
    if (self.hidden || self.alpha < 0.05 || !self.revertPillView || self.revertPillView.hidden || self.revertPillView.alpha < 0.05) {
        return NO;
    }
    CGPoint p = [self convertPoint:point toView:self.revertPillView];
    return [self.revertPillView pointInside:p withEvent:event];
}

- (void)startInSituTranslation {
    if (!agTransIsEnabled()) {
        [[GeminiAssistantManager sharedManager] showActionBanner:@"⚠️ 请先在《设置 -> ✨天使守护》启用实时翻译"];
        return;
    }
    if (!agUseNativeiOSTranslator() && agTransAPIKey().length < 4) {
        [[GeminiAssistantManager sharedManager] showActionBanner:@"⚠️ ☁️API模式未填Key，已自动切回「🍎iOS原生免Key翻译」"];
        agSetUseNativeiOSTranslator(YES);
    }

    AGVisualTheme theme = agCurrentVisualTheme();
    UIColor *accentBorderCol = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.92];
    UIColor *pillBgCol       = [UIColor colorWithRed:0.05 green:0.07 blue:0.20 alpha:0.76];
    UIColor *laserCol        = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.95];
    if (theme == AGVisualThemeLightLuxury) {
        accentBorderCol = [UIColor colorWithRed:0.99 green:0.86 blue:0.58 alpha:0.90];
        pillBgCol       = [UIColor colorWithRed:0.10 green:0.07 blue:0.05 alpha:0.76];
        laserCol        = [UIColor colorWithRed:0.99 green:0.84 blue:0.48 alpha:0.95];
    } else if (theme == AGVisualThemeMinimalist) {
        accentBorderCol = [UIColor colorWithRed:0.72 green:0.92 blue:1.00 alpha:0.92];
        pillBgCol       = [UIColor colorWithRed:0.06 green:0.12 blue:0.28 alpha:0.72];
        laserCol        = [UIColor colorWithRed:0.45 green:0.88 blue:1.00 alpha:0.95];
    }
    self.revertPillView.backgroundColor = pillBgCol;
    self.revertPillView.layer.borderWidth = 1.3;
    self.revertPillView.layer.borderColor = accentBorderCol.CGColor;
    self.laserBeamView.backgroundColor = laserCol;
    self.laserBeamView.layer.shadowColor = laserCol.CGColor;

    [self.impactHaptic impactOccurred];
    self.hidden = NO;
    self.alpha = 1.0;
    self.isInSituActive = YES;
    self.isFingerTouching = NO;
    self.inSituScanEpoch++;
    [self.patchContainerView.subviews makeObjectsPerformSelector:@selector(removeFromSuperview)];
    self.patchContainerView.alpha = 1.0;
    agDisableLayerHitTestingRecursively(self.patchContainerView.layer);

    initInSituGlobalTouchMonitor();

    self.laserBeamView.frame = CGRectMake(0, 0, self.bounds.size.width, 3.0);
    self.laserBeamView.alpha = 1.0;
    [UIView animateWithDuration:0.85 delay:0 options:UIViewAnimationOptionCurveEaseInOut animations:^{
        self.laserBeamView.frame = CGRectMake(0, self.bounds.size.height, self.bounds.size.width, 3.0);
    } completion:^(BOOL finished) {
        self.laserBeamView.alpha = 0.0;
    }];

    self.revertPillView.alpha = 1.0;
    self.revertPillView.transform = CGAffineTransformMakeTranslation(0, 50);
    self.statusLabel.text = agUseNativeiOSTranslator() ? @"⚡ 🍎原生秒译中..." : @"⚡ ☁️API翻译中...";
    self.statusLabel.textColor = [UIColor colorWithRed:1.0 green:0.85 blue:0.30 alpha:1.0];
    [UIView animateWithDuration:0.35 delay:0 usingSpringWithDamping:0.80 initialSpringVelocity:0.6 options:UIViewAnimationOptionCurveEaseOut animations:^{
        self.revertPillView.transform = CGAffineTransformIdentity;
    } completion:nil];

    __weak typeof(self) weakSelf = self;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        [weakSelf performInSituRetranslateQuietly];
    });
}

- (void)handleGlobalTouchStateChanged:(BOOL)isTouching eventMask:(uint32_t)mask {
    if (!self.isInSituActive) return;

    if (isTouching) {
        if (!self.isFingerTouching) {
            self.isFingerTouching = YES;
            self.inSituScanEpoch++;
            if (self.scrollSettleTimer) {
                [self.scrollSettleTimer invalidate];
                self.scrollSettleTimer = nil;
            }
            if (self.patchContainerView.alpha > 0.1) {
                [UIView animateWithDuration:0.12 animations:^{
                    self.patchContainerView.alpha = 0.02;
                }];
            }
            self.statusLabel.text = @"👆 滑动中 (松手即译)...";
            self.statusLabel.textColor = [UIColor colorWithRed:0.4 green:0.8 blue:1.0 alpha:1.0];
        } else {
            if (self.scrollSettleTimer) {
                [self.scrollSettleTimer invalidate];
                self.scrollSettleTimer = nil;
            }
        }
    } else {
        if (self.isFingerTouching) {
            self.isFingerTouching = NO;
            NSTimeInterval userDelay = agCustomScrollDebounceSeconds();
            self.statusLabel.text = [NSString stringWithFormat:@"⏳ 停稳 %.1fs 后重译...", userDelay];
            self.statusLabel.textColor = [UIColor colorWithRed:1.0 green:0.85 blue:0.3 alpha:1.0];

            if (self.scrollSettleTimer) [self.scrollSettleTimer invalidate];
            __weak typeof(self) weakSelf = self;
            self.scrollSettleTimer = [NSTimer scheduledTimerWithTimeInterval:userDelay repeats:NO block:^(NSTimer * _Nonnull timer) {
                if (!weakSelf || !weakSelf.isInSituActive || weakSelf.isFingerTouching) return;
                [weakSelf performInSituRetranslateQuietly];
            }];
        }
    }
}

- (void)manualRetranslateTapped {
    [self.impactHaptic impactOccurred];
    if (self.scrollSettleTimer) {
        [self.scrollSettleTimer invalidate];
        self.scrollSettleTimer = nil;
    }
    [self performInSituRetranslateQuietly];
}

// ====== 最终确认替换块 3 开始（原位智能跟随翻译：剔除黑字墨水干扰采样 + 100%图层穿透 + 直达设置->翻译） ======
static void agSamplePatchBackgroundStyle(CGImageRef cleanCG, CGRect screenRect, CGSize screenSize, UIColor **outBgColor, UIColor **outTextColor, UIColor **outBorderColor) {
    BOOL isLightBackground = YES; // 网页默认以浅色优先，防止黑字笔画拉低均值造成黑膏药色块
    double bgR = 0.98, bgG = 0.98, bgB = 0.99;

    if (cleanCG && screenSize.width > 0 && screenSize.height > 0) {
        size_t imgW = CGImageGetWidth(cleanCG);
        size_t imgH = CGImageGetHeight(cleanCG);
        CGFloat scaleX = (CGFloat)imgW / screenSize.width;
        CGFloat scaleY = (CGFloat)imgH / screenSize.height;
        CGRect rawPixelRect = CGRectMake(screenRect.origin.x * scaleX,
                                         screenRect.origin.y * scaleY,
                                         screenRect.size.width * scaleX,
                                         screenRect.size.height * scaleY);
        CGRect pixelRect = CGRectIntersection(rawPixelRect, CGRectMake(0, 0, (CGFloat)imgW, (CGFloat)imgH));
        if (!CGRectIsNull(pixelRect) && pixelRect.size.width >= 4.0 && pixelRect.size.height >= 4.0) {
            CGImageRef subCG = CGImageCreateWithImageInRect(cleanCG, pixelRect);
            if (subCG) {
                uint8_t rgba[6 * 6 * 4] = {0};
                CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
                CGContextRef ctx = CGBitmapContextCreate(rgba, 6, 6, 8, 24, cs, kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
                if (ctx) {
                    CGContextDrawImage(ctx, CGRectMake(0, 0, 6, 6), subCG);
                    CGContextRelease(ctx);

                    // 统计 36 个采样点中亮度较高的像素（剔除黑色文字笔画对白底网页的干扰！）
                    double lums[36];
                    int lightCount = 0;
                    double lightRSum = 0, lightGSum = 0, lightBSum = 0;
                    double darkRSum = 0, darkGSum = 0, darkBSum = 0;
                    int darkCount = 0;

                    for (int i = 0; i < 36; i++) {
                        double r = rgba[i * 4 + 0] / 255.0;
                        double g = rgba[i * 4 + 1] / 255.0;
                        double b = rgba[i * 4 + 2] / 255.0;
                        double l = 0.299 * r + 0.587 * g + 0.114 * b;
                        lums[i] = l;
                        if (l >= 0.46) {
                            lightCount++;
                            lightRSum += r; lightGSum += g; lightBSum += b;
                        } else {
                            darkCount++;
                            darkRSum += r; darkGSum += g; darkBSum += b;
                        }
                    }
                    (void)lums;

                    // 只要有 30% 以上像素是亮色（白底黑字网页背景部分），即判定为浅色背景并取亮色像素均值作为原位底色！
                    if (lightCount >= 11) {
                        isLightBackground = YES;
                        bgR = lightRSum / lightCount;
                        bgG = lightGSum / lightCount;
                        bgB = lightBSum / lightCount;
                    } else {
                        isLightBackground = NO;
                        if (darkCount > 0) {
                            bgR = MAX(0.12, darkRSum / darkCount);
                            bgG = MAX(0.13, darkGSum / darkCount);
                            bgB = MAX(0.18, darkBSum / darkCount);
                        } else {
                            bgR = 0.14; bgG = 0.15; bgB = 0.20;
                        }
                    }
                }
                CGColorSpaceRelease(cs);
                CGImageRelease(subCG);
            }
        }
    }

    NSInteger styleIdx = agTransPatchStyleIndex();
    CGFloat alphaVal = (styleIdx == 0) ? 0.72 : ((styleIdx == 2) ? 0.94 : 0.84);

    if (isLightBackground) {
        if (outBgColor)     *outBgColor     = [UIColor colorWithRed:MAX(0.92, bgR) green:MAX(0.92, bgG) blue:MAX(0.94, bgB) alpha:alphaVal];
        if (outTextColor)   *outTextColor   = [UIColor colorWithRed:0.10 green:0.12 blue:0.16 alpha:1.0];
        if (outBorderColor) *outBorderColor = [UIColor colorWithWhite:0.0 alpha:0.06];
    } else {
        // 深色网页也采用柔和深灰蓝，绝不用死黑块
        if (outBgColor)     *outBgColor     = [UIColor colorWithRed:MIN(0.24, bgR + 0.04) green:MIN(0.25, bgG + 0.04) blue:MIN(0.30, bgB + 0.05) alpha:alphaVal];
        if (outTextColor)   *outTextColor   = [UIColor colorWithRed:0.96 green:0.97 blue:0.99 alpha:1.0];
        if (outBorderColor) *outBorderColor = [UIColor colorWithWhite:1.0 alpha:0.10];
    }
}

static void agAddPatchToContainer(UIView *container, NSDictionary *item, NSString *zhLine) {
    if (!container || !item || zhLine.length == 0) return;
    CGRect rect = [item[@"rect"] CGRectValue];
    CGFloat singleLineH = [item[@"lineHeight"] doubleValue];
    CGRect patchRect = CGRectInset(rect, -2.5, -1.0);
    UIView *patch = [[UIView alloc] initWithFrame:patchRect];
    patch.backgroundColor = item[@"bgColor"] ?: [UIColor colorWithRed:0.96 green:0.96 blue:0.98 alpha:0.84];
    patch.layer.cornerRadius = 4.5;
    patch.layer.borderWidth = 0.5;
    patch.layer.borderColor = [item[@"borderColor"] CGColor];
    patch.userInteractionEnabled = NO;

    UILabel *lbl = [[UILabel alloc] initWithFrame:CGRectInset(patch.bounds, 2.5, 0.5)];
    lbl.text = zhLine;
    lbl.textColor = item[@"textColor"] ?: [UIColor colorWithRed:0.10 green:0.12 blue:0.16 alpha:1.0];
    lbl.font = [UIFont systemFontOfSize:MAX(11.0, MIN(20.0, singleLineH * 0.82)) weight:UIFontWeightMedium];
    lbl.numberOfLines = 0;
    lbl.adjustsFontSizeToFitWidth = YES;
    lbl.minimumScaleFactor = 0.55;
    lbl.userInteractionEnabled = NO;
    [patch addSubview:lbl];

    // 核心：对每一个新生成的翻译覆膜禁用 CALayer 硬件点击测试，让手指在覆膜上滑动和点击网页 100% 穿透！
    agDisableLayerHitTestingRecursively(patch.layer);
    [container addSubview:patch];
}

static BOOL agShouldTranslateOCRString(NSString *str) {
    NSString *trim = [str stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (trim.length < 2) return NO;
    NSString *lower = [trim lowercaseString];
    if ([lower hasPrefix:@"http://"] || [lower hasPrefix:@"https://"] || [lower hasPrefix:@"www."] || [lower containsString:@"@"]) {
        return NO;
    }
    NSUInteger foreignCount = 0;
    NSUInteger hanziCount = 0;
    for (NSUInteger i = 0; i < trim.length; i++) {
        unichar c = [trim characterAtIndex:i];
        if (c >= 0x4E00 && c <= 0x9FFF) hanziCount++;
        else if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= 0x0400 && c <= 0x04FF) || (c >= 0x3040 && c <= 0x30FF) || (c >= 0xAC00 && c <= 0xD7AF)) {
            foreignCount++;
        }
    }
    if (foreignCount < 2 || hanziCount > foreignCount) return NO;
    return YES;
}

- (void)performInSituRetranslateQuietly {
    if (!self.isInSituActive || !agTransIsEnabled()) return;
    BOOL useNative = agUseNativeiOSTranslator();
    if (!useNative && agTransAPIKey().length < 4) return;

    NSInteger currentEpoch = ++self.inSituScanEpoch;
    self.statusLabel.text = useNative ? @"⚡ 🍎原生秒译中..." : @"⚡ ☁️API刷新中...";
    self.statusLabel.textColor = [UIColor colorWithRed:1.0 green:0.85 blue:0.30 alpha:1.0];

    self.patchContainerView.hidden = YES;
    self.revertPillView.hidden = YES;
    UIImage *screenImg = nil;
    @try { screenImg = _UICreateScreenUIImage(); } @catch (NSException *e) { screenImg = nil; }
    self.patchContainerView.hidden = NO;
    self.revertPillView.hidden = NO;

    if (!screenImg || !screenImg.CGImage) {
        self.statusLabel.text = useNative ? @"🍎 原生跟随(点此切)" : @"☁️ API跟随(点此切)";
        self.statusLabel.textColor = [UIColor colorWithRed:0.25 green:0.88 blue:0.45 alpha:1.0];
        self.patchContainerView.alpha = 1.0;
        return;
    }

    CGImageRef cleanCG = CGImageCreateCopy(screenImg.CGImage);
    if (!cleanCG) return;

    __weak typeof(self) weakSelf = self;
    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
        if (currentEpoch != weakSelf.inSituScanEpoch) {
            CGImageRelease(cleanCG);
            return;
        }

        VNRecognizeTextRequest *req = [[VNRecognizeTextRequest alloc] initWithCompletionHandler:^(VNRequest * _Nonnull request, NSError * _Nullable error) {
            if (currentEpoch != weakSelf.inSituScanEpoch) {
                CGImageRelease(cleanCG);
                return;
            }

            if (error || request.results.count == 0) {
                CGImageRelease(cleanCG);
                dispatch_async(dispatch_get_main_queue(), ^{
                    if (currentEpoch != weakSelf.inSituScanEpoch) return;
                    [weakSelf.patchContainerView.subviews makeObjectsPerformSelector:@selector(removeFromSuperview)];
                    weakSelf.statusLabel.text = useNative ? @"🍎 原生跟随(点此切)" : @"☁️ API跟随(点此切)";
                    weakSelf.statusLabel.textColor = [UIColor colorWithRed:0.25 green:0.88 blue:0.45 alpha:1.0];
                    weakSelf.patchContainerView.alpha = 1.0;
                });
                return;
            }

            CGFloat screenW = [UIScreen mainScreen].bounds.size.width;
            CGFloat screenH = [UIScreen mainScreen].bounds.size.height;
            CGSize screenSize = CGSizeMake(screenW, screenH);
            NSMutableArray<NSMutableDictionary *> *rawLines = [NSMutableArray array];

            for (VNRecognizedTextObservation *obs in request.results) {
                VNRecognizedText *cand = [[obs topCandidates:1] firstObject];
                if (!agShouldTranslateOCRString(cand.string)) continue;

                CGRect box = obs.boundingBox;
                CGRect rect = CGRectMake(box.origin.x * screenW,
                                         (1.0 - box.origin.y - box.size.height) * screenH,
                                         box.size.width * screenW,
                                         box.size.height * screenH);

                if (rect.origin.y < 44.0 || rect.origin.y > (screenH - 70.0) || rect.size.width < 15.0 || rect.size.height < 8.0) continue;

                [rawLines addObject:[@{
                    @"text": cand.string,
                    @"rect": [NSValue valueWithCGRect:rect],
                    @"lineHeight": @(rect.size.height),
                    @"lineCount": @1
                } mutableCopy]];
            }

            [rawLines sortUsingComparator:^NSComparisonResult(NSDictionary *a, NSDictionary *b) {
                CGRect ra = [a[@"rect"] CGRectValue];
                CGRect rb = [b[@"rect"] CGRectValue];
                if (fabs(ra.origin.y - rb.origin.y) > MIN(ra.size.height, rb.size.height) * 0.45) {
                    return (ra.origin.y < rb.origin.y) ? NSOrderedAscending : NSOrderedDescending;
                }
                return (ra.origin.x < rb.origin.x) ? NSOrderedAscending : NSOrderedDescending;
            }];

            NSMutableArray<NSMutableDictionary *> *detectedBlocks = [NSMutableArray array];
            for (NSMutableDictionary *lineItem in rawLines) {
                if (detectedBlocks.count == 0) {
                    [detectedBlocks addObject:lineItem];
                    continue;
                }
                NSMutableDictionary *prevItem = detectedBlocks.lastObject;
                CGRect prevRect = [prevItem[@"rect"] CGRectValue];
                CGRect curRect  = [lineItem[@"rect"] CGRectValue];
                CGFloat prevLineH = [prevItem[@"lineHeight"] doubleValue];
                CGFloat vGap = curRect.origin.y - CGRectGetMaxY(prevRect);
                CGFloat hOverlap = MIN(CGRectGetMaxX(prevRect), CGRectGetMaxX(curRect)) - MAX(prevRect.origin.x, curRect.origin.x);
                BOOL sameColumn = (fabs(curRect.origin.x - prevRect.origin.x) < 36.0) || (hOverlap > MIN(prevRect.size.width, curRect.size.width) * 0.45);
                BOOL similarFont = fabs(curRect.size.height - prevLineH) < (prevLineH * 0.45);
                CGRect unionRect = CGRectUnion(prevRect, curRect);

                if (vGap >= -5.0 && vGap <= MAX(14.0, prevLineH * 0.85) && sameColumn && similarFont && unionRect.size.height <= 165.0) {
                    prevItem[@"text"] = [NSString stringWithFormat:@"%@ %@", prevItem[@"text"], lineItem[@"text"]];
                    prevItem[@"rect"] = [NSValue valueWithCGRect:unionRect];
                    prevItem[@"lineCount"] = @([prevItem[@"lineCount"] integerValue] + 1);
                } else {
                    [detectedBlocks addObject:lineItem];
                }
            }

            NSMutableArray<NSString *> *sourceLines = [NSMutableArray array];
            for (NSUInteger i = 0; i < detectedBlocks.count; i++) {
                NSMutableDictionary *blk = detectedBlocks[i];
                CGRect r = [blk[@"rect"] CGRectValue];
                UIColor *bgCol = nil, *txtCol = nil, *bdrCol = nil;
                agSamplePatchBackgroundStyle(cleanCG, r, screenSize, &bgCol, &txtCol, &bdrCol);
                blk[@"bgColor"] = bgCol;
                blk[@"textColor"] = txtCol;
                blk[@"borderColor"] = bdrCol;
                [sourceLines addObject:[NSString stringWithFormat:@"[%lu] %@", (unsigned long)(i + 1), blk[@"text"]]];
            }
            CGImageRelease(cleanCG);

            if (sourceLines.count == 0 || currentEpoch != weakSelf.inSituScanEpoch) {
                dispatch_async(dispatch_get_main_queue(), ^{
                    if (currentEpoch != weakSelf.inSituScanEpoch) return;
                    [weakSelf.patchContainerView.subviews makeObjectsPerformSelector:@selector(removeFromSuperview)];
                    weakSelf.statusLabel.text = useNative ? @"🍎 原生跟随(点此切)" : @"☁️ API跟随(点此切)";
                    weakSelf.statusLabel.textColor = [UIColor colorWithRed:0.25 green:0.88 blue:0.45 alpha:1.0];
                    weakSelf.patchContainerView.alpha = 1.0;
                });
                return;
            }

            if (useNative) {
                dispatch_async(dispatch_get_main_queue(), ^{
                    if (currentEpoch != weakSelf.inSituScanEpoch) return;
                    [weakSelf.patchContainerView.subviews makeObjectsPerformSelector:@selector(removeFromSuperview)];
                    weakSelf.patchContainerView.alpha = 1.0;

                    __block NSUInteger remainingCount = detectedBlocks.count;
                    for (NSUInteger i = 0; i < detectedBlocks.count; i++) {
                        NSDictionary *blkItem = detectedBlocks[i];
                        NSString *rawBlockText = blkItem[@"text"] ?: @"";

                        NSString *cachedZh = [agSharedTranslationMemoryCache() objectForKey:rawBlockText];
                        if (cachedZh.length > 0) {
                            agAddPatchToContainer(weakSelf.patchContainerView, blkItem, cachedZh);
                            remainingCount--;
                            if (remainingCount == 0) {
                                weakSelf.statusLabel.text = @"🍎 原生跟随(点此切)";
                                weakSelf.statusLabel.textColor = [UIColor colorWithRed:0.25 green:0.88 blue:0.45 alpha:1.0];
                            }
                            continue;
                        }

                        agTranslateWithNativeiOSFramework(rawBlockText, nil, NO, ^(NSString *zhText, BOOL usedNative) {
                            if (currentEpoch != weakSelf.inSituScanEpoch) return;
                            NSString *finalZh = (zhText.length > 0) ? zhText : rawBlockText;
                            agAddPatchToContainer(weakSelf.patchContainerView, blkItem, finalZh);
                            remainingCount--;
                            if (remainingCount == 0) {
                                weakSelf.statusLabel.text = @"🍎 原生跟随(点此切)";
                                weakSelf.statusLabel.textColor = [UIColor colorWithRed:0.25 green:0.88 blue:0.45 alpha:1.0];
                                [weakSelf.impactHaptic impactOccurred];
                            }
                        });
                    }
                });
                return;
            }

            NSString *fullCombined = [sourceLines componentsJoinedByString:@"\n"];
            agPerformCloudAPIGeneralTranslation(fullCombined, ^(NSString *translatedText, NSError *transError) {
                if (currentEpoch != weakSelf.inSituScanEpoch) return;
                if (transError || translatedText.length == 0) {
                    weakSelf.statusLabel.text = @"⚠️ API超时(点此切🍎)";
                    weakSelf.statusLabel.textColor = [UIColor colorWithRed:1.0 green:0.4 blue:0.4 alpha:1.0];
                    weakSelf.patchContainerView.alpha = 1.0;
                    return;
                }

                NSArray<NSString *> *translatedLines = [translatedText componentsSeparatedByString:@"\n"];
                NSMutableDictionary<NSNumber *, NSString *> *indexedMap = [NSMutableDictionary dictionary];
                NSRegularExpression *idxRe = [NSRegularExpression regularExpressionWithPattern:@"^\\[(\\d+)\\]\\s*(.*)$" options:0 error:nil];
                for (NSString *rawLine in translatedLines) {
                    NSString *tLine = [rawLine stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
                    if (tLine.length == 0) continue;
                    NSTextCheckingResult *match = [idxRe firstMatchInString:tLine options:0 range:NSMakeRange(0, tLine.length)];
                    if (match && match.numberOfRanges > 2) {
                        NSInteger idx = [[tLine substringWithRange:[match rangeAtIndex:1]] integerValue];
                        NSString *content = [tLine substringWithRange:[match rangeAtIndex:2]];
                        indexedMap[@(idx)] = content;
                    }
                }

                [weakSelf.patchContainerView.subviews makeObjectsPerformSelector:@selector(removeFromSuperview)];
                for (NSUInteger i = 0; i < detectedBlocks.count; i++) {
                    NSDictionary *item = detectedBlocks[i];
                    NSString *zhLine = indexedMap[@(i + 1)];
                    if (!zhLine || zhLine.length == 0) {
                        zhLine = (i < translatedLines.count) ? [translatedLines[i] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] : @"";
                        zhLine = [idxRe stringByReplacingMatchesInString:zhLine options:0 range:NSMakeRange(0, zhLine.length) withTemplate:@"$2"];
                    }
                    if (zhLine.length == 0) zhLine = item[@"text"];
                    agAddPatchToContainer(weakSelf.patchContainerView, item, zhLine);
                }

                weakSelf.patchContainerView.alpha = 0.0;
                [UIView animateWithDuration:0.25 animations:^{
                    weakSelf.patchContainerView.alpha = 1.0;
                }];
                weakSelf.statusLabel.text = @"☁️ API跟随(点此切)";
                weakSelf.statusLabel.textColor = [UIColor colorWithRed:0.25 green:0.88 blue:0.45 alpha:1.0];
                [weakSelf.impactHaptic impactOccurred];
            });
        }];

        req.recognitionLevel = agTransIsHighAccuracyOCR() ? VNRequestTextRecognitionLevelAccurate : VNRequestTextRecognitionLevelFast;
        req.usesLanguageCorrection = YES;
        req.recognitionLanguages = @[@"en-US", @"ru-RU", @"zh-Hans", @"zh-Hant", @"fr-FR", @"de-DE", @"es-ES", @"ja-JP", @"ko-KR", @"uk-UA", @"it-IT", @"pt-BR"];

        VNImageRequestHandler *handler = [[VNImageRequestHandler alloc] initWithCGImage:cleanCG options:@{}];
        [handler performRequests:@[req] error:nil];
    });
}

- (void)revertInSituTranslation {
    [self.impactHaptic impactOccurred];
    self.isInSituActive = NO;
    self.inSituScanEpoch++;
    if (self.scrollSettleTimer) {
        [self.scrollSettleTimer invalidate];
        self.scrollSettleTimer = nil;
    }
    [UIView animateWithDuration:0.25 animations:^{
        self.revertPillView.transform = CGAffineTransformMakeTranslation(0, 50);
        self.patchContainerView.alpha = 0.0;
    } completion:^(BOOL finished) {
        [self.patchContainerView.subviews makeObjectsPerformSelector:@selector(removeFromSuperview)];
        self.patchContainerView.alpha = 1.0;
        self.hidden = YES;
        [[GeminiAssistantManager sharedManager] showActionBanner:@"↩️ 已恢复英文原文"];
    }];
}

@end

// ==================== ⚙️ 手机《设置 -> ✨天使守护 -> 🌐 实时字幕与翻译》面板无损扩展 ====================
@implementation AngelGuardianSettingsViewController (AGNativeTranslationSettingsExt)

- (void)agOnTransEngineModeSegChanged:(UISegmentedControl *)seg {
    BOOL useNative = (seg.selectedSegmentIndex == 0);
    agSetUseNativeiOSTranslator(useNative);
    [self reloadSettingsLayoutAnimated:YES];

    if (useNative) {
        __weak typeof(self) weakSelf = self;
        agRunNativeOfflineTranslationDiagnostics(^(NSString *shortCardSummary, NSString *fullAlertReport, BOOL allCoreReady) {
            [weakSelf reloadSettingsLayoutAnimated:NO];
        });
    }
}

- (void)agOnScrollDelaySegChanged:(UISegmentedControl *)seg {
    NSArray<NSNumber *> *delays = @[@0.20, @0.50, @0.90, @1.50];
    NSInteger idx = MAX(0, MIN((NSInteger)delays.count - 1, seg.selectedSegmentIndex));
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_Trans_ScrollDebounceTime"] = delays[idx];
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
}

- (void)agOnPatchStyleSegChanged:(UISegmentedControl *)seg {
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_Trans_PatchStyle"] = @(seg.selectedSegmentIndex);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
}

- (void)agRunFullNativeDiagnosticsButtonTapped:(UIButton *)sender {
    [sender setTitle:@"⏳ 正在全面体检..." forState:UIControlStateNormal];
    sender.enabled = NO;
    __weak typeof(self) weakSelf = self;
    agRunNativeOfflineTranslationDiagnostics(^(NSString *shortCardSummary, NSString *fullAlertReport, BOOL allCoreReady) {
        sender.enabled = YES;
        [sender setTitle:@"🩺 重新体检离线环境" forState:UIControlStateNormal];
        [weakSelf reloadSettingsLayoutAnimated:NO];

        UIAlertController *alert = [UIAlertController alertControllerWithTitle:(allCoreReady ? @"✅ iOS 原生离线翻译体检通过" : @"🩺 iOS 原生离线翻译体检报告")
                                                                       message:fullAlertReport
                                                                preferredStyle:UIAlertControllerStyleAlert];
        [alert addAction:[UIAlertAction actionWithTitle:@"📥 去《设置->翻译》下载语言包" style:UIAlertActionStyleDefault handler:^(UIAlertAction * _Nonnull action) {
            [weakSelf agOpenSystemTranslateLanguageSettings];
        }]];
        [alert addAction:[UIAlertAction actionWithTitle:@"我知道了" style:UIAlertActionStyleCancel handler:nil]];
        [weakSelf presentViewController:alert animated:YES completion:nil];
    });
}

// 点击「📥 去下载语言包」直接收起模态层并跳转进系统《设置 -> 翻译》
- (void)agOpenSystemTranslateLanguageSettings {
    [self dismissViewControllerAnimated:YES completion:^{
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIApplication *app = [UIApplication sharedApplication];
            Class wsCls = objc_getClass("LSApplicationWorkspace");
            id ws = (wsCls && [wsCls respondsToSelector:@selector(defaultWorkspace)]) ? [wsCls defaultWorkspace] : nil;

            NSArray<NSString *> *prefURLs = @[
                @"prefs:root=TRANSLATE",
                @"App-prefs:root=TRANSLATE",
                @"prefs:root=com.apple.Translate",
                @"App-prefs:root=com.apple.Translate"
            ];
            // 1. 若当前处于系统 Preferences.app 内，优先调用 PreferencesAppController 内部原生路由方法直接跳转《设置 -> 翻译》
            if ([app respondsToSelector:@selector(applicationOpenURL:)]) {
                for (NSString *uStr in prefURLs) {
                    NSURL *u = [NSURL URLWithString:uStr];
                    if (u && [app applicationOpenURL:u]) return;
                }
            }
            // 2. 通过 LSApplicationWorkspace 唤醒《设置 -> 翻译》
            if (ws && [ws respondsToSelector:@selector(openSensitiveURL:withOptions:)]) {
                for (NSString *uStr in prefURLs) {
                    NSURL *u = [NSURL URLWithString:uStr];
                    if (u && [ws openSensitiveURL:u withOptions:nil]) return;
                }
            }
            // 3. 兜底：直接打开苹果自带「翻译」App
            if (ws && [ws respondsToSelector:@selector(openApplicationWithBundleID:)]) {
                [ws openApplicationWithBundleID:@"com.apple.Translate"];
            }
        });
    }];
}

@end

// 在设置卡片底部附加「滑动重译速度」与「覆膜底色深浅」调节器
static void agAppendScrollAndPatchControlsToCard(UIView *card, AngelGuardianSettingsViewController *target, CGFloat startY, CGFloat cardW) {
    CGFloat fieldW = cardW - 32.0;

    UILabel *delayLbl = [[UILabel alloc] initWithFrame:CGRectMake(16, startY, fieldW, 18)];
    delayLbl.text = @"⏱️ 滑动停稳后自动重译速度：";
    delayLbl.font = [UIFont systemFontOfSize:11.5 weight:UIFontWeightSemibold];
    delayLbl.textColor = [UIColor colorWithWhite:0.80 alpha:1.0];
    [card addSubview:delayLbl];

    UISegmentedControl *delaySeg = [[UISegmentedControl alloc] initWithItems:@[@"0.2s极速", @"0.5s适中", @"0.9s从容", @"1.5s慢速"]];
    delaySeg.frame = CGRectMake(16, startY + 20, fieldW, 28);
    NSTimeInterval curDelay = agCustomScrollDebounceSeconds();
    if (curDelay <= 0.30) delaySeg.selectedSegmentIndex = 0;
    else if (curDelay <= 0.65) delaySeg.selectedSegmentIndex = 1;
    else if (curDelay <= 1.15) delaySeg.selectedSegmentIndex = 2;
    else delaySeg.selectedSegmentIndex = 3;
    [delaySeg addTarget:target action:@selector(agOnScrollDelaySegChanged:) forControlEvents:UIControlEventValueChanged];
    [card addSubview:delaySeg];

    UILabel *styleLbl = [[UILabel alloc] initWithFrame:CGRectMake(16, startY + 56, fieldW, 18)];
    styleLbl.text = @"🎨 网页翻译覆膜底色浓淡：";
    styleLbl.font = [UIFont systemFontOfSize:11.5 weight:UIFontWeightSemibold];
    styleLbl.textColor = [UIColor colorWithWhite:0.80 alpha:1.0];
    [card addSubview:styleLbl];

    UISegmentedControl *styleSeg = [[UISegmentedControl alloc] initWithItems:@[@"清爽浅透(72%)", @"柔和自然(84%)", @"实心遮盖(94%)"]];
    styleSeg.frame = CGRectMake(16, startY + 76, fieldW, 28);
    styleSeg.selectedSegmentIndex = agTransPatchStyleIndex();
    [styleSeg addTarget:target action:@selector(agOnPatchStyleSegChanged:) forControlEvents:UIControlEventValueChanged];
    [card addSubview:styleSeg];
}

static UIView *(*orig_AGBuildModuleCard)(id self, SEL _cmd, AGConfigTab tab, CGFloat y, CGFloat cardW) = NULL;
static UIView *hooked_AGBuildModuleCard(AngelGuardianSettingsViewController *self, SEL _cmd, AGConfigTab tab, CGFloat y, CGFloat cardW) {
    if (tab != AGConfigTabTranslation) {
        return orig_AGBuildModuleCard(self, _cmd, tab, y, cardW);
    }

    BOOL isEnabled = agIsTabEnabled(AGConfigTabTranslation);
    BOOL isExpanded = isEnabled && (self.expandedModuleTab == (NSInteger)AGConfigTabTranslation);
    BOOL useNative = agUseNativeiOSTranslator();

    if (!isExpanded) {
        UIView *collapsedCard = orig_AGBuildModuleCard(self, _cmd, tab, y, cardW);
        for (UIView *sub in collapsedCard.subviews) {
            if ([sub isKindOfClass:[UILabel class]] && sub.frame.origin.y > 25.0) {
                UILabel *statusLbl = (UILabel *)sub;
                if (isEnabled) {
                    statusLbl.text = useNative
                        ? @"当前引擎：🍎 iOS 原生离线翻译 (免Key) ▾ 点击配置"
                        : [NSString stringWithFormat:@"当前引擎：☁️ 专属 API (%@) ▾ 点击配置", [agTransModel() stringByReplacingOccurrencesOfString:@"models/" withString:@""]];
                }
                break;
            }
        }
        return collapsedCard;
    }

    if (!useNative) {
        UIView *apiCard = orig_AGBuildModuleCard(self, _cmd, tab, y, cardW);
        CGFloat topShift = 48.0;
        CGFloat bottomExtra = 114.0;
        CGRect f = apiCard.frame;
        CGFloat origH = f.size.height;
        f.size.height = origH + topShift + bottomExtra;
        apiCard.frame = f;

        for (UIView *sub in apiCard.subviews) {
            if (sub.frame.origin.y >= 62.0) {
                CGRect sf = sub.frame;
                sf.origin.y += topShift;
                sub.frame = sf;
            }
        }

        UISegmentedControl *modeSeg = [[UISegmentedControl alloc] initWithItems:@[@"🍎 iOS 原生离线翻译 (免Key)", @"☁️ 专属 API 大模型"]];
        modeSeg.frame = CGRectMake(16, 68, cardW - 32, 32);
        modeSeg.selectedSegmentIndex = 1;
        [modeSeg addTarget:self action:@selector(agOnTransEngineModeSegChanged:) forControlEvents:UIControlEventValueChanged];
        [apiCard addSubview:modeSeg];

        agAppendScrollAndPatchControlsToCard(apiCard, self, origH + topShift - 4.0, cardW);
        return apiCard;
    }

    UIColor *accentCol = [UIColor colorWithRed:0.22 green:0.92 blue:0.65 alpha:1.0];
    CGFloat headerH = 60.0;
    CGFloat bodyH   = 324.0;
    UIView *card = [[UIView alloc] initWithFrame:CGRectMake(16, y, cardW, headerH + bodyH)];
    card.backgroundColor = [UIColor colorWithRed:0.13 green:0.12 blue:0.22 alpha:1.0];
    card.layer.cornerRadius = 16.0;
    card.layer.masksToBounds = YES;
    card.layer.borderWidth = 1.2;
    card.layer.borderColor = [accentCol colorWithAlphaComponent:0.65].CGColor;

    UIButton *headerTapBtn = [UIButton buttonWithType:UIButtonTypeCustom];
    headerTapBtn.frame = CGRectMake(0, 0, cardW - 76, headerH);
    headerTapBtn.tag = 9100 + tab;
    [headerTapBtn addTarget:self action:@selector(onModuleHeaderTapped:) forControlEvents:UIControlEventTouchUpInside];
    [card addSubview:headerTapBtn];

    UILabel *titleLbl = [[UILabel alloc] initWithFrame:CGRectMake(16, 10, cardW - 96, 22)];
    titleLbl.text = @"🌐 实时字幕与翻译";
    titleLbl.font = [UIFont systemFontOfSize:15.5 weight:UIFontWeightBold];
    titleLbl.textColor = [UIColor whiteColor];
    [card addSubview:titleLbl];

    UILabel *statusLbl = [[UILabel alloc] initWithFrame:CGRectMake(16, 33, cardW - 96, 18)];
    statusLbl.text = @"🍎 iOS 原生离线翻译模式 · 免 API Key · ▴ 收起配置";
    statusLbl.font = [UIFont systemFontOfSize:11.5 weight:UIFontWeightMedium];
    statusLbl.textColor = accentCol;
    [card addSubview:statusLbl];

    UISwitch *enableSw = [[UISwitch alloc] init];
    enableSw.on = isEnabled;
    enableSw.onTintColor = accentCol;
    enableSw.tag = 9200 + tab;
    enableSw.center = CGPointMake(cardW - 38, headerH * 0.5);
    [enableSw addTarget:self action:@selector(onModuleEnableSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    [card addSubview:enableSw];

    UIView *sep = [[UIView alloc] initWithFrame:CGRectMake(16, headerH, cardW - 32, 0.5)];
    sep.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.10];
    [card addSubview:sep];

    UISegmentedControl *modeSeg = [[UISegmentedControl alloc] initWithItems:@[@"🍎 iOS 原生离线翻译 (免Key)", @"☁️ 专属 API 大模型"]];
    modeSeg.frame = CGRectMake(16, headerH + 10, cardW - 32, 32);
    modeSeg.selectedSegmentIndex = 0;
    [modeSeg addTarget:self action:@selector(agOnTransEngineModeSegChanged:) forControlEvents:UIControlEventValueChanged];
    [card addSubview:modeSeg];

    UIView *diagBox = [[UIView alloc] initWithFrame:CGRectMake(16, headerH + 50, cardW - 32, 100)];
    diagBox.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.06];
    diagBox.layer.cornerRadius = 12.0;
    diagBox.layer.borderWidth = 0.8;
    diagBox.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.14].CGColor;
    [card addSubview:diagBox];

    UILabel *diagLbl = [[UILabel alloc] initWithFrame:CGRectInset(diagBox.bounds, 10, 8)];
    diagLbl.text = gLatestNativeDiagShortSummary;
    diagLbl.textColor = [UIColor colorWithWhite:0.95 alpha:1.0];
    diagLbl.font = [UIFont systemFontOfSize:11.8 weight:UIFontWeightMedium];
    diagLbl.numberOfLines = 0;
    diagLbl.adjustsFontSizeToFitWidth = YES;
    diagLbl.minimumScaleFactor = 0.80;
    [diagBox addSubview:diagLbl];

    static BOOL sHasAutoRunInitialDiag = NO;
    if (!sHasAutoRunInitialDiag) {
        sHasAutoRunInitialDiag = YES;
        __weak AngelGuardianSettingsViewController *weakSelf = self;
        agRunNativeOfflineTranslationDiagnostics(^(NSString *shortCardSummary, NSString *fullAlertReport, BOOL allCoreReady) {
            [weakSelf reloadSettingsLayoutAnimated:NO];
        });
    }

    CGFloat btnW = (cardW - 32.0 - 10.0) * 0.5;
    UIButton *recheckBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    recheckBtn.frame = CGRectMake(16, headerH + 158, btnW, 34);
    recheckBtn.backgroundColor = [accentCol colorWithAlphaComponent:0.18];
    recheckBtn.layer.cornerRadius = 10.0;
    recheckBtn.layer.borderWidth = 1.0;
    recheckBtn.layer.borderColor = accentCol.CGColor;
    [recheckBtn setTitle:@"🩺 重新体检离线环境" forState:UIControlStateNormal];
    [recheckBtn setTitleColor:accentCol forState:UIControlStateNormal];
    recheckBtn.titleLabel.font = [UIFont boldSystemFontOfSize:12.0];
    [recheckBtn addTarget:self action:@selector(agRunFullNativeDiagnosticsButtonTapped:) forControlEvents:UIControlEventTouchUpInside];
    [card addSubview:recheckBtn];

    UIButton *dlLangBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    dlLangBtn.frame = CGRectMake(16 + btnW + 10.0, headerH + 158, btnW, 34);
    dlLangBtn.backgroundColor = [UIColor colorWithRed:0.25 green:0.65 blue:1.00 alpha:0.22];
    dlLangBtn.layer.cornerRadius = 10.0;
    dlLangBtn.layer.borderWidth = 1.0;
    dlLangBtn.layer.borderColor = [UIColor colorWithRed:0.35 green:0.78 blue:1.00 alpha:0.90].CGColor;
    [dlLangBtn setTitle:@"📥 去下载语言包" forState:UIControlStateNormal];
    [dlLangBtn setTitleColor:[UIColor colorWithRed:0.45 green:0.86 blue:1.00 alpha:1.0] forState:UIControlStateNormal];
    dlLangBtn.titleLabel.font = [UIFont boldSystemFontOfSize:12.0];
    [dlLangBtn addTarget:self action:@selector(agOpenSystemTranslateLanguageSettings) forControlEvents:UIControlEventTouchUpInside];
    [card addSubview:dlLangBtn];

    agAppendScrollAndPatchControlsToCard(card, self, headerH + 202, cardW);
    return card;
}

__attribute__((constructor)) static void agInitNativeTranslationSettingsHook(void) {
    Class cls = objc_getClass("AGSystemPreferencesController");
    SEL sel = @selector(buildIndependentModuleAccordionCardForTab:originY:width:);
    if (cls && sel) {
        Method m = class_getInstanceMethod(cls, sel);
        if (m) {
            orig_AGBuildModuleCard = (UIView *(*)(id, SEL, AGConfigTab, CGFloat, CGFloat))method_getImplementation(m);
            method_setImplementation(m, (IMP)hooked_AGBuildModuleCard);
        }
    }
}
// ====== 最终确认替换块 3 结束 ======

// ==================== 挂钩主界面与《设置》面板 ====================
%group SpringBoardOverlayExtHooks
%hook AGSystemVoiceCoordinator

- (void)setupWindowIfNeeded {
    %orig;
    UIView *content = self.cardBlurView.contentView;
    if (content && ![content viewWithTag:95881]) {
        UIButton *transBtn = [UIButton buttonWithType:UIButtonTypeCustom];
        transBtn.tag = 95881;
        transBtn.backgroundColor = [UIColor clearColor];
        [transBtn addTarget:self action:@selector(agScreenTranslateButtonTapped) forControlEvents:UIControlEventTouchUpInside];
        transBtn.hidden = !agTransIsEnabled();
        [content addSubview:transBtn];
        [self updateHeaderBadges];
    }
}

- (void)toggleOverlayInternal {
    if (![AGScreenTranslationOverlay sharedOverlay].hidden) {
        [[AGScreenTranslationOverlay sharedOverlay] hideTranslatorFloatingBox];
    }
    if (![AGInSituTranslationOverlay sharedOverlay].hidden) {
        [[AGInSituTranslationOverlay sharedOverlay] revertInSituTranslation];
    }
    %orig;
}

%new
- (void)agScreenTranslateButtonTapped {
    [self.impactHaptic impactOccurred];
    if (!agTransIsEnabled()) {
        [self showActionBanner:@"⚠️ 请先在手机《设置 -> ✨天使守护》启用屏幕实时翻译"];
        return;
    }
    AGVisualTheme theme = agCurrentVisualTheme();

    // 若已存在翻译选择面板则收起
    UIView *existingSheet = [self.cardBlurView.contentView viewWithTag:95889];
    if (existingSheet) {
        [existingSheet removeFromSuperview];
        return;
    }

    UIView *parent = self.cardBlurView.contentView;
    CGRect boxFrame = self.innerGlassBox.frame;

    UIBlurEffect *sheetBlur = [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialDark];
    UIVisualEffectView *sheetView = [[UIVisualEffectView alloc] initWithEffect:sheetBlur];
    sheetView.frame = boxFrame;
    sheetView.tag = 95889;
    sheetView.layer.cornerRadius = self.innerGlassBox.layer.cornerRadius;
    sheetView.layer.masksToBounds = YES;
    sheetView.layer.borderWidth = 1.4;

    UIColor *borderCol = nil;
    UIColor *tintBgCol = nil;
    UIColor *btnBgCol  = nil;
    UIColor *titleCol  = nil;

    CGFloat glassAlpha = agMainGlassOpacity();

    if (theme == AGVisualThemeLightLuxury) {
        borderCol = [UIColor colorWithRed:0.98 green:0.85 blue:0.60 alpha:0.85];
        tintBgCol = [UIColor colorWithRed:0.08 green:0.06 blue:0.04 alpha:glassAlpha * 0.95];
        btnBgCol  = [UIColor colorWithRed:0.22 green:0.16 blue:0.10 alpha:0.65];
        titleCol  = [UIColor colorWithRed:1.00 green:0.92 blue:0.75 alpha:1.0];
    } else if (theme == AGVisualThemeMinimalist) {
        borderCol = [UIColor colorWithRed:0.75 green:0.92 blue:1.00 alpha:0.88];
        tintBgCol = [UIColor colorWithRed:0.06 green:0.11 blue:0.26 alpha:glassAlpha * 0.92];
        btnBgCol  = [UIColor colorWithRed:0.16 green:0.28 blue:0.54 alpha:0.58];
        titleCol  = [UIColor colorWithRed:0.88 green:0.96 blue:1.00 alpha:1.0];
    } else {
        borderCol = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.88];
        tintBgCol = [UIColor colorWithRed:0.04 green:0.06 blue:0.18 alpha:glassAlpha * 0.95];
        btnBgCol  = [UIColor colorWithRed:0.10 green:0.20 blue:0.44 alpha:0.62];
        titleCol  = [UIColor colorWithRed:0.55 green:0.96 blue:1.00 alpha:1.0];
    }

    sheetView.layer.borderColor = borderCol.CGColor;
    sheetView.contentView.backgroundColor = tintBgCol;

    CGFloat w = boxFrame.size.width;
    UILabel *hdr = [[UILabel alloc] initWithFrame:CGRectMake(16, 12, w - 32, 22)];
    hdr.text = @"✨ 翻译模块 · 选择实时交互方式";
    hdr.textColor = titleCol;
    hdr.font = [UIFont systemFontOfSize:13.5 weight:UIFontWeightHeavy];
    hdr.textAlignment = NSTextAlignmentCenter;
    [sheetView.contentView addSubview:hdr];

    // 按钮 1：原位智能跟随翻译 (保留)
    UIButton *inSituBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    inSituBtn.frame = CGRectMake(14, 42, w - 28, 48);
    inSituBtn.backgroundColor = btnBgCol;
    inSituBtn.layer.cornerRadius = 14.0;
    inSituBtn.layer.borderWidth = 1.1;
    inSituBtn.layer.borderColor = [borderCol colorWithAlphaComponent:0.65].CGColor;
    [inSituBtn setTitle:@"🪄 原位智能跟随翻译 (覆膜换字·滑动自动重译)" forState:UIControlStateNormal];
    [inSituBtn setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
    inSituBtn.titleLabel.font = [UIFont systemFontOfSize:13.5 weight:UIFontWeightBold];
    [inSituBtn addTarget:self action:@selector(launchInSituFollowTranslationFromSheet) forControlEvents:UIControlEventTouchUpInside];
    [sheetView.contentView addSubview:inSituBtn];

    // 按钮 2：实时语音同传听译 (保留，已彻底移除屏幕框选)
    UIButton *listenTransBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    listenTransBtn.frame = CGRectMake(14, 98, w - 28, 48);
    listenTransBtn.backgroundColor = btnBgCol;
    listenTransBtn.layer.cornerRadius = 14.0;
    listenTransBtn.layer.borderWidth = 1.1;
    listenTransBtn.layer.borderColor = [borderCol colorWithAlphaComponent:0.65].CGColor;
    [listenTransBtn setTitle:@"🎧 实时语音同传听译 (纯译文悬浮字幕)" forState:UIControlStateNormal];
    [listenTransBtn setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
    listenTransBtn.titleLabel.font = [UIFont systemFontOfSize:13.5 weight:UIFontWeightBold];
    [listenTransBtn addTarget:self action:@selector(launchLiveAudioListenTranslationFromSheet) forControlEvents:UIControlEventTouchUpInside];
    [sheetView.contentView addSubview:listenTransBtn];

    // 底部返回按钮
    UIButton *cancelBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    cancelBtn.frame = CGRectMake(14, 152, w - 28, 32);
    [cancelBtn setTitle:@"收起返回" forState:UIControlStateNormal];
    [cancelBtn setTitleColor:[UIColor colorWithWhite:0.82 alpha:1.0] forState:UIControlStateNormal];
    cancelBtn.titleLabel.font = [UIFont systemFontOfSize:12.5 weight:UIFontWeightSemibold];
    [cancelBtn addTarget:self action:@selector(dismissTranslationSheetView) forControlEvents:UIControlEventTouchUpInside];
    [sheetView.contentView addSubview:cancelBtn];

    sheetView.alpha = 0.0;
    sheetView.transform = CGAffineTransformMakeScale(0.94, 0.94);
    [parent addSubview:sheetView];
    [UIView animateWithDuration:0.26 delay:0 usingSpringWithDamping:0.78 initialSpringVelocity:0.8 options:UIViewAnimationOptionCurveEaseOut animations:^{
        sheetView.alpha = 1.0;
        sheetView.transform = CGAffineTransformIdentity;
    } completion:nil];
}

%new
- (void)dismissTranslationSheetView {
    UIView *sheetView = [self.cardBlurView.contentView viewWithTag:95889];
    if (sheetView) {
        [UIView animateWithDuration:0.20 animations:^{
            sheetView.alpha = 0.0;
            sheetView.transform = CGAffineTransformMakeScale(0.94, 0.94);
        } completion:^(BOOL finished) {
            [sheetView removeFromSuperview];
        }];
    }
}

%new
- (void)launchInSituFollowTranslationFromSheet {
    [self dismissTranslationSheetView];
    [self dismissOverlay];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.22 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        [[AGInSituTranslationOverlay sharedOverlay] startInSituTranslation];
    });
}

%new
- (void)launchLiveAudioListenTranslationFromSheet {
    [self dismissTranslationSheetView];
    [self dismissOverlay];

    // 1. 立即重置翻译网络队列与上次的快照缓存
    agResetRealtimeTranslationState();

    // 2. 清空翻页/翻译历史字典中的记录
    if (self.tabTranscriptMap[@(AGConfigTabTranslation)]) {
        [self.tabTranscriptMap[@(AGConfigTabTranslation)] setString:@""];
    }
    if (self.tabHistoryMap[@(AGConfigTabTranslation)]) {
        [self.tabHistoryMap[@(AGConfigTabTranslation)] removeAllObjects];
    }

    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.22 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        // 3. 启动听译悬浮窗并强制清空之前的残留
        AGScreenTranslationOverlay *listenOverlay = [AGScreenTranslationOverlay sharedOverlay];
        [listenOverlay resetAllTranslationHistoryAndUI];
        [listenOverlay showTranslatorFloatingBox];
    });
}

%end
%end // end group SpringBoardOverlayExtHooks

static int (*orig_TCCAccessPreflight)(CFStringRef service, CFDictionaryRef options) = NULL;
static int my_TCCAccessPreflight(CFStringRef service, CFDictionaryRef options) {
    if (agIsSpringBoardProcess() && service) {
        if (CFEqual(service, CFSTR("kTCCServiceCamera")) ||
            CFEqual(service, CFSTR("kTCCServiceMicrophone")) ||
            CFEqual(service, CFSTR("kTCCServiceAddressBook")) ||
            CFEqual(service, CFSTR("kTCCServiceSpeechRecognition"))) {
            return 0; // 仅在 SpringBoard 内免弹窗放行
        }
    }
    if (orig_TCCAccessPreflight) {
        return orig_TCCAccessPreflight(service, options);
    }
    return 0;
}

// ====== 防闪退替换 2 开始（替换文件底部直至末尾 %ctor） ======

static void *gSelfDylibBase = NULL;
static void *gCoreLocationBase = NULL;
static void *gCoreLocationValidSym = NULL;
static const char *gCoreLocationPath = "/System/Library/Frameworks/CoreLocation.framework/CoreLocation";

static const char * const kAGNativeCLSymbolPool[] = {
    "CLClientGetLocation",
    "CLClientCreateWithBundleIdentifierAndPath",
    "CLClientRetrieveData",
    "CLClientGetAuthorizationStatus",
    "CLClientStartVehicleHeadingUpdates",
    "CLClientCreateIso6709Notation",
    "CLCopyTechnologiesInUse",
    "CLProvideNetworkLocationUpdate"
};

static BOOL agIsSuspiciousJailbreakPath(const char *path) {
    if (!path) return NO;
    return (strstr(path, "/var/jb") != NULL ||
            strstr(path, ".jbroot") != NULL ||
            strstr(path, "/private/preboot/") != NULL ||
            strstr(path, "procursus") != NULL ||
            strstr(path, "MobileSubstrate") != NULL ||
            strstr(path, "DynamicLibraries") != NULL ||
            strstr(path, "TweakInject") != NULL ||
            strstr(path, "ellekit") != NULL ||
            strstr(path, "substitute") != NULL ||
            strstr(path, "libhooker") != NULL ||
            strstr(path, "Substrate") != NULL ||
            strstr(path, "Cydia") != NULL ||
            strstr(path, "Sileo") != NULL ||
            strstr(path, "Zebra") != NULL ||
            strstr(path, "Filza") != NULL ||
            strstr(path, "TrollStore") != NULL ||
            strstr(path, "Choicy") != NULL ||
            strstr(path, "/apt/") != NULL ||
            strstr(path, "ag_live_diagnostic") != NULL);
}

static int (*orig_dladdr)(const void *addr, Dl_info *info) = NULL;
static int hooked_dladdr(const void *addr, Dl_info *info) {
    int ret = orig_dladdr ? orig_dladdr(addr, info) : 0;
    if (ret != 0 && info && info->dli_fname && agIsAntiDetectionShieldActive()) {
        if ((gSelfDylibBase != NULL && info->dli_fbase == gSelfDylibBase) ||
            agIsSuspiciousJailbreakPath(info->dli_fname)) {
            BOOL isDirectFunctionEntryQuery = (info->dli_saddr == addr);
            info->dli_fname = gCoreLocationPath;
            uintptr_t addrHash = ((uintptr_t)addr >> 4) & 0x7;
            info->dli_sname = kAGNativeCLSymbolPool[addrHash];
            if (isDirectFunctionEntryQuery && gCoreLocationBase != NULL) {
                info->dli_fbase = gCoreLocationBase;
                if (gCoreLocationValidSym != NULL) {
                    info->dli_saddr = gCoreLocationValidSym;
                }
            }
        }
    }
    return ret;
}

static const char *(*orig_dyld_get_image_name)(uint32_t image_index) = NULL;
static const char *hooked_dyld_get_image_name(uint32_t image_index) {
    const char *name = orig_dyld_get_image_name ? orig_dyld_get_image_name(image_index) : NULL;
    if (name && agIsAntiDetectionShieldActive()) {
        if (agIsSuspiciousJailbreakPath(name)) {
            static char sSafeSysPaths[32][128];
            uint32_t slot = image_index & 31;
            if (sSafeSysPaths[slot][0] == 0) {
                snprintf(sSafeSysPaths[slot], sizeof(sSafeSysPaths[slot]),
                         "/System/Library/PrivateFrameworks/CoreSpatial_%u.framework/CoreSpatial_%u",
                         slot, slot);
            }
            return sSafeSysPaths[slot];
        }
    }
    return name;
}

static const char *(*orig_class_getImageName)(Class cls) = NULL;
static const char *hooked_class_getImageName(Class cls) {
    const char *name = orig_class_getImageName ? orig_class_getImageName(cls) : NULL;
    if (name && agIsAntiDetectionShieldActive()) {
        if (agIsSuspiciousJailbreakPath(name)) {
            return gCoreLocationPath;
        }
    }
    return name;
}

static const char * _Nonnull * _Nonnull (*orig_objc_copyImageNames)(unsigned int *outCount) = NULL;
static const char * _Nonnull * _Nonnull hooked_objc_copyImageNames(unsigned int *outCount) {
    const char **names = orig_objc_copyImageNames ? orig_objc_copyImageNames(outCount) : NULL;
    if (names && outCount && *outCount > 0 && agIsAntiDetectionShieldActive()) {
        unsigned int writeIdx = 0;
        unsigned int total = *outCount;
        for (unsigned int i = 0; i < total; i++) {
            if (names[i] && agIsSuspiciousJailbreakPath(names[i])) {
                continue;
            }
            names[writeIdx++] = names[i];
        }
        *outCount = writeIdx;
    }
    return names;
}

static const char *(*orig_dyld_image_path_containing_address)(const void *addr) = NULL;
static const char *hooked_dyld_image_path_containing_address(const void *addr) {
    const char *name = orig_dyld_image_path_containing_address ? orig_dyld_image_path_containing_address(addr) : NULL;
    if (name && agIsAntiDetectionShieldActive()) {
        if ((gSelfDylibBase != NULL && addr == gSelfDylibBase) || agIsSuspiciousJailbreakPath(name)) {
            return gCoreLocationPath;
        }
    }
    return name;
}

static int (*orig_access)(const char *path, int amode) = NULL;
static int hooked_access(const char *path, int amode) {
    if (path && agIsAntiDetectionShieldActive() && agIsSuspiciousJailbreakPath(path)) {
        errno = ENOENT;
        return -1;
    }
    return orig_access ? orig_access(path, amode) : -1;
}

// 只要开启了「防检测保护」开关，对所有命中虚拟定位的软件 100% 统一提供 Wi-Fi 保护，不再受固定包名列表限制
static NSInteger agResolveWiFiProtectionMode(NSDictionary **outCustomWiFiDict) {
    if (!agIsAntiDetectionShieldActive()) return 0;

    BOOL kActive = NO, kShield = NO;
    NSInteger kScope = 0, wifiMode = 0;
    double lat = 0.0, lon = 0.0;
    if (!agReadSpoofStateFromKernel(&kActive, &kScope, &kShield, &wifiMode, &lat, &lon, NULL, NULL, NULL)) {
        return 0;
    }
    if (!kActive || !kShield || wifiMode == 0) return 0;

    if (wifiMode == 2) {
        NSString *ssid = nil;
        NSString *bssid = nil;
        if (!agReadCustomWiFiFromKernel(&ssid, &bssid)) {
            NSDictionary *p = agReadOnlyPrefs();
            ssid = [p[@"AG_AntiDet_FakeSSID"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            bssid = [[p[@"AG_AntiDet_FakeBSSID"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] lowercaseString];
        }
        if (ssid.length > 0 && bssid.length >= 11) {
            if (outCustomWiFiDict) {
                NSData *ssidData = [ssid dataUsingEncoding:NSUTF8StringEncoding] ?: [NSData data];
                *outCustomWiFiDict = @{
                    @"SSID": [ssid copy],
                    @"BSSID": [bssid copy],
                    @"SSIDDATA": [ssidData copy]
                };
            }
            return 2;
        }
    }
    return 1;
}

static CFDictionaryRef (*orig_CNCopyCurrentNetworkInfo)(CFStringRef interfaceName) = NULL;
static CFDictionaryRef hooked_CNCopyCurrentNetworkInfo(CFStringRef interfaceName) {
    if (!interfaceName || CFStringGetLength(interfaceName) == 0) return NULL;
    NSDictionary *customWiFi = nil;
    NSInteger mode = agResolveWiFiProtectionMode(&customWiFi);
    if (mode == 2 && customWiFi) {
        return (__bridge_retained CFDictionaryRef)customWiFi;
    } else if (mode == 1) {
        return NULL;
    }
    return orig_CNCopyCurrentNetworkInfo ? orig_CNCopyCurrentNetworkInfo(interfaceName) : NULL;
}

// ==================== 3. 实例级自洽的客户端定位与传感器 Hook ====================
%group StealthLocationClientHooks

%hook UIApplication

- (BOOL)canOpenURL:(NSURL *)url {
    if (url && agIsAntiDetectionShieldActive()) {
        NSString *scheme = [[url scheme] lowercaseString];
        if (scheme.length > 0) {
            if ([scheme isEqualToString:@"cydia"] ||
                [scheme isEqualToString:@"sileo"] ||
                [scheme isEqualToString:@"zbra"] ||
                [scheme isEqualToString:@"filza"] ||
                [scheme isEqualToString:@"trollstore"] ||
                [scheme isEqualToString:@"undecimus"] ||
                [scheme isEqualToString:@"activator"] ||
                [scheme isEqualToString:@"sbreload"]) {
                return NO;
            }
        }
    }
    return %orig(url);
}

%end

%hook NSFileManager

- (BOOL)fileExistsAtPath:(NSString *)path {
    if (path && agIsAntiDetectionShieldActive()) {
        if (agIsSuspiciousJailbreakPath([path UTF8String])) {
            return NO;
        }
    }
    return %orig(path);
}

- (BOOL)fileExistsAtPath:(NSString *)path isDirectory:(BOOL *)isDirectory {
    if (path && agIsAntiDetectionShieldActive()) {
        if (agIsSuspiciousJailbreakPath([path UTF8String])) {
            return NO;
        }
    }
    return %orig(path, isDirectory);
}

%end

%hook CLLocation

- (instancetype)initWithLatitude:(CLLocationDegrees)latitude longitude:(CLLocationDegrees)longitude {
    CLLocation *instance = %orig(latitude, longitude);
    if (instance && !sIsCreatingInternalSpoofLocation) {
        objc_setAssociatedObject(instance, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN);
    }
    return instance;
}

- (instancetype)initWithCoordinate:(CLLocationCoordinate2D)coordinate
                          altitude:(CLLocationDistance)altitude
                horizontalAccuracy:(CLLocationAccuracy)hAccuracy
                  verticalAccuracy:(CLLocationAccuracy)vAccuracy
                         timestamp:(NSDate *)timestamp {
    CLLocation *instance = %orig(coordinate, altitude, hAccuracy, vAccuracy, timestamp);
    if (instance && !sIsCreatingInternalSpoofLocation) {
        objc_setAssociatedObject(instance, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN);
    }
    return instance;
}

- (instancetype)initWithCoordinate:(CLLocationCoordinate2D)coordinate
                          altitude:(CLLocationDistance)altitude
                horizontalAccuracy:(CLLocationAccuracy)hAccuracy
                  verticalAccuracy:(CLLocationAccuracy)vAccuracy
                            course:(CLLocationDirection)course
                             speed:(CLLocationSpeed)speed
                         timestamp:(NSDate *)timestamp {
    CLLocation *instance = %orig(coordinate, altitude, hAccuracy, vAccuracy, course, speed, timestamp);
    if (instance && !sIsCreatingInternalSpoofLocation) {
        objc_setAssociatedObject(instance, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN);
    }
    return instance;
}

- (instancetype)initWithCoordinate:(CLLocationCoordinate2D)coordinate
                          altitude:(CLLocationDistance)altitude
                horizontalAccuracy:(CLLocationAccuracy)hAccuracy
                  verticalAccuracy:(CLLocationAccuracy)vAccuracy
                            course:(CLLocationDirection)course
                    courseAccuracy:(CLLocationDirectionAccuracy)courseAccuracy
                             speed:(CLLocationSpeed)speed
                     speedAccuracy:(CLLocationSpeedAccuracy)speedAccuracy
                         timestamp:(NSDate *)timestamp {
    CLLocation *instance = %orig(coordinate, altitude, hAccuracy, vAccuracy, course, courseAccuracy, speed, speedAccuracy, timestamp);
    if (instance && !sIsCreatingInternalSpoofLocation) {
        objc_setAssociatedObject(instance, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN);
    }
    return instance;
}

- (id)copyWithZone:(NSZone *)zone {
    id copyObj = %orig(zone);
    if (copyObj) {
        if (agIsInAppCustomConstructedLocation(self)) {
            objc_setAssociatedObject(copyObj, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN);
        }
        if (agIsCleanSpoofedLocation(self)) {
            objc_setAssociatedObject(copyObj, kAGHardwareCleanLocationKey, @YES, OBJC_ASSOCIATION_RETAIN);
        }
    }
    return copyObj;
}

- (CLLocationCoordinate2D)coordinate {
    CLLocationCoordinate2D origCoord = %orig;
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) {
            CLLocationCoordinate2D expectedGCJ = agWGS84ToGCJ02(tel.lat, tel.lon);
            if (fabs(origCoord.latitude - expectedGCJ.latitude) < 0.0002 &&
                fabs(origCoord.longitude - expectedGCJ.longitude) < 0.0002) {
                objc_setAssociatedObject(self, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                return origCoord;
            }
            static SEL sSetRefSel = NULL;
            static dispatch_once_t onceToken;
            dispatch_once(&onceToken, ^{
                sSetRefSel = sel_registerName("setReferenceFrame:");
            });
            if ([self respondsToSelector:sSetRefSel]) {
                ((void(*)(id, SEL, int))objc_msgSend)(self, sSetRefSel, 1);
            }
            return CLLocationCoordinate2DMake(tel.lat, tel.lon);
        }
    }
    return origCoord;
}

- (CLLocationDistance)altitude {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) return tel.alt;
    }
    return %orig;
}

- (CLLocationDistance)ellipsoidalAltitude {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) {
            return tel.alt + agGeoidSeparationForCoord(tel.lat, tel.lon);
        }
    }
    return %orig;
}

- (CLLocationAccuracy)horizontalAccuracy {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) return tel.hAcc;
    }
    return %orig;
}

- (CLLocationAccuracy)verticalAccuracy {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) return tel.vAcc;
    }
    return %orig;
}

- (CLLocationDirection)course {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) return tel.course;
    }
    return %orig;
}

- (CLLocationSpeed)speed {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) return tel.speed;
    }
    return %orig;
}

- (CLLocationSpeedAccuracy)speedAccuracy {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) {
            return tel.spdAcc;
        }
    }
    CLLocationSpeedAccuracy orig = %orig;
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && orig < 0.0) {
        return 0.19;
    }
    return orig;
}

- (CLLocationDirectionAccuracy)courseAccuracy {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self) && !agIsCleanSpoofedLocation(self)) {
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) {
            return tel.crsAcc;
        }
    }
    CLLocationDirectionAccuracy orig = %orig;
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self)) {
        if ([self course] < 0.0) return -1.0;
        return (orig > 0.0) ? orig : 13.6;
    }
    return orig;
}

- (NSDate *)timestamp {
    NSDate *origDate = %orig;
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self)) {
        if (origDate && fabs([origDate timeIntervalSinceNow]) < 30.0) {
            return origDate;
        }
        return [NSDate date];
    }
    return origDate;
}

- (CLLocationDistance)distanceFromLocation:(const CLLocation *)location {
    if (!location || ![location isKindOfClass:[CLLocation class]]) return %orig(location);
    if (agIsCurrentProcessTargetedForLocSpoof()) {
        CLLocationCoordinate2D c1 = [self coordinate];
        CLLocationCoordinate2D c2 = [location coordinate];
        double radLat1 = c1.latitude * M_PI / 180.0;
        double radLat2 = c2.latitude * M_PI / 180.0;
        double dLat = radLat2 - radLat1;
        double dLon = (c2.longitude - c1.longitude) * M_PI / 180.0;
        double a = sin(dLat * 0.5) * sin(dLat * 0.5) +
                   cos(radLat1) * cos(radLat2) * sin(dLon * 0.5) * sin(dLon * 0.5);
        double c = 2.0 * atan2(sqrt(a), sqrt(MAX(0.0, 1.0 - a)));
        return 6378137.0 * c;
    }
    return %orig(location);
}

- (NSString *)description {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(self)) {
        CLLocationCoordinate2D c = [self coordinate];
        return [NSString stringWithFormat:@"<+%.8f,+%.8f> +/- %.2fm (speed %.2f mps / course %.2f) @ %@",
                c.latitude, c.longitude, [self horizontalAccuracy], [self speed], [self course], [self timestamp]];
    }
    return %orig;
}

%end

%hook CLLocationManager

- (CLLocation *)location {
    CLLocation *origLoc = %orig;
    if (agIsCurrentProcessTargetedForLocSpoof()) {
        if (origLoc) return origLoc;
        return [[AGLocationSpoofManager sharedSpoofer] constructRealisticSpoofedLocation];
    }
    return origLoc;
}

- (CLAccuracyAuthorization)accuracyAuthorization {
    if (agIsCurrentProcessTargetedForLocSpoof()) {
        return CLAccuracyAuthorizationFullAccuracy;
    }
    return %orig;
}

- (void)startUpdatingLocation {
    %orig;
}

- (void)requestLocation {
    %orig;
}

%end

%hook CLGeocoder

- (void)reverseGeocodeLocation:(CLLocation *)location completionHandler:(CLGeocodeCompletionHandler)completionHandler {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(location)) {
        CLLocation *spoof = [[AGLocationSpoofManager sharedSpoofer] constructRealisticSpoofedLocation];
        if (spoof) {
            %orig(spoof, completionHandler);
            return;
        }
    }
    %orig(location, completionHandler);
}

- (void)reverseGeocodeLocation:(CLLocation *)location preferredLocale:(NSLocale *)locale completionHandler:(CLGeocodeCompletionHandler)completionHandler {
    if (agIsCurrentProcessTargetedForLocSpoof() && !agIsInAppCustomConstructedLocation(location)) {
        CLLocation *spoof = [[AGLocationSpoofManager sharedSpoofer] constructRealisticSpoofedLocation];
        if (spoof) {
            %orig(spoof, locale, completionHandler);
            return;
        }
    }
    %orig(location, locale, completionHandler);
}

%end

%hook CMMotionActivity

- (BOOL)stationary {
    if (agIsAntiDetectionShieldActive()) {
        double kSpeed = 0.0;
        agReadSpoofStateFromKernel(NULL, NULL, NULL, NULL, NULL, NULL, NULL, &kSpeed, NULL);
        return (kSpeed < 0.2);
    }
    return %orig;
}

- (BOOL)walking {
    if (agIsAntiDetectionShieldActive()) {
        double kSpeed = 0.0;
        agReadSpoofStateFromKernel(NULL, NULL, NULL, NULL, NULL, NULL, NULL, &kSpeed, NULL);
        return (kSpeed >= 0.2 && kSpeed <= 4.5);
    }
    return %orig;
}

- (BOOL)automotive {
    if (agIsAntiDetectionShieldActive()) {
        double kSpeed = 0.0;
        agReadSpoofStateFromKernel(NULL, NULL, NULL, NULL, NULL, NULL, NULL, &kSpeed, NULL);
        return (kSpeed > 4.5);
    }
    return %orig;
}

%end

%hook CMPedometerData

- (NSNumber *)numberOfSteps {
    NSNumber *orig = %orig;
    if (agIsAntiDetectionShieldActive()) {
        double kSpeed = 0.0;
        agReadSpoofStateFromKernel(NULL, NULL, NULL, NULL, NULL, NULL, NULL, &kSpeed, NULL);
        if (kSpeed >= 0.2 && kSpeed <= 4.5) {
            NSInteger baseSteps = orig ? [orig integerValue] : 1680;
            NSInteger delta = (NSInteger)(((uint64_t)CFAbsoluteTimeGetCurrent() % 3600) * 1.6);
            return @(MAX(baseSteps, 1200 + delta));
        } else if (orig == nil || [orig integerValue] == 0) {
            return @(1520 + ((NSInteger)CFAbsoluteTimeGetCurrent() % 180));
        }
    }
    return orig;
}

- (NSNumber *)distance {
    NSNumber *orig = %orig;
    if (agIsAntiDetectionShieldActive()) {
        NSNumber *steps = [self numberOfSteps];
        if (steps) {
            return @([steps doubleValue] * 0.72);
        }
    }
    return orig;
}

%end

%hook CMAltitudeData

- (NSNumber *)relativeAltitude {
    if (agIsAntiDetectionShieldActive()) {
        return @(sOUDriftAltM * 0.35);
    }
    return %orig;
}

- (NSNumber *)pressure {
    if (agIsAntiDetectionShieldActive()) {
        AGSpoofedTelemetry tel;
        if (agGetCurrentSpoofedTelemetry(&tel) && tel.valid) {
            double h = MAX(-100.0, MIN(6000.0, tel.alt));
            double pKPa = 101.325 * pow(1.0 - 2.25577e-5 * h, 5.25588);
            return @(pKPa);
        }
    }
    return %orig;
}

%end

%hook NEHotspotNetwork

- (NSString *)SSID {
    NSDictionary *customWiFi = nil;
    NSInteger mode = agResolveWiFiProtectionMode(&customWiFi);
    if (mode == 2 && customWiFi[@"SSID"]) {
        return customWiFi[@"SSID"];
    } else if (mode == 1) {
        return nil;
    }
    return %orig;
}

- (NSString *)BSSID {
    NSDictionary *customWiFi = nil;
    NSInteger mode = agResolveWiFiProtectionMode(&customWiFi);
    if (mode == 2 && customWiFi[@"BSSID"]) {
        return customWiFi[@"BSSID"];
    } else if (mode == 1) {
        return nil;
    }
    return %orig;
}

%end

%end // end group StealthLocationClientHooks

// ==================== 3B. 动态无符号注册的敏感防检测替换函数 ====================
static IMP gOrig_SrcInfo_isSimSoft = NULL;
static IMP gOrig_SrcInfo_isProdAcc = NULL;
static IMP gOrig_CLLoc_isSim1 = NULL;
static IMP gOrig_CLLoc_isSim2 = NULL;
static IMP gOrig_CLLoc_srcInfo = NULL;
static IMP gOrig_CLLoc_type = NULL;
static IMP gOrig_CLLoc_clientLoc = NULL;
static IMP gOrig_AMap_detectRisk = NULL;
static IMP gOrig_AMap_setDetectRisk = NULL;
static Method gDynMethod_AMap_setDetectRisk = NULL;

static BOOL agDyn_SrcInfo_isSimSoft(id self, SEL _cmd) {
    if (agIsAntiDetectionShieldActive()) return NO;
    return gOrig_SrcInfo_isSimSoft ? ((BOOL(*)(id, SEL))gOrig_SrcInfo_isSimSoft)(self, _cmd) : NO;
}

static BOOL agDyn_SrcInfo_isProdAcc(id self, SEL _cmd) {
    if (agIsAntiDetectionShieldActive()) return NO;
    return gOrig_SrcInfo_isProdAcc ? ((BOOL(*)(id, SEL))gOrig_SrcInfo_isProdAcc)(self, _cmd) : NO;
}

static BOOL agDyn_CLLoc_isSim1(id self, SEL _cmd) {
    if (agIsAntiDetectionShieldActive()) return NO;
    return gOrig_CLLoc_isSim1 ? ((BOOL(*)(id, SEL))gOrig_CLLoc_isSim1)(self, _cmd) : NO;
}

static BOOL agDyn_CLLoc_isSim2(id self, SEL _cmd) {
    if (agIsAntiDetectionShieldActive()) return NO;
    return gOrig_CLLoc_isSim2 ? ((BOOL(*)(id, SEL))gOrig_CLLoc_isSim2)(self, _cmd) : NO;
}

static BOOL agDyn_AMap_detectRisk(id self, SEL _cmd) {
    if (agIsAntiDetectionShieldActive()) return NO;
    return gOrig_AMap_detectRisk ? ((BOOL(*)(id, SEL))gOrig_AMap_detectRisk)(self, _cmd) : NO;
}

static void agDyn_AMap_setDetectRisk(id self, SEL _cmd, BOOL detectRisk) {
    if (agIsAntiDetectionShieldActive()) {
        detectRisk = NO; // 强制将高德定位 SDK 内部成员变量 _detectRiskOfFakeLocation 锁定为 NO
    }
    if (gOrig_AMap_setDetectRisk) {
        ((void(*)(id, SEL, BOOL))gOrig_AMap_setDetectRisk)(self, _cmd, detectRisk);
    }
}

static id agDyn_CLLoc_srcInfo(id self, SEL _cmd) {
    id origInfo = gOrig_CLLoc_srcInfo ? ((id(*)(id, SEL))gOrig_CLLoc_srcInfo)(self, _cmd) : nil;
    if (origInfo) return origInfo;
    if (agIsAntiDetectionShieldActive()) {
        if (@available(iOS 15.0, *)) {
            static id sPersistentCleanSource = nil;
            static dispatch_once_t onceToken;
            dispatch_once(&onceToken, ^{
                static const uint8_t kEncSrcCls[] = {0x19,0x16,0x16,0x35,0x39,0x3b,0x2e,0x33,0x35,0x34,0x09,0x35,0x2f,0x28,0x39,0x3f,0x13,0x34,0x3c,0x35,0x28,0x37,0x3b,0x2e,0x33,0x35,0x34};
                static const uint8_t kEncInitSrc[] = {0x33,0x34,0x33,0x2e,0x0d,0x33,0x2e,0x32,0x09,0x35,0x3c,0x2e,0x2d,0x3b,0x28,0x3f,0x09,0x33,0x37,0x2f,0x36,0x3b,0x2e,0x33,0x35,0x34,0x09,0x2e,0x3b,0x2e,0x3f,0x60,0x3b,0x34,0x3e,0x1f,0x22,0x2e,0x3f,0x28,0x34,0x3b,0x36,0x1b,0x39,0x39,0x3f,0x29,0x29,0x35,0x28,0x23,0x09,0x2e,0x3b,0x2e,0x3f,0x60};
                Class srcCls = NSClassFromString(agDecodeObfuscatedCStr(kEncSrcCls, sizeof(kEncSrcCls), 0x5A));
                SEL selInitSrc = agDecodeSelector(kEncInitSrc, sizeof(kEncInitSrc), 0x5A);
                if (srcCls && [srcCls instancesRespondToSelector:selInitSrc]) {
                    id obj = ((id(*)(id, SEL, BOOL, BOOL))objc_msgSend)([srcCls alloc], selInitSrc, NO, NO);
                    if (obj) {
                        CFRetain((__bridge CFTypeRef)obj);
                        sPersistentCleanSource = obj;
                    }
                }
            });
            if (sPersistentCleanSource) return sPersistentCleanSource;
        }
    }
    return nil;
}

static int agDyn_CLLoc_type(id self, SEL _cmd) {
    if (agIsAntiDetectionShieldActive() && !agIsInAppCustomConstructedLocation((CLLocation *)self)) {
        return 1;
    }
    return gOrig_CLLoc_type ? ((int(*)(id, SEL))gOrig_CLLoc_type)(self, _cmd) : 1;
}

static AGCLDaemonLocation agDyn_CLLoc_clientLoc(CLLocation *self, SEL _cmd) {
    AGCLDaemonLocation raw;
    memset(&raw, 0, sizeof(raw));
    if (gOrig_CLLoc_clientLoc) {
        raw = ((AGCLDaemonLocation(*)(id, SEL))gOrig_CLLoc_clientLoc)(self, _cmd);
    }
    if (agIsCurrentProcessTargetedForLocSpoof()) {
        BOOL shieldOn = agIsAntiDetectionShieldActive();
        if (agIsInAppCustomConstructedLocation(self)) {
            if (shieldOn) {
                raw.fromSimulationController = NO;
                if (raw.type <= 0) raw.type = 1;
            }
            return raw;
        }
        AGSpoofedTelemetry tel;
        if (agGetTelemetryForLocationInstance(self, &tel) && tel.valid) {
            CLLocationCoordinate2D expectedGCJ = agWGS84ToGCJ02(tel.lat, tel.lon);
            if (fabs(raw.coordinate.latitude - expectedGCJ.latitude) < 0.0002 &&
                fabs(raw.coordinate.longitude - expectedGCJ.longitude) < 0.0002) {
                objc_setAssociatedObject(self, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                if (shieldOn) {
                    raw.fromSimulationController = NO;
                    if (raw.type <= 0) raw.type = 1;
                }
                return raw;
            }
            double spd = (tel.speed > 0.0) ? tel.speed : 0.0;
            double crs = (tel.course >= 0.0) ? tel.course : -1.0;

            raw.coordinate.latitude = tel.lat;
            raw.coordinate.longitude = tel.lon;
            raw.rawCoordinate.latitude = tel.lat;
            raw.rawCoordinate.longitude = tel.lon;
            raw.horizontalAccuracy = tel.hAcc;
            raw.altitude = tel.alt;
            raw.ellipsoidalAltitude = tel.alt + agGeoidSeparationForCoord(tel.lat, tel.lon);
            raw.verticalAccuracy = tel.vAcc;
            raw.speed = spd;
            raw.course = crs;
            raw.rawCourse = crs;
            raw.referenceFrame = 1;
            raw.rawReferenceFrame = 1;
            if (raw.type <= 0 || raw.type > 1) raw.type = 1;
            if (raw.timestamp <= 0.0) {
                raw.timestamp = CFAbsoluteTimeGetCurrent();
            }

            if (shieldOn) {
                raw.suitability = 1;
                raw.speedAccuracy = tel.spdAcc;
                raw.courseAccuracy = (crs >= 0.0) ? tel.crsAcc : -1.0;
                raw.confidence = 65;
                raw.lifespan = 20.0;
                raw.type = 1;
                raw.integrity = 50;
                raw.referenceFrame = 1;
                raw.rawReferenceFrame = 1;
                raw.fromSimulationController = NO;
            }
        }
    }
    return raw;
}

// ==================== 4. 仅限 SpringBoard 生效的系统级权限与 Info.plist Hook ====================
%group SpringBoardOnlyHooks

%hook NSBundle
- (NSDictionary *)infoDictionary {
    NSDictionary *orig = %orig;
    if (agIsSpringBoardProcess() && self == [NSBundle mainBundle]) {
        NSMutableDictionary *dict = orig ? [orig mutableCopy] : [NSMutableDictionary dictionary];
        dict[@"NSCameraUsageDescription"] = @"天使守护需要使用相机进行独立实景视频 AI 对话";
        dict[@"NSMicrophoneUsageDescription"] = @"天使守护需要使用麦克风进行实时语音对话";
        dict[@"NSSpeechRecognitionUsageDescription"] = @"天使守护需要使用语音识别实现原厂级打断检测";
        return dict;
    }
    return orig;
}
%end

%hook AVCaptureDevice
+ (AVAuthorizationStatus)authorizationStatusForMediaType:(AVMediaType)mediaType {
    if (agIsSpringBoardProcess()) return AVAuthorizationStatusAuthorized;
    return %orig(mediaType);
}
+ (void)requestAccessForMediaType:(AVMediaType)mediaType completionHandler:(void (^)(BOOL granted))handler {
    if (agIsSpringBoardProcess()) {
        if (handler) handler(YES);
        return;
    }
    %orig(mediaType, handler);
}
%end

%hook SFSpeechRecognizer
+ (SFSpeechRecognizerAuthorizationStatus)authorizationStatus {
    if (agIsSpringBoardProcess()) return SFSpeechRecognizerAuthorizationStatusAuthorized;
    return %orig;
}
+ (void)requestAuthorization:(void (^)(SFSpeechRecognizerAuthorizationStatus status))handler {
    if (agIsSpringBoardProcess()) {
        if (handler) handler(SFSpeechRecognizerAuthorizationStatusAuthorized);
        return;
    }
    %orig(handler);
}
%end

%end // end group SpringBoardOnlyHooks

