        [[AGGlobalActionPillWindow sharedPill] showActionPill:msg];
        [self showActionBanner:msg];
    });
}

- (void)handleAirplaneMode:(BOOL)on {
    dispatch_async(dispatch_get_main_queue(), ^{
        dlopen("/System/Library/PrivateFrameworks/AppSupport.framework/AppSupport", RTLD_LAZY);
        Class rpCls = objc_getClass("RadiosPreferences");
        if (rpCls) {
            RadiosPreferences *rp = [[rpCls alloc] init];
            if ([rp respondsToSelector:@selector(setAirplaneMode:)]) {
                [rp setAirplaneMode:on];
                if ([rp respondsToSelector:@selector(synchronize)]) [rp synchronize];
            }
        }
        NSString *msg = on ? @"✈️ 飞行模式已开启" : @"✈️ 飞行模式已关闭";
        [[AGGlobalActionPillWindow sharedPill] showActionPill:msg];
        [self showActionBanner:msg];
    });
}

- (void)handleAppearanceMode:(NSString *)mode {
    dispatch_async(dispatch_get_main_queue(), ^{
        NSString *m = [mode lowercaseString];
        if ([m containsString:@"nightshift"]) {
            BOOL enable = ![m containsString:@"off"];
            dlopen("/System/Library/PrivateFrameworks/CoreBrightness.framework/CoreBrightness", RTLD_LAZY);
            Class cbCls = objc_getClass("CBClient");
            if (cbCls) {
                id client = [[cbCls alloc] init];
                id bl = [client respondsToSelector:@selector(blueLightClient)] ? [client valueForKey:@"blueLightClient"] : nil;
                if (bl && [bl respondsToSelector:@selector(setEnabled:)]) {
                    typedef BOOL (*SetBLFunc)(id, SEL, BOOL);
                    SetBLFunc fn = (SetBLFunc)[bl methodForSelector:sel_registerName("setEnabled:")];
                    if (fn) fn(bl, sel_registerName("setEnabled:"), enable);
                }
            }
            [[AGGlobalActionPillWindow sharedPill] showActionPill:enable ? @"🌅 夜览护眼模式已开启" : @"🌅 夜览护眼模式已关闭"];
            return;
        }
        BOOL isDark = ([m containsString:@"dark"] || [m containsString:@"深"] || [m containsString:@"暗"]);
        dlopen("/System/Library/PrivateFrameworks/UIKitServices.framework/UIKitServices", RTLD_LAZY);
        Class styleCls = objc_getClass("UISUserInterfaceStyleMode");
        if (styleCls) {
            UISUserInterfaceStyleMode *sm = [[styleCls alloc] init];
            if (!sm) sm = ((id(*)(id, SEL, id))objc_msgSend)([styleCls alloc], @selector(initWithDelegate:), nil);
            if ([sm respondsToSelector:@selector(setModeValue:)]) sm.modeValue = isDark ? 2 : 1;
        }
        NSString *msg = isDark ? @"🌙 已切换至系统深色模式" : @"☀️ 已切换至系统浅色模式";
        [[AGGlobalActionPillWindow sharedPill] showActionPill:msg];
        [self showActionBanner:msg];
    });
}

- (void)handleKillBackgroundApps {
    __block double usedBeforeGB = 0.0;
    __block double totalRAMGB = 0.0;
    agGetDeviceMemoryInfo(&usedBeforeGB, &totalRAMGB);

    dispatch_async(dispatch_get_main_queue(), ^{
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🧹 正在安全清理后台应用并测算释放运存..."];
        [self showActionBanner:@"🧹 正在安全清理后台应用并测算释放运存..."];
        AudioServicesPlaySystemSound(1519);
    });

    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
        NSMutableSet<NSString *> *excludedBIDs = [NSMutableSet setWithObjects:
            @"com.apple.springboard", @"com.apple.InCallService", @"com.apple.mobilephone", nil];
        __block NSUInteger closedCardsCount = 0;
        NSMutableArray<NSNumber *> *pidsToKill = [NSMutableArray array];

        // 铁律：在主线程安全访问 SpringBoard 窗口切换器与 FBProcessManager，仅提取纯数字 int PID 供子线程 kill，100% 杜绝 EXC_BAD_ACCESS 注销！
        dispatch_sync(dispatch_get_main_queue(), ^{
            @try {
                Class mediaCtrlCls = objc_getClass("SBMediaController");
                if (mediaCtrlCls && [mediaCtrlCls respondsToSelector:@selector(sharedInstance)]) {
                    id mediaCtrl = [mediaCtrlCls sharedInstance];
                    if ([mediaCtrl respondsToSelector:@selector(nowPlayingApplication)]) {
                        id nowPlayingApp = [mediaCtrl nowPlayingApplication];
                        if (nowPlayingApp && [nowPlayingApp respondsToSelector:@selector(bundleIdentifier)]) {
                            NSString *npBID = [nowPlayingApp bundleIdentifier];
                            if (npBID.length > 0) [excludedBIDs addObject:npBID];
                        }
                    }
                }
            } @catch (NSException *e) {}

            @try {
                UIApplication *app = [UIApplication sharedApplication];
                SEL fgSel = NSSelectorFromString(@"_accessibilityFrontMostApplication");
                if ([app respondsToSelector:fgSel]) {
                    id frontApp = ((id(*)(id, SEL))objc_msgSend)(app, fgSel);
                    if (frontApp && [frontApp respondsToSelector:@selector(bundleIdentifier)]) {
                        NSString *fgBID = [frontApp bundleIdentifier];
                        if (fgBID.length > 0 && ![fgBID isEqualToString:@"com.apple.springboard"]) {
                            [excludedBIDs addObject:fgBID];
                        }
                    }
                }
            } @catch (NSException *e) {}

            id switcher = nil;
            Class coordCls = objc_getClass("SBMainSwitcherControllerCoordinator");
            if (coordCls && [coordCls respondsToSelector:@selector(sharedInstance)]) switcher = [coordCls sharedInstance];
            if (!switcher) {
                Class swCls = objc_getClass("SBMainSwitcherViewController");
                if (swCls) {
                    if ([swCls respondsToSelector:@selector(sharedInstance)]) switcher = [swCls sharedInstance];
                    else if ([swCls respondsToSelector:@selector(sharedInstanceIfExists)]) switcher = [swCls sharedInstanceIfExists];
                }
            }
            if (!switcher) {
                Class wsCls = objc_getClass("SBMainWorkspace");
                if (wsCls && [wsCls respondsToSelector:@selector(sharedInstance)]) {
                    id ws = [wsCls sharedInstance];
                    if ([ws respondsToSelector:@selector(switcherController)]) switcher = [ws valueForKey:@"switcherController"];
                }
            }

            if (switcher && [switcher respondsToSelector:@selector(recentAppLayouts)]) {
                NSArray *layouts = [[switcher recentAppLayouts] copy];
                for (id layout in layouts) {
                    NSString *bid = nil;
                    if ([layout respondsToSelector:@selector(allItems)]) {
                        NSArray *items = [layout allItems];
                        if (items.count > 0 && [items[0] respondsToSelector:@selector(bundleIdentifier)]) bid = [items[0] bundleIdentifier];
                    }
                    if (!bid && [layout respondsToSelector:@selector(rolesToLayoutItemsMap)]) {
                        NSDictionary *map = [layout valueForKey:@"rolesToLayoutItemsMap"];
                        for (id k in map) {
                            id it = map[k];
                            if ([it respondsToSelector:@selector(bundleIdentifier)]) { bid = [it bundleIdentifier]; break; }
                        }
                    }
                    if (bid && [excludedBIDs containsObject:bid]) continue;

                    BOOL cardRemoved = NO;
                    if (bid.length > 0 && [switcher respondsToSelector:@selector(_deleteAppLayoutsMatchingBundleIdentifier:)]) {
                        @try { [switcher _deleteAppLayoutsMatchingBundleIdentifier:bid]; cardRemoved = YES; } @catch (NSException *e) {}
                    }
                    if (!cardRemoved && [switcher respondsToSelector:@selector(_deleteAppLayout:forReason:)]) {
                        @try { [switcher _deleteAppLayout:layout forReason:1]; cardRemoved = YES; } @catch (NSException *e) {}
                    }
                    if (cardRemoved) closedCardsCount++;
                }
            }

            @try {
                Class fbpmCls = objc_getClass("FBProcessManager");
                id fbpm = (fbpmCls && [fbpmCls respondsToSelector:@selector(sharedInstance)]) ? [fbpmCls sharedInstance] : nil;
                if (fbpm && [fbpm respondsToSelector:@selector(allApplicationProcesses)]) {
                    NSArray *procsSnapshot = [[fbpm allApplicationProcesses] copy];
                    for (id proc in procsSnapshot) {
                        NSString *bid = [proc respondsToSelector:@selector(bundleIdentifier)] ? [proc bundleIdentifier] : nil;
                        if (!bid || [excludedBIDs containsObject:bid]) continue;
                        int pid = [proc respondsToSelector:@selector(pid)] ? (int)[(FBProcess *)proc pid] : 0;
                        if (pid > 0) {
                            [pidsToKill addObject:@(pid)];
                        }
                    }
                }
            } @catch (NSException *e) {}
        });

        // 在子线程仅对纯 C 整型 PID 发送信号，绝不触碰任何 Objective-C 对象
        NSUInteger killedProcsCount = 0;
        for (NSNumber *pidNum in pidsToKill) {
            int pid = [pidNum intValue];
            if (pid > 0) {
                kill(pid, SIGKILL);
                killedProcsCount++;
            }
        }

        typedef void (*ag_malloc_relief_fn)(void *, size_t);
        ag_malloc_relief_fn relief = (ag_malloc_relief_fn)dlsym(RTLD_DEFAULT, "malloc_zone_pressure_relief");
        if (relief) relief(NULL, 0);

        // 等待 0.25 秒让内核完成页面回收后读取最新运行内存
        usleep(250000);
        double usedAfterGB = 0.0;
        agGetDeviceMemoryInfo(&usedAfterGB, &totalRAMGB);
        double freeAfterGB = MAX(0.05, totalRAMGB - usedAfterGB);
        int freedMB = (int)round(MAX(0.0, usedBeforeGB - usedAfterGB) * 1024.0);
        int freeAfterMB = (int)round(freeAfterGB * 1024.0);
        int pctBefore = (totalRAMGB > 0) ? (int)round((usedBeforeGB / totalRAMGB) * 100.0) : 0;
        int pctAfter  = (totalRAMGB > 0) ? (int)round((usedAfterGB / totalRAMGB) * 100.0) : 0;

        dispatch_async(dispatch_get_main_queue(), ^{
            NSUInteger totalCleaned = MAX(closedCardsCount, killedProcsCount);
            NSString *cleanMsg = (totalCleaned > 0 || freedMB > 10)
                ? [NSString stringWithFormat:@"🧹 已关%lu个应用｜释放%dMB｜可用运存%.2fG/%.0fG(%d%%)",
                   (unsigned long)totalCleaned, MAX(18, freedMB), freeAfterGB, totalRAMGB, pctAfter]
                : [NSString stringWithFormat:@"🧹 后台已纯净｜当前可用运存 %.2fG/%.0fG (占用%d%%)",
                   freeAfterGB, totalRAMGB, pctAfter];
            [[AGGlobalActionPillWindow sharedPill] showActionPill:cleanMsg];
            [self showActionBanner:cleanMsg];
            AudioServicesPlaySystemSound(1520);

            NSMutableString *curTrans = [self currentTabTranscript];
            if (curTrans.length > 0 && ![curTrans hasSuffix:@"\\n"]) [curTrans appendString:@"\\n\\n"];
            [curTrans appendFormat:@"🧹 智能后台与运行内存清理报告：\\n• 关闭后台应用：%lu 个 (终止进程 %lu 个)\\n• 运行内存变化：占用 %d%% (%.2fG) ➔ %d%% (%.2fG)\\n• 当前可用运存：%.2f GB (%d MB) / 总计 %.1f GB\\n",
             (unsigned long)closedCardsCount, (unsigned long)killedProcsCount, pctBefore, usedBeforeGB, pctAfter, usedAfterGB, freeAfterGB, freeAfterMB, totalRAMGB];
            [self updateResponseTextViewSmoothly:curTrans];
            [self throttledExpandAndScrollTextViewForce:YES];

            NSString *speechReport = [NSString stringWithFormat:@"后台清理完成，已为您关闭 %lu 个后台应用，当前总运行内存 %.0f GB，已用 %.2f GB，剩余可用运行内存 %.2f GB，运存占用率 %d%%。",
                                      (unsigned long)totalCleaned, totalRAMGB, usedAfterGB, freeAfterGB, pctAfter];
            agSpeakAndBroadcastHardwareResult(self, speechReport);
        });
    });
}

- (void)handleSystemDeepClean {
    dispatch_async(dispatch_get_main_queue(), ^{
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🧹 正在深度清理垃圾与释放内存..."];
        [self showActionBanner:@"🧹 正在深度清理垃圾与释放内存..."];
        AudioServicesPlaySystemSound(1519);
    });

    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
        NSFileManager *fm = [NSFileManager defaultManager];
        NSDictionary *fsBefore = [fm attributesOfFileSystemForPath:@"/var" error:nil];
        unsigned long long freeBefore = [fsBefore[NSFileSystemFreeSize] unsignedLongLongValue];
        __block NSUInteger deletedItemsCount = 0;
        __block unsigned long long manualDeletedBytes = 0;

        void (^cleanDirectoryContents)(NSString *, NSArray<NSString *> *) = ^(NSString *dirPath, NSArray<NSString *> *excludedNames) {
            BOOL isDir = NO;
            if (![fm fileExistsAtPath:dirPath isDirectory:&isDir] || !isDir) return;
            NSArray *items = [fm contentsOfDirectoryAtPath:dirPath error:nil];
            if (!items) return;
            for (NSString *item in items) {
                BOOL skip = NO;
                if (excludedNames) {
                    for (NSString *ex in excludedNames) {
                        if ([item containsString:ex]) { skip = YES; break; }
                    }
                }
                if (skip) continue;
                NSString *fullPath = [dirPath stringByAppendingPathComponent:item];
                NSDictionary *attrs = [fm attributesOfItemAtPath:fullPath error:nil];
                if (attrs) manualDeletedBytes += [attrs fileSize];
                if ([fm removeItemAtPath:fullPath error:nil]) deletedItemsCount++;
            }
        };

        NSString *appContainersPath = @"/private/var/mobile/Containers/Data/Application";
        NSArray *appUUIDs = [fm contentsOfDirectoryAtPath:appContainersPath error:nil];
        if (appUUIDs) {
            for (NSString *uuid in appUUIDs) {
                cleanDirectoryContents([NSString stringWithFormat:@"%@/%@/Library/Caches", appContainersPath, uuid], @[@"Snapshots"]);
                cleanDirectoryContents([NSString stringWithFormat:@"%@/%@/tmp", appContainersPath, uuid], nil);
            }
        }
        cleanDirectoryContents(@"/private/var/mobile/tmp", nil);
        cleanDirectoryContents(@"/private/var/tmp", nil);
        cleanDirectoryContents(@"/tmp", @[@"ag_cam_status", @"geminisirioverlay"]);
        cleanDirectoryContents(@"/private/var/mobile/Library/Logs/CrashReporter", @[@"SpringBoard", @"backboardd", @"panic", @"ResetCounter"]);
        cleanDirectoryContents(@"/private/var/root/Library/Logs/CrashReporter", @[@"SpringBoard", @"backboardd", @"panic", @"ResetCounter"]);
        cleanDirectoryContents(@"/private/var/Logs/DiagnosticLogs", nil);
        cleanDirectoryContents(@"/private/var/logs", nil);

        typedef void (*ag_malloc_relief_fn)(void *, size_t);
        ag_malloc_relief_fn relief = (ag_malloc_relief_fn)dlsym(RTLD_DEFAULT, "malloc_zone_pressure_relief");
        if (relief) relief(NULL, 0);

        dispatch_async(dispatch_get_main_queue(), ^{
            NSDictionary *fsAfter = [fm attributesOfFileSystemForPath:@"/var" error:nil];
            unsigned long long freeAfter = [fsAfter[NSFileSystemFreeSize] unsignedLongLongValue];
            unsigned long long freedBytes = (freeAfter > freeBefore) ? (freeAfter - freeBefore) : manualDeletedBytes;
            NSString *freedStr = @"";
            if (freedBytes >= (1024ULL * 1024ULL * 1024ULL)) {
                freedStr = [NSString stringWithFormat:@"%.2f GB", (double)freedBytes / (1024.0 * 1024.0 * 1024.0)];
            } else if (freedBytes >= (1024ULL * 1024ULL)) {
                freedStr = [NSString stringWithFormat:@"%.1f MB", (double)freedBytes / (1024.0 * 1024.0)];
            } else {
                freedStr = [NSString stringWithFormat:@"%lu 个缓存项", (unsigned long)MAX(1, deletedItemsCount)];
            }
            NSString *pillMsg = [NSString stringWithFormat:@"🧹 已安全释放 %@ 空间，内存已加速", freedStr];
            [[AGGlobalActionPillWindow sharedPill] showActionPill:pillMsg];
            [self showActionBanner:pillMsg];
            AudioServicesPlaySystemSound(1520);
        });
    });
}

- (void)handleCreateAlarmHour:(NSInteger)hour minute:(NSInteger)minute title:(NSString *)title {
    dispatch_async(dispatch_get_main_queue(), ^{
        dlopen("/System/Library/PrivateFrameworks/MobileTimer.framework/MobileTimer", RTLD_LAZY);
        Class mgrCls = objc_getClass("MTAlarmManager");
        Class mutAlarmCls = objc_getClass("MTMutableAlarm");
        if (mgrCls && mutAlarmCls) {
            @try {
                id mgr = [[mgrCls alloc] init];
                typedef id (*InitAlarmFunc)(id, SEL, NSUInteger, NSUInteger);
                id alarm = [mutAlarmCls alloc];
                SEL initSel = NSSelectorFromString(@"initWithHour:minute:");
                if ([alarm respondsToSelector:initSel]) {
                    InitAlarmFunc fn = (InitAlarmFunc)[alarm methodForSelector:initSel];
                    alarm = fn(alarm, initSel, (NSUInteger)hour, (NSUInteger)minute);
                } else {
                    alarm = [alarm init];
                    [alarm setValue:@(hour) forKey:@"hour"];
                    [alarm setValue:@(minute) forKey:@"minute"];
                }
                [alarm setValue:(title ?: @"天使守护闹钟") forKey:@"title"];
                [alarm setValue:@YES forKey:@"enabled"];
                SEL addAlarmSel = NSSelectorFromString(@"addAlarm:");
                if ([mgr respondsToSelector:addAlarmSel]) {
                    ((void(*)(id, SEL, id))objc_msgSend)(mgr, addAlarmSel, alarm);
                }
                NSString *msg = [NSString stringWithFormat:@"⏰ 已为您设定 %02ld:%02ld 的系统闹钟", (long)hour, (long)minute];
                [[AGGlobalActionPillWindow sharedPill] showActionPill:msg];
                [self showActionBanner:msg];
                return;
            } @catch (NSException *e) {}
        }
        [self openApplicationByName:@"时钟"];
    });
}

- (void)handleStartTimerSeconds:(NSInteger)seconds {
    dispatch_async(dispatch_get_main_queue(), ^{
        dlopen("/System/Library/PrivateFrameworks/MobileTimer.framework/MobileTimer", RTLD_LAZY);
        Class tmCls = objc_getClass("MTTimerManager");
        if (tmCls) {
            @try {
                id tm = [[tmCls alloc] init];
                SEL startSel = NSSelectorFromString(@"startTimerWithDuration:");
                if ([tm respondsToSelector:startSel]) {
                    typedef id (*StartTimerFunc)(id, SEL, double);
                    StartTimerFunc fn = (StartTimerFunc)[tm methodForSelector:startSel];
                    fn(tm, startSel, (double)seconds);
                }
                NSString *msg = (seconds >= 60)
                    ? [NSString stringWithFormat:@"⏳ 已启动 %ld 分钟系统倒计时", (long)(seconds / 60)]
                    : [NSString stringWithFormat:@"⏳ 已启动 %ld 秒系统倒计时", (long)seconds];
                [[AGGlobalActionPillWindow sharedPill] showActionPill:msg];
                [self showActionBanner:msg];
                return;
            } @catch (NSException *e) {}
        }
        [self openApplicationByName:@"时钟"];
    });
}

- (void)handleAddSystemReminder:(NSString *)title {
    dlopen("/System/Library/Frameworks/EventKit.framework/EventKit", RTLD_LAZY);
    Class storeCls = objc_getClass("EKEventStore");
    Class remCls = objc_getClass("EKReminder");
    if (!storeCls || !remCls) return;
    @try {
        id store = [[storeCls alloc] init];
        SEL remSel = NSSelectorFromString(@"reminderWithEventStore:");
        if ([remCls respondsToSelector:remSel]) {
            id reminder = ((id(*)(id, SEL, id))objc_msgSend)(remCls, remSel, store);
            [reminder setValue:title forKey:@"title"];
            SEL defCalSel = NSSelectorFromString(@"defaultCalendarForNewReminders");
            id cal = [store respondsToSelector:defCalSel] ? ((id(*)(id, SEL))objc_msgSend)(store, defCalSel) : nil;
            if (cal) [reminder setValue:cal forKey:@"calendar"];
            typedef BOOL (*SaveRemFunc)(id, SEL, id, BOOL, NSError **);
            SEL saveSel = NSSelectorFromString(@"saveReminder:commit:error:");
            if ([store respondsToSelector:saveSel]) {
                SaveRemFunc fn = (SaveRemFunc)[store methodForSelector:saveSel];
                NSError *err = nil;
                fn(store, saveSel, reminder, YES, &err);
            }
            [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"📝 已写入系统提醒事项: %@", title]];
        }
    } @catch (NSException *e) {}
}

// 视觉双擎定位：40ms 本地极速 OCR（支持直接算“最贵的/最便宜的”、“第N个结果”、文字与数字）+ 几何方位点击
- (void)handleVisualTapTextOnScreen:(NSString *)targetText {
    if (!targetText || targetText.length == 0) return;
    [self dismissOverlayIfMainCardActive];

    NSString *cleanT = [targetText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    CGRect sb = [UIScreen mainScreen].bounds;

    // 1. 屏幕四角方位词 0ms 瞬时直点
    if ([cleanT containsString:@"左上角"]) {
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👆 已点击左上角区域"];
        agSimulateScreenTapAtPoint(CGPointMake(36.0, MAX(64.0, agComputeDeviceMetrics().safeTop + 22.0)));
        return;
    }
    if ([cleanT containsString:@"右上角"]) {
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👆 已点击右上角区域"];
        agSimulateScreenTapAtPoint(CGPointMake(sb.size.width - 36.0, MAX(64.0, agComputeDeviceMetrics().safeTop + 22.0)));
        return;
    }
    if ([cleanT containsString:@"左下角"]) {
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👆 已点击左下角按钮"];
        agSimulateScreenTapAtPoint(CGPointMake(48.0, sb.size.height - 48.0));
        return;
    }
    if ([cleanT containsString:@"右下角"]) {
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👆 已点击右下角按钮"];
        agSimulateScreenTapAtPoint(CGPointMake(sb.size.width - 48.0, sb.size.height - 48.0));
        return;
    }

    // 2. 交由本地 40ms 极速 OCR 引擎处理（支持“最贵的”、“最便宜的”、“第一个/第二个/第三个”、数字及任意文字）
    [self performVisualTapWithRetry:cleanT attempt:1 maxAttempts:1];
}

- (void)performVisualTapWithRetry:(NSString *)targetText attempt:(NSInteger)attempt maxAttempts:(NSInteger)maxAttempts {
    (void)maxAttempts;
    if (gIsScreenVisionAgentBusy && attempt == 1) return;
    gIsScreenVisionAgentBusy = YES;

    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.22 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIImage *safeScreenImg = agCaptureSafeScreenBitmapWithMaxEdge(800.0, self.overlayWindow);
        if (!safeScreenImg || !safeScreenImg.CGImage) {
            gIsScreenVisionAgentBusy = NO;
            return;
        }
        CGRect sb = [UIScreen mainScreen].bounds;

        dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0), ^{
            @autoreleasepool {
                UIImage *strongImgHold = safeScreenImg;
                CGImageRef cgImg = strongImgHold.CGImage;
                VNRecognizeTextRequest *req = [[VNRecognizeTextRequest alloc] initWithCompletionHandler:^(VNRequest * _Nonnull request, NSError * _Nullable error) {
                    NSString *cleanTarget = [[targetText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] lowercaseString];
                    NSArray<NSString *> *noiseWords = @[@"这个数字的", @"这个数字", @"这几个字的", @"这几个字", @"搜索结果", @"的结果", @"结果", @"按钮", @"选项", @"那个", @"商品", @"的"];
                    for (NSString *nw in noiseWords) {
                        if ([cleanTarget hasSuffix:nw] && cleanTarget.length > nw.length) {
                            cleanTarget = [cleanTarget substringToIndex:cleanTarget.length - nw.length];
                        }
                    }
                    cleanTarget = [cleanTarget stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];

                    // 模式 A：智能价格比大小（兼容“最贵 / 贵的那个 / 贵的 / 价格最高” 或 “最便宜 / 便宜的那个 / 便宜的 / 最低价”）
                    BOOL wantMostExpensive = ([cleanTarget containsString:@"最贵"] || [cleanTarget containsString:@"贵的"] || [cleanTarget isEqualToString:@"贵"] || [cleanTarget containsString:@"最高价"] || [cleanTarget containsString:@"价格最高"]);
                    BOOL wantCheapest      = ([cleanTarget containsString:@"最便宜"] || [cleanTarget containsString:@"便宜的"] || [cleanTarget isEqualToString:@"便宜"] || [cleanTarget containsString:@"最低价"] || [cleanTarget containsString:@"价格最低"]);
                    if (wantMostExpensive || wantCheapest) {
                        NSRegularExpression *priceRe = [NSRegularExpression regularExpressionWithPattern:@"(?:¥|￥|\\$)?\\s*(\\d{2,6}(?:\\.\\d{1,2})?)" options:0 error:nil];
                        VNRecognizedTextObservation *extremePriceObs = nil;
                        double extremePriceVal = wantMostExpensive ? -1.0 : 1e12;

                        for (VNRecognizedTextObservation *obs in request.results) {
                            CGRect box = obs.boundingBox;
                            CGFloat screenY = (1.0 - CGRectGetMidY(box)) * sb.size.height;
                            // 仅在商品列表主区域 (135pt ~ 底部栏上方 70pt) 提取价格
                            if (screenY < 135.0 || screenY > sb.size.height - 70.0) continue;

                            VNRecognizedText *top = [[obs topCandidates:1] firstObject];
                            NSString *s = top.string ?: @"";
                            // 过滤付款人数、评价数、好评率、折扣、年份等非价格数字
                            if ([s containsString:@"人"] || [s containsString:@"付款"] || [s containsString:@"已售"] ||
                                [s containsString:@"评价"] || [s containsString:@"条"] || [s containsString:@"%"] ||
                                [s containsString:@"折"] || [s containsString:@"km"] || [s containsString:@"万"]) {
                                continue;
                            }
                            BOOL hasCurrencySign = ([s containsString:@"¥"] || [s containsString:@"￥"] || [s containsString:@"元"] || [s containsString:@"到手"] || [s containsString:@"起"]);
                            NSArray<NSTextCheckingResult *> *pMatches = [priceRe matchesInString:s options:0 range:NSMakeRange(0, s.length)];
                            for (NSTextCheckingResult *pm in pMatches) {
                                if (pm.numberOfRanges > 1) {
                                    double val = [[s substringWithRange:[pm rangeAtIndex:1]] doubleValue];
                                    // 若无货币符号，仅采纳合理商品价格区间 (50 ~ 99999) 且排除类似型号年份 (2023/2024/2025/2026)
                                    if (!hasCurrencySign && (val < 50.0 || val > 99999.0 || (val >= 2020.0 && val <= 2027.0))) continue;
                                    if (val <= 1.0 || val > 200000.0) continue;

                                    if (wantMostExpensive && val > extremePriceVal) {
                                        extremePriceVal = val;
                                        extremePriceObs = obs;
                                    } else if (wantCheapest && val < extremePriceVal) {
                                        extremePriceVal = val;
                                        extremePriceObs = obs;
                                    }
                                }
                            }
                        }

                        if (extremePriceObs) {
                            CGRect box = extremePriceObs.boundingBox;
                            CGFloat tapX = CGRectGetMidX(box) * sb.size.width;
                            CGFloat tapY = (1.0 - CGRectGetMidY(box)) * sb.size.height;
                            dispatch_async(dispatch_get_main_queue(), ^{
                                gIsScreenVisionAgentBusy = NO;
                                [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"💰 已找到%@商品 (¥%.0f) 并点击", (wantMostExpensive ? @"最贵" : @"最便宜"), extremePriceVal]];
                                agSimulateScreenTapAtPoint(CGPointMake(tapX, tapY));
                            });
                            return;
                        }
                    }

                    // 模式 B：按序点击列表第 N 项（“第一个 / 第二个 / 第三个 / 第四个 / 最后一个”）
                    NSInteger targetOrdinal = 0;
                    if ([cleanTarget containsString:@"第一"] || [cleanTarget containsString:@"第1"]) targetOrdinal = 1;
                    else if ([cleanTarget containsString:@"第二"] || [cleanTarget containsString:@"第2"]) targetOrdinal = 2;
                    else if ([cleanTarget containsString:@"第三"] || [cleanTarget containsString:@"第3"]) targetOrdinal = 3;
                    else if ([cleanTarget containsString:@"第四"] || [cleanTarget containsString:@"第4"]) targetOrdinal = 4;
                    else if ([cleanTarget containsString:@"最后"]) targetOrdinal = 99;

                    if (targetOrdinal > 0) {
                        // 收集主内容区 (145pt ~ screenH - 75pt) 内长度 >= 4 的商品标题行，按从上到下排序并按 58pt 间距聚类为独立商品卡片
                        NSMutableArray<VNRecognizedTextObservation *> *contentObs = [NSMutableArray array];
                        for (VNRecognizedTextObservation *obs in request.results) {
                            VNRecognizedText *top = [[obs topCandidates:1] firstObject];
                            if (!top || top.string.length < 4) continue;
                            CGFloat sy = (1.0 - CGRectGetMidY(obs.boundingBox)) * sb.size.height;
                            if (sy >= 145.0 && sy <= sb.size.height - 75.0) {
                                [contentObs addObject:obs];
                            }
                        }
                        [contentObs sortUsingComparator:^NSComparisonResult(VNRecognizedTextObservation *a, VNRecognizedTextObservation *b) {
                            CGFloat ya = (1.0 - CGRectGetMidY(a.boundingBox)) * sb.size.height;
                            CGFloat yb = (1.0 - CGRectGetMidY(b.boundingBox)) * sb.size.height;
                            return (ya < yb) ? NSOrderedAscending : NSOrderedDescending;
                        }];

                        NSMutableArray<NSValue *> *cardCenters = [NSMutableArray array];
                        CGFloat lastRowY = -999.0;
                        for (VNRecognizedTextObservation *obs in contentObs) {
                            CGFloat sy = (1.0 - CGRectGetMidY(obs.boundingBox)) * sb.size.height;
                            CGFloat sx = CGRectGetMidX(obs.boundingBox) * sb.size.width;
                            if (sy - lastRowY >= 62.0) {
                                [cardCenters addObject:[NSValue valueWithCGPoint:CGPointMake(sx, sy)]];
                                lastRowY = sy;
                            }
                        }

                        if (cardCenters.count > 0) {
                            NSUInteger pickIdx = (targetOrdinal == 99) ? (cardCenters.count - 1) : MIN((NSUInteger)(targetOrdinal - 1), cardCenters.count - 1);
                            CGPoint pt = [cardCenters[pickIdx] CGPointValue];
                            dispatch_async(dispatch_get_main_queue(), ^{
                                gIsScreenVisionAgentBusy = NO;
                                [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"👆 已精准点击第 %lu 项结果", (unsigned long)(pickIdx + 1)]];
                                agSimulateScreenTapAtPoint(pt);
                            });
                            return;
                        }
                    }

                    // 模式 C：文字与数字精确匹配（如“4999”、“电池”、“个人热点”、“通知”）
                    VNRecognizedTextObservation *bestObs = nil;
                    NSInteger bestScore = 0;

                    for (VNRecognizedTextObservation *obs in request.results) {
                        VNRecognizedText *top = [[obs topCandidates:1] firstObject];
                        if (!top || top.string.length == 0 || cleanTarget.length == 0) continue;
                        NSString *candStr = [top.string lowercaseString];

                        NSInteger score = 0;
                        if ([candStr isEqualToString:cleanTarget]) {
                            score = 100;
                        } else if ([candStr containsString:cleanTarget]) {
                            score = 85 - (NSInteger)MIN(30, (NSInteger)candStr.length - (NSInteger)cleanTarget.length);
                        } else if (cleanTarget.length >= 2 && [cleanTarget containsString:candStr] && candStr.length >= 2) {
                            score = 68;
                        }
                        if (score > bestScore) {
                            bestScore = score;
                            bestObs = obs;
                        }
                    }

                    if (bestObs) {
                        CGRect box = bestObs.boundingBox;
                        CGFloat tapX = CGRectGetMidX(box) * sb.size.width;
                        CGFloat tapY = (1.0 - CGRectGetMidY(box)) * sb.size.height;
                        dispatch_async(dispatch_get_main_queue(), ^{
                            gIsScreenVisionAgentBusy = NO;
                            [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"👆 已精准定位并点击「%@」", cleanTarget]];
                            agSimulateScreenTapAtPoint(CGPointMake(tapX, tapY));
                        });
                    } else {
                        dispatch_async(dispatch_get_main_queue(), ^{
                            gIsScreenVisionAgentBusy = NO;
                            [self performAIVisionScreenAgentWithGoal:[NSString stringWithFormat:@"找到并点击「%@」", targetText] step:1 maxSteps:2];
                        });
                    }
                }];
                // 采用 Accurate 识别中文与数字，配合 @autoreleasepool 与 malloc_zone_pressure_relief 即用即清
                req.recognitionLevel = VNRequestTextRecognitionLevelAccurate;
                req.usesLanguageCorrection = NO;
                req.recognitionLanguages = @[@"zh-Hans", @"zh-Hant", @"en-US"];
                VNImageRequestHandler *handler = [[VNImageRequestHandler alloc] initWithCGImage:cgImg options:@{}];
                [handler performRequests:@[req] error:nil];
                strongImgHold = nil;
            }
            typedef void (*ag_malloc_relief_fn)(void *, size_t);
            static ag_malloc_relief_fn sRelief = NULL;
            static dispatch_once_t onceToken;
            dispatch_once(&onceToken, ^{
                sRelief = (ag_malloc_relief_fn)dlsym(RTLD_DEFAULT, "malloc_zone_pressure_relief");
            });
            if (sRelief) sRelief(NULL, 0);
        });
    });
}

- (void)performAIVisionScreenAgentWithGoal:(NSString *)goalDesc step:(NSInteger)step maxSteps:(NSInteger)maxSteps {
    if (!goalDesc || goalDesc.length == 0 || step > maxSteps) {
        gIsScreenVisionAgentBusy = NO;
        return;
    }
    if (step == 1 && gIsScreenVisionAgentBusy) return;
    gIsScreenVisionAgentBusy = YES;

    [self dismissOverlayIfMainCardActive];

    NSTimeInterval waitSec = (step == 1) ? 0.28 : 1.35;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(waitSec * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIImage *scaledImg = agCaptureSafeScreenBitmapWithMaxEdge(768.0, self.overlayWindow);
        NSData *jpgData = scaledImg ? UIImageJPEGRepresentation(scaledImg, 0.58) : nil;
        scaledImg = nil;
        if (!jpgData || jpgData.length < 500) {
            gIsScreenVisionAgentBusy = NO;
            return;
        }

        AGConfigTab useTab = (agAPIKeyForTab(AGConfigTabPureText).length >= 4) ? AGConfigTabPureText : ((agAPIKeyForTab(AGConfigTabVideoAI).length >= 4) ? AGConfigTabVideoAI : AGConfigTabNativeLive);
        NSString *apiKey = agAPIKeyForTab(useTab);
        NSString *endpoint = agEndpointForTab(useTab);
        NSString *model = agModelForTab(useTab);
        NSString *proxy = agProxyForTab(useTab);
        if (apiKey.length < 4) {
            gIsScreenVisionAgentBusy = NO;
            return;
        }
        NSString *lowerM = [model lowercaseString];
        if (model.length == 0 || [lowerM containsString:@"native-audio"] || [lowerM containsString:@"-live"] || [lowerM containsString:@"realtime"]) {
            NSString *transM = agTransModel();
            if (transM.length > 0 && ![[transM lowercaseString] containsString:@"-live"]) {
                model = transM;
            } else {
                model = @"models/gemini-2.5-flash";
            }
        }

        [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"👁️ AI 正在看屏定位：%@...", goalDesc]];

        NSString *visionPrompt = [NSString stringWithFormat:
            @"你是一个精准的 iOS 屏幕视觉操作智能体。请观察当前手机屏幕截图，用户的操作目标是：【%@】。\n"
            @"屏幕左上角归一化坐标为 (0, 0)，右下角为 (1000, 1000)。请算出目标图标、按钮或输入框正中心点的 (x, y) 坐标。\n"
            @"请仅输出一行纯 JSON（严禁输出 Markdown 代码块或任何多余解释）：\n"
            @"1. 点击按钮/图标/区域：{\"act\":\"tap\",\"x\":500,\"y\":320,\"desc\":\"控件名\",\"done\":true}\n"
            @"2. 点击输入框并打字：{\"act\":\"type\",\"x\":500,\"y\":180,\"text\":\"要输入的文字\",\"submit\":true,\"desc\":\"输入框名\",\"done\":true}\n"
            @"3. 当前屏未出现目标需上滑寻找：{\"act\":\"swipe_up\",\"desc\":\"向下滑动寻找\",\"done\":false}\n"
            @"4. 目标已完成：{\"act\":\"done\",\"desc\":\"已完成\",\"done\":true}", goalDesc];

        NSString *b64Img = [jpgData base64EncodedStringWithOptions:0];
        BOOL isGoogle = agIsGoogleNativeProtocol(endpoint, model);
        NSMutableURLRequest *req = nil;

        if (isGoogle) {
            NSString *baseEP = agSanitizeEndpoint(endpoint, useTab);
            NSString *fullM = [model hasPrefix:@"models/"] ? model : [NSString stringWithFormat:@"models/%@", model];
            NSString *urlStr = [NSString stringWithFormat:@"%@/v1beta/%@:generateContent?key=%@", baseEP, fullM, apiKey];
            req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
            req.HTTPMethod = @"POST";
            [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];

            NSMutableDictionary *genCfg = [@{ @"temperature": @0.1, @"maxOutputTokens": @512 } mutableCopy];
            if ([fullM containsString:@"2.5"] || [fullM containsString:@"3."]) {
                genCfg[@"thinkingConfig"] = @{ @"thinkingBudget": @0 };
            }
            NSDictionary *body = @{
                @"contents": @[ @{ @"role": @"user", @"parts": @[
                    @{ @"inlineData": @{ @"mimeType": @"image/jpeg", @"data": b64Img } },
                    @{ @"text": visionPrompt }
                ] } ],
                @"generationConfig": genCfg
            };
            req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
        } else {
            NSString *urlStr = agSanitizeOpenAIEndpoint(endpoint);
            req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
            req.HTTPMethod = @"POST";
            [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];
            [req setValue:[NSString stringWithFormat:@"Bearer %@", apiKey] forHTTPHeaderField:@"Authorization"];
            NSString *exactM = [model stringByReplacingOccurrencesOfString:@"models/" withString:@""];
            NSDictionary *body = @{
                @"model": exactM,
                @"messages": @[ @{ @"role": @"user", @"content": @[
                    @{ @"type": @"image_url", @"image_url": @{ @"url": [NSString stringWithFormat:@"data:image/jpeg;base64,%@", b64Img] } },
                    @{ @"type": @"text", @"text": visionPrompt }
                ] } ],
                @"temperature": @0.1, @"max_tokens": @512
            };
            req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
        }
        req.timeoutInterval = 8.0;

        // 关键修复：复用全局共享连接池，彻底消灭每次 AI 视觉点击新建 NSURLSession 引发的线程与句柄泄漏！
        static NSURLSession *sSharedVisionSess = nil;
        static NSString *sLastVisionProxy = nil;
        static os_unfair_lock sVisionSessLock = OS_UNFAIR_LOCK_INIT;
        os_unfair_lock_lock(&sVisionSessLock);
        NSString *normProxy = proxy ?: @"";
        if (!sSharedVisionSess || ![sLastVisionProxy isEqualToString:normProxy]) {
            if (sSharedVisionSess) [sSharedVisionSess finishTasksAndInvalidate];
            sSharedVisionSess = agCreateSessionWithProxy(normProxy, nil, nil);
            sLastVisionProxy = [normProxy copy];
        }
        NSURLSession *sess = sSharedVisionSess;
        os_unfair_lock_unlock(&sVisionSessLock);

        [[sess dataTaskWithRequest:req completionHandler:^(NSData *data, NSURLResponse *resp, NSError *err) {
            if (err || !data) {
                gIsScreenVisionAgentBusy = NO;
                return;
            }
            NSDictionary *json = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
            NSString *reply = [[self extractTextFromDictionary:json] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            if (!reply || reply.length == 0) {
                gIsScreenVisionAgentBusy = NO;
                return;
            }

            NSRange lBrace = [reply rangeOfString:@"{"];
            NSRange rBrace = [reply rangeOfString:@"}" options:NSBackwardsSearch];
            if (lBrace.location == NSNotFound || rBrace.location == NSNotFound || rBrace.location <= lBrace.location) {
                gIsScreenVisionAgentBusy = NO;
                return;
            }
            NSString *jsonSub = [reply substringWithRange:NSMakeRange(lBrace.location, rBrace.location - lBrace.location + 1)];
            NSDictionary *cmdDict = [NSJSONSerialization JSONObjectWithData:[jsonSub dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];
            if (![cmdDict isKindOfClass:[NSDictionary class]]) {
                gIsScreenVisionAgentBusy = NO;
                return;
            }

            dispatch_async(dispatch_get_main_queue(), ^{
                CGRect sb = [UIScreen mainScreen].bounds;
                NSString *act = [cmdDict[@"act"] lowercaseString];
                NSString *desc = cmdDict[@"desc"] ?: goalDesc;
                BOOL isDone = (cmdDict[@"done"] == nil) ? YES : [cmdDict[@"done"] boolValue];

                if ([act isEqualToString:@"tap"] || [act isEqualToString:@"type"]) {
                    CGFloat normX = [cmdDict[@"x"] doubleValue];
                    CGFloat normY = [cmdDict[@"y"] doubleValue];
                    CGPoint pt = CGPointMake((normX / 1000.0) * sb.size.width, (normY / 1000.0) * sb.size.height);
                    [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"👆 AI 视觉点击：%@", desc]];
                    agSimulateScreenTapAtPoint(pt);

                    if ([act isEqualToString:@"type"] && [cmdDict[@"text"] length] > 0) {
                        NSString *inputTxt = cmdDict[@"text"];
                        BOOL shouldSubmit = (cmdDict[@"submit"] != nil) ? [cmdDict[@"submit"] boolValue] : ([goalDesc containsString:@"搜索"] || [goalDesc containsString:@"发送"]);
                        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.48 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                            agInjectTextIntoFocusedInput(inputTxt, shouldSubmit);
                        });
                    }
                } else if ([act isEqualToString:@"swipe_up"]) {
                    [self handleSynthesizedUIGesture:@"swipe_up"];
                }

                if (!isDone && step < maxSteps) {
                    [self performAIVisionScreenAgentWithGoal:goalDesc step:(step + 1) maxSteps:maxSteps];
                } else {
                    gIsScreenVisionAgentBusy = NO;
                }
            });
        }] resume];
    });
}

// 合成全自动刷视频/滑动/长按/连点/回顶部手势
// 合成全自动刷视频/快慢滑动/长按/连点/回顶部/智能返回手势
- (void)handleSynthesizedUIGesture:(NSString *)gesture {
    [self dismissOverlayIfMainCardActive];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.22 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        CGRect sb = [UIScreen mainScreen].bounds;
        CGFloat midX = sb.size.width * 0.5;
        CGFloat midY = sb.size.height * 0.5;
        NSString *g = [gesture lowercaseString];

        // 若当前系统控制中心或通知中心正处于下拉展开状态，说“返回”或“向上滑”时优先收起控制中心/通知中心！
        if ([g containsString:@"back"] || [g containsString:@"up"]) {
            Class ccCls = objc_getClass("SBControlCenterController");
            SBControlCenterController *cc = (ccCls && [ccCls respondsToSelector:@selector(sharedInstanceIfExists)])
                ? [ccCls sharedInstanceIfExists]
                : ((ccCls && [ccCls respondsToSelector:@selector(sharedInstance)]) ? [ccCls sharedInstance] : nil);
            BOOL ccOpen = (cc && (([cc respondsToSelector:@selector(isVisible)] && [cc isVisible]) ||
                                  ([cc respondsToSelector:@selector(isPresented)] && [cc isPresented])));
            if (ccOpen && [cc respondsToSelector:@selector(dismissAnimated:)]) {
                [cc dismissAnimated:YES];
                [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🎛️ 已为您收起控制中心"];
                return;
            }
        }

        if ([g isEqualToString:@"swipe_up_slow"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👆 已为您小幅慢慢上滑"];
            agSimulateScreenSwipe(CGPointMake(midX, sb.size.height * 0.62), CGPointMake(midX, sb.size.height * 0.40), 0.45);
        } else if ([g isEqualToString:@"swipe_down_slow"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👇 已为您小幅慢慢下滑"];
            agSimulateScreenSwipe(CGPointMake(midX, sb.size.height * 0.38), CGPointMake(midX, sb.size.height * 0.60), 0.45);
        } else if ([g containsString:@"up"] || [g containsString:@"next"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👆 已为您上滑"];
            agSimulateScreenSwipe(CGPointMake(midX, sb.size.height * 0.74), CGPointMake(midX, sb.size.height * 0.24), 0.24);
        } else if ([g containsString:@"down"] || [g containsString:@"prev"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👇 已为您下滑"];
            agSimulateScreenSwipe(CGPointMake(midX, sb.size.height * 0.26), CGPointMake(midX, sb.size.height * 0.76), 0.24);
        } else if ([g containsString:@"left"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👈 已为您向左滑动翻页"];
            agSimulateScreenSwipe(CGPointMake(sb.size.width * 0.84, midY), CGPointMake(sb.size.width * 0.16, midY), 0.22);
        } else if ([g containsString:@"scroll_to_top"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"⬆️ 已为您触发状态栏回到最顶部"];
            agSimulateScreenTapAtPoint(CGPointMake(midX, 14.0));
        } else if ([g containsString:@"long_press"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👆 已为您执行长按屏幕手势"];
            agSimulateScreenLongPressAtPoint(CGPointMake(midX, midY), 1.5);
        } else if ([g containsString:@"rapid_like"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"❤️ 正在为您连续快速点赞..."];
            for (int i = 0; i < 10; i++) {
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * 0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    CGFloat jx = ((CGFloat)arc4random_uniform(7) - 3.0);
                    CGFloat jy = ((CGFloat)arc4random_uniform(7) - 3.0);
                    agSimulateScreenTapAtPoint(CGPointMake(midX + jx, midY + jy));
                });
            }
        } else if ([g containsString:@"double"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"❤️ 已为您双击屏幕点赞"];
            agSimulateScreenTapAtPoint(CGPointMake(midX, midY));
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                agSimulateScreenTapAtPoint(CGPointMake(midX, midY));
            });
        } else if ([g containsString:@"back"] || [g containsString:@"right"]) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:@"👈 已为您执行侧滑返回"];
            agSimulateScreenSwipe(CGPointMake(2.5, midY), CGPointMake(sb.size.width * 0.72, midY), 0.22);
        }
    });
}

// 剪贴板无痕写入与跨进程焦点输入框自动打字上屏
- (void)handleClipboardAndAutoType:(NSString *)text {
    if (!text || text.length == 0) return;
    agInjectTextIntoFocusedInput(text, NO);
}

// 手机电池电量与存储空间硬件自检播报
- (void)handleReportDeviceStatus {
    dispatch_async(dispatch_get_main_queue(), ^{
        NSString *pillText = nil;
        NSString *fullCardText = nil;
        NSString *voiceSpeechText = nil;
        NSString *sysPrompt = nil;
        agCollectRealHardwareAndBatteryTelemetry(&pillText, &fullCardText, &voiceSpeechText, &sysPrompt);

        if (pillText) {
            [[AGGlobalActionPillWindow sharedPill] showActionPill:pillText];
        }
        if (fullCardText) {
            [self showActionBanner:fullCardText];
            NSMutableString *curTrans = [self currentTabTranscript];
            if (curTrans.length > 0 && ![curTrans hasSuffix:@"\n"]) [curTrans appendString:@"\n\n"];
            [curTrans appendString:fullCardText];
            [self updateResponseTextViewSmoothly:curTrans];
            [self throttledExpandAndScrollTextViewForce:YES];
        }
        if (voiceSpeechText) {
            agSpeakAndBroadcastHardwareResult(self, voiceSpeechText);
        }
    });
}
// ====== 全场景 Agent 连招提权、价格比大小秒点与超容电池替换块 3 结束 ======




- (void)handleOrientationLock:(BOOL)lock {
    dispatch_async(dispatch_get_main_queue(), ^{
        Class olmCls = objc_getClass("SBOrientationLockManager");
        if (olmCls && [olmCls respondsToSelector:@selector(sharedInstance)]) {
            id olm = [olmCls sharedInstance];
            if (lock) {
                if ([olm respondsToSelector:@selector(lock)]) [olm lock];
            } else {
                if ([olm respondsToSelector:@selector(unlock)]) [olm unlock];
            }
        }
        NSString *msg = lock ? @"🔄 屏幕竖排方向已锁定" : @"🔄 屏幕旋转已解锁";
        [[AGGlobalActionPillWindow sharedPill] showActionPill:msg];
        [self showActionBanner:msg];
    });
}

- (void)handleMacroScene:(NSString *)scene {
    NSString *sc = [scene lowercaseString];
    if ([sc containsString:@"sleep"] || [sc containsString:@"晚安"] || [sc containsString:@"睡觉"]) {
        [self toggleFlashlight:NO level:1.0f];
        [self toggleLowPowerMode:YES];
        [self handleMediaControl:@"pause"];
        [self handleBrightnessControl:@"set" level:@(0.05f)];
        [self handleVolumeControl:@"mute" level:@(0.0f)];
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🌙 晚安模式已启动：亮度调暗、静音、省电并锁屏"];
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            [self handleSystemControl:@"lock"];
        });
    } else if ([sc containsString:@"drive"] || [sc containsString:@"车"] || [sc containsString:@"出发"]) {
        [self toggleLowPowerMode:NO];
        [self handleBrightnessControl:@"set" level:@(0.85f)];
        [self handleVolumeControl:@"set" level:@(0.75f)];
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🚗 出发模式已启动：音量75%、亮度85%"];
    } else {
        [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"✨ 场景模式「%@」执行完毕", scene]];
    }
}

- (void)handleSearchOnPlatform:(NSString *)platform keyword:(NSString *)keyword {
    if (!keyword || keyword.length == 0) return;
    NSString *cleanKw = [keyword stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    NSString *encoded = [cleanKw stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]];
    NSString *plt = [[platform stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] lowercaseString];
    NSURL *targetURL = nil;
    NSString *pillText = [NSString stringWithFormat:@"🔍 正在检索 %@...", cleanKw];

    // 1. 电商购物与闲置特卖
    if ([plt containsString:@"taobao"] || [plt containsString:@"淘宝"]) {
        pillText = [NSString stringWithFormat:@"🛍️ 正在淘宝搜索: %@...", cleanKw];
        targetURL = [NSURL URLWithString:[NSString stringWithFormat:@"taobao://s.taobao.com/search?q=%@", encoded]];
    } else if ([plt containsString:@"jd"] || [plt containsString:@"京东"]) {
        pillText = [NSString stringWithFormat:@"📦 正在京东搜索: %@...", cleanKw];
        NSString *jdJson = [NSString stringWithFormat:@"{\"des\":\"productList\",\"keyWord\":\"%@\",\"from\":\"search\",\"category\":\"jump\"}", cleanKw];
        NSString *encodedParams = [jdJson stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet alphanumericCharacterSet]];
        targetURL = [NSURL URLWithString:[NSString stringWithFormat:@"openapp.jdmobile://virtual?params=%@", encodedParams]];
    } else if ([plt containsString:@"pdd"] || [plt containsString:@"拼多多"]) {
        pillText = [NSString stringWithFormat:@"🛍️ 正在拼多多搜索: %@...", cleanKw];
        targetURL = [NSURL URLWithString:[NSString stringWithFormat:@"pinduoduo://yangkeduo.com/search_result.html?search_key=%@", encoded]];
    } else if ([plt containsString:@"xianyu"] || [plt containsString:@"闲鱼"]) {
        pillText = [NSString stringWithFormat:@"🐟 正在闲鱼搜索: %@...", cleanKw];
        targetURL = [NSURL URLWithString:[NSString stringWithFormat:@"fleamarket://x_search_items?keyword=%@", encoded]];
    } else if ([plt containsString:@"vip"] || [plt containsString:@"唯品会"]) {
        pillText = [NSString stringWithFormat:@"👗 正在唯品会搜索: %@...", cleanKw];
