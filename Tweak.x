static NSString *agLiveDiagnosticLogPath(void) {
    return @"/tmp/ag_live_diagnostic.log";
}

static void agLiveDiagLog(NSString *stage, NSString *format, ...) {
    if ([stage hasPrefix:@"LOC_"] || [stage hasPrefix:@"CLIENT_"]) {
        return; // 彻底屏蔽所有虚拟定位相关日志（保留语音、相机、翻译与联网日志）
    }
    NSString *bid = [[NSBundle mainBundle] bundleIdentifier];
    if (bid && ![bid isEqualToString:@"com.apple.springboard"] && ![bid isEqualToString:@"com.apple.Preferences"]) {
        return; // 铁律：严禁在第三方受控沙盒 App 内操作 /tmp 诊断日志文件，消除文件句柄与沙盒探测特征
    }

    va_list args;
    va_start(args, format);
    NSString *msg = [[NSString alloc] initWithFormat:format arguments:args];
    va_end(args);

    os_log(OS_LOG_DEFAULT, "[AGLiveDiag][%{public}@] %{public}@", stage, msg);

    static dispatch_queue_t logQ = nil;
    static NSDateFormatter *sLogDateFormatter = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        logQ = dispatch_queue_create("com.angelguardian.diaglog", DISPATCH_QUEUE_SERIAL);
        sLogDateFormatter = [[NSDateFormatter alloc] init];
        sLogDateFormatter.dateFormat = @"HH:mm:ss.SSS";
    });
    NSDate *nowDate = [NSDate date];
    dispatch_async(logQ, ^{
        NSString *line = [NSString stringWithFormat:@"[%@][%@] %@\n", [sLogDateFormatter stringFromDate:nowDate], stage, msg];
        NSData *data = [line dataUsingEncoding:NSUTF8StringEncoding];
        int fd = open([agLiveDiagnosticLogPath() UTF8String], O_WRONLY | O_CREAT | O_APPEND, 0666);
        if (fd >= 0) {
            write(fd, data.bytes, data.length);
            close(fd);
        }
    });
}

static void killNativeSiriAudioDaemon(void) {
    // 严禁 killall -9 assistantd！Siri 界面已由底部 %hook SBAssistantController 彻底拦截，保持 assistantd 存活以支持毫秒级实时语音转字幕
}

static void killZombieCameraHelpers(void) {
    pid_t pid;
    NSArray<NSString *> *killPaths = @[ agJBRootPath(@"/usr/bin/killall"), @"/var/jb/usr/bin/killall", @"/usr/bin/killall" ];
    for (NSString *kp in killPaths) {
        if ([[NSFileManager defaultManager] isExecutableFileAtPath:kp]) {
            char *argv[] = { (char *)"killall", (char *)"-9", (char *)"AngelCameraHelper", NULL };
            posix_spawn(&pid, [kp UTF8String], NULL, NULL, argv, environ);
            break;
        }
    }
}

typedef Boolean (*MRMediaRemoteSendCommandFunc)(uint32_t command, void *userInfo);
static void pauseBackgroundMediaPlayback(void) {
    static MRMediaRemoteSendCommandFunc sendCmd = NULL;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        void *handle = dlopen("/System/Library/PrivateFrameworks/MediaRemote.framework/MediaRemote", RTLD_LAZY);
        if (handle) {
            sendCmd = (MRMediaRemoteSendCommandFunc)dlsym(handle, "MRMediaRemoteSendCommand");
        }
    });
    if (sendCmd) {
        sendCmd(1, NULL);
    }
}

// ==================== 跨进程共享配置 + notifyd 内核级共享内存穿透沙盒通道 ====================
static CFStringRef const kAGCFPrefsAppID = CFSTR("com.custom.geminisirioverlay");
static NSString * const kAGLocAppHookLogNotification = @"com.apple.coremedia.spatial.hitlog";
static NSString * const kAGLocMasterSyncNotification = @"com.apple.coremedia.spatial.mastersync";
static os_unfair_lock gPrefsLock = OS_UNFAIR_LOCK_INIT;

static uint32_t agHashBundleID(NSString *bundleID) {
    if (!bundleID || bundleID.length == 0) return 0;
    const char *str = [bundleID UTF8String];
    uint32_t hash = 2166136261u;
    while (*str) {
        hash ^= (uint8_t)(*str++);
        hash *= 16777619u;
    }
    return (hash == 0) ? 1 : hash;
}

// 64位对称混淆掩码（消除 0xA5A5 明文魔数与 double 经纬度明文特征）
static inline uint64_t agKernelObfuscateMask(uint32_t channelSalt) {
    uint64_t z = 0x9E3779B97F4A7C15ULL ^ ((uint64_t)channelSalt * 0xBF58476D1CE4E5B9ULL);
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
    return z ^ (z >> 31);
}

static void agPublishSpoofStateToKernel(BOOL isActive, NSInteger scopeMode, NSInteger moveMode, BOOL shieldOn, NSInteger wifiMode, BOOL isMoving, double wgsLat, double wgsLon, double course, double speed, NSArray<NSString *> *targetApps) {
    static int sTokState = 0, sTokLat = 0, sTokLon = 0, sTokMotion = 0;
    static int sTokApps[16] = {0};
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        notify_register_check("com.apple.coremedia.spatial.st", &sTokState);
        notify_register_check("com.apple.coremedia.spatial.x", &sTokLat);
        notify_register_check("com.apple.coremedia.spatial.y", &sTokLon);
        notify_register_check("com.apple.coremedia.spatial.v", &sTokMotion);
        for (int i = 0; i < 16; i++) {
            char keyBuf[48];
            snprintf(keyBuf, sizeof(keyBuf), "com.apple.coremedia.spatial.p%d", i);
            notify_register_check(keyBuf, &sTokApps[i]);
        }
    });

    // 铁律：若定位总开关关闭，内核中的防检测与伪装 Wi-Fi 强制同步关闭
    if (!isActive) {
        shieldOn = NO;
        wifiMode = 0;
        isMoving = NO;
    }

    NSUInteger appCount = [targetApps isKindOfClass:[NSArray class]] ? MIN((NSUInteger)32, targetApps.count) : 0;
    uint64_t stateBits = 0xA5A5000000000000ULL;
    if (isActive) stateBits |= (1ULL << 0);
    stateBits |= (((uint64_t)(scopeMode & 0x3)) << 1);
    stateBits |= (((uint64_t)(moveMode & 0x3)) << 3);
    if (shieldOn) stateBits |= (1ULL << 5);
    stateBits |= (((uint64_t)(wifiMode & 0x3)) << 6);
    if (isMoving) stateBits |= (1ULL << 8);
    stateBits |= (((uint64_t)(appCount & 0xFF)) << 16);

    uint64_t latBits = 0, lonBits = 0;
    memcpy(&latBits, &wgsLat, sizeof(double));
    memcpy(&lonBits, &wgsLon, sizeof(double));

    float fCourse = (float)course;
    float fSpeed  = (float)speed;
    uint32_t cBits = 0, sBits = 0;
    memcpy(&cBits, &fCourse, sizeof(float));
    memcpy(&sBits, &fSpeed, sizeof(float));
    uint64_t motionBits = (((uint64_t)cBits) << 32) | ((uint64_t)sBits);

    notify_set_state(sTokState,  stateBits  ^ agKernelObfuscateMask(0x101));
    notify_set_state(sTokLat,    latBits    ^ agKernelObfuscateMask(0x102));
    notify_set_state(sTokLon,    lonBits    ^ agKernelObfuscateMask(0x103));
    notify_set_state(sTokMotion, motionBits ^ agKernelObfuscateMask(0x104));

    for (int i = 0; i < 16; i++) {
        uint32_t h0 = (i * 2 < appCount) ? agHashBundleID(targetApps[i * 2]) : 0;
        uint32_t h1 = (i * 2 + 1 < appCount) ? agHashBundleID(targetApps[i * 2 + 1]) : 0;
        uint64_t pairBits = (((uint64_t)h0) << 32) | ((uint64_t)h1);
        notify_set_state(sTokApps[i], pairBits ^ agKernelObfuscateMask(0x200 + i));
    }
}

// 将用户填写的伪装 Wi-Fi (SSID 与 BSSID) 加密写入 notifyd 内核寄存器，100% 穿透钉钉/企微/飞书沙盒限制
static void agPublishCustomWiFiToKernel(NSString *ssid, NSString *bssid) {
    static int sTokSSID[4] = {0};
    static int sTokBSSID[3] = {0};
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        for (int i = 0; i < 4; i++) {
            char buf[48];
            snprintf(buf, sizeof(buf), "com.apple.coremedia.spatial.w%d", i);
            notify_register_check(buf, &sTokSSID[i]);
        }
        for (int i = 0; i < 3; i++) {
            char buf[48];
            snprintf(buf, sizeof(buf), "com.apple.coremedia.spatial.b%d", i);
            notify_register_check(buf, &sTokBSSID[i]);
        }
    });

    uint8_t ssidBytes[32];
    memset(ssidBytes, 0, sizeof(ssidBytes));
    NSString *cleanSSID = [ssid stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (cleanSSID.length > 0) {
        const char *cStr = [cleanSSID UTF8String];
        if (cStr) strncpy((char *)ssidBytes, cStr, 31);
    }
    for (int i = 0; i < 4; i++) {
        uint64_t chunk = 0;
        memcpy(&chunk, ssidBytes + i * 8, 8);
        notify_set_state(sTokSSID[i], chunk ^ agKernelObfuscateMask(0x310 + i));
    }

    uint8_t bssidBytes[24];
    memset(bssidBytes, 0, sizeof(bssidBytes));
    NSString *cleanBSSID = [[bssid stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] lowercaseString];
    if (cleanBSSID.length > 0) {
        const char *cStr = [cleanBSSID UTF8String];
        if (cStr) strncpy((char *)bssidBytes, cStr, 23);
    }
    for (int i = 0; i < 3; i++) {
        uint64_t chunk = 0;
        memcpy(&chunk, bssidBytes + i * 8, 8);
        notify_set_state(sTokBSSID[i], chunk ^ agKernelObfuscateMask(0x320 + i));
    }
}

static BOOL agReadCustomWiFiFromKernel(NSString **outSSID, NSString **outBSSID) {
    static int sTokSSID[4] = {0};
    static int sTokBSSID[3] = {0};
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        for (int i = 0; i < 4; i++) {
            char buf[48];
            snprintf(buf, sizeof(buf), "com.apple.coremedia.spatial.w%d", i);
            notify_register_check(buf, &sTokSSID[i]);
        }
        for (int i = 0; i < 3; i++) {
            char buf[48];
            snprintf(buf, sizeof(buf), "com.apple.coremedia.spatial.b%d", i);
            notify_register_check(buf, &sTokBSSID[i]);
        }
    });

    uint8_t ssidBytes[33];
    memset(ssidBytes, 0, sizeof(ssidBytes));
    for (int i = 0; i < 4; i++) {
        uint64_t raw = 0;
        if (notify_get_state(sTokSSID[i], &raw) != NOTIFY_STATUS_OK) return NO;
        uint64_t chunk = raw ^ agKernelObfuscateMask(0x310 + i);
        memcpy(ssidBytes + i * 8, &chunk, 8);
    }

    uint8_t bssidBytes[25];
    memset(bssidBytes, 0, sizeof(bssidBytes));
    for (int i = 0; i < 3; i++) {
        uint64_t raw = 0;
        if (notify_get_state(sTokBSSID[i], &raw) != NOTIFY_STATUS_OK) return NO;
        uint64_t chunk = raw ^ agKernelObfuscateMask(0x320 + i);
        memcpy(bssidBytes + i * 8, &chunk, 8);
    }

    if (ssidBytes[0] == 0 || bssidBytes[0] == 0) return NO;
    NSString *s = [NSString stringWithUTF8String:(const char *)ssidBytes];
    NSString *b = [NSString stringWithUTF8String:(const char *)bssidBytes];
    if (s.length > 0 && b.length >= 11) {
        if (outSSID) *outSSID = s;
        if (outBSSID) *outBSSID = b;
        return YES;
    }
    return NO;
}

// ====== 防卡顿替换 1 开始（替换 agReadSpoofStateFromKernel 函数） ======
static BOOL agReadSpoofStateFromKernel(BOOL *outActive, NSInteger *outScopeMode, BOOL *outShieldOn, NSInteger *outWiFiMode, double *outLat, double *outLon, double *outCourse, double *outSpeed, BOOL *outIsTargetAppMatch) {
    static int sTokState = 0, sTokLat = 0, sTokLon = 0, sTokMotion = 0;
    static int sTokApps[16] = {0};
    static uint32_t sMyBundleHash = 0;
    static os_unfair_lock sKernelCacheLock = OS_UNFAIR_LOCK_INIT;
    static NSTimeInterval sLastKernelReadTime = 0;
    static BOOL sCachedActive = NO, sCachedShield = NO, sCachedAppMatch = NO;
    static NSInteger sCachedScope = 0, sCachedWiFi = 0;
    static double sCachedLat = 0.0, sCachedLon = 0.0, sCachedCourse = -1.0, sCachedSpeed = 0.0;

    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        NSString *bid = [[NSBundle mainBundle] bundleIdentifier] ?: @"";
        sMyBundleHash = agHashBundleID(bid);
        notify_register_check("com.apple.coremedia.spatial.st", &sTokState);
        notify_register_check("com.apple.coremedia.spatial.x", &sTokLat);
        notify_register_check("com.apple.coremedia.spatial.y", &sTokLon);
        notify_register_check("com.apple.coremedia.spatial.v", &sTokMotion);
        for (int i = 0; i < 16; i++) {
            char keyBuf[48];
            snprintf(keyBuf, sizeof(keyBuf), "com.apple.coremedia.spatial.p%d", i);
            notify_register_check(keyBuf, &sTokApps[i]);
        }
    });

    NSTimeInterval now = CFAbsoluteTimeGetCurrent();
    os_unfair_lock_lock(&sKernelCacheLock);
    // 0.20 秒高速内存缓存：将每秒上万次的 notify_get_state 跨进程调用削减 99.9%，彻底消除地图渲染卡顿！
    if (now - sLastKernelReadTime < 0.20 && sLastKernelReadTime > 0) {
        if (outActive) *outActive = sCachedActive;
        if (outScopeMode) *outScopeMode = sCachedScope;
        if (outShieldOn) *outShieldOn = sCachedShield;
        if (outWiFiMode) *outWiFiMode = sCachedWiFi;
        if (outLat) *outLat = sCachedLat;
        if (outLon) *outLon = sCachedLon;
        if (outCourse) *outCourse = sCachedCourse;
        if (outSpeed) *outSpeed = sCachedSpeed;
        if (outIsTargetAppMatch) *outIsTargetAppMatch = sCachedAppMatch;
        os_unfair_lock_unlock(&sKernelCacheLock);
        return YES;
    }

    uint64_t rawState = 0;
    if (notify_get_state(sTokState, &rawState) != NOTIFY_STATUS_OK) {
        os_unfair_lock_unlock(&sKernelCacheLock);
        return NO;
    }
    uint64_t stateBits = rawState ^ agKernelObfuscateMask(0x101);
    if ((stateBits & 0xFFFF000000000000ULL) != 0xA5A5000000000000ULL) {
        os_unfair_lock_unlock(&sKernelCacheLock);
        return NO;
    }

    BOOL active = (stateBits & (1ULL << 0)) != 0;
    NSInteger scope = (stateBits >> 1) & 0x3;
    BOOL shield = active ? ((stateBits & (1ULL << 5)) != 0) : NO;
    NSInteger wifi = active ? ((stateBits >> 6) & 0x3) : 0;
    NSUInteger appCount = (stateBits >> 16) & 0xFF;

    uint64_t rawLat = 0, rawLon = 0, rawMotion = 0;
    notify_get_state(sTokLat, &rawLat);
    notify_get_state(sTokLon, &rawLon);
    notify_get_state(sTokMotion, &rawMotion);

    uint64_t latBits    = rawLat    ^ agKernelObfuscateMask(0x102);
    uint64_t lonBits    = rawLon    ^ agKernelObfuscateMask(0x103);
    uint64_t motionBits = rawMotion ^ agKernelObfuscateMask(0x104);

    double lat = 0.0, lon = 0.0;
    memcpy(&lat, &latBits, sizeof(double));
    memcpy(&lon, &lonBits, sizeof(double));

    uint32_t cBits = (uint32_t)(motionBits >> 32);
    uint32_t sBits = (uint32_t)(motionBits & 0xFFFFFFFFULL);
    float fCourse = -1.0f, fSpeed = 0.0f;
    memcpy(&fCourse, &cBits, sizeof(float));
    memcpy(&fSpeed, &sBits, sizeof(float));

    BOOL foundInKernelList = NO;
    if (sMyBundleHash != 0 && appCount > 0) {
        for (int i = 0; i < 16 && (i * 2) < appCount; i++) {
            uint64_t rawPair = 0;
            notify_get_state(sTokApps[i], &rawPair);
            uint64_t pairBits = rawPair ^ agKernelObfuscateMask(0x200 + i);
            uint32_t h0 = (uint32_t)(pairBits >> 32);
            uint32_t h1 = (uint32_t)(pairBits & 0xFFFFFFFFULL);
            if ((h0 != 0 && h0 == sMyBundleHash) || (h1 != 0 && h1 == sMyBundleHash)) {
                foundInKernelList = YES;
                break;
            }
        }
    }

    sLastKernelReadTime = now;
    sCachedActive   = active;
    sCachedScope    = scope;
    sCachedShield   = shield;
    sCachedWiFi     = wifi;
    sCachedLat      = lat;
    sCachedLon      = lon;
    sCachedCourse   = (double)fCourse;
    sCachedSpeed    = (double)fSpeed;
    sCachedAppMatch = foundInKernelList;

    if (outActive) *outActive = active;
    if (outScopeMode) *outScopeMode = scope;
    if (outShieldOn) *outShieldOn = shield;
    if (outWiFiMode) *outWiFiMode = wifi;
    if (outLat) *outLat = lat;
    if (outLon) *outLon = lon;
    if (outCourse) *outCourse = (double)fCourse;
    if (outSpeed) *outSpeed = (double)fSpeed;
    if (outIsTargetAppMatch) *outIsTargetAppMatch = foundInKernelList;
    os_unfair_lock_unlock(&sKernelCacheLock);
    return YES;
}
// ====== 防卡顿替换 1 结束 ======

