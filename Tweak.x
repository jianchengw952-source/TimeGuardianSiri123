typedef struct {
    BOOL valid;
    double lat;
    double lon;
    double alt;
    double hAcc;
    double vAcc;
    double course;
    double speed;
    double spdAcc;
    double crsAcc;
} AGSpoofedTelemetry;

typedef struct {
    uintptr_t locPtr;
    AGSpoofedTelemetry tel;
} AGLocPtrTelemetrySlot;

static os_unfair_lock sTelemetryCacheLock = OS_UNFAIR_LOCK_INIT;
static AGSpoofedTelemetry sLastTelemetry = {NO, 0, 0, 18.5, 5.0, 3.5, -1.0, 0.0, 0.18, -1.0};
static NSTimeInterval sLastTelemetryTime = 0;
static double sLastTelemetryBaseLat = 0.0;
static double sLastTelemetryBaseLon = 0.0;
static double sSessionStandOffsetLat = 0.0;
static double sSessionStandOffsetLon = 0.0;
static BOOL sHasInitSessionStandOffset = NO;
static AGLocPtrTelemetrySlot sLocPtrRing[64];
static uint32_t sLocPtrRingWriteIdx = 0;

static BOOL agGetCurrentSpoofedTelemetry(AGSpoofedTelemetry *outTel) {
    if (!outTel) return NO;
    double lat = 0.0, lon = 0.0, kCourse = -1.0, kSpeed = 0.0;
    BOOL kActive = NO, kShield = NO;
    if (agReadSpoofStateFromKernel(&kActive, NULL, &kShield, NULL, &lat, &lon, &kCourse, &kSpeed, NULL) && kActive && (fabs(lat) > 0.001 || fabs(lon) > 0.001)) {
        // 已从内核寄存器读取
    } else if (agIsSpringBoardProcess()) {
        AGLocationSpoofManager *mgr = [AGLocationSpoofManager sharedSpoofer];
        NSDictionary *p = agReadOnlyPrefs();
        lat = mgr.currentWGS84Coord.latitude;
        lon = mgr.currentWGS84Coord.longitude;
        if (fabs(lat) < 0.001 && fabs(lon) < 0.001) {
            lat = [p[@"AG_LocSpoof_Lat"] doubleValue];
            lon = [p[@"AG_LocSpoof_Lon"] doubleValue];
        }
        kCourse = mgr.currentCourse;
        kSpeed = mgr.isRouteMoving ? MAX(0.2, mgr.moveSpeedMetersPerSec) : 0.0;
        kShield = (p[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [p[@"AG_AntiDet_ShieldEnabled"] boolValue];
    } else {
        outTel->valid = NO;
        return NO;
    }

    if (fabs(lat) < 0.001 && fabs(lon) < 0.001) {
        outTel->valid = NO;
        return NO;
    }

    NSTimeInterval now = CFAbsoluteTimeGetCurrent();
    os_unfair_lock_lock(&sTelemetryCacheLock);

    // 每次进程启动或更换大地点时，生成一次性的 2.5m ~ 6.5m 自然站位偏移，彻底破除服务端后台「多日打卡中心点毫米级重合」聚类算法
    if (!sHasInitSessionStandOffset || fabs(lat - sLastTelemetryBaseLat) > 0.0005 || fabs(lon - sLastTelemetryBaseLon) > 0.0005) {
        sHasInitSessionStandOffset = YES;
        double angle = ((double)arc4random_uniform(3600)) * M_PI / 1800.0;
        double radiusMeters = 2.5 + ((double)arc4random_uniform(40)) * 0.1; // 2.5m ~ 6.5m
        sSessionStandOffsetLat = (radiusMeters * sin(angle)) / 111320.0;
        sSessionStandOffsetLon = (radiusMeters * cos(angle)) / (111320.0 * MAX(0.2, cos(lat * M_PI / 180.0)));
    }

    if (sLastTelemetry.valid &&
        (now - sLastTelemetryTime < 1.80) &&
        fabs(lat - sLastTelemetryBaseLat) < 1e-6 &&
        fabs(lon - sLastTelemetryBaseLon) < 1e-6) {
        *outTel = sLastTelemetry;
        os_unfair_lock_unlock(&sTelemetryCacheLock);
        return YES;
    }

    double baseAlt = agEstimatedBaseAltitudeForCoord(lat, lon);
    double microLat = lat;
    double microLon = lon;
    if (kShield) {
        microLat += sSessionStandOffsetLat + agGaussianRandom() * 0.0000025;
        microLon += sSessionStandOffsetLon + agGaussianRandom() * 0.0000025;
        baseAlt  += agGaussianRandom() * 0.08;
    }
    double hAcc = kShield ? (6.8 + ((double)arc4random_uniform(77)) * 0.1) : 5.0;
    double vAcc = kShield ? (3.6 + ((double)arc4random_uniform(32)) * 0.1) : 3.5;
    double spd  = (kSpeed >= 0.0) ? kSpeed : 0.0;
    double spdAcc = (spd > 0.1) ? (0.21 + ((double)arc4random_uniform(15)) * 0.01) : (0.14 + ((double)arc4random_uniform(11)) * 0.01);
    double crsAcc = (kCourse >= 0.0) ? (11.8 + ((double)arc4random_uniform(68)) * 0.1) : -1.0;

    sLastTelemetryBaseLat = lat;
    sLastTelemetryBaseLon = lon;
    sLastTelemetry.valid  = YES;
    sLastTelemetry.lat    = microLat;
    sLastTelemetry.lon    = microLon;
    sLastTelemetry.alt    = baseAlt;
    sLastTelemetry.hAcc   = hAcc;
    sLastTelemetry.vAcc   = vAcc;
    sLastTelemetry.course = kCourse;
    sLastTelemetry.speed  = spd;
    sLastTelemetry.spdAcc = spdAcc;
    sLastTelemetry.crsAcc = crsAcc;
    sLastTelemetryTime    = now;
    *outTel = sLastTelemetry;
    os_unfair_lock_unlock(&sTelemetryCacheLock);
    return YES;
}

static BOOL agGetTelemetryForLocationInstance(CLLocation *loc, AGSpoofedTelemetry *outTel) {
    if (!outTel) return NO;
    uintptr_t ptr = (uintptr_t)loc;
    if (ptr == 0) return agGetCurrentSpoofedTelemetry(outTel);

    os_unfair_lock_lock(&sTelemetryCacheLock);
    for (int i = 0; i < 64; i++) {
        if (sLocPtrRing[i].locPtr == ptr && sLocPtrRing[i].tel.valid) {
            *outTel = sLocPtrRing[i].tel;
            os_unfair_lock_unlock(&sTelemetryCacheLock);
            return YES;
        }
    }
    os_unfair_lock_unlock(&sTelemetryCacheLock);

    AGSpoofedTelemetry freshTel;
    if (!agGetCurrentSpoofedTelemetry(&freshTel) || !freshTel.valid) {
        return NO;
    }

    os_unfair_lock_lock(&sTelemetryCacheLock);
    uint32_t slot = (sLocPtrRingWriteIdx++) & 63;
    sLocPtrRing[slot].locPtr = ptr;
    sLocPtrRing[slot].tel = freshTel;
    *outTel = freshTel;
    os_unfair_lock_unlock(&sTelemetryCacheLock);
    return YES;
}

static os_unfair_lock sCachedTickLocLock = OS_UNFAIR_LOCK_INIT;

- (CLLocation *)constructRealisticSpoofedLocation {
    AGSpoofedTelemetry tel;
    if (!agGetCurrentSpoofedTelemetry(&tel) || !tel.valid) {
        return nil;
    }
    NSTimeInterval now = [[NSDate date] timeIntervalSince1970];
    os_unfair_lock_lock(&sCachedTickLocLock);
    CLLocation *cached = _cachedTickLocation;
    if (cached && fabs(now - [cached.timestamp timeIntervalSince1970]) < 0.90) {
        os_unfair_lock_unlock(&sCachedTickLocLock);
        return cached;
    }
    os_unfair_lock_unlock(&sCachedTickLocLock);

    CLLocation *loc = agCreateHardwareGradeLocation(CLLocationCoordinate2DMake(tel.lat, tel.lon),
                                                    tel.alt,
                                                    tel.hAcc,
                                                    tel.vAcc,
                                                    tel.course,
                                                    tel.speed);
    os_unfair_lock_lock(&sCachedTickLocLock);
    _cachedTickLocation = loc;
    os_unfair_lock_unlock(&sCachedTickLocLock);
    return loc;
}


- (void)pinLocationWithCoordinate:(CLLocationCoordinate2D)coord coordSystem:(NSString *)sysType placeName:(NSString *)placeName {
    CLLocationCoordinate2D wgs = coord;
    NSString *upperSys = [sysType uppercaseString] ?: @"GCJ02";
    if ([upperSys containsString:@"BD"] || [upperSys containsString:@"BAIDU"]) {
        wgs = agBD09ToWGS84Exact(coord.latitude, coord.longitude);
    } else if ([upperSys containsString:@"GCJ"] || [upperSys containsString:@"AMAP"] || [upperSys containsString:@"MARS"]) {
        wgs = agGCJ02ToWGS84Exact(coord.latitude, coord.longitude);
    }

    NSDictionary *roPrefs = agReadOnlyPrefs();
    NSInteger moveMode = roPrefs[@"AG_LocSpoof_MoveMode"] ? [roPrefs[@"AG_LocSpoof_MoveMode"] integerValue] : 0;
    self.currentPlaceName = placeName.length > 0 ? placeName : [NSString stringWithFormat:@"%.5f, %.5f", wgs.latitude, wgs.longitude];

    double curKernelLat = 0.0, curKernelLon = 0.0;
    BOOL kActive = NO;
    if (agReadSpoofStateFromKernel(&kActive, NULL, NULL, NULL, &curKernelLat, &curKernelLon, NULL, NULL, NULL) && kActive && (fabs(curKernelLat) > 0.01 || fabs(curKernelLon) > 0.01)) {
        self.currentWGS84Coord = CLLocationCoordinate2DMake(curKernelLat, curKernelLon);
    }

    if (moveMode > 0) {
        if (!self.isSpoofingActive || (fabs(self.currentWGS84Coord.latitude) < 0.01 && fabs(self.currentWGS84Coord.longitude) < 0.01)) {
            self.currentWGS84Coord = CLLocationCoordinate2DMake(wgs.latitude - 0.0025, wgs.longitude - 0.0025);
            self.baseWGS84Coord = self.currentWGS84Coord;
        }
        double dLat = wgs.latitude - self.currentWGS84Coord.latitude;
        double dLon = wgs.longitude - self.currentWGS84Coord.longitude;
        double distM = hypot(dLat * 111320.0, dLon * 111320.0 * cos(wgs.latitude * M_PI / 180.0));

        if (distM > 80000.0 || distM < 5.0) {
            self.currentWGS84Coord = CLLocationCoordinate2DMake(wgs.latitude - 0.0035, wgs.longitude - 0.0035);
            self.baseWGS84Coord = self.currentWGS84Coord;
            distM = hypot(0.0035 * 111320.0, 0.0035 * 111320.0 * cos(wgs.latitude * M_PI / 180.0));
        }

        self.targetWalkWGS84Coord = wgs;
        self.remainingDistanceMeters = distM;
        self.moveSpeedMetersPerSec = (moveMode == 1) ? 1.5 : 12.5;
        self.isRouteMoving = YES;
        self.isSpoofingActive = YES;
    } else {
        self.baseWGS84Coord = wgs;
        self.currentWGS84Coord = wgs;
        self.targetWalkWGS84Coord = wgs;
        self.remainingDistanceMeters = 0.0;
        self.isRouteMoving = NO;
        self.currentCourse = -1.0;
        self.isSpoofingActive = YES;
        self.cachedTickLocation = nil;
    }

    NSMutableDictionary *p = loadGeminiPrefs();
    BOOL wasActiveBefore = [p[@"AG_LocSpoof_Active"] boolValue];
    p[@"AG_LocSpoof_Active"] = @YES;
    p[@"AG_LocSpoof_Lat"] = @(self.currentWGS84Coord.latitude);
    p[@"AG_LocSpoof_Lon"] = @(self.currentWGS84Coord.longitude);
    p[@"AG_LocSpoof_TargetLat"] = @(wgs.latitude);
    p[@"AG_LocSpoof_TargetLon"] = @(wgs.longitude);
    p[@"AG_LocSpoof_IsMoving"] = @(self.isRouteMoving);
    p[@"AG_LocSpoof_InputLat"] = @(coord.latitude);
    p[@"AG_LocSpoof_InputLon"] = @(coord.longitude);
    p[@"AG_LocSpoof_Name"] = self.currentPlaceName;
    // 开启定位总开关时，默认只负责修改定位功能，防检测默认关闭（由用户按需开启）
    if (!wasActiveBefore || p[@"AG_AntiDet_ShieldEnabled"] == nil) {
        p[@"AG_AntiDet_ShieldEnabled"] = @NO;
        p[@"AG_AntiDet_HideSimFlag"] = @NO;
        p[@"AG_AntiDet_WiFiMode"] = @0;
        p[@"AG_AntiDet_MotionSync"] = @NO;
        p[@"AG_AntiDet_HideHookPtr"] = @NO;
        p[@"AG_LocSpoof_JitterEnabled"] = @NO;
    }
    saveGeminiPrefs(p);

    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);

    if ([[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.apple.springboard"]) {
        [self applyPreferencesAndRestartTimerIfNeeded];
        [self pushSimulatedLocationToDaemonWithCourse:self.currentCourse speed:(self.isRouteMoving ? self.moveSpeedMetersPerSec : 0.0) forceRestart:YES];
    }

    NSString *pillMsg = self.isRouteMoving
        ? [NSString stringWithFormat:@"🟢 虚拟定位已接管 (%@前往：%@ · 距%.0f米)", (moveMode == 1 ? @"🚶步行" : @"🚗驾车"), self.currentPlaceName, self.remainingDistanceMeters]
        : [NSString stringWithFormat:@"🟢 虚拟定位已接管：📍 %@", self.currentPlaceName];
    [[AGGlobalActionPillWindow sharedPill] showActionPill:pillMsg];
}

- (void)teleportImmediatelyToCurrentTarget {
    NSDictionary *p = agReadOnlyPrefs();
    double targetLat = p[@"AG_LocSpoof_TargetLat"] ? [p[@"AG_LocSpoof_TargetLat"] doubleValue] : self.targetWalkWGS84Coord.latitude;
    double targetLon = p[@"AG_LocSpoof_TargetLon"] ? [p[@"AG_LocSpoof_TargetLon"] doubleValue] : self.targetWalkWGS84Coord.longitude;
    if (fabs(targetLat) > 0.01 || fabs(targetLon) > 0.01) {
        self.targetWalkWGS84Coord = CLLocationCoordinate2DMake(targetLat, targetLon);
    }
    self.currentWGS84Coord = self.targetWalkWGS84Coord;
    self.baseWGS84Coord = self.targetWalkWGS84Coord;
    self.remainingDistanceMeters = 0.0;
    self.isRouteMoving = NO;
    self.currentCourse = -1.0;
    self.cachedTickLocation = nil;

    NSMutableDictionary *mp = loadGeminiPrefs();
    mp[@"AG_LocSpoof_Lat"] = @(self.baseWGS84Coord.latitude);
    mp[@"AG_LocSpoof_Lon"] = @(self.baseWGS84Coord.longitude);
    mp[@"AG_LocSpoof_IsMoving"] = @NO;
    saveGeminiPrefs(mp);

    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);
    [[NSNotificationCenter defaultCenter] postNotificationName:kAGLocTickUIUpdateNotification object:nil];
    [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"⚡ 已立即抵达终点：%@", self.currentPlaceName ?: (p[@"AG_LocSpoof_Name"] ?: @"终点")]];
}

- (void)applyPreferencesAndRestartTimerIfNeeded {
    if (![NSThread isMainThread]) {
        dispatch_async(dispatch_get_main_queue(), ^{
            [self applyPreferencesAndRestartTimerIfNeeded];
        });
        return;
    }
    [self.jitterTimer invalidate];
    self.jitterTimer = nil;

    if (![[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.apple.springboard"]) {
        return;
    }

    NSDictionary *p = agReadOnlyPrefs();
    if (![p[@"AG_LocSpoof_Active"] boolValue]) return;

    self.jitterTimer = [NSTimer scheduledTimerWithTimeInterval:1.0 target:self selector:@selector(onSimulationTick) userInfo:nil repeats:YES];
    [[NSRunLoop mainRunLoop] addTimer:self.jitterTimer forMode:NSRunLoopCommonModes];
}

- (void)onSimulationTick {
    BOOL kActive = YES;
    if (agReadSpoofStateFromKernel(&kActive, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL) && !kActive) {
        reloadGeminiPrefsCache();
    }
    NSDictionary *p = agReadOnlyPrefs();
    if (!self.isSpoofingActive || ![p[@"AG_LocSpoof_Active"] boolValue]) {
        [self stopAndResetToRealLocation];
        return;
    }

    static NSUInteger sMoveTickCounter = 0;
    sMoveTickCounter++;

    double course = -1.0;
    double speed = 0.0;
    NSTimeInterval tick = 1.0;

    if (self.isRouteMoving) {
        double curLat = self.baseWGS84Coord.latitude;
        double curLon = self.baseWGS84Coord.longitude;
        double dLat = self.targetWalkWGS84Coord.latitude - curLat;
        double dLon = self.targetWalkWGS84Coord.longitude - curLon;
        double cosLat = MAX(0.2, cos(curLat * M_PI / 180.0));
        double northMeters = dLat * 111320.0;
        double eastMeters  = dLon * 111320.0 * cosLat;
        double distMeters  = hypot(northMeters, eastMeters);

        // 1. 真人步速/车速呼吸波动
        BOOL shieldOnForMove = (p[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [p[@"AG_AntiDet_ShieldEnabled"] boolValue];
        double baseSpd = MAX(0.5, self.moveSpeedMetersPerSec);
        double breathWave = sin((double)sMoveTickCounter * 0.35) * 0.09 + agGaussianRandom() * 0.05;
        double rawTargetSpd = MAX(0.45, baseSpd * (1.0 + MAX(-0.18, MIN(0.18, breathWave))));
        double decelFactor = (shieldOnForMove && distMeters < 12.0) ? MAX(0.35, distMeters / 12.0) : 1.0;
        speed = rawTargetSpd * decelFactor;
        double stepMeters = speed * tick;

        if (distMeters <= stepMeters) {
            self.currentWGS84Coord = self.targetWalkWGS84Coord;
            self.baseWGS84Coord = self.targetWalkWGS84Coord;
            self.remainingDistanceMeters = 0.0;
            self.isRouteMoving = NO;
            self.currentCourse = -1.0;
            speed = 0.0;

            NSMutableDictionary *mp = loadGeminiPrefs();
            mp[@"AG_LocSpoof_Lat"] = @(self.baseWGS84Coord.latitude);
            mp[@"AG_LocSpoof_Lon"] = @(self.baseWGS84Coord.longitude);
            mp[@"AG_LocSpoof_IsMoving"] = @NO;
            saveGeminiPrefs(mp);

            [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"🏁 已抵达目标终点：%@", self.currentPlaceName]];
        } else {
            // 2. 沿主方向推进基线坐标
            double ratio = stepMeters / distMeters;
            double nextBaseLat = curLat + dLat * ratio;
            double nextBaseLon = curLon + dLon * ratio;
            self.baseWGS84Coord = CLLocationCoordinate2DMake(nextBaseLat, nextBaseLon);
            self.remainingDistanceMeters = distMeters - stepMeters;

            // 3. 叠加垂直于前进方向的真人步态/车道正弦微摆动，消除多点共线性破绽
            double uNorth = northMeters / distMeters;
            double uEast  = eastMeters  / distMeters;
            double perpNorth = -uEast;
            double perpEast  =  uNorth;

            BOOL isDriving = (baseSpd > 4.0);
            double swayAmpMeters = isDriving ? 0.28 : 0.52;
            double lateralOffsetM = sin((double)sMoveTickCounter * 0.58) * swayAmpMeters
                                  + cos((double)sMoveTickCounter * 0.23) * (swayAmpMeters * 0.45)
                                  + agGaussianRandom() * 0.14;

            double degPerMeter = 1.0 / 111320.0;
            double finalLat = nextBaseLat + (perpNorth * lateralOffsetM) * degPerMeter;
            double finalLon = nextBaseLon + (perpEast  * lateralOffsetM) * degPerMeter / cosLat;
            self.currentWGS84Coord = CLLocationCoordinate2DMake(finalLat, finalLon);

            // 4. 航向角叠加 ±3.5° 自然浮动
            double radAngle = atan2(eastMeters, northMeters);
            double rawCourse = fmod((radAngle * 180.0 / M_PI) + 360.0, 360.0);
            double courseJitter = sin((double)sMoveTickCounter * 0.62) * 2.4 + agGaussianRandom() * 1.1;
            course = fmod(rawCourse + courseJitter + 360.0, 360.0);
            self.currentCourse = course;

            // 5. 每 5 秒将最新坐标落盘，防止中途重启跳回起点
            if (sMoveTickCounter % 5 == 0) {
                NSMutableDictionary *mp = loadGeminiPrefs();
                mp[@"AG_LocSpoof_Lat"] = @(self.baseWGS84Coord.latitude);
                mp[@"AG_LocSpoof_Lon"] = @(self.baseWGS84Coord.longitude);
                mp[@"AG_LocSpoof_IsMoving"] = @YES;
                saveGeminiPrefs(mp);
            }
        }
    } else {
        BOOL shieldOn = (p[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [p[@"AG_AntiDet_ShieldEnabled"] boolValue];
        double driftLat = self.baseWGS84Coord.latitude;
        double driftLon = self.baseWGS84Coord.longitude;
        agStepKalmanSmoothDrift(shieldOn, &driftLat, &driftLon, NULL, NULL, NULL);
        self.currentWGS84Coord = CLLocationCoordinate2DMake(driftLat, driftLon);
    }

    NSInteger scopeMode = p[@"AG_LocSpoof_ScopeMode"] ? [p[@"AG_LocSpoof_ScopeMode"] integerValue] : 0;
    NSInteger moveMode  = p[@"AG_LocSpoof_MoveMode"] ? [p[@"AG_LocSpoof_MoveMode"] integerValue] : 0;
    BOOL shieldOn = (p[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [p[@"AG_AntiDet_ShieldEnabled"] boolValue];
    NSInteger rawWiFi = p[@"AG_AntiDet_WiFiMode"] ? [p[@"AG_AntiDet_WiFiMode"] integerValue] : 1;
    // 关键修复：只要开启了防检测 (shieldOn=YES)，若未选自定义 Wi-Fi (2)，必须保持默认模式 1 (隐藏异地 Wi-Fi)，严禁重置为 0 导致真实家庭 Wi-Fi 泄露！
    NSInteger wifiMode = shieldOn ? ((rawWiFi == 2) ? 2 : 1) : 0;
    NSArray *targetApps = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];
    agPublishSpoofStateToKernel(YES, scopeMode, moveMode, shieldOn, wifiMode, self.isRouteMoving, self.currentWGS84Coord.latitude, self.currentWGS84Coord.longitude, course, speed, targetApps);
    if (wifiMode == 2) {
        agPublishCustomWiFiToKernel(p[@"AG_AntiDet_FakeSSID"], p[@"AG_AntiDet_FakeBSSID"]);
    }

    self.cachedTickLocation = nil;
    if (self.isRouteMoving || (shieldOn && (sMoveTickCounter % 2 == 0))) {
        [self pushSimulatedLocationToDaemonWithCourse:course speed:speed forceRestart:NO];
    }
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocTickUIUpdateNotification,
                                         NULL, NULL, YES);
}


- (void)pushSimulatedLocationToDaemonWithCourse:(double)course speed:(double)speed forceRestart:(BOOL)forceRestart {
    (void)course; (void)speed; (void)forceRestart;
    if (![[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.apple.springboard"]) {
        return;
    }

    // 铁律：绝不再调用 CLSimulationManager 向系统 locationd 注入任何模拟位置（彻底杜绝 locationd 缓存被印上 isSimulatedBySoftware=YES）！
    // 此处仅在首次调用或关闭定位时，将 locationd 中历史残留的模拟状态彻底归零并冲洗干净。
    dispatch_async(self.simDaemonQueue, ^{
        if (!self.simManager) {
            // "CLSimulationManager" ^ 0x5A
            static const uint8_t kEncCLSimCls[] = {0x19,0x16,0x09,0x33,0x37,0x2f,0x36,0x3b,0x2e,0x33,0x35,0x34,0x17,0x3b,0x34,0x3b,0x3d,0x3f,0x28};
            Class simCls = NSClassFromString(agDecodeObfuscatedCStr(kEncCLSimCls, sizeof(kEncCLSimCls), 0x5A));
            if (simCls) {
                self.simManager = [[simCls alloc] init];
            }
        }
        if (!self.simManager) return;

        @try {
            // "setLocationRepeatBehavior:" ^ 0x5A
            static const uint8_t kEncSetRep[] = {0x29,0x3f,0x2e,0x16,0x35,0x39,0x3b,0x2e,0x33,0x35,0x34,0x08,0x3f,0x2a,0x3f,0x3b,0x2e,0x18,0x3f,0x32,0x3b,0x2c,0x33,0x35,0x28,0x60};
            // "setLocationDeliveryBehavior:" ^ 0x5A
            static const uint8_t kEncSetDel[] = {0x29,0x3f,0x2e,0x16,0x35,0x39,0x3b,0x2e,0x33,0x35,0x34,0x1e,0x3f,0x36,0x33,0x2c,0x3f,0x28,0x23,0x18,0x3f,0x32,0x3b,0x2c,0x33,0x35,0x28,0x60};
            // "clearSimulatedLocations" ^ 0x5A
            static const uint8_t kEncClear[]  = {0x39,0x36,0x3f,0x3b,0x28,0x09,0x33,0x37,0x2f,0x36,0x3b,0x2e,0x3f,0x3e,0x16,0x35,0x39,0x3b,0x2e,0x33,0x35,0x34,0x29};
            // "stopLocationSimulation" ^ 0x5A
            static const uint8_t kEncStop[]   = {0x29,0x2e,0x35,0x2a,0x16,0x35,0x39,0x3b,0x2e,0x33,0x35,0x34,0x09,0x33,0x37,0x2f,0x36,0x3b,0x2e,0x33,0x35,0x34};
            // "flush" ^ 0x5A
            static const uint8_t kEncFlush[]  = {0x3c,0x36,0x2f,0x29,0x32};

            SEL selSetRep = agDecodeSelector(kEncSetRep, sizeof(kEncSetRep), 0x5A);
            SEL selSetDel = agDecodeSelector(kEncSetDel, sizeof(kEncSetDel), 0x5A);
            SEL selClear  = agDecodeSelector(kEncClear, sizeof(kEncClear), 0x5A);
            SEL selStop   = agDecodeSelector(kEncStop, sizeof(kEncStop), 0x5A);
            SEL selFlush  = agDecodeSelector(kEncFlush, sizeof(kEncFlush), 0x5A);

            if ([self.simManager respondsToSelector:selSetRep]) {
                ((void(*)(id, SEL, uint8_t))objc_msgSend)(self.simManager, selSetRep, 0);
            }
            if ([self.simManager respondsToSelector:selSetDel]) {
                ((void(*)(id, SEL, uint8_t))objc_msgSend)(self.simManager, selSetDel, 0);
            }
            if ([self.simManager respondsToSelector:selClear]) {
                ((void(*)(id, SEL))objc_msgSend)(self.simManager, selClear);
            }
            if ([self.simManager respondsToSelector:selStop]) {
                ((void(*)(id, SEL))objc_msgSend)(self.simManager, selStop);
            }
            if ([self.simManager respondsToSelector:selClear]) {
                ((void(*)(id, SEL))objc_msgSend)(self.simManager, selClear);
            }
            if ([self.simManager respondsToSelector:selFlush]) {
                ((void(*)(id, SEL))objc_msgSend)(self.simManager, selFlush);
            }
            self.isDaemonSimRunning = NO;
        } @catch (NSException *e) {}
    });
}


- (void)resolvePlaceAndPin:(NSString *)placeQuery completion:(void(^)(BOOL ok, NSString *summary))completion {
    NSString *cleanPlace = [placeQuery stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (cleanPlace.length == 0) {
        if (completion) completion(NO, @"地点名称为空");
        return;
    }

    NSDictionary *landmarks = [self builtinFamousLandmarksGCJ02];
    NSString *exactMatchedKey = nil;
    if (landmarks[cleanPlace]) {
        exactMatchedKey = cleanPlace;
    } else {
        for (NSString *key in landmarks) {
            if ([cleanPlace isEqualToString:key] || [cleanPlace hasPrefix:key]) {
                if (cleanPlace.length <= key.length + 1) {
                    exactMatchedKey = key;
                    break;
                }
            }
        }
    }

    if (exactMatchedKey) {
        NSArray<NSNumber *> *pair = landmarks[exactMatchedKey];
        CLLocationCoordinate2D gcj = CLLocationCoordinate2DMake([pair[0] doubleValue], [pair[1] doubleValue]);
        dispatch_async(dispatch_get_main_queue(), ^{
            [self pinLocationWithCoordinate:gcj coordSystem:@"GCJ02" placeName:exactMatchedKey];
            if (completion) completion(YES, [NSString stringWithFormat:@"已将定位修改至「%@」", exactMatchedKey]);
        });
        return;
    }

    dispatch_async(dispatch_get_main_queue(), ^{
        __block BOOL hasCompleted = NO;
        MKLocalSearchRequest *req = [[MKLocalSearchRequest alloc] init];
        req.naturalLanguageQuery = cleanPlace;
        MKLocalSearch *search = [[MKLocalSearch alloc] initWithRequest:req];

        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(5.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (hasCompleted) return;
            hasCompleted = YES;
            [search cancel];
            for (NSString *key in landmarks) {
                if ([cleanPlace containsString:key]) {
                    NSArray<NSNumber *> *pair = landmarks[key];
                    CLLocationCoordinate2D gcj = CLLocationCoordinate2DMake([pair[0] doubleValue], [pair[1] doubleValue]);
                    [self pinLocationWithCoordinate:gcj coordSystem:@"GCJ02" placeName:cleanPlace];
                    if (completion) completion(YES, [NSString stringWithFormat:@"已将定位锁定至「%@」", cleanPlace]);
                    return;
                }
            }
            if (completion) completion(NO, [NSString stringWithFormat:@"搜索地点「%@」超时", cleanPlace]);
        });

        [search startWithCompletionHandler:^(MKLocalSearchResponse * _Nullable response, NSError * _Nullable error) {
            dispatch_async(dispatch_get_main_queue(), ^{
                if (hasCompleted) return;
                hasCompleted = YES;

                MKMapItem *firstItem = response.mapItems.firstObject;
                if (firstItem && firstItem.placemark.location) {
                    CLLocationCoordinate2D rawCoord = firstItem.placemark.location.coordinate;
                    NSString *displayName = firstItem.name ?: cleanPlace;
                                [self pinLocationWithCoordinate:rawCoord coordSystem:@"GCJ02" placeName:displayName];
                    if (completion) completion(YES, [NSString stringWithFormat:@"已将定位锁定至「%@」", displayName]);
                } else {
                    for (NSString *key in landmarks) {
                        if ([cleanPlace containsString:key]) {
                            NSArray<NSNumber *> *pair = landmarks[key];
                            CLLocationCoordinate2D gcj = CLLocationCoordinate2DMake([pair[0] doubleValue], [pair[1] doubleValue]);
                            [self pinLocationWithCoordinate:gcj coordSystem:@"GCJ02" placeName:cleanPlace];
                            if (completion) completion(YES, [NSString stringWithFormat:@"已将定位锁定至「%@」", cleanPlace]);
                            return;
                        }
                    }
                    [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"⚠️ 未找到地点：%@", cleanPlace]];
                    if (completion) completion(NO, [NSString stringWithFormat:@"未能解析地点「%@」", cleanPlace]);
                }
            });
        }];
    });
}

- (void)startCruisingToPlace:(NSString *)destQuery speed:(double)speedMps completion:(void(^)(BOOL ok, NSString *summary))completion {
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_LocSpoof_MoveMode"] = (speedMps > 4.0) ? @2 : @1;
    saveGeminiPrefs(p);
    [self resolvePlaceAndPin:destQuery completion:completion];
}

- (void)enableAttendanceStealthPreset {
    reloadGeminiPrefsCache();
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_AntiDet_ShieldEnabled"] = @YES;
    p[@"AG_AntiDet_HideSimFlag"] = @YES;
    p[@"AG_AntiDet_WiFiMode"] = @1;
    p[@"AG_AntiDet_MotionSync"] = @YES;
    p[@"AG_AntiDet_HideHookPtr"] = @YES;
    p[@"AG_LocSpoof_JitterEnabled"] = @YES;
    p[@"AG_LocSpoof_JitterRadius"] = @1.2;

    // 若当前处于白名单模式(1)且尚未勾选任何软件，自动补齐钉钉、企业微信、微信、高德等常用软件，防止白名单为空导致定位不生效
    NSInteger scopeMode = p[@"AG_LocSpoof_ScopeMode"] ? [p[@"AG_LocSpoof_ScopeMode"] integerValue] : 0;
    NSArray *targetApps = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];
    if (scopeMode == 1 && targetApps.count == 0) {
        p[@"AG_LocSpoof_TargetApps"] = @[
            @"com.laiwang.DingTalk",
            @"com.tencent.wework",
            @"com.bytedance.ee.lark",
            @"com.electron.lark",
            @"com.weaver.emobile7",
            @"com.seeyon.cmp",
            @"com.beisen.italent",
            @"com.tencent.xin",
            @"com.meituan.imeituan",
            @"com.autonavi.amap",
            @"com.baidu.BaiduMobileMap"
        ];
    }
    saveGeminiPrefs(p);
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);
    [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🛡️ 已开启防检测保护护盾"];
}

- (void)stopAndResetToRealLocation {
    self.isSpoofingActive = NO;
    self.isRouteMoving = NO;
    self.remainingDistanceMeters = 0.0;
    self.currentCourse = -1.0;
    self.cachedTickLocation = nil;
    [self.jitterTimer invalidate];
    self.jitterTimer = nil;

    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_LocSpoof_Active"] = @NO;
    p[@"AG_LocSpoof_IsMoving"] = @NO;
    // 关闭虚拟定位总开关时，防检测保护与伪装 Wi-Fi 自动随着关闭
    p[@"AG_AntiDet_ShieldEnabled"] = @NO;
    p[@"AG_AntiDet_HideSimFlag"] = @NO;
    p[@"AG_AntiDet_MotionSync"] = @NO;
    p[@"AG_AntiDet_HideHookPtr"] = @NO;
    p[@"AG_LocSpoof_JitterEnabled"] = @NO;
    p[@"AG_AntiDet_WiFiMode"] = @0;
    saveGeminiPrefs(p);

    if ([[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.apple.springboard"]) {
        [self pushSimulatedLocationToDaemonWithCourse:-1.0 speed:0.0 forceRestart:YES];
    }

    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocTickUIUpdateNotification,
                                         NULL, NULL, YES);
    [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🛰️ 已恢复真实物理 GPS (防检测已同步关闭)"];
}

@end

// ==================== 🗺️ 免签名权限高德高清中文街道瓦片图层 ====================
@interface AGGaodeTileOverlay : MKTileOverlay
@end

@implementation AGGaodeTileOverlay

- (NSURL *)URLForTilePath:(MKTileOverlayPath)path {
    NSInteger subdomain = (path.x + path.y) % 4 + 1;
    NSString *urlStr = [NSString stringWithFormat:@"https://webrd0%ld.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=2&style=8&x=%ld&y=%ld&z=%ld",
                        (long)subdomain, (long)path.x, (long)path.y, (long)path.z];
    return [NSURL URLWithString:urlStr];
}

- (void)loadTileAtPath:(MKTileOverlayPath)path result:(void (^)(NSData * _Nullable, NSError * _Nullable))result {
    if (!result) return;
    NSURL *url = [self URLForTilePath:path];
    if (!url) {
        result(nil, nil);
        return;
    }

    static NSCache<NSString *, NSData *> *sTileCache = nil;
    static NSURLSession *sTileSession = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sTileCache = [[NSCache alloc] init];
        sTileCache.countLimit = 400;
        NSURLSessionConfiguration *cfg = [NSURLSessionConfiguration defaultSessionConfiguration];
        cfg.timeoutIntervalForRequest = 6.0;
        sTileSession = [NSURLSession sessionWithConfiguration:cfg];
    });

    NSString *cacheKey = [NSString stringWithFormat:@"%ld_%ld_%ld", (long)path.z, (long)path.x, (long)path.y];
    NSData *cached = [sTileCache objectForKey:cacheKey];
    if (cached) {
        result(cached, nil);
        return;
    }

    NSMutableURLRequest *req = [NSMutableURLRequest requestWithURL:url];
    [req setValue:@"Mozilla/5.0 (iPhone; CPU iPhone OS 16_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148" forHTTPHeaderField:@"User-Agent"];
    [[sTileSession dataTaskWithRequest:req completionHandler:^(NSData * _Nullable data, NSURLResponse * _Nullable response, NSError * _Nullable error) {
        if (data && data.length > 100 && !error) {
            [sTileCache setObject:data forKey:cacheKey];
            result(data, nil);
        } else {
            result(nil, error);
        }
    }] resume];
}

@end

// ==================== 📱 本机应用动态列表选择器 ====================
@interface AGAppScopePickerViewController : UIViewController <UITableViewDelegate, UITableViewDataSource, UISearchBarDelegate>
@property (nonatomic, strong) UITableView *tableView;
@property (nonatomic, strong) UISearchBar *searchBar;
@property (nonatomic, strong) NSMutableSet<NSString *> *selectedBundleIDs;
@property (nonatomic, strong) NSArray<NSDictionary *> *allApps;
@property (nonatomic, strong) NSArray<NSDictionary *> *selectedSectionApps;
@property (nonatomic, strong) NSArray<NSDictionary *> *userSectionApps;
@property (nonatomic, strong) NSArray<NSDictionary *> *systemSectionApps;
@property (nonatomic, copy) NSString *searchKeyword;
@property (nonatomic, copy) void (^onSelectionChanged)(NSUInteger count);
@end

@implementation AGAppScopePickerViewController

+ (NSCache<NSString *, UIImage *> *)sharedIconCache {
    static NSCache *sCache = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sCache = [[NSCache alloc] init];
        sCache.countLimit = 300;
    });
    return sCache;
}

- (void)viewDidLoad {
    [super viewDidLoad];
    self.title = @"📱 选择生效的软件";
    self.view.backgroundColor = [UIColor colorWithRed:0.06 green:0.07 blue:0.12 alpha:1.0];
    if (@available(iOS 13.0, *)) {
        self.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
    }

    NSDictionary *p = agReadOnlyPrefs();
    NSArray *saved = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];
    self.selectedBundleIDs = [NSMutableSet setWithArray:saved];

    UIBarButtonItem *presetItem = [[UIBarButtonItem alloc] initWithTitle:@"⚡一键勾选常用软件" style:UIBarButtonItemStylePlain target:self action:@selector(selectAttendancePreset)];
    UIBarButtonItem *clearItem  = [[UIBarButtonItem alloc] initWithTitle:@"清空" style:UIBarButtonItemStylePlain target:self action:@selector(clearAllSelection)];
    self.navigationItem.rightBarButtonItems = @[clearItem, presetItem];

    self.searchBar = [[UISearchBar alloc] initWithFrame:CGRectMake(0, 0, self.view.bounds.size.width, 52)];
    self.searchBar.placeholder = @"搜索软件名称 (如: 钉钉 / 微信 / 高德)...";
    self.searchBar.searchBarStyle = UISearchBarStyleMinimal;
    self.searchBar.delegate = self;

    self.tableView = [[UITableView alloc] initWithFrame:self.view.bounds style:UITableViewStyleInsetGrouped];
    self.tableView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    self.tableView.backgroundColor = [UIColor clearColor];
    self.tableView.delegate = self;
    self.tableView.dataSource = self;
    self.tableView.tableHeaderView = self.searchBar;
    self.tableView.keyboardDismissMode = UIScrollViewKeyboardDismissModeOnDrag;
    [self.view addSubview:self.tableView];

    [self loadInstalledApplications];
}

- (void)loadInstalledApplications {
    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0), ^{
        NSMutableArray<NSDictionary *> *loaded = [NSMutableArray array];
        @try {
            Class wsCls = objc_getClass("LSApplicationWorkspace");
            LSApplicationWorkspace *ws = (wsCls && [wsCls respondsToSelector:@selector(defaultWorkspace)]) ? [wsCls defaultWorkspace] : nil;
            NSArray<LSApplicationProxy *> *proxies = [ws respondsToSelector:@selector(allInstalledApplications)] ? [ws allInstalledApplications] : @[];

            for (LSApplicationProxy *proxy in proxies) {
                NSString *bundleID = proxy.applicationIdentifier;
                if (!bundleID || bundleID.length == 0) continue;
                if ([bundleID hasPrefix:@"com.apple.springboard"] || [bundleID hasPrefix:@"com.apple.WebKit"] || [bundleID containsString:@"watchkit"]) continue;
                if ([proxy respondsToSelector:@selector(appTags)]) {
                    NSArray *tags = [proxy appTags];
                    if ([tags isKindOfClass:[NSArray class]] && [tags containsObject:@"hidden"]) continue;
                }

                NSString *name = [proxy localizedName];
                if (!name || name.length == 0) name = bundleID;
                NSString *appType = [proxy respondsToSelector:@selector(applicationType)] ? ([proxy applicationType] ?: @"User") : @"User";
                BOOL isSystem = [appType isEqualToString:@"System"] || [bundleID hasPrefix:@"com.apple."];

                [loaded addObject:@{
                    @"bundleID": bundleID,
                    @"name": name,
                    @"isSystem": @(isSystem)
                }];
            }
        } @catch (NSException *e) {}

        [loaded sortUsingComparator:^NSComparisonResult(NSDictionary *a, NSDictionary *b) {
            return [a[@"name"] localizedStandardCompare:b[@"name"]];
        }];

        dispatch_async(dispatch_get_main_queue(), ^{
            self.allApps = loaded;
            [self rebuildFilteredSections];
        });
    });
}

- (void)rebuildFilteredSections {
    NSMutableArray *secSelected = [NSMutableArray array];
    NSMutableArray *secUser     = [NSMutableArray array];
    NSMutableArray *secSystem   = [NSMutableArray array];
    NSString *kw = [self.searchKeyword lowercaseString];

    for (NSDictionary *app in self.allApps) {
        NSString *bid  = app[@"bundleID"];
        NSString *name = app[@"name"];
        if (kw.length > 0) {
            if (![[name lowercaseString] containsString:kw] && ![[bid lowercaseString] containsString:kw]) {
                continue;
            }
        }
        if ([self.selectedBundleIDs containsObject:bid]) {
            [secSelected addObject:app];
        } else if (![app[@"isSystem"] boolValue]) {
            [secUser addObject:app];
        } else {
            [secSystem addObject:app];
        }
    }

    self.selectedSectionApps = secSelected;
    self.userSectionApps     = secUser;
    self.systemSectionApps   = secSystem;
    [self.tableView reloadData];
}

- (void)persistSelectedApps {
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_LocSpoof_TargetApps"] = [self.selectedBundleIDs allObjects];
    saveGeminiPrefs(p);
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);
    if (self.onSelectionChanged) {
        self.onSelectionChanged(self.selectedBundleIDs.count);
    }
}

- (void)selectAttendancePreset {
    NSArray *presets = @[
        @"com.laiwang.DingTalk",
        @"com.tencent.wework",
        @"com.bytedance.ee.lark",
        @"com.electron.lark",
        @"com.weaver.emobile7",
        @"com.seeyon.cmp",
        @"com.beisen.italent",
        @"com.tencent.xin",
        @"com.tencent.mqq",
        @"com.xingin.discover",
        @"com.ss.iphone.ugc.Aweme",
        @"com.sina.weibo",
        @"com.meituan.imeituan",
        @"com.autonavi.amap",
        @"com.baidu.BaiduMobileMap",
        @"com.eyemore.TodayCamera",
        @"com.water.camera"
    ];
    for (NSString *bid in presets) {
        [self.selectedBundleIDs addObject:bid];
    }
    [self persistSelectedApps];
    [self rebuildFilteredSections];
    [[AGGlobalActionPillWindow sharedPill] showActionPill:@"⚡ 已勾选常用打卡、社交与地图软件"];
}

- (void)clearAllSelection {
    [self.selectedBundleIDs removeAllObjects];
    [self persistSelectedApps];
    [self rebuildFilteredSections];
}

- (void)searchBar:(UISearchBar *)searchBar textDidChange:(NSString *)searchText {
    self.searchKeyword = [searchText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    [self rebuildFilteredSections];
}

- (NSInteger)numberOfSectionsInTableView:(UITableView *)tableView {
    return 3;
}

- (NSString *)tableView:(UITableView *)tableView titleForHeaderInSection:(NSInteger)section {
    if (section == 0) return [NSString stringWithFormat:@"✅ 已勾选生效的软件 (%lu)", (unsigned long)self.selectedSectionApps.count];
    if (section == 1) return [NSString stringWithFormat:@"📲 手机安装的软件 (%lu)", (unsigned long)self.userSectionApps.count];
    return [NSString stringWithFormat:@"⚙️ 系统自带软件 (%lu)", (unsigned long)self.systemSectionApps.count];
}

- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section {
    if (section == 0) return self.selectedSectionApps.count;
    if (section == 1) return self.userSectionApps.count;
    return self.systemSectionApps.count;
}

- (NSDictionary *)appDictAtIndexPath:(NSIndexPath *)indexPath {
    if (indexPath.section == 0) return self.selectedSectionApps[indexPath.row];
    if (indexPath.section == 1) return self.userSectionApps[indexPath.row];
    return self.systemSectionApps[indexPath.row];
}

- (UITableViewCell *)tableView:(UITableView *)tableView cellForRowAtIndexPath:(NSIndexPath *)indexPath {
    static NSString * const kAppCellID = @"AGAppScopeCell";
    UITableViewCell *cell = [tableView dequeueReusableCellWithIdentifier:kAppCellID];
    if (!cell) {
        cell = [[UITableViewCell alloc] initWithStyle:UITableViewCellStyleSubtitle reuseIdentifier:kAppCellID];
        cell.backgroundColor = [UIColor colorWithRed:0.11 green:0.13 blue:0.20 alpha:0.92];
        cell.textLabel.textColor = [UIColor whiteColor];
        cell.textLabel.font = [UIFont systemFontOfSize:15.0 weight:UIFontWeightSemibold];
        cell.detailTextLabel.textColor = [UIColor colorWithWhite:0.65 alpha:1.0];
        cell.detailTextLabel.font = [UIFont systemFontOfSize:11.5];
    }

    NSDictionary *app = [self appDictAtIndexPath:indexPath];
    NSString *bid = app[@"bundleID"];
    cell.textLabel.text = app[@"name"];
    cell.detailTextLabel.text = bid;

    NSCache *iconCache = [AGAppScopePickerViewController sharedIconCache];
    UIImage *icon = [iconCache objectForKey:bid];
    if (!icon && [UIImage respondsToSelector:@selector(_applicationIconImageForBundleIdentifier:format:scale:)]) {
        icon = [UIImage _applicationIconImageForBundleIdentifier:bid format:0 scale:[UIScreen mainScreen].scale];
        if (icon) [iconCache setObject:icon forKey:bid];
    }
    cell.imageView.image = icon;
    cell.imageView.layer.cornerRadius = 7.0;
    cell.imageView.layer.masksToBounds = YES;

    UISwitch *sw = [[UISwitch alloc] init];
    sw.onTintColor = [UIColor colorWithRed:0.18 green:0.88 blue:0.62 alpha:1.0];
    sw.on = [self.selectedBundleIDs containsObject:bid];
    sw.accessibilityIdentifier = bid;
    [sw addTarget:self action:@selector(appSwitchToggled:) forControlEvents:UIControlEventValueChanged];
    cell.accessoryView = sw;

    return cell;
}

- (void)appSwitchToggled:(UISwitch *)sender {
    NSString *bid = sender.accessibilityIdentifier;
    if (!bid) return;
    if (sender.isOn) {
        [self.selectedBundleIDs addObject:bid];
    } else {
        [self.selectedBundleIDs removeObject:bid];
    }
    [self persistSelectedApps];
    [self rebuildFilteredSections];
}

- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)indexPath {
    [tableView deselectRowAtIndexPath:indexPath animated:YES];
    NSDictionary *app = [self appDictAtIndexPath:indexPath];
    NSString *bid = app[@"bundleID"];
    if ([self.selectedBundleIDs containsObject:bid]) {
        [self.selectedBundleIDs removeObject:bid];
    } else {
        [self.selectedBundleIDs addObject:bid];
    }
    [self persistSelectedApps];
    [self rebuildFilteredSections];
}

@end

// ==================== 📍 虚拟定位主控面板 (跨进程实时蓝点 + 轨迹线 + 直观生效感知) ====================
@interface AGLocationSpoofSettingsViewController : UIViewController <UITableViewDelegate, UITableViewDataSource, UITextFieldDelegate, MKMapViewDelegate, UISearchBarDelegate>
@property (nonatomic, strong) UITableView *tableView;
@property (nonatomic, strong) UIView *mapHeaderCard;
@property (nonatomic, strong) MKMapView *mapView;
@property (nonatomic, strong) AGGaodeTileOverlay *gaodeTileOverlay;
@property (nonatomic, strong) MKPointAnnotation *currentSpoofAnnotation;
@property (nonatomic, strong) MKPolyline *routeLineOverlay;
@property (nonatomic, strong) UISearchBar *mapSearchBar;
@property (nonatomic, strong) UILabel *centerPinView;
@property (nonatomic, strong) UILabel *mapCenterAddressLabel;
@property (nonatomic, strong) UIButton *confirmPinButton;
@property (nonatomic, strong) UIButton *expandMapButton;
@property (nonatomic, assign) BOOL isMapExpanded;
@property (nonatomic, assign) CLLocationCoordinate2D previewCenterCoord;
@property (nonatomic, copy) NSString *previewPlaceName;
@property (nonatomic, strong) CLGeocoder *reverseGeocoder;
@property (nonatomic, strong) UITextField *ssidInputField;
@property (nonatomic, strong) UITextField *bssidInputField;
- (void)onRealtimeLocTickUpdate;
@end

static void agSettingsPanelTickDarwinCallback(CFNotificationCenterRef center, void *observer, CFStringRef name, const void *object, CFDictionaryRef userInfo) {
    AGLocationSpoofSettingsViewController *vc = (__bridge AGLocationSpoofSettingsViewController *)observer;
    dispatch_async(dispatch_get_main_queue(), ^{
        [vc onRealtimeLocTickUpdate];
    });
}

@implementation AGLocationSpoofSettingsViewController

- (void)viewDidLoad {
    [super viewDidLoad];
    self.title = @"📍 虚拟定位中心";
    self.view.backgroundColor = [UIColor colorWithRed:0.05 green:0.06 blue:0.11 alpha:1.0];
    if (@available(iOS 13.0, *)) {
        self.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
    }

    self.reverseGeocoder = [[CLGeocoder alloc] init];

    UIBarButtonItem *closeItem = [[UIBarButtonItem alloc] initWithTitle:@"完成" style:UIBarButtonItemStyleDone target:self action:@selector(dismissSelf)];
    self.navigationItem.rightBarButtonItem = closeItem;

    self.tableView = [[UITableView alloc] initWithFrame:self.view.bounds style:UITableViewStyleInsetGrouped];
    self.tableView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    self.tableView.backgroundColor = [UIColor clearColor];
    self.tableView.delegate = self;
    self.tableView.dataSource = self;
    self.tableView.keyboardDismissMode = UIScrollViewKeyboardDismissModeOnDrag;
    [self.view addSubview:self.tableView];

    [self setupInteractiveMapHeader];

    CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(),
                                    (__bridge const void *)(self),
                                    agSettingsPanelTickDarwinCallback,
                                    (__bridge CFStringRef)kAGLocTickUIUpdateNotification,
                                    NULL,
                                    CFNotificationSuspensionBehaviorDeliverImmediately);
}

- (void)dealloc {
    CFNotificationCenterRemoveObserver(CFNotificationCenterGetDarwinNotifyCenter(),
                                       (__bridge const void *)(self),
                                       (__bridge CFStringRef)kAGLocTickUIUpdateNotification,
                                       NULL);
    [[NSNotificationCenter defaultCenter] removeObserver:self];
}

- (void)setupInteractiveMapHeader {
    CGFloat w = self.view.bounds.size.width;
    if (w < 200.0) w = [UIScreen mainScreen].bounds.size.width;
    CGFloat mapCardH = self.isMapExpanded ? 460.0 : 315.0;

    UIView *headerWrapper = [[UIView alloc] initWithFrame:CGRectMake(0, 0, w, mapCardH + 16.0)];
    headerWrapper.backgroundColor = [UIColor clearColor];

    self.mapHeaderCard = [[UIView alloc] initWithFrame:CGRectMake(16.0, 8.0, w - 32.0, mapCardH)];
    self.mapHeaderCard.autoresizingMask = UIViewAutoresizingFlexibleWidth;
    self.mapHeaderCard.backgroundColor = [UIColor colorWithRed:0.10 green:0.12 blue:0.19 alpha:0.96];
    self.mapHeaderCard.layer.cornerRadius = 22.0;
    self.mapHeaderCard.layer.masksToBounds = YES;
    self.mapHeaderCard.layer.borderWidth = 1.2;
    self.mapHeaderCard.layer.borderColor = [UIColor colorWithRed:0.25 green:0.85 blue:1.0 alpha:0.42].CGColor;
    [headerWrapper addSubview:self.mapHeaderCard];

    CGFloat cardW = self.mapHeaderCard.bounds.size.width;

    self.mapSearchBar = [[UISearchBar alloc] initWithFrame:CGRectMake(6.0, 4.0, cardW - 92.0, 44.0)];
    self.mapSearchBar.autoresizingMask = UIViewAutoresizingFlexibleWidth;
    self.mapSearchBar.placeholder = @"🔍 搜地点 (如: 海口宜家 / 科兴科学园)";
    self.mapSearchBar.searchBarStyle = UISearchBarStyleMinimal;
    self.mapSearchBar.returnKeyType = UIReturnKeySearch;
    self.mapSearchBar.delegate = self;
    [self.mapHeaderCard addSubview:self.mapSearchBar];

    self.expandMapButton = [UIButton buttonWithType:UIButtonTypeSystem];
    self.expandMapButton.frame = CGRectMake(cardW - 82.0, 10.0, 72.0, 32.0);
    self.expandMapButton.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin;
    self.expandMapButton.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.12];
    self.expandMapButton.layer.cornerRadius = 16.0;
    [self.expandMapButton setTitle:(self.isMapExpanded ? @"🗕 收起地图" : @"⛶ 放大地图") forState:UIControlStateNormal];
    [self.expandMapButton setTitleColor:[UIColor colorWithRed:0.45 green:0.92 blue:1.0 alpha:1.0] forState:UIControlStateNormal];
    self.expandMapButton.titleLabel.font = [UIFont systemFontOfSize:12.0 weight:UIFontWeightSemibold];
    [self.expandMapButton addTarget:self action:@selector(toggleMapSizeTapped) forControlEvents:UIControlEventTouchUpInside];
    [self.mapHeaderCard addSubview:self.expandMapButton];

    CGFloat mapY = 50.0;
    CGFloat mapH = mapCardH - mapY - 56.0;
    self.mapView = [[MKMapView alloc] initWithFrame:CGRectMake(0, mapY, cardW, mapH)];
    self.mapView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    self.mapView.delegate = self;
    self.mapView.showsUserLocation = NO;
    self.mapView.rotateEnabled = NO;

    self.gaodeTileOverlay = [[AGGaodeTileOverlay alloc] init];
    self.gaodeTileOverlay.canReplaceMapContent = YES;
    self.gaodeTileOverlay.minimumZ = 3;
    self.gaodeTileOverlay.maximumZ = 18;
    [self.mapView addOverlay:self.gaodeTileOverlay level:MKOverlayLevelAboveLabels];
    [self.mapHeaderCard addSubview:self.mapView];

    self.centerPinView = [[UILabel alloc] initWithFrame:CGRectMake((cardW - 44.0) * 0.5, mapY + (mapH * 0.5) - 34.0, 44.0, 44.0)];
    self.centerPinView.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleRightMargin | UIViewAutoresizingFlexibleTopMargin | UIViewAutoresizingFlexibleBottomMargin;
    self.centerPinView.text = @"📍";
    self.centerPinView.font = [UIFont systemFontOfSize:34.0];
    self.centerPinView.textAlignment = NSTextAlignmentCenter;
    self.centerPinView.userInteractionEnabled = NO;
    [self.mapHeaderCard addSubview:self.centerPinView];

    UIView *bottomBar = [[UIView alloc] initWithFrame:CGRectMake(0, mapCardH - 56.0, cardW, 56.0)];
    bottomBar.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleTopMargin;
    bottomBar.backgroundColor = [UIColor colorWithRed:0.08 green:0.10 blue:0.16 alpha:0.98];
    [self.mapHeaderCard addSubview:bottomBar];

    self.mapCenterAddressLabel = [[UILabel alloc] initWithFrame:CGRectMake(12.0, 6.0, cardW - 148.0, 44.0)];
    self.mapCenterAddressLabel.autoresizingMask = UIViewAutoresizingFlexibleWidth;
    self.mapCenterAddressLabel.textColor = [UIColor colorWithWhite:0.92 alpha:1.0];
    self.mapCenterAddressLabel.font = [UIFont systemFontOfSize:12.0 weight:UIFontWeightMedium];
    self.mapCenterAddressLabel.numberOfLines = 2;
    self.mapCenterAddressLabel.text = @"👆 拖动地图让 📍 对准目标，点击右侧生效";
    [bottomBar addSubview:self.mapCenterAddressLabel];

    self.confirmPinButton = [UIButton buttonWithType:UIButtonTypeSystem];
    self.confirmPinButton.frame = CGRectMake(cardW - 130.0, 10.0, 120.0, 36.0);
    self.confirmPinButton.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin;
    self.confirmPinButton.layer.cornerRadius = 18.0;
    [self.confirmPinButton setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
    self.confirmPinButton.titleLabel.font = [UIFont boldSystemFontOfSize:13.0];
    [self.confirmPinButton addTarget:self action:@selector(confirmMapPinTapped) forControlEvents:UIControlEventTouchUpInside];
    [bottomBar addSubview:self.confirmPinButton];

    self.tableView.tableHeaderView = headerWrapper;

    reloadGeminiPrefsCache();
    NSDictionary *p = agReadOnlyPrefs();
    double savedWGS84Lat = [p[@"AG_LocSpoof_Lat"] doubleValue];
    double savedWGS84Lon = [p[@"AG_LocSpoof_Lon"] doubleValue];
    CLLocationCoordinate2D initGCJ = CLLocationCoordinate2DMake(39.908722, 116.397499);
    if (fabs(savedWGS84Lat) > 0.01 || fabs(savedWGS84Lon) > 0.01) {
        initGCJ = agWGS84ToGCJ02(savedWGS84Lat, savedWGS84Lon);
        self.previewPlaceName = p[@"AG_LocSpoof_Name"] ?: @"已选位置";
        self.mapCenterAddressLabel.text = [NSString stringWithFormat:@"🎯 准星指向：%@", self.previewPlaceName];
    } else {
        self.previewPlaceName = @"北京天安门";
    }
    self.previewCenterCoord = initGCJ;
    MKCoordinateRegion region = MKCoordinateRegionMakeWithDistance(initGCJ, 900, 900);
    [self.mapView setRegion:region animated:NO];

    [self updateConfirmButtonAppearance];
    [self updateLiveMapBlueDotAndRoute];
}

- (void)updateConfirmButtonAppearance {
    NSDictionary *p = agReadOnlyPrefs();
    NSInteger moveMode = p[@"AG_LocSpoof_MoveMode"] ? [p[@"AG_LocSpoof_MoveMode"] integerValue] : 0;
    if (moveMode == 1) {
        [self.confirmPinButton setTitle:@"🚶 走路去这里" forState:UIControlStateNormal];
        self.confirmPinButton.backgroundColor = [UIColor colorWithRed:0.18 green:0.80 blue:0.55 alpha:1.0];
    } else if (moveMode == 2) {
        [self.confirmPinButton setTitle:@"🚗 开车去这里" forState:UIControlStateNormal];
        self.confirmPinButton.backgroundColor = [UIColor colorWithRed:0.95 green:0.56 blue:0.18 alpha:1.0];
    } else {
        [self.confirmPinButton setTitle:@"⚡ 瞬移到这里" forState:UIControlStateNormal];
        self.confirmPinButton.backgroundColor = [UIColor colorWithRed:0.15 green:0.75 blue:0.98 alpha:1.0];
    }
}

- (void)updateLiveMapBlueDotAndRoute {
    reloadGeminiPrefsCache();
    NSDictionary *p = agReadOnlyPrefs();
    BOOL isActive = NO;
    double curWGS84Lat = 0.0, curWGS84Lon = 0.0, kSpeed = 0.0;
    if (!agReadSpoofStateFromKernel(&isActive, NULL, NULL, NULL, &curWGS84Lat, &curWGS84Lon, NULL, &kSpeed, NULL)) {
        isActive = [p[@"AG_LocSpoof_Active"] boolValue];
        curWGS84Lat = [p[@"AG_LocSpoof_Lat"] doubleValue];
        curWGS84Lon = [p[@"AG_LocSpoof_Lon"] doubleValue];
    }

    if (self.routeLineOverlay) {
        [self.mapView removeOverlay:self.routeLineOverlay];
        self.routeLineOverlay = nil;
    }

    if (!isActive || (fabs(curWGS84Lat) < 0.01 && fabs(curWGS84Lon) < 0.01)) {
        if (self.currentSpoofAnnotation) {
            [self.mapView removeAnnotation:self.currentSpoofAnnotation];
            self.currentSpoofAnnotation = nil;
        }
        return;
    }

    CLLocationCoordinate2D curGCJ = agWGS84ToGCJ02(curWGS84Lat, curWGS84Lon);
    if (!self.currentSpoofAnnotation) {
        self.currentSpoofAnnotation = [[MKPointAnnotation alloc] init];
        [self.mapView addAnnotation:self.currentSpoofAnnotation];
    }
    self.currentSpoofAnnotation.coordinate = curGCJ;

    double targetLat = p[@"AG_LocSpoof_TargetLat"] ? [p[@"AG_LocSpoof_TargetLat"] doubleValue] : curWGS84Lat;
    double targetLon = p[@"AG_LocSpoof_TargetLon"] ? [p[@"AG_LocSpoof_TargetLon"] doubleValue] : curWGS84Lon;
    double remDist = hypot((targetLat - curWGS84Lat) * 111320.0, (targetLon - curWGS84Lon) * 111320.0 * cos(curWGS84Lat * M_PI / 180.0));

    if (kSpeed > 0.1 && remDist > 3.0) {
        CLLocationCoordinate2D destGCJ = agWGS84ToGCJ02(targetLat, targetLon);
        CLLocationCoordinate2D coords[2] = {curGCJ, destGCJ};
        self.routeLineOverlay = [MKPolyline polylineWithCoordinates:coords count:2];
        [self.mapView addOverlay:self.routeLineOverlay level:MKOverlayLevelAboveLabels];
    }
}

- (void)onRealtimeLocTickUpdate {
    if (!self.isViewLoaded || !self.view.window) return;
    [self updateLiveMapBlueDotAndRoute];
    [self.tableView reloadSections:[NSIndexSet indexSetWithIndex:0] withRowAnimation:UITableViewRowAnimationNone];
}

- (MKOverlayRenderer *)mapView:(MKMapView *)mapView rendererForOverlay:(id<MKOverlay>)overlay {
    if ([overlay isKindOfClass:[MKTileOverlay class]]) {
        return [[MKTileOverlayRenderer alloc] initWithTileOverlay:(MKTileOverlay *)overlay];
    }
    if ([overlay isKindOfClass:[MKPolyline class]]) {
        MKPolylineRenderer *lineRenderer = [[MKPolylineRenderer alloc] initWithPolyline:(MKPolyline *)overlay];
        lineRenderer.strokeColor = [UIColor colorWithRed:0.15 green:0.82 blue:0.98 alpha:0.95];
        lineRenderer.lineWidth = 4.0;
        lineRenderer.lineDashPattern = @[@6, @4];
        return lineRenderer;
    }
    return nil;
}

- (MKAnnotationView *)mapView:(MKMapView *)mapView viewForAnnotation:(id<MKAnnotation>)annotation {
    if (annotation == self.currentSpoofAnnotation) {
        static NSString * const kBlueDotID = @"AGSpoofBlueDot";
        MKAnnotationView *av = [mapView dequeueReusableAnnotationViewWithIdentifier:kBlueDotID];
        if (!av) {
            av = [[MKAnnotationView alloc] initWithAnnotation:annotation reuseIdentifier:kBlueDotID];
            av.frame = CGRectMake(0, 0, 26, 26);
            av.backgroundColor = [UIColor colorWithRed:0.12 green:0.75 blue:1.0 alpha:0.28];
            av.layer.cornerRadius = 13.0;
            UIView *core = [[UIView alloc] initWithFrame:CGRectMake(6, 6, 14, 14)];
            core.backgroundColor = [UIColor colorWithRed:0.12 green:0.92 blue:0.65 alpha:1.0];
            core.layer.cornerRadius = 7.0;
            core.layer.borderWidth = 2.2;
            core.layer.borderColor = [UIColor whiteColor].CGColor;
            [av addSubview:core];
        }
        av.annotation = annotation;
        return av;
    }
    return nil;
}

- (void)toggleMapSizeTapped {
    [self.view endEditing:YES];
    self.isMapExpanded = !self.isMapExpanded;
    CLLocationCoordinate2D currentCenter = self.mapView.centerCoordinate;
    [self setupInteractiveMapHeader];
    MKCoordinateRegion region = MKCoordinateRegionMakeWithDistance(currentCenter, 900, 900);
    [self.mapView setRegion:region animated:NO];
}

- (void)mapView:(MKMapView *)mapView regionDidChangeAnimated:(BOOL)animated {
    CLLocationCoordinate2D center = mapView.centerCoordinate;
    self.previewCenterCoord = center;

    self.centerPinView.transform = CGAffineTransformMakeTranslation(0, -8.0);
    [UIView animateWithDuration:0.25 delay:0 usingSpringWithDamping:0.5 initialSpringVelocity:0.8 options:UIViewAnimationOptionCurveEaseOut animations:^{
        self.centerPinView.transform = CGAffineTransformIdentity;
    } completion:nil];

    [self.reverseGeocoder cancelGeocode];
    CLLocationCoordinate2D wgsCenter = agGCJ02ToWGS84Exact(center.latitude, center.longitude);
    CLLocation *loc = [[CLLocation alloc] initWithLatitude:wgsCenter.latitude longitude:wgsCenter.longitude];
    [self.reverseGeocoder reverseGeocodeLocation:loc completionHandler:^(NSArray<CLPlacemark *> * _Nullable placemarks, NSError * _Nullable error) {
        CLPlacemark *pm = placemarks.firstObject;
        if (pm) {
            NSMutableString *addr = [NSMutableString string];
            if (pm.locality) [addr appendString:pm.locality];
            if (pm.subLocality) [addr appendString:pm.subLocality];
            if (pm.thoroughfare) [addr appendString:pm.thoroughfare];
            if (pm.name && ![addr hasSuffix:pm.name]) [addr appendFormat:@" · %@", pm.name];
            NSString *finalName = addr.length > 0 ? addr : (pm.name ?: @"地图选定位置");
            self.previewPlaceName = finalName;
            self.mapCenterAddressLabel.text = [NSString stringWithFormat:@"🎯 准星指向：%@", finalName];
        } else {
            self.previewPlaceName = [NSString stringWithFormat:@"地图选点 (%.4f, %.4f)", center.latitude, center.longitude];
            self.mapCenterAddressLabel.text = [NSString stringWithFormat:@"🎯 准星指向：%.5f, %.5f", center.latitude, center.longitude];
        }
    }];
}

- (void)searchBarSearchButtonClicked:(UISearchBar *)searchBar {
    [searchBar resignFirstResponder];
    NSString *query = [searchBar.text stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (query.length == 0) return;

    NSDictionary *landmarks = [[AGLocationSpoofManager sharedSpoofer] builtinFamousLandmarksGCJ02];
    if (landmarks[query]) {
        NSArray<NSNumber *> *pair = landmarks[query];
        CLLocationCoordinate2D coord = CLLocationCoordinate2DMake([pair[0] doubleValue], [pair[1] doubleValue]);
        self.previewCenterCoord = coord;
        self.previewPlaceName = query;
        MKCoordinateRegion region = MKCoordinateRegionMakeWithDistance(coord, 800, 800);
        [self.mapView setRegion:region animated:YES];
        self.mapCenterAddressLabel.text = [NSString stringWithFormat:@"🎯 已找到：%@ (点右侧按钮生效)", query];
        return;
    }

    self.mapCenterAddressLabel.text = [NSString stringWithFormat:@"⏳ 正在搜索「%@」...", query];
    MKLocalSearchRequest *req = [[MKLocalSearchRequest alloc] init];
    req.naturalLanguageQuery = query;
    MKLocalSearch *search = [[MKLocalSearch alloc] initWithRequest:req];
    [search startWithCompletionHandler:^(MKLocalSearchResponse * _Nullable response, NSError * _Nullable error) {
        dispatch_async(dispatch_get_main_queue(), ^{
            if (response.mapItems.count == 0) {
                [[AGGlobalActionPillWindow sharedPill] showActionPill:@"⚠️ 未搜到该地点，请换个关键词试试"];
                self.mapCenterAddressLabel.text = @"⚠️ 未找到匹配地点，请尝试输入城市+地名";
                return;
            }
            if (response.mapItems.count == 1) {
                MKMapItem *item = response.mapItems.firstObject;
                CLLocationCoordinate2D coord = item.placemark.location.coordinate;
                self.previewCenterCoord = coord;
                self.previewPlaceName = item.name ?: query;
                MKCoordinateRegion region = MKCoordinateRegionMakeWithDistance(coord, 800, 800);
                [self.mapView setRegion:region animated:YES];
                self.mapCenterAddressLabel.text = [NSString stringWithFormat:@"🎯 已找到：%@ (点右侧按钮生效)", self.previewPlaceName];
            } else {
                UIAlertController *sheet = [UIAlertController alertControllerWithTitle:[NSString stringWithFormat:@"🔍「%@」搜索结果", query]
                                                                               message:@"点击选择具体地点，将自动移动过去并生效"
                                                                        preferredStyle:UIAlertControllerStyleActionSheet];
                NSUInteger count = MIN((NSUInteger)8, response.mapItems.count);
                for (NSUInteger i = 0; i < count; i++) {
                    MKMapItem *item = response.mapItems[i];
                    NSString *sub = item.placemark.thoroughfare ?: (item.placemark.locality ?: @"");
                    NSString *title = sub.length > 0 ? [NSString stringWithFormat:@"📍 %@ (%@)", item.name, sub] : [NSString stringWithFormat:@"📍 %@", item.name];
                    [sheet addAction:[UIAlertAction actionWithTitle:title style:UIAlertActionStyleDefault handler:^(UIAlertAction * _Nonnull action) {
                        CLLocationCoordinate2D coord = item.placemark.location.coordinate;
                        self.previewCenterCoord = coord;
                        self.previewPlaceName = item.name ?: query;
                        MKCoordinateRegion region = MKCoordinateRegionMakeWithDistance(coord, 600, 600);
                        [self.mapView setRegion:region animated:YES];
                        self.mapCenterAddressLabel.text = [NSString stringWithFormat:@"🎯 已选：%@", self.previewPlaceName];
                        [[AGLocationSpoofManager sharedSpoofer] pinLocationWithCoordinate:coord coordSystem:@"GCJ02" placeName:self.previewPlaceName];
                        [self updateLiveMapBlueDotAndRoute];
                        [self.tableView reloadData];
                    }]];
                }
                [sheet addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];
                [self presentViewController:sheet animated:YES completion:nil];
            }
        });
    }];
}

- (void)confirmMapPinTapped {
    [self.view endEditing:YES];
    CLLocationCoordinate2D coord = self.mapView.centerCoordinate;
    NSString *name = self.previewPlaceName.length > 0 ? self.previewPlaceName : @"地图选点位置";
    [[AGLocationSpoofManager sharedSpoofer] pinLocationWithCoordinate:coord coordSystem:@"GCJ02" placeName:name];
    [self updateLiveMapBlueDotAndRoute];
    [self.tableView reloadData];
}

- (void)dismissSelf {
    [self.view endEditing:YES];
    if (self.navigationController && self.navigationController.viewControllers.count > 1) {
        [self.navigationController popViewControllerAnimated:YES];
    } else {
        [self dismissViewControllerAnimated:YES completion:nil];
    }
}

- (NSString *)summaryOfSelectedTargetApps:(NSArray<NSString *> *)bundleIDs {
    if (!bundleIDs || bundleIDs.count == 0) {
        return @"⚠️ 尚未勾选任何软件 (点击立即勾选)";
    }
    NSMutableArray<NSString *> *names = [NSMutableArray array];
    @try {
        Class proxyCls = objc_getClass("LSApplicationProxy");
        for (NSString *bid in bundleIDs) {
            if (names.count >= 3) break;
            if (proxyCls && [proxyCls respondsToSelector:@selector(applicationProxyForIdentifier:)]) {
                LSApplicationProxy *proxy = [proxyCls applicationProxyForIdentifier:bid];
                NSString *locName = [proxy localizedName];
                [names addObject:(locName.length > 0 ? locName : bid)];
            } else {
                [names addObject:bid];
            }
        }
    } @catch (NSException *e) {}
    NSString *joined = [names componentsJoinedByString:@"、"];
    if (bundleIDs.count > 3) {
        return [NSString stringWithFormat:@"%@ 等 %lu 款软件", joined, (unsigned long)bundleIDs.count];
    }
    return [NSString stringWithFormat:@"%@ (共 %lu 款)", joined, (unsigned long)bundleIDs.count];
}

#pragma mark - 极简 3 分组通俗化表格数据源

- (NSInteger)numberOfSectionsInTableView:(UITableView *)tableView {
    return 3;
}

- (NSString *)tableView:(UITableView *)tableView titleForHeaderInSection:(NSInteger)section {
    switch (section) {
        case 0: return @"🛰️ 1. 实时定位状态与总开关";
        case 1: return @"🎯 2. 生效软件与移动方式";
        case 2: return @"🛡️ 3. 打卡与社交防检测保护";
    }
    return @"";
}

- (NSString *)tableView:(UITableView *)tableView titleForFooterInSection:(NSInteger)section {
    if (section == 0) return @"提示：地图上的绿色圆点 🟢 代表你当前已生效的虚拟位置；打开受控软件时，屏幕顶部会弹出绿色胶囊提示定位已接管。";
    if (section == 1) return @"• 选「所有软件」时全机生效；选「仅选中的软件」时只对你勾选的软件生效。\n• 选「走路过去」或「开车过去」再点击地图定位按钮，可在地图上直观看到你的位置沿虚线走向终点。";
    if (section == 2) return @"开启「防检测保护」后，系统将自动隐藏虚拟定位痕迹、模拟真实卫星微抖动并防止周围真实 Wi-Fi 暴露真实位置。";
    return nil;
}

- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section {
    NSDictionary *p = agReadOnlyPrefs();
    if (section == 0) return 2;
    if (section == 1) return 3;
    if (section == 2) {
        NSInteger wifiMode = p[@"AG_AntiDet_WiFiMode"] ? [p[@"AG_AntiDet_WiFiMode"] integerValue] : 1;
        return (wifiMode == 2) ? 4 : 2;
    }
    return 0;
}

- (UITableViewCell *)makeBaseCellWithStyle:(UITableViewCellStyle)style reuseID:(NSString *)reuseID {
    UITableViewCell *cell = [[UITableViewCell alloc] initWithStyle:style reuseIdentifier:reuseID];
    cell.backgroundColor = [UIColor colorWithRed:0.10 green:0.12 blue:0.19 alpha:0.95];
    cell.textLabel.textColor = [UIColor whiteColor];
    cell.textLabel.font = [UIFont systemFontOfSize:15.0 weight:UIFontWeightMedium];
    cell.detailTextLabel.textColor = [UIColor colorWithRed:0.45 green:0.86 blue:1.0 alpha:0.95];
    cell.detailTextLabel.font = [UIFont systemFontOfSize:12.0];
    cell.selectionStyle = UITableViewCellSelectionStyleNone;
    return cell;
}

- (UITableViewCell *)tableView:(UITableView *)tableView cellForRowAtIndexPath:(NSIndexPath *)indexPath {
    NSDictionary *p = agReadOnlyPrefs();
    BOOL isActive = NO;
    double kLat = 0.0, kLon = 0.0, kSpeed = 0.0;
    agReadSpoofStateFromKernel(&isActive, NULL, NULL, NULL, &kLat, &kLon, NULL, &kSpeed, NULL);
    if (p[@"AG_LocSpoof_Active"] != nil) {
        isActive = [p[@"AG_LocSpoof_Active"] boolValue];
    }
    if (fabs(kLat) < 0.001 && fabs(kLon) < 0.001) {
        kLat = [p[@"AG_LocSpoof_Lat"] doubleValue];
        kLon = [p[@"AG_LocSpoof_Lon"] doubleValue];
    }

    if (indexPath.section == 0) {
        if (indexPath.row == 0) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleSubtitle reuseID:@"S0R0"];
            NSString *place = p[@"AG_LocSpoof_Name"] ?: @"未设定";
            double targetLat = p[@"AG_LocSpoof_TargetLat"] ? [p[@"AG_LocSpoof_TargetLat"] doubleValue] : kLat;
            double targetLon = p[@"AG_LocSpoof_TargetLon"] ? [p[@"AG_LocSpoof_TargetLon"] doubleValue] : kLon;
            double remDist = hypot((targetLat - kLat) * 111320.0, (targetLon - kLon) * 111320.0 * cos(kLat * M_PI / 180.0));

            if (isActive) {
                if (kSpeed > 0.1 && remDist > 3.0) {
                    NSInteger moveMode = [p[@"AG_LocSpoof_MoveMode"] integerValue];
                    NSString *icon = (moveMode == 2) ? @"🚗 开车前往" : @"🚶 步行前往";
                    int etaSec = (int)ceil(remDist / MAX(0.5, kSpeed));
                    cell.textLabel.text = [NSString stringWithFormat:@"%@：%@", icon, place];
                    cell.textLabel.textColor = [UIColor colorWithRed:0.35 green:0.92 blue:1.0 alpha:1.0];
                    cell.detailTextLabel.text = [NSString stringWithFormat:@"剩余 %.0f 米 · 预计 %d 秒抵达 (地图绿点实时移动中)", remDist, etaSec];

                    UIButton *arriveBtn = [UIButton buttonWithType:UIButtonTypeSystem];
                    arriveBtn.frame = CGRectMake(0, 0, 86, 28);
                    arriveBtn.backgroundColor = [UIColor colorWithRed:0.18 green:0.82 blue:0.58 alpha:0.25];
                    arriveBtn.layer.cornerRadius = 14.0;
                    arriveBtn.layer.borderWidth = 1.0;
                    arriveBtn.layer.borderColor = [UIColor colorWithRed:0.25 green:0.95 blue:0.68 alpha:0.8].CGColor;
                    [arriveBtn setTitle:@"⚡立即抵达" forState:UIControlStateNormal];
                    [arriveBtn setTitleColor:[UIColor colorWithRed:0.35 green:0.98 blue:0.72 alpha:1.0] forState:UIControlStateNormal];
                    arriveBtn.titleLabel.font = [UIFont boldSystemFontOfSize:11.5];
                    [arriveBtn addTarget:self action:@selector(instantArriveTapped) forControlEvents:UIControlEventTouchUpInside];
                    cell.accessoryView = arriveBtn;
                } else {
                    NSInteger scopeMode = [p[@"AG_LocSpoof_ScopeMode"] integerValue];
                    NSArray *targetApps = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];
                    NSString *scopeDesc = (scopeMode == 0) ? @"对全机所有软件生效中" : ((scopeMode == 1) ? [NSString stringWithFormat:@"对已选的 %lu 款软件生效中", (unsigned long)targetApps.count] : @"黑名单排除模式生效中");

                    cell.textLabel.text = [NSString stringWithFormat:@"🟢 已生效：%@", place];
                    cell.textLabel.textColor = [UIColor colorWithRed:0.25 green:0.98 blue:0.65 alpha:1.0];
                    BOOL shieldOn = (p[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [p[@"AG_AntiDet_ShieldEnabled"] boolValue];
                    cell.detailTextLabel.text = [NSString stringWithFormat:@"%@ · %@", scopeDesc, (shieldOn ? @"🛡️防检测保护已开启" : @"⚡日常纯定位模式")];

                    UIButton *resetBtn = [UIButton buttonWithType:UIButtonTypeSystem];
                    resetBtn.frame = CGRectMake(0, 0, 88, 28);
                    resetBtn.backgroundColor = [UIColor colorWithRed:0.95 green:0.32 blue:0.36 alpha:0.22];
                    resetBtn.layer.cornerRadius = 14.0;
                    resetBtn.layer.borderWidth = 1.0;
                    resetBtn.layer.borderColor = [UIColor colorWithRed:1.0 green:0.45 blue:0.48 alpha:0.65].CGColor;
                    [resetBtn setTitle:@"恢复真实位置" forState:UIControlStateNormal];
                    [resetBtn setTitleColor:[UIColor colorWithRed:1.0 green:0.55 blue:0.55 alpha:1.0] forState:UIControlStateNormal];
                    resetBtn.titleLabel.font = [UIFont boldSystemFontOfSize:11.5];
                    [resetBtn addTarget:self action:@selector(restoreRealLocationTapped) forControlEvents:UIControlEventTouchUpInside];
                    cell.accessoryView = resetBtn;
                }
            } else {
                cell.textLabel.text = @"⚪ 当前状态：真实手机 GPS 位置";
                cell.textLabel.textColor = [UIColor colorWithWhite:0.88 alpha:1.0];
                cell.detailTextLabel.text = @"未开启虚拟定位 (点击下方开关或地图右下按钮开启)";
                cell.accessoryView = nil;
            }
            return cell;
        }
        if (indexPath.row == 1) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleDefault reuseID:@"S0R1"];
            cell.textLabel.text = @"开启虚拟定位总开关";
            UISwitch *sw = [[UISwitch alloc] init];
            sw.onTintColor = [UIColor colorWithRed:0.18 green:0.88 blue:0.62 alpha:1.0];
            sw.on = isActive;
            [sw addTarget:self action:@selector(masterSpoofSwitchChanged:) forControlEvents:UIControlEventValueChanged];
            cell.accessoryView = sw;
            return cell;
        }
    }

    if (indexPath.section == 1) {
        NSInteger scopeMode = p[@"AG_LocSpoof_ScopeMode"] ? [p[@"AG_LocSpoof_ScopeMode"] integerValue] : 0;
        NSArray *targetApps = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];

        if (indexPath.row == 0) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleDefault reuseID:@"S1R0"];
            cell.textLabel.text = @"生效范围";
            UISegmentedControl *seg = [[UISegmentedControl alloc] initWithItems:@[@"所有软件", @"仅选中的软件", @"排除选中软件"]];
            seg.selectedSegmentIndex = scopeMode;
            [seg addTarget:self action:@selector(scopeModeSegChanged:) forControlEvents:UIControlEventValueChanged];
            cell.accessoryView = seg;
            return cell;
        }
        if (indexPath.row == 1) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleSubtitle reuseID:@"S1R1"];
            cell.accessoryType = UITableViewCellAccessoryDisclosureIndicator;
            cell.selectionStyle = UITableViewCellSelectionStyleDefault;

            if (scopeMode == 0) {
                cell.textLabel.text = @"🌐 当前对【全机所有软件】生效";
                cell.textLabel.textColor = [UIColor colorWithRed:0.25 green:0.98 blue:0.65 alpha:1.0];
                cell.detailTextLabel.text = @"无需单独勾选，微信/钉钉/高德/抖音等全部生效";
            } else if (scopeMode == 1) {
                cell.textLabel.text = @"🎯 选择要生效的软件 (白名单)";
                cell.textLabel.textColor = (targetApps.count > 0) ? [UIColor whiteColor] : [UIColor colorWithRed:1.0 green:0.55 blue:0.45 alpha:1.0];
                cell.detailTextLabel.text = [NSString stringWithFormat:@"当前生效：%@", [self summaryOfSelectedTargetApps:targetApps]];
            } else {
                cell.textLabel.text = @"🚫 选择要排除的软件 (黑名单)";
                cell.textLabel.textColor = [UIColor whiteColor];
                cell.detailTextLabel.text = [NSString stringWithFormat:@"当前排除：%@", [self summaryOfSelectedTargetApps:targetApps]];
            }
            return cell;
        }
        if (indexPath.row == 2) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleSubtitle reuseID:@"S1R2"];
            NSInteger moveMode = p[@"AG_LocSpoof_MoveMode"] ? [p[@"AG_LocSpoof_MoveMode"] integerValue] : 0;
            cell.textLabel.text = @"到达方式";
            if (moveMode == 0) {
                cell.detailTextLabel.text = @"⚡ 瞬移模式：选点后 0 秒直接跳到目标位置";
            } else if (moveMode == 1) {
                cell.detailTextLabel.text = @"🚶 步行模式：以 1.5米/秒 真人步速沿路线走过去";
            } else {
                cell.detailTextLabel.text = @"🚗 驾车模式：以 45公里/小时 车速沿路线开过去";
            }
            UISegmentedControl *seg = [[UISegmentedControl alloc] initWithItems:@[@"⚡直接瞬移", @"🚶走路过去", @"🚗开车过去"]];
            seg.selectedSegmentIndex = moveMode;
            [seg addTarget:self action:@selector(moveModeSegChanged:) forControlEvents:UIControlEventValueChanged];
            cell.accessoryView = seg;
            return cell;
        }
    }

    if (indexPath.section == 2) {
        BOOL shieldOn = isActive && ((p[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [p[@"AG_AntiDet_ShieldEnabled"] boolValue]);
        NSInteger wifiMode = isActive ? (p[@"AG_AntiDet_WiFiMode"] ? [p[@"AG_AntiDet_WiFiMode"] integerValue] : 0) : 0;
        if (indexPath.row == 0) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleSubtitle reuseID:@"S2R0"];
            cell.textLabel.text = @"开启防检测保护 (打卡时按需开启)";
            cell.textLabel.alpha = isActive ? 1.0 : 0.45;
            cell.detailTextLabel.text = isActive
                ? @"自动隐藏模拟标记 + 模拟卫星微波动 + 气压/步数闭环 + 防Wi-Fi穿帮"
                : @"⚠️ 请先开启上方「虚拟定位总开关」后才可开启防检测";
            UISwitch *sw = [[UISwitch alloc] init];
            sw.onTintColor = [UIColor colorWithRed:0.15 green:0.82 blue:0.98 alpha:1.0];
            sw.on = shieldOn;
            sw.enabled = isActive;
            [sw addTarget:self action:@selector(stealthShieldSwitchChanged:) forControlEvents:UIControlEventValueChanged];
            cell.accessoryView = sw;
            return cell;
        }
        if (indexPath.row == 1) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleSubtitle reuseID:@"S2R1"];
            cell.textLabel.text = @"伪装连接的公司/指定 Wi-Fi";
            cell.textLabel.alpha = isActive ? 1.0 : 0.45;
            cell.detailTextLabel.text = isActive
                ? @"需要连特定 Wi-Fi 打卡时开启，平时无需开启"
                : @"⚠️ 需先开启虚拟定位总开关";
            UISwitch *sw = [[UISwitch alloc] init];
            sw.onTintColor = [UIColor colorWithRed:0.15 green:0.82 blue:0.98 alpha:1.0];
            sw.on = (wifiMode == 2);
            sw.enabled = isActive;
            [sw addTarget:self action:@selector(customWiFiSwitchChanged:) forControlEvents:UIControlEventValueChanged];
            cell.accessoryView = sw;
            return cell;
        }
        if (indexPath.row == 2) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleDefault reuseID:@"S2R2"];
            cell.textLabel.text = @"伪装 Wi-Fi 名称";
            self.ssidInputField = [[UITextField alloc] initWithFrame:CGRectMake(0, 0, 175, 30)];
            self.ssidInputField.placeholder = @"选填 (如: Office-5G)";
            self.ssidInputField.textAlignment = NSTextAlignmentRight;
            self.ssidInputField.textColor = [UIColor colorWithRed:0.45 green:0.92 blue:1.0 alpha:1.0];
            self.ssidInputField.returnKeyType = UIReturnKeyDone;
            self.ssidInputField.delegate = self;
            self.ssidInputField.text = p[@"AG_AntiDet_FakeSSID"] ?: @"";
            [self.ssidInputField addTarget:self action:@selector(wifiTextFieldEdited) forControlEvents:UIControlEventEditingDidEnd];
            cell.accessoryView = self.ssidInputField;
            return cell;
        }
        if (indexPath.row == 3) {
            UITableViewCell *cell = [self makeBaseCellWithStyle:UITableViewCellStyleDefault reuseID:@"S2R3"];
            cell.textLabel.text = @"伪装路由器地址 (MAC)";
            self.bssidInputField = [[UITextField alloc] initWithFrame:CGRectMake(0, 0, 175, 30)];
            self.bssidInputField.placeholder = @"选填 (如: a4:50:46:12:34:56)";
            self.bssidInputField.textAlignment = NSTextAlignmentRight;
            self.bssidInputField.textColor = [UIColor colorWithRed:0.45 green:0.92 blue:1.0 alpha:1.0];
            self.bssidInputField.returnKeyType = UIReturnKeyDone;
            self.bssidInputField.delegate = self;
            self.bssidInputField.text = p[@"AG_AntiDet_FakeBSSID"] ?: @"";
            [self.bssidInputField addTarget:self action:@selector(wifiTextFieldEdited) forControlEvents:UIControlEventEditingDidEnd];
            cell.accessoryView = self.bssidInputField;
            return cell;
        }
    }

    return [[UITableViewCell alloc] init];
}

- (void)instantArriveTapped {
    [[AGLocationSpoofManager sharedSpoofer] teleportImmediatelyToCurrentTarget];
    [self updateLiveMapBlueDotAndRoute];
    [self.tableView reloadData];
}

- (void)restoreRealLocationTapped {
    [[AGLocationSpoofManager sharedSpoofer] stopAndResetToRealLocation];
    [self updateLiveMapBlueDotAndRoute];
    [self.tableView reloadData];
}

- (void)masterSpoofSwitchChanged:(UISwitch *)sender {
    if (sender.isOn) {
        [self confirmMapPinTapped];
    } else {
        [[AGLocationSpoofManager sharedSpoofer] stopAndResetToRealLocation];
        [self updateLiveMapBlueDotAndRoute];
        [self.tableView reloadData];
    }
}

- (void)scopeModeSegChanged:(UISegmentedControl *)seg {
    NSMutableDictionary *p = loadGeminiPrefs();
    NSInteger mode = seg.selectedSegmentIndex;
    p[@"AG_LocSpoof_ScopeMode"] = @(mode);

    NSArray *targetApps = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];
    if (mode == 1 && targetApps.count == 0) {
        NSArray *defaultPresets = @[
            @"com.laiwang.DingTalk",
            @"com.tencent.wework",
            @"com.bytedance.ee.lark",
            @"com.electron.lark",
            @"com.weaver.emobile7",
            @"com.seeyon.cmp",
            @"com.beisen.italent",
            @"com.tencent.xin",
            @"com.autonavi.amap",
            @"com.baidu.BaiduMobileMap",
            @"com.eyemore.TodayCamera",
            @"com.water.camera"
        ];
        p[@"AG_LocSpoof_TargetApps"] = defaultPresets;
        [[AGGlobalActionPillWindow sharedPill] showActionPill:@"🎯 已自动勾选微信、钉钉、高德等常用软件"];
    }

    saveGeminiPrefs(p);
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);
    [self.tableView reloadData];
}

- (void)moveModeSegChanged:(UISegmentedControl *)seg {
    NSMutableDictionary *p = loadGeminiPrefs();
    NSInteger mode = seg.selectedSegmentIndex;
    p[@"AG_LocSpoof_MoveMode"] = @(mode);
    saveGeminiPrefs(p);
    [self updateConfirmButtonAppearance];
    [self.tableView reloadSections:[NSIndexSet indexSetWithIndex:1] withRowAnimation:UITableViewRowAnimationNone];

    if (mode == 0) {
        [[AGLocationSpoofManager sharedSpoofer] teleportImmediatelyToCurrentTarget];
        [self updateLiveMapBlueDotAndRoute];
        [self.tableView reloadData];
    } else {
        NSString *tip = (mode == 1) ? @"🚶 已切为步行模式：拖动地图点「走路去这里」即可开始移动" : @"🚗 已切为开车模式：拖动地图点「开车去这里」即可开始移动";
        [[AGGlobalActionPillWindow sharedPill] showActionPill:tip];
    }
}

- (void)stealthShieldSwitchChanged:(UISwitch *)sender {
    NSMutableDictionary *p = loadGeminiPrefs();
    BOOL on = sender.isOn;
    p[@"AG_AntiDet_ShieldEnabled"] = @(on);
    p[@"AG_AntiDet_HideSimFlag"] = @(on);
    p[@"AG_AntiDet_MotionSync"] = @(on);
    p[@"AG_AntiDet_HideHookPtr"] = @(on);
    p[@"AG_LocSpoof_JitterEnabled"] = @(on);
    if (!on) {
        p[@"AG_AntiDet_WiFiMode"] = @0;
    }
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);
    [self.tableView reloadData];
}

- (void)customWiFiSwitchChanged:(UISwitch *)sender {
    NSMutableDictionary *p = loadGeminiPrefs();
    if (sender.isOn) {
        p[@"AG_AntiDet_ShieldEnabled"] = @YES;
        p[@"AG_AntiDet_HideSimFlag"] = @YES;
        p[@"AG_AntiDet_MotionSync"] = @YES;
        p[@"AG_AntiDet_WiFiMode"] = @2;
    } else {
        p[@"AG_AntiDet_WiFiMode"] = @0;
    }
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                         NULL, NULL, YES);
    [self.tableView reloadSections:[NSIndexSet indexSetWithIndex:2] withRowAnimation:UITableViewRowAnimationAutomatic];
}

- (void)wifiTextFieldEdited {
    NSMutableDictionary *p = loadGeminiPrefs();
    if (self.ssidInputField) p[@"AG_AntiDet_FakeSSID"] = self.ssidInputField.text ?: @"";
    if (self.bssidInputField) p[@"AG_AntiDet_FakeBSSID"] = self.bssidInputField.text ?: @"";
    saveGeminiPrefs(p);
}

- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)indexPath {
    [tableView deselectRowAtIndexPath:indexPath animated:YES];
    [self.view endEditing:YES];

    if (indexPath.section == 1 && indexPath.row == 1) {
        AGAppScopePickerViewController *picker = [[AGAppScopePickerViewController alloc] init];
        picker.onSelectionChanged = ^(NSUInteger count) {
            [self.tableView reloadData];
        };
        if (self.navigationController) {
            [self.navigationController pushViewController:picker animated:YES];
        } else {
            UINavigationController *nav = [[UINavigationController alloc] initWithRootViewController:picker];
            [self presentViewController:nav animated:YES completion:nil];
        }
    }
}

- (BOOL)textFieldShouldReturn:(UITextField *)textField {
    [textField resignFirstResponder];
    [self wifiTextFieldEdited];
    return YES;
}

@end

static BOOL isDeviceCurrentlyLocked(void) {
    Class lsmClass = objc_getClass("SBLockScreenManager");
    if (lsmClass && [lsmClass respondsToSelector:@selector(sharedInstanceIfExists)]) {
        SBLockScreenManager *lsm = [lsmClass sharedInstanceIfExists];
        if (lsm && [lsm respondsToSelector:@selector(isUILocked)]) {
            return [lsm isUILocked];
        }
    }
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    if ([sb respondsToSelector:@selector(isLocked)]) {
        return [sb isLocked];
    }
    return NO;
}

@interface UIScreen (AGPrivateCorner)
- (CGFloat)_displayCornerRadius;
@end

typedef NS_ENUM(NSInteger, AGVisualTheme) {
    AGVisualThemeLightLuxury = 0, // 1. 轻奢 (高定黑金琉璃)
    AGVisualThemeMinimalist  = 1, // 2. 简约 (超折射液态玻璃)
    AGVisualThemeCyberCool   = 2, // 3. 炫酷 (全息流光液态玻璃)
    AGVisualThemeSakura      = 3  // 4. 樱花 (粉晶琉璃液态玻璃)
};

typedef NS_ENUM(NSInteger, AGVectorIconType) {
    AGVectorIconMicLive = 0,
    AGVectorIconVideoAI,
    AGVectorIconPureText,
    AGVectorIconSendArrow,
    AGVectorIconTranslate,
    AGVectorIconModelHex,
    AGVectorIconCloseCross
};

#include <sys/sysctl.h>

typedef struct {
    CGFloat screenW;
    CGFloat screenH;
    CGFloat scale;
    CGFloat safeTop;
    CGFloat safeBottom;
    CGFloat screenCornerRadius;
    BOOL isCompactPhone;     // 11 Pro / 12 mini / 13 mini 或开启了放大显示模式 (<= 375pt)
    BOOL isLargePhone;       // 11 / 11 Pro Max / 12~15 Plus & Pro Max (>= 414pt)
    BOOL hasDynamicIsland;   // 14 Pro / 14 Pro Max / 15 / 15 Plus / 15 Pro / 15 Pro Max
    BOOL isProMotion120Hz;   // 13 Pro / 13 Pro Max / 14 Pro / 14 Pro Max / 15 Pro / 15 Pro Max
    BOOL isLegacyGPU;        // iPhone 11 全系 / mini 轻量光效档
    NSInteger targetAnimFPS; // 恒定帧率锁 (消除帧率跳变微卡顿)
    CGFloat waveStepPt;      // 声波顶点采样步长 (按 18 款机型 GPU 分档)
    CGFloat sideMargin;
    CGFloat bottomRestMargin;
    CGFloat topSafeLimit;
    CGFloat cardCornerRadius;
    CGFloat innerCardRadius;
    CGFloat barButtonSize;   // 顶栏与底栏严格同尺寸 (30pt / 32pt / 33pt)
    CGFloat headerAndBottomPadding;
    CGFloat defaultCapsuleH;
    CGFloat titleFontSize;
    CGFloat bodyFontSize;
    CGFloat badgeWidth;
    CGFloat camPipW;
    CGFloat camPipH;
} AGDeviceMetrics;

static NSString *agHardwareMachineIdentifier(void) {
    static NSString *sMachine = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        size_t size = 0;
        sysctlbyname("hw.machine", NULL, &size, NULL, 0);
        if (size > 0) {
            char *machine = (char *)malloc(size);
            if (machine) {
                sysctlbyname("hw.machine", machine, &size, NULL, 0);
                sMachine = [NSString stringWithUTF8String:machine];
                free(machine);
            }
        }
        if (!sMachine) sMachine = @"";
    });
    return sMachine;
}

// 保持单参数签名，100% 兼容 setupWindowIfNeeded 中的调用
static CGFloat adaptiveScreenCornerRadius(CGRect bounds) {
    UIScreen *mainScreen = [UIScreen mainScreen];
    if ([mainScreen respondsToSelector:@selector(_displayCornerRadius)]) {
        CGFloat hwRadius = [mainScreen _displayCornerRadius];
        if (hwRadius > 10.0) return hwRadius;
    }
    NSString *machine = agHardwareMachineIdentifier();
    if ([machine hasPrefix:@"iPhone15,2"] || [machine hasPrefix:@"iPhone15,3"] ||
        [machine hasPrefix:@"iPhone15,4"] || [machine hasPrefix:@"iPhone15,5"] ||
        [machine hasPrefix:@"iPhone16,1"] || [machine hasPrefix:@"iPhone16,2"]) {
        return 55.0; // iPhone 14 Pro / Pro Max & iPhone 15 全系
    }
    if ([machine isEqualToString:@"iPhone13,4"] || [machine isEqualToString:@"iPhone14,3"] || [machine isEqualToString:@"iPhone14,8"]) {
        return 53.33; // iPhone 12 Pro Max / 13 Pro Max / 14 Plus
    }
    if ([machine isEqualToString:@"iPhone13,2"] || [machine isEqualToString:@"iPhone13,3"] ||
        [machine isEqualToString:@"iPhone14,5"] || [machine isEqualToString:@"iPhone14,2"] || [machine isEqualToString:@"iPhone14,7"]) {
        return 47.33; // iPhone 12 / 12 Pro / 13 / 13 Pro / 14
    }
    if ([machine isEqualToString:@"iPhone13,1"] || [machine isEqualToString:@"iPhone14,4"]) {
        return 44.0; // iPhone 12 mini / 13 mini
    }
    if ([machine isEqualToString:@"iPhone12,1"]) {
        return 41.5; // iPhone 11 (6.1" LCD)
    }
    if ([machine isEqualToString:@"iPhone12,3"] || [machine isEqualToString:@"iPhone12,5"]) {
        return 39.0; // iPhone 11 Pro / 11 Pro Max
    }

    CGFloat maxDim = MAX(bounds.size.width, bounds.size.height);
    CGFloat minDim = MIN(bounds.size.width, bounds.size.height);
    CGFloat scale = mainScreen.scale;
    if (minDim == 393.0 || minDim == 430.0 || maxDim == 852.0 || maxDim == 932.0) return 55.0;
    if (minDim == 428.0 || maxDim == 926.0) return 53.33;
    if (minDim == 390.0 || maxDim == 844.0) return 47.33;
    if (minDim == 414.0 && maxDim == 896.0) return (scale <= 2.1) ? 41.5 : 39.0;
    if (minDim <= 360.0 || maxDim <= 780.0) return 44.0;
    if (minDim == 375.0 && maxDim == 812.0) return 39.0;
    return 47.33;
}

// 静态缓存 iPhone 11 ~ iPhone 15 Pro Max 共 18 款机型硬件布局与 GPU 分档参数，全生命周期只计算 1 次
static AGDeviceMetrics agComputeDeviceMetrics(void) {
    static AGDeviceMetrics cachedMetrics;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        UIScreen *scr = [UIScreen mainScreen];
        CGRect b = scr.bounds;
        NSString *machine = agHardwareMachineIdentifier();

        cachedMetrics.screenW = MIN(b.size.width, b.size.height);
        cachedMetrics.screenH = MAX(b.size.width, b.size.height);
        cachedMetrics.scale = scr.scale;

        // 1. 全自动识别灵动岛机型 (iPhone 14 Pro/Max, 15 全系, 16 全系及后续机型) 与无灵动岛刘海机型
        BOOL isIslandHW = ([machine isEqualToString:@"iPhone15,2"] || [machine isEqualToString:@"iPhone15,3"] ||
                           [machine isEqualToString:@"iPhone15,4"] || [machine isEqualToString:@"iPhone15,5"] ||
                           [machine hasPrefix:@"iPhone16,"] || [machine hasPrefix:@"iPhone17,"] || [machine hasPrefix:@"iPhone18,"] ||
                           cachedMetrics.screenW == 393.0 || cachedMetrics.screenW == 430.0 ||
                           cachedMetrics.screenW == 402.0 || cachedMetrics.screenW == 440.0 ||
                           cachedMetrics.screenH == 852.0 || cachedMetrics.screenH == 932.0);

        // 2. 识别 mini 机型 (iPhone 12 mini / 13 mini) 与 iPhone 11 系列
        BOOL isMiniHW = ([machine isEqualToString:@"iPhone13,1"] || [machine isEqualToString:@"iPhone14,4"] || cachedMetrics.screenW <= 360.0);
        BOOL isIPhone11LCD = ([machine isEqualToString:@"iPhone12,1"] || (cachedMetrics.screenW == 414.0 && cachedMetrics.screenH == 896.0 && cachedMetrics.scale <= 2.1));
        BOOL isIPhone11ProSeries = ([machine isEqualToString:@"iPhone12,3"] || [machine isEqualToString:@"iPhone12,5"]);

        // 3. 精确匹配 18 款机型的顶部安全区高度 safeTop
        CGFloat safeTop = 47.0; // 默认 iPhone 12 / 12 Pro / 12 Pro Max / 13 / 13 Pro / 13 Pro Max / 14 / 14 Plus
        if (isIslandHW) {
            safeTop = 59.0;
        } else if (isMiniHW) {
            safeTop = 50.0;
        } else if (isIPhone11LCD) {
            safeTop = 48.0;
        } else if (isIPhone11ProSeries || cachedMetrics.screenW == 375.0) {
            safeTop = 44.0;
        }

        cachedMetrics.safeTop = safeTop;
        cachedMetrics.safeBottom = 34.0;
        cachedMetrics.screenCornerRadius = adaptiveScreenCornerRadius(b);

        cachedMetrics.isCompactPhone   = (cachedMetrics.screenW <= 375.0);
        cachedMetrics.isLargePhone     = (cachedMetrics.screenW >= 414.0);
        cachedMetrics.hasDynamicIsland = isIslandHW;

        // 4. 识别 120Hz ProMotion 机型 (13 Pro/Max, 14 Pro/Max, 15 Pro/Max) 与 GPU 性能档位
        NSInteger maxFPS = [scr respondsToSelector:@selector(maximumFramesPerSecond)] ? scr.maximumFramesPerSecond : 60;
        cachedMetrics.isProMotion120Hz = (maxFPS > 60 ||
                                          [machine isEqualToString:@"iPhone14,2"] || [machine isEqualToString:@"iPhone14,3"] ||
                                          [machine isEqualToString:@"iPhone15,2"] || [machine isEqualToString:@"iPhone15,3"] ||
                                          [machine isEqualToString:@"iPhone16,1"] || [machine isEqualToString:@"iPhone16,2"]);

        cachedMetrics.isLegacyGPU = (isIPhone11LCD || isIPhone11ProSeries || isMiniHW);
        cachedMetrics.targetAnimFPS = cachedMetrics.isLegacyGPU ? 30 : 60;
        cachedMetrics.waveStepPt = cachedMetrics.isLegacyGPU ? 6.0 : (cachedMetrics.isProMotion120Hz ? 4.5 : 5.0);

        // 5. 按小屏 (375pt) / 标准屏 (390~393pt) / 大屏 (414~430pt) 自适应匹配视觉比例
        cachedMetrics.sideMargin       = cachedMetrics.isCompactPhone ? 10.0 : (cachedMetrics.isLargePhone ? 14.0 : 12.0);
        cachedMetrics.bottomRestMargin = cachedMetrics.isCompactPhone ? 18.0 : 21.0;
        cachedMetrics.topSafeLimit     = safeTop + (cachedMetrics.hasDynamicIsland ? 10.0 : 8.0);
        cachedMetrics.cardCornerRadius = cachedMetrics.isCompactPhone ? 34.0 : (cachedMetrics.isLargePhone ? 39.0 : 37.0);
        cachedMetrics.innerCardRadius  = cachedMetrics.isCompactPhone ? 20.0 : (cachedMetrics.isLargePhone ? 23.0 : 22.0);
        cachedMetrics.barButtonSize    = cachedMetrics.isCompactPhone ? 30.0 : (cachedMetrics.isLargePhone ? 33.0 : 32.0);
        cachedMetrics.headerAndBottomPadding = cachedMetrics.isCompactPhone ? 11.0 : (cachedMetrics.isLargePhone ? 14.0 : 13.0);
                // 锁定初始紧凑高度（小屏 304pt / 标准屏 316pt / Pro Max 大屏 324pt），确保打开瞬间即为正常紧凑尺寸，绝不先高后缩！
        cachedMetrics.defaultCapsuleH  = cachedMetrics.isCompactPhone ? 304.0 : (cachedMetrics.isLargePhone ? 324.0 : 316.0);
        cachedMetrics.titleFontSize    = cachedMetrics.isCompactPhone ? 16.5 : (cachedMetrics.isLargePhone ? 18.5 : 17.5);
        cachedMetrics.bodyFontSize     = cachedMetrics.isCompactPhone ? 14.5 : (cachedMetrics.isLargePhone ? 16.0 : 15.2);
        cachedMetrics.badgeWidth       = cachedMetrics.isCompactPhone ? 80.0 : 88.0;
        cachedMetrics.camPipW          = cachedMetrics.isCompactPhone ? 90.0 : (cachedMetrics.isLargePhone ? 108.0 : 100.0);
        cachedMetrics.camPipH          = cachedMetrics.isCompactPhone ? 122.0 : (cachedMetrics.isLargePhone ? 144.0 : 132.0);
    });
    return cachedMetrics;
}

static AGVisualTheme agCurrentVisualTheme(void) {
    if (!gCachedPrefs) {
        reloadGeminiPrefsCache();
    }
    NSNumber *val = gCachedPrefs[@"AG_Visual_Theme"];
    if (!val) return AGVisualThemeCyberCool;
    NSInteger idx = [val integerValue];
    if (idx < 0 || idx > 3) return AGVisualThemeCyberCool;
    return (AGVisualTheme)idx;
}

// 跑马灯总开关 (默认 YES 开启)
static BOOL agIsMarqueeEnabled(void) {
    if (!gCachedPrefs) {
        reloadGeminiPrefsCache();
    }
    NSNumber *val = gCachedPrefs[@"AG_Marquee_Enabled"];
    return val ? [val boolValue] : YES;
}

// 固定最佳主界面半透明液态镜面玻璃不透明度 (50%)
static CGFloat agMainGlassOpacity(void) {
    return 0.50;
}

// 固定最佳跑马灯向内柔光羽化度 (85%)
static CGFloat agMarqueeFeatherLevel(void) {
    return 0.85;
}

// 生成 18 阶指数衰减无断层向内羽化遮罩纹理 + 底部加厚柔光垫 (全生命周期只生成 1 次，0 CPU 每帧重绘开销)
static CGImageRef agCreateSmoothFeatheredEdgeMaskImage(CGRect bounds, CGFloat cornerRadius, CGFloat maxFeatherDepth, BOOL includeBottomCushion) {
    if (bounds.size.width <= 10 || bounds.size.height <= 10) return NULL;
    UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat];
    fmt.scale = 1.0; // 1x 纹理利用 GPU 硬件双线性插值自带天然柔化，且内存占用极低
    fmt.opaque = NO;
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:bounds.size format:fmt];
    UIImage *maskImg = [renderer imageWithActions:^(UIGraphicsImageRendererContext * _Nonnull rCtx) {
        CGContextRef ctx = rCtx.CGContext;
        CGFloat w = bounds.size.width;
        CGFloat h = bounds.size.height;

        // 1. 绘制 18 层指数衰减的同心圆角描边，使最外沿 0~2.5pt 极亮，向内 2.5pt -> maxFeatherDepth 丝滑衰减至 0，彻底消除硬切边台阶
        NSInteger steps = 18;
        for (NSInteger i = 0; i < steps; i++) {
            CGFloat t = (CGFloat)i / (CGFloat)(steps - 1);
            CGFloat inset = 0.6 + pow(t, 1.35) * maxFeatherDepth;
            CGFloat lineW = 2.2 + t * 4.5;
            CGFloat alpha = pow(1.0 - t, 2.25) * 0.42;
            if (alpha <= 0.005) continue;

            CGRect r = CGRectInset(bounds, inset, inset);
            if (r.size.width <= 4 || r.size.height <= 4) continue;
            UIBezierPath *p = [UIBezierPath bezierPathWithRoundedRect:r cornerRadius:MAX(6.0, cornerRadius - inset)];
            p.lineWidth = lineW;
            [[UIColor colorWithWhite:1.0 alpha:alpha] setStroke];
            [p stroke];
        }

        // 2. 复刻 iOS 27 Siri 底部（手电筒与相机区下方）特有的加厚氛围柔光垫
        if (includeBottomCushion) {
            CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
            NSArray *cCols = @[
                (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.82].CGColor,
                (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.32].CGColor,
                (__bridge id)[UIColor clearColor].CGColor
            ];
            CGFloat locs[3] = {0.0, 0.52, 1.0};
            CGGradientRef grad = CGGradientCreateWithColors(space, (__bridge CFArrayRef)cCols, locs);
            if (grad) {
                CGContextSaveGState(ctx);
                UIBezierPath *clipP = [UIBezierPath bezierPathWithRoundedRect:bounds cornerRadius:cornerRadius];
                [clipP addClip];
                CGContextDrawRadialGradient(ctx, grad,
                                            CGPointMake(w * 0.5, h + 6.0), 4.0,
                                            CGPointMake(w * 0.5, h - 8.0), w * 0.62,
                                            kCGGradientDrawsAfterEndLocation);
                CGContextRestoreGState(ctx);
                CGGradientRelease(grad);
            }
            CGColorSpaceRelease(space);
        }
    }];
    return maskImg.CGImage;
}

static void agDrawRadialGradient(CGContextRef ctx, CGPoint startCenter, CGFloat startR, CGPoint endCenter, CGFloat endR, NSArray<UIColor *> *colors, const CGFloat *locations) {
    NSMutableArray *cgColors = [NSMutableArray arrayWithCapacity:colors.count];
    for (UIColor *c in colors) [cgColors addObject:(__bridge id)c.CGColor];
    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
    CGGradientRef grad = CGGradientCreateWithColors(space, (__bridge CFArrayRef)cgColors, locations);
    if (grad) {
        CGContextDrawRadialGradient(ctx, grad, startCenter, startR, endCenter, endR, kCGGradientDrawsAfterEndLocation);
        CGGradientRelease(grad);
    }
    CGColorSpaceRelease(space);
}

// ==================== 1. 零掉帧 GPU 硬件合批液态玻璃背景光场 (双轨透明夹层玻璃壁 + 顶/底独立玻璃舱，消除白雾感) ====================
@interface AGCardBgCanvasView : UIView
@property (nonatomic, assign) CGFloat phase;
@property (nonatomic, assign) CGFloat amplitude;
@property (nonatomic, assign) CGFloat cornerRadius;
- (void)applyTheme:(AGVisualTheme)theme;
- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp;
@end

@implementation AGCardBgCanvasView {
    CAGradientLayer *_blob1;
    CAGradientLayer *_blob2;
    CAGradientLayer *_blob3;
    CAGradientLayer *_liquidMirrorGlossLayer; // 新增：50% 液态镜面玻璃斜切反射层
    CALayer         *_staticGlassShellLayer;
    CAGradientLayer *_hotspotTL;
    CAGradientLayer *_hotspotBR;
    AGVisualTheme   _appliedTheme;
    BOOL            _hasInitializedTheme;
    CGSize          _lastRenderedSize;
    AGVisualTheme   _lastRenderedTheme;
    CGFloat         _lastRenderedOpacity;
}

- (instancetype)initWithFrame:(CGRect)frame {
    if (self = [super initWithFrame:frame]) {
        self.backgroundColor = [UIColor clearColor];
        self.userInteractionEnabled = NO;
        self.clipsToBounds = YES;

        _blob1 = [CAGradientLayer layer];
        _blob1.type = kCAGradientLayerRadial;
        _blob1.startPoint = CGPointMake(0.5, 0.5);
        _blob1.endPoint = CGPointMake(1.0, 1.0);
        [self.layer addSublayer:_blob1];

        _blob2 = [CAGradientLayer layer];
        _blob2.type = kCAGradientLayerRadial;
        _blob2.startPoint = CGPointMake(0.5, 0.5);
        _blob2.endPoint = CGPointMake(1.0, 1.0);
        [self.layer addSublayer:_blob2];

        _blob3 = [CAGradientLayer layer];
        _blob3.type = kCAGradientLayerRadial;
        _blob3.startPoint = CGPointMake(0.5, 0.5);
        _blob3.endPoint = CGPointMake(1.0, 1.0);
        [self.layer addSublayer:_blob3];

        _liquidMirrorGlossLayer = [CAGradientLayer layer];
        _liquidMirrorGlossLayer.startPoint = CGPointMake(0.0, 0.0);
        _liquidMirrorGlossLayer.endPoint = CGPointMake(0.85, 0.95);
        _liquidMirrorGlossLayer.colors = @[
            (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.28].CGColor,
            (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.08].CGColor,
            (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.00].CGColor,
            (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.12].CGColor
        ];
        _liquidMirrorGlossLayer.locations = @[@0.0, @0.26, @0.62, @1.0];
        [self.layer addSublayer:_liquidMirrorGlossLayer];

        _staticGlassShellLayer = [CALayer layer];
        _staticGlassShellLayer.contentsScale = [UIScreen mainScreen].scale;
        [self.layer addSublayer:_staticGlassShellLayer];

        _hotspotTL = [CAGradientLayer layer];
        _hotspotTL.type = kCAGradientLayerRadial;
        _hotspotTL.startPoint = CGPointMake(0.5, 0.5);
        _hotspotTL.endPoint = CGPointMake(1.0, 1.0);
        [self.layer addSublayer:_hotspotTL];

        _hotspotBR = [CAGradientLayer layer];
        _hotspotBR.type = kCAGradientLayerRadial;
        _hotspotBR.startPoint = CGPointMake(0.5, 0.5);
        _hotspotBR.endPoint = CGPointMake(1.0, 1.0);
        [self.layer addSublayer:_hotspotBR];

        _lastRenderedTheme = (AGVisualTheme)(-1);
        [self applyTheme:agCurrentVisualTheme()];
    }
    return self;
}

- (void)rebuildStaticGlassShellTextureIfNeeded {
    CGRect b = self.bounds;
    if (b.size.width <= 20 || b.size.height <= 20) return;
    CGFloat glassAlpha = agMainGlassOpacity(); // 默认 0.50 (50% 透明液态镜面)
    if (CGSizeEqualToSize(b.size, _lastRenderedSize) &&
        _appliedTheme == _lastRenderedTheme &&
        fabs(glassAlpha - _lastRenderedOpacity) < 0.005 &&
        _staticGlassShellLayer.contents != nil) {
        return;
    }
    _lastRenderedSize = b.size;
    _lastRenderedTheme = _appliedTheme;
    _lastRenderedOpacity = glassAlpha;

    AGDeviceMetrics m = agComputeDeviceMetrics();
    CGFloat cr = self.cornerRadius > 0 ? self.cornerRadius : m.cardCornerRadius;
    AGVisualTheme theme = _appliedTheme;

    UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat];
    fmt.scale = m.scale;
    fmt.opaque = NO;
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:b.size format:fmt];

    UIImage *shellImg = [renderer imageWithActions:^(UIGraphicsImageRendererContext * _Nonnull rCtx) {
        CGContextRef ctx = rCtx.CGContext;
        CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
        UIBezierPath *outerClip = [UIBezierPath bezierPathWithRoundedRect:b cornerRadius:cr];
        [outerClip addClip];

        NSArray *baseCols = nil;
        NSArray *rimGradCols = nil;
        UIColor *grooveColor = nil;
        UIColor *innerWireCol = nil;
        UIColor *podFillTop = nil;
        UIColor *podFillBot = nil;
        UIColor *podStrokeCol = nil;
        UIColor *edgeGlowCol = nil;

        if (theme == AGVisualThemeLightLuxury) {
            // 1. 轻奢：50% 液态黑金镜面玻璃底
            baseCols = @[(id)[UIColor colorWithRed:0.14 green:0.10 blue:0.08 alpha:glassAlpha * 0.95].CGColor,
                         (id)[UIColor colorWithRed:0.06 green:0.05 blue:0.05 alpha:glassAlpha * 1.05].CGColor,
                         (id)[UIColor colorWithRed:0.12 green:0.08 blue:0.05 alpha:glassAlpha * 1.00].CGColor];
            rimGradCols = @[(id)[UIColor whiteColor].CGColor,
                            (id)[UIColor colorWithRed:0.99 green:0.88 blue:0.68 alpha:0.96].CGColor,
                            (id)[UIColor colorWithRed:0.72 green:0.50 blue:0.28 alpha:0.78].CGColor,
                            (id)[UIColor colorWithRed:0.98 green:0.84 blue:0.58 alpha:0.95].CGColor,
                            (id)[UIColor whiteColor].CGColor];
            grooveColor  = [UIColor colorWithRed:0.05 green:0.03 blue:0.02 alpha:0.68];
            innerWireCol = [UIColor colorWithRed:1.00 green:0.94 blue:0.82 alpha:0.68];
            podFillTop   = [UIColor colorWithRed:0.28 green:0.20 blue:0.14 alpha:0.42];
            podFillBot   = [UIColor colorWithRed:0.08 green:0.06 blue:0.05 alpha:0.62];
            podStrokeCol = [UIColor colorWithRed:0.98 green:0.86 blue:0.66 alpha:0.62];
            edgeGlowCol  = [UIColor colorWithRed:0.98 green:0.82 blue:0.52 alpha:0.28];
        } else if (theme == AGVisualThemeMinimalist) {
            // 2. 简约：50% 液态冰晶蓝镜面玻璃底
            baseCols = @[(id)[UIColor colorWithRed:0.10 green:0.16 blue:0.34 alpha:glassAlpha * 0.92].CGColor,
                         (id)[UIColor colorWithRed:0.06 green:0.10 blue:0.24 alpha:glassAlpha * 1.02].CGColor,
                         (id)[UIColor colorWithRed:0.14 green:0.10 blue:0.32 alpha:glassAlpha * 0.96].CGColor];
            rimGradCols = @[(id)[UIColor whiteColor].CGColor,
                            (id)[UIColor colorWithRed:0.73 green:0.91 blue:1.00 alpha:0.96].CGColor,
                            (id)[UIColor colorWithRed:0.56 green:0.62 blue:0.98 alpha:0.80].CGColor,
                            (id)[UIColor colorWithRed:0.88 green:0.78 blue:1.00 alpha:0.94].CGColor,
                            (id)[UIColor whiteColor].CGColor];
            grooveColor  = [UIColor colorWithRed:0.04 green:0.08 blue:0.20 alpha:0.62];
            innerWireCol = [UIColor colorWithWhite:1.0 alpha:0.76];
            podFillTop   = [UIColor colorWithRed:0.38 green:0.56 blue:0.88 alpha:0.28];
            podFillBot   = [UIColor colorWithRed:0.10 green:0.16 blue:0.36 alpha:0.48];
            podStrokeCol = [UIColor colorWithWhite:1.0 alpha:0.68];
            edgeGlowCol  = [UIColor colorWithRed:0.48 green:0.82 blue:1.00 alpha:0.28];
        } else if (theme == AGVisualThemeSakura) {
            // 4. 樱花：50% 液态粉晶琉璃镜面玻璃底
            baseCols = @[(id)[UIColor colorWithRed:0.20 green:0.09 blue:0.16 alpha:glassAlpha * 0.94].CGColor,
                         (id)[UIColor colorWithRed:0.11 green:0.05 blue:0.10 alpha:glassAlpha * 1.04].CGColor,
                         (id)[UIColor colorWithRed:0.22 green:0.10 blue:0.18 alpha:glassAlpha * 0.98].CGColor];
            rimGradCols = @[(id)[UIColor whiteColor].CGColor,
                            (id)[UIColor colorWithRed:1.00 green:0.78 blue:0.88 alpha:0.98].CGColor,
                            (id)[UIColor colorWithRed:0.96 green:0.56 blue:0.76 alpha:0.84].CGColor,
                            (id)[UIColor colorWithRed:1.00 green:0.86 blue:0.92 alpha:0.95].CGColor,
                            (id)[UIColor whiteColor].CGColor];
            grooveColor  = [UIColor colorWithRed:0.08 green:0.03 blue:0.06 alpha:0.65];
            innerWireCol = [UIColor colorWithRed:1.00 green:0.90 blue:0.95 alpha:0.78];
            podFillTop   = [UIColor colorWithRed:0.48 green:0.22 blue:0.35 alpha:0.34];
            podFillBot   = [UIColor colorWithRed:0.16 green:0.07 blue:0.13 alpha:0.54];
            podStrokeCol = [UIColor colorWithRed:1.00 green:0.82 blue:0.90 alpha:0.70];
            edgeGlowCol  = [UIColor colorWithRed:1.00 green:0.68 blue:0.84 alpha:0.30];
        } else {
            // 3. 炫酷：50% 液态全息深空镜面玻璃底
            baseCols = @[(id)[UIColor colorWithRed:0.06 green:0.10 blue:0.26 alpha:glassAlpha * 0.95].CGColor,
                         (id)[UIColor colorWithRed:0.04 green:0.05 blue:0.16 alpha:glassAlpha * 1.05].CGColor,
                         (id)[UIColor colorWithRed:0.16 green:0.06 blue:0.28 alpha:glassAlpha * 1.00].CGColor];
            rimGradCols = @[(id)[UIColor whiteColor].CGColor,
                            (id)[UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.98].CGColor,
                            (id)[UIColor colorWithRed:0.58 green:0.32 blue:0.98 alpha:0.88].CGColor,
                            (id)[UIColor colorWithRed:1.00 green:0.18 blue:0.56 alpha:0.96].CGColor,
                            (id)[UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.98].CGColor];
            grooveColor  = [UIColor colorWithRed:0.02 green:0.04 blue:0.14 alpha:0.68];
            innerWireCol = [UIColor colorWithRed:0.68 green:0.96 blue:1.00 alpha:0.75];
            podFillTop   = [UIColor colorWithRed:0.08 green:0.32 blue:0.62 alpha:0.34];
            podFillBot   = [UIColor colorWithRed:0.06 green:0.08 blue:0.24 alpha:0.58];
            podStrokeCol = [UIColor colorWithRed:0.38 green:0.92 blue:1.00 alpha:0.68];
            edgeGlowCol  = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.30];
        }

        // 1. 绘制高对比度深邃玻璃基底 (不涂白雾，保留通透景深)
        CGFloat baseLocs[3] = {0.0, 0.52, 1.0};
        CGGradientRef baseG = CGGradientCreateWithColors(space, (__bridge CFArrayRef)baseCols, baseLocs);
        CGContextDrawLinearGradient(ctx, baseG, CGPointMake(0, 0), CGPointMake(b.size.width * 0.85, b.size.height), 0);
        CGGradientRelease(baseG);

        // 2. 四周边缘柔和内折射光晕 (只分布在边缘 28pt 内，绝不污染中心对话区)
        CGFloat glowLocs[2] = {0.0, 1.0};
        agDrawRadialGradient(ctx, CGPointMake(28.0, 22.0), 2.0, CGPointMake(28.0, 22.0), 115.0,
                             @[edgeGlowCol, [UIColor clearColor]], glowLocs);
        agDrawRadialGradient(ctx, CGPointMake(b.size.width - 28.0, b.size.height - 22.0), 2.0, CGPointMake(b.size.width - 28.0, b.size.height - 22.0), 120.0,
                             @[edgeGlowCol, [UIColor clearColor]], glowLocs);

        // 3. 绘制顶部导航栏独立圆角玻璃舱 (Top Glass Pod) 与底部控制栏独立圆角玻璃舱 (Bottom Glass Pod)
        CGFloat podH = m.barButtonSize + 10.0;
        CGRect topPodRect = CGRectMake(8.0, m.headerAndBottomPadding - 5.0, b.size.width - 16.0, podH);
        CGRect botPodRect = CGRectMake(8.0, b.size.height - m.headerAndBottomPadding - m.barButtonSize - 5.0, b.size.width - 16.0, podH);

        CGRect pods[2] = {topPodRect, botPodRect};
        for (int pIdx = 0; pIdx < 2; pIdx++) {
            CGRect pr = pods[pIdx];
            UIBezierPath *podPath = [UIBezierPath bezierPathWithRoundedRect:pr cornerRadius:podH / 2.0];
            CGContextSaveGState(ctx);
            [podPath addClip];
            NSArray *pCols = @[(id)podFillTop.CGColor, (id)podFillBot.CGColor];
            CGFloat pLocs[2] = {0.0, 1.0};
            CGGradientRef pg = CGGradientCreateWithColors(space, (__bridge CFArrayRef)pCols, pLocs);
            CGContextDrawLinearGradient(ctx, pg, CGPointMake(0, pr.origin.y), CGPointMake(0, pr.origin.y + pr.size.height), 0);
            CGGradientRelease(pg);

            // 胶囊舱顶部弯月面细高光
            UIBezierPath *topArc = [UIBezierPath bezierPathWithRoundedRect:CGRectInset(pr, 1.0, 0.8) cornerRadius:(podH / 2.0) - 0.8];
            [[UIColor colorWithWhite:1.0 alpha:0.38] setStroke];
            topArc.lineWidth = 0.9;
            [topArc stroke];
            CGContextRestoreGState(ctx);

            [podStrokeCol setStroke];
            podPath.lineWidth = 1.15;
            [podPath stroke];
        }

        // 4. 绘制真正的 3D 双轨透明夹层厚玻璃外框：
        // (a) 1.5pt ~ 4.4pt 之间的深色半透明折射夹层槽 (Groove)
        UIBezierPath *groovePath = [UIBezierPath bezierPathWithRoundedRect:CGRectInset(b, 2.8, 2.8) cornerRadius:MAX(8.0, cr - 2.8)];
        [grooveColor setStroke];
        groovePath.lineWidth = 3.0;
        [groovePath stroke];

        // (b) 最外圈 1.6pt 高亮流光金属/水晶边
        CGContextSaveGState(ctx);
        UIBezierPath *outerRimRing = [UIBezierPath bezierPathWithRoundedRect:b cornerRadius:cr];
        [outerRimRing appendPath:[UIBezierPath bezierPathWithRoundedRect:CGRectInset(b, 1.7, 1.7) cornerRadius:MAX(8.0, cr - 1.7)]];
        outerRimRing.usesEvenOddFillRule = YES;
        [outerRimRing addClip];
        CGFloat rimLocs[5] = {0.0, 0.25, 0.50, 0.78, 1.0};
        CGGradientRef rimG = CGGradientCreateWithColors(space, (__bridge CFArrayRef)rimGradCols, rimLocs);
        CGContextDrawLinearGradient(ctx, rimG, CGPointMake(0, 0), CGPointMake(b.size.width, b.size.height), 0);
        CGGradientRelease(rimG);
        CGContextRestoreGState(ctx);

        // (c) 内侧 4.5pt 处的第二道锐利高光折射细环
        UIBezierPath *innerWirePath = [UIBezierPath bezierPathWithRoundedRect:CGRectInset(b, 4.4, 4.4) cornerRadius:MAX(8.0, cr - 4.4)];
        [innerWireCol setStroke];
        innerWirePath.lineWidth = 1.05;
        [innerWirePath stroke];

        // (d) 边缘局部高光反射点
        agDrawRadialGradient(ctx, CGPointMake(b.size.width - 72.0, 1.2), 0.5, CGPointMake(b.size.width - 72.0, 1.2), 36.0,
                             @[[UIColor whiteColor], [UIColor clearColor]], glowLocs);
        agDrawRadialGradient(ctx, CGPointMake(64.0, b.size.height - 1.2), 0.5, CGPointMake(64.0, b.size.height - 1.2), 38.0,
                             @[[UIColor whiteColor], [UIColor clearColor]], glowLocs);

        CGColorSpaceRelease(space);
    }];

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    _staticGlassShellLayer.frame = b;
    _staticGlassShellLayer.contents = (__bridge id)shellImg.CGImage;
    [CATransaction commit];
}

- (void)layoutSubviews {
    [super layoutSubviews];
    CGRect b = self.bounds;
    if (b.size.width <= 10 || b.size.height <= 10) return;
    AGDeviceMetrics m = agComputeDeviceMetrics();
    CGFloat cr = self.cornerRadius > 0 ? self.cornerRadius : m.cardCornerRadius;
    self.layer.cornerRadius = cr;

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    CGFloat bSize = MIN(b.size.width, b.size.height) * 0.72;
    _blob1.bounds = CGRectMake(0, 0, bSize, bSize);
    _blob2.bounds = CGRectMake(0, 0, bSize, bSize);
    _blob3.bounds = CGRectMake(0, 0, bSize, bSize);
    _liquidMirrorGlossLayer.frame = b;
    _hotspotTL.frame = CGRectMake(18.0, -3.5, 96.0, 10.0);
    _hotspotBR.frame = CGRectMake(b.size.width - 118.0, b.size.height - 6.5, 96.0, 10.0);
    [CATransaction commit];

    [self rebuildStaticGlassShellTextureIfNeeded];
}

- (void)applyTheme:(AGVisualTheme)theme {
    if (_hasInitializedTheme && _appliedTheme == theme) return;
    _hasInitializedTheme = YES;
    _appliedTheme = theme;

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    if (theme == AGVisualThemeLightLuxury) {
        _blob1.colors = @[(__bridge id)[UIColor colorWithRed:0.98 green:0.84 blue:0.58 alpha:0.22].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob2.colors = @[(__bridge id)[UIColor colorWithRed:0.82 green:0.56 blue:0.30 alpha:0.20].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob3.colors = @[(__bridge id)[UIColor colorWithRed:0.92 green:0.72 blue:0.44 alpha:0.18].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        NSArray *hsCols = @[(__bridge id)[UIColor whiteColor].CGColor, (__bridge id)[UIColor colorWithRed:0.98 green:0.85 blue:0.62 alpha:0.75].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _hotspotTL.colors = hsCols; _hotspotBR.colors = hsCols;
    } else if (theme == AGVisualThemeMinimalist) {
        _blob1.colors = @[(__bridge id)[UIColor colorWithRed:0.38 green:0.72 blue:1.00 alpha:0.24].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob2.colors = @[(__bridge id)[UIColor colorWithRed:0.68 green:0.42 blue:0.98 alpha:0.22].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob3.colors = @[(__bridge id)[UIColor colorWithRed:0.56 green:0.85 blue:1.00 alpha:0.20].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        NSArray *hsCols = @[(__bridge id)[UIColor whiteColor].CGColor, (__bridge id)[UIColor colorWithRed:0.56 green:0.85 blue:1.00 alpha:0.82].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _hotspotTL.colors = hsCols; _hotspotBR.colors = hsCols;
    } else if (theme == AGVisualThemeSakura) {
        _blob1.colors = @[(__bridge id)[UIColor colorWithRed:1.00 green:0.72 blue:0.85 alpha:0.25].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob2.colors = @[(__bridge id)[UIColor colorWithRed:0.98 green:0.52 blue:0.74 alpha:0.22].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob3.colors = @[(__bridge id)[UIColor colorWithRed:0.88 green:0.62 blue:0.94 alpha:0.20].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        NSArray *hsCols = @[(__bridge id)[UIColor whiteColor].CGColor, (__bridge id)[UIColor colorWithRed:1.00 green:0.78 blue:0.88 alpha:0.85].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _hotspotTL.colors = hsCols; _hotspotBR.colors = hsCols;
    } else {
        _blob1.colors = @[(__bridge id)[UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.26].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob2.colors = @[(__bridge id)[UIColor colorWithRed:1.00 green:0.16 blue:0.52 alpha:0.24].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _blob3.colors = @[(__bridge id)[UIColor colorWithRed:0.62 green:0.28 blue:0.98 alpha:0.25].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        NSArray *hsCols = @[(__bridge id)[UIColor whiteColor].CGColor, (__bridge id)[UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.85].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _hotspotTL.colors = hsCols; _hotspotBR.colors = hsCols;
    }
    [CATransaction commit];

    [self rebuildStaticGlassShellTextureIfNeeded];
}

- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp {
    CGRect b = self.bounds;
    if (b.size.width <= 10) return;
    CGFloat w = b.size.width, h = b.size.height;
    CGFloat sc = 1.0 + amp * 0.25;
    CGFloat drift = sin(phase * 0.65) * 15.0;

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    _blob1.position = CGPointMake((0.24 + 0.20 * sin(phase * 0.55)) * w, (0.28 + 0.18 * cos(phase * 0.45)) * h);
    _blob2.position = CGPointMake((0.76 + 0.20 * cos(phase * 0.50)) * w, (0.72 + 0.18 * sin(phase * 0.60)) * h);
    _blob3.position = CGPointMake((0.50 + 0.22 * sin(phase * 0.40 + 1.0)) * w, (0.50 + 0.18 * sin(phase * 0.45)) * h);
    _blob1.transform = CATransform3DMakeScale(sc, sc, 1.0);
    _blob2.transform = CATransform3DMakeScale(sc, sc, 1.0);

    _hotspotTL.position = CGPointMake(68.0 + drift, 1.5);
    _hotspotBR.position = CGPointMake(w - 72.0 - drift, h - 1.5);
    [CATransaction commit];
}

- (void)setNeedsDisplay {}
@end

// ==================== 2. 纯 GPU 硬件加速 3D 液态球面镜核心球 (0 CPU drawRect) ====================
@interface AGOrbCanvasView : UIView
@property (nonatomic, assign) CGFloat phase;
@property (nonatomic, assign) CGFloat amplitude;
- (void)applyTheme:(AGVisualTheme)theme;
- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp;
@end

@implementation AGOrbCanvasView {
    CAGradientLayer *_coreGrad;
    CAGradientLayer *_subBlob1;
    CAGradientLayer *_subBlob2;
    CAGradientLayer *_specularCap;
    CAShapeLayer    *_outerRing;
    CAShapeLayer    *_innerRing;
    AGVisualTheme   _appliedTheme;
    BOOL            _hasInit;
}

- (instancetype)initWithFrame:(CGRect)frame {
    if (self = [super initWithFrame:frame]) {
        self.backgroundColor = [UIColor clearColor];
        self.userInteractionEnabled = NO;

        _subBlob1 = [CAGradientLayer layer];
        _subBlob1.type = kCAGradientLayerRadial;
        _subBlob1.startPoint = CGPointMake(0.5, 0.5);
        _subBlob1.endPoint = CGPointMake(1.0, 1.0);
        [self.layer addSublayer:_subBlob1];

        _subBlob2 = [CAGradientLayer layer];
        _subBlob2.type = kCAGradientLayerRadial;
        _subBlob2.startPoint = CGPointMake(0.5, 0.5);
        _subBlob2.endPoint = CGPointMake(1.0, 1.0);
        [self.layer addSublayer:_subBlob2];

        _coreGrad = [CAGradientLayer layer];
        _coreGrad.type = kCAGradientLayerRadial;
        _coreGrad.startPoint = CGPointMake(0.32, 0.26);
        _coreGrad.endPoint = CGPointMake(0.95, 0.95);
        [self.layer addSublayer:_coreGrad];

        _specularCap = [CAGradientLayer layer];
        _specularCap.startPoint = CGPointMake(0.3, 0.0);
        _specularCap.endPoint = CGPointMake(0.7, 1.0);
        _specularCap.colors = @[
            (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.90].CGColor,
            (__bridge id)[UIColor colorWithWhite:1.0 alpha:0.0].CGColor
        ];
        [self.layer addSublayer:_specularCap];

        _outerRing = [CAShapeLayer layer];
        _outerRing.fillColor = [UIColor clearColor].CGColor;
        _outerRing.lineWidth = 1.6;
        [self.layer addSublayer:_outerRing];

        _innerRing = [CAShapeLayer layer];
        _innerRing.fillColor = [UIColor clearColor].CGColor;
        _innerRing.lineWidth = 1.0;
        [self.layer addSublayer:_innerRing];

        [self applyTheme:agCurrentVisualTheme()];
    }
    return self;
}

- (void)layoutSubviews {
    [super layoutSubviews];
    CGRect b = self.bounds;
    if (b.size.width <= 4) return;
    CGFloat s = b.size.width;

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    _coreGrad.frame = CGRectInset(b, s * 0.08, s * 0.08);
    _coreGrad.cornerRadius = _coreGrad.bounds.size.width / 2.0;

    _subBlob1.frame = CGRectInset(b, s * 0.06, s * 0.14);
    _subBlob1.cornerRadius = _subBlob1.bounds.size.height / 2.0;

    _subBlob2.frame = CGRectInset(b, s * 0.14, s * 0.06);
    _subBlob2.cornerRadius = _subBlob2.bounds.size.width / 2.0;

    _specularCap.frame = CGRectMake(s * 0.18, s * 0.12, s * 0.46, s * 0.28);
    _specularCap.cornerRadius = s * 0.14;
    _specularCap.transform = CATransform3DMakeRotation(-0.32, 0, 0, 1);

    _outerRing.frame = b;
    _outerRing.path = [UIBezierPath bezierPathWithOvalInRect:CGRectInset(b, 1.0, 1.0)].CGPath;

    _innerRing.frame = b;
    _innerRing.path = [UIBezierPath bezierPathWithOvalInRect:CGRectInset(b, 3.2, 3.2)].CGPath;
    [CATransaction commit];
}

- (void)applyTheme:(AGVisualTheme)theme {
    if (_hasInit && _appliedTheme == theme) return;
    _hasInit = YES;
    _appliedTheme = theme;

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    if (theme == AGVisualThemeLightLuxury) {
        _coreGrad.colors = @[
            (__bridge id)[UIColor whiteColor].CGColor,
            (__bridge id)[UIColor colorWithRed:0.99 green:0.90 blue:0.68 alpha:1.0].CGColor,
            (__bridge id)[UIColor colorWithRed:0.82 green:0.55 blue:0.26 alpha:0.95].CGColor,
            (__bridge id)[UIColor colorWithRed:0.25 green:0.15 blue:0.08 alpha:0.95].CGColor
        ];
        _subBlob1.hidden = YES;
        _subBlob2.hidden = YES;
        _outerRing.strokeColor = [UIColor colorWithRed:1.00 green:0.94 blue:0.82 alpha:0.92].CGColor;
        _innerRing.strokeColor = [UIColor colorWithRed:0.95 green:0.78 blue:0.52 alpha:0.68].CGColor;
    } else if (theme == AGVisualThemeMinimalist) {
        _coreGrad.colors = @[
            (__bridge id)[UIColor whiteColor].CGColor,
            (__bridge id)[UIColor colorWithRed:0.73 green:0.91 blue:1.00 alpha:0.96].CGColor,
            (__bridge id)[UIColor colorWithRed:0.25 green:0.52 blue:0.98 alpha:0.92].CGColor,
            (__bridge id)[UIColor colorWithRed:0.84 green:0.32 blue:0.96 alpha:0.90].CGColor
        ];
        _subBlob1.hidden = NO;
        _subBlob1.colors = @[(__bridge id)[UIColor colorWithWhite:1.0 alpha:0.85].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _subBlob2.hidden = NO;
        _subBlob2.colors = @[(__bridge id)[UIColor colorWithRed:0.56 green:0.85 blue:1.00 alpha:0.75].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _outerRing.strokeColor = [UIColor colorWithWhite:1.0 alpha:0.95].CGColor;
        _innerRing.strokeColor = [UIColor colorWithRed:0.73 green:0.90 blue:1.00 alpha:0.78].CGColor;
    } else if (theme == AGVisualThemeSakura) {
        _coreGrad.colors = @[
            (__bridge id)[UIColor whiteColor].CGColor,
            (__bridge id)[UIColor colorWithRed:1.00 green:0.84 blue:0.91 alpha:0.98].CGColor,
            (__bridge id)[UIColor colorWithRed:0.96 green:0.52 blue:0.74 alpha:0.94].CGColor,
            (__bridge id)[UIColor colorWithRed:0.68 green:0.28 blue:0.54 alpha:0.92].CGColor
        ];
        _subBlob1.hidden = NO;
        _subBlob1.colors = @[(__bridge id)[UIColor colorWithWhite:1.0 alpha:0.88].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _subBlob2.hidden = NO;
        _subBlob2.colors = @[(__bridge id)[UIColor colorWithRed:1.00 green:0.76 blue:0.88 alpha:0.80].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _outerRing.strokeColor = [UIColor colorWithRed:1.00 green:0.94 blue:0.97 alpha:0.95].CGColor;
        _innerRing.strokeColor = [UIColor colorWithRed:1.00 green:0.76 blue:0.88 alpha:0.82].CGColor;
    } else {
        _coreGrad.colors = @[
            (__bridge id)[UIColor whiteColor].CGColor,
            (__bridge id)[UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.95].CGColor,
            (__bridge id)[UIColor colorWithRed:0.48 green:0.24 blue:0.96 alpha:0.92].CGColor,
            (__bridge id)[UIColor colorWithRed:1.00 green:0.16 blue:0.52 alpha:0.92].CGColor
        ];
        _subBlob1.hidden = NO;
        _subBlob1.colors = @[(__bridge id)[UIColor whiteColor].CGColor, (__bridge id)[UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.85].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _subBlob2.hidden = NO;
        _subBlob2.colors = @[(__bridge id)[UIColor whiteColor].CGColor, (__bridge id)[UIColor colorWithRed:1.00 green:0.16 blue:0.52 alpha:0.85].CGColor, (__bridge id)[UIColor clearColor].CGColor];
        _outerRing.strokeColor = [UIColor colorWithWhite:1.0 alpha:0.92].CGColor;
        _innerRing.strokeColor = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.80].CGColor;
    }
    [CATransaction commit];
}

- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp {
    CGFloat sc = 1.0 + amp * 0.16;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    _coreGrad.transform = CATransform3DMakeScale(sc, sc, 1.0);
    if (!_subBlob1.hidden) {
        _subBlob1.transform = CATransform3DConcat(CATransform3DMakeScale(sc, sc, 1.0), CATransform3DMakeRotation(phase * 0.85, 0, 0, 1));
        _subBlob2.transform = CATransform3DConcat(CATransform3DMakeScale(sc, sc, 1.0), CATransform3DMakeRotation(-phase * 1.05, 0, 0, 1));
    }
    [CATransaction commit];
}

- (void)setNeedsDisplay {}
@end

// ==================== 3. 纯 GPU 双轨高低交织流光丝带声波 (彻底移除突兀白斑，还原参考图大弧度交错丝带) ====================
@interface AGWaveCanvasView : UIView
@property (nonatomic, assign) CGFloat phase;
@property (nonatomic, assign) CGFloat amplitude;
- (void)applyTheme:(AGVisualTheme)theme;
- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp;
@end

@implementation AGWaveCanvasView {
    CAGradientLayer *_bottomHorizonGlow; // 底部柔和地平线环境光晕
    CAShapeLayer    *_fill1, *_glow1, *_stroke1;
    CAShapeLayer    *_fill2, *_glow2, *_stroke2;
    CAShapeLayer    *_fill3, *_glow3, *_stroke3;
    AGVisualTheme   _appliedTheme;
    BOOL            _hasInit;
}

- (instancetype)initWithFrame:(CGRect)frame {
    if (self = [super initWithFrame:frame]) {
        self.backgroundColor = [UIColor clearColor];
        self.userInteractionEnabled = NO;

        _bottomHorizonGlow = [CAGradientLayer layer];
        _bottomHorizonGlow.startPoint = CGPointMake(0.5, 0.0);
        _bottomHorizonGlow.endPoint = CGPointMake(0.5, 1.0);
        [self.layer addSublayer:_bottomHorizonGlow];

        CAShapeLayer *(^makeFill)(void) = ^{
            CAShapeLayer *l = [CAShapeLayer layer];
            l.strokeColor = [UIColor clearColor].CGColor;
            [self.layer addSublayer:l];
            return l;
        };
        CAShapeLayer *(^makeStroke)(CGFloat lw) = ^(CGFloat lw) {
            CAShapeLayer *l = [CAShapeLayer layer];
            l.fillColor = [UIColor clearColor].CGColor;
            l.lineWidth = lw;
            l.lineCap = kCALineCapRound;
            l.shadowOpacity = 0.0;
            [self.layer addSublayer:l];
            return l;
        };

        _fill3 = makeFill(); _glow3 = makeStroke(5.0); _stroke3 = makeStroke(1.8);
        _fill2 = makeFill(); _glow2 = makeStroke(5.8); _stroke2 = makeStroke(2.2);
        _fill1 = makeFill(); _glow1 = makeStroke(6.5); _stroke1 = makeStroke(2.6);

        [self applyTheme:agCurrentVisualTheme()];
    }
    return self;
}

- (void)layoutSubviews {
    [super layoutSubviews];
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    _bottomHorizonGlow.frame = self.bounds;
    [CATransaction commit];
}

- (void)applyTheme:(AGVisualTheme)theme {
    if (_hasInit && _appliedTheme == theme) return;
    _hasInit = YES;
    _appliedTheme = theme;

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    if (theme == AGVisualThemeLightLuxury) {
        _bottomHorizonGlow.colors = @[
            (__bridge id)[UIColor clearColor].CGColor,
            (__bridge id)[UIColor colorWithRed:0.96 green:0.76 blue:0.42 alpha:0.24].CGColor
        ];
        _stroke1.strokeColor = [UIColor colorWithRed:1.00 green:0.97 blue:0.88 alpha:1.0].CGColor;
        _glow1.strokeColor   = [UIColor colorWithRed:0.99 green:0.82 blue:0.48 alpha:0.35].CGColor;
        _fill1.fillColor     = [UIColor colorWithRed:0.98 green:0.82 blue:0.50 alpha:0.22].CGColor;

        _stroke2.strokeColor = [UIColor colorWithRed:0.90 green:0.64 blue:0.34 alpha:0.95].CGColor;
        _glow2.strokeColor   = [UIColor colorWithRed:0.88 green:0.58 blue:0.26 alpha:0.28].CGColor;
        _fill2.fillColor     = [UIColor colorWithRed:0.82 green:0.54 blue:0.24 alpha:0.16].CGColor;

        _stroke3.hidden = YES; _glow3.hidden = YES; _fill3.hidden = YES;
    } else if (theme == AGVisualThemeMinimalist) {
        _bottomHorizonGlow.colors = @[
            (__bridge id)[UIColor clearColor].CGColor,
            (__bridge id)[UIColor colorWithRed:0.38 green:0.72 blue:1.00 alpha:0.26].CGColor
        ];
        _stroke1.strokeColor = [UIColor colorWithRed:0.88 green:0.97 blue:1.00 alpha:1.0].CGColor;
        _glow1.strokeColor   = [UIColor colorWithRed:0.22 green:0.78 blue:1.00 alpha:0.38].CGColor;
        _fill1.fillColor     = [UIColor colorWithRed:0.38 green:0.78 blue:1.00 alpha:0.24].CGColor;

        _stroke2.strokeColor = [UIColor colorWithRed:0.94 green:0.48 blue:0.96 alpha:0.95].CGColor;
        _glow2.strokeColor   = [UIColor colorWithRed:0.85 green:0.32 blue:0.95 alpha:0.32].CGColor;
        _fill2.fillColor     = [UIColor colorWithRed:0.78 green:0.36 blue:0.96 alpha:0.18].CGColor;

        _stroke3.hidden = YES; _glow3.hidden = YES; _fill3.hidden = YES;
    } else if (theme == AGVisualThemeSakura) {
        _bottomHorizonGlow.colors = @[
            (__bridge id)[UIColor clearColor].CGColor,
            (__bridge id)[UIColor colorWithRed:1.00 green:0.68 blue:0.84 alpha:0.26].CGColor
        ];
        _stroke1.strokeColor = [UIColor colorWithRed:1.00 green:0.93 blue:0.96 alpha:1.0].CGColor;
        _glow1.strokeColor   = [UIColor colorWithRed:1.00 green:0.74 blue:0.86 alpha:0.38].CGColor;
        _fill1.fillColor     = [UIColor colorWithRed:1.00 green:0.76 blue:0.88 alpha:0.24].CGColor;

        _stroke2.strokeColor = [UIColor colorWithRed:1.00 green:0.56 blue:0.76 alpha:0.98].CGColor;
        _glow2.strokeColor   = [UIColor colorWithRed:0.98 green:0.46 blue:0.70 alpha:0.32].CGColor;
        _fill2.fillColor     = [UIColor colorWithRed:0.96 green:0.48 blue:0.72 alpha:0.19].CGColor;

        _stroke3.hidden = NO; _glow3.hidden = NO; _fill3.hidden = NO;
        _stroke3.strokeColor = [UIColor colorWithRed:0.88 green:0.64 blue:0.96 alpha:0.92].CGColor;
        _glow3.strokeColor   = [UIColor colorWithRed:0.84 green:0.54 blue:0.94 alpha:0.26].CGColor;
        _fill3.fillColor     = [UIColor colorWithRed:0.84 green:0.54 blue:0.94 alpha:0.15].CGColor;
    } else {
        _bottomHorizonGlow.colors = @[
            (__bridge id)[UIColor clearColor].CGColor,
            (__bridge id)[UIColor colorWithRed:0.00 green:0.88 blue:1.00 alpha:0.26].CGColor
        ];
        _stroke1.strokeColor = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:1.0].CGColor;
        _glow1.strokeColor   = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.36].CGColor;
        _fill1.fillColor     = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.24].CGColor;

        _stroke2.strokeColor = [UIColor colorWithRed:1.00 green:0.22 blue:0.62 alpha:1.0].CGColor;
        _glow2.strokeColor   = [UIColor colorWithRed:1.00 green:0.16 blue:0.52 alpha:0.32].CGColor;
        _fill2.fillColor     = [UIColor colorWithRed:1.00 green:0.16 blue:0.52 alpha:0.20].CGColor;

        _stroke3.hidden = NO; _glow3.hidden = NO; _fill3.hidden = NO;
        _stroke3.strokeColor = [UIColor colorWithRed:0.68 green:0.38 blue:0.98 alpha:0.95].CGColor;
        _glow3.strokeColor   = [UIColor colorWithRed:0.66 green:0.33 blue:0.97 alpha:0.28].CGColor;
        _fill3.fillColor     = [UIColor colorWithRed:0.66 green:0.33 blue:0.97 alpha:0.16].CGColor;
    }
    [CATransaction commit];
}

- (void)updateWavePairStroke:(CAShapeLayer *)sLayer glow:(CAShapeLayer *)gLayer fill:(CAShapeLayer *)fLayer width:(CGFloat)w height:(CGFloat)h midY:(CGFloat)midY amp:(CGFloat)amp freq:(CGFloat)freq speed:(CGFloat)sp phaseOffset:(CGFloat)pOff scale:(CGFloat)sc step:(CGFloat)step {
    UIBezierPath *openPath = [UIBezierPath bezierPath];
    for (CGFloat x = 0; x <= w; x += step) {
        CGFloat n = x / w;
        // 两端平滑收拢包络 + 中段优雅饱满的 S 型正弦交织曲线
        CGFloat env = 0.25 + 0.75 * sin(n * M_PI);
        CGFloat y = midY - sin(n * M_PI * freq + self.phase * sp + pOff) * (amp * sc) * env;
        if (x == 0) [openPath moveToPoint:CGPointMake(x, y)];
        else [openPath addLineToPoint:CGPointMake(x, y)];
    }

    UIBezierPath *closedPath = [openPath copy];
    [closedPath addLineToPoint:CGPointMake(w, h)];
    [closedPath addLineToPoint:CGPointMake(0, h)];
    [closedPath closePath];

    CGPathRef sharedOpenCGPath = openPath.CGPath;
    sLayer.path = sharedOpenCGPath;
    gLayer.path = sharedOpenCGPath;
    fLayer.path = closedPath.CGPath;
}

- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp {
    self.phase = phase;
    self.amplitude = amp;
    CGFloat w = self.bounds.size.width, h = self.bounds.size.height;
    if (w <= 10 || h <= 5) return;

    AGDeviceMetrics m = agComputeDeviceMetrics();
    CGFloat step = m.waveStepPt;
    CGFloat midY = h * 0.52;
    // 关键修复：即使在待机状态也保持优雅的 9.5pt 基础波峰弧度，让两条波浪始终呈现参考图的高低交错缠绕美感
    CGFloat waveAmp = (h * 0.21) + (h * 0.24) * amp;

    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    [self updateWavePairStroke:_stroke1 glow:_glow1 fill:_fill1 width:w height:h midY:midY amp:waveAmp freq:2.1 speed:0.95 phaseOffset:0.0 scale:1.0 step:step];
    [self updateWavePairStroke:_stroke2 glow:_glow2 fill:_fill2 width:w height:h midY:midY + 2.5 amp:waveAmp freq:2.6 speed:-1.10 phaseOffset:1.65 scale:0.88 step:step];
    if (!_stroke3.hidden) {
        [self updateWavePairStroke:_stroke3 glow:_glow3 fill:_fill3 width:w height:h midY:midY + 3.5 amp:waveAmp freq:3.1 speed:0.85 phaseOffset:3.10 scale:0.74 step:step];
    }
    [CATransaction commit];
}

- (void)setNeedsDisplay {}
@end

@interface CALayer (AGHitTestPassthrough)
- (void)setAllowsHitTesting:(BOOL)allows;
- (void)setHitTestsAsOpaque:(BOOL)opaque;
@end

static void agDisableLayerHitTestingRecursively(CALayer *layer) {
    if (!layer) return;
    if ([layer respondsToSelector:@selector(setAllowsHitTesting:)]) {
        [layer setAllowsHitTesting:NO];
    }
    if ([layer respondsToSelector:@selector(setHitTestsAsOpaque:)]) {
        [layer setHitTestsAsOpaque:NO];
    }
    for (CALayer *sub in layer.sublayers) {
        agDisableLayerHitTestingRecursively(sub);
    }
}

// ==================== 3B. 四大殿堂级唤出形态配置读取与纯 GPU 渲染引擎 ====================
// 返回值：1=①4D水晶胶囊(默认), 2=②灵动岛极光水滴, 3=③无界北极光天际线, 4=④3D全息丝绸, 0=传统直接弹主界面
static NSInteger agMiniSummonStyle(void) {
    if (!gCachedPrefs) reloadGeminiPrefsCache();
    NSNumber *val = gCachedPrefs[@"AG_MiniSummon_Style"];
    if (!val) return 1;
    NSInteger s = [val integerValue];
    if (s < 0 || s > 4) return 1;
    return s;
}

// 返回值：NO=底部悬浮(默认), YES=顶部灵动岛/刘海自适应
static BOOL agMiniSummonIsTop(void) {
    if (!gCachedPrefs) reloadGeminiPrefsCache();
    NSNumber *val = gCachedPrefs[@"AG_MiniSummon_Position"];
    return val ? ([val integerValue] == 1) : NO;
}

@interface AGMiniSummonCanvasView : UIView
@property (nonatomic, assign) NSInteger styleIndex;
@property (nonatomic, assign) BOOL isTopPosition;
@property (nonatomic, assign) BOOL hasDynamicIsland;
@property (nonatomic, assign) AGVisualTheme currentTheme;
@property (nonatomic, strong) UILabel *captionLabel;
@property (nonatomic, strong) UIButton *closeButton;
@property (nonatomic, copy) void (^onTapExpand)(void);
@property (nonatomic, copy) void (^onTapClose)(void);
- (void)refreshStyleAndThemeLayout;
- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp;
@end

@implementation AGMiniSummonCanvasView {
    // 款式 ① & ② 共用组件
    UIView          *_pillContainer;
    AGCardBgCanvasView *_s1CrystalBg;
    UIView          *_s2DropBlackBg;
    CAGradientLayer *_s2ConicSpinner;
    CAShapeLayer    *_s2ConicMask;
    CAGradientLayer *_s2BottomBloom;
    AGOrbCanvasView *_miniOrbView;
    AGWaveCanvasView *_miniWaveView;

    // 款式 ③：无界北极光海浪天际线 (自适应顶部/底部 & 灵动岛/刘海) + 飘落星尘微粒
    UIView          *_s3HorizonContainer;
    CAGradientLayer *_s3IslandHaloLayer;
    CAGradientLayer *_s3AuroraCurtainLayer;
    CAShapeLayer    *_s3WaveStrokes[3];
    CAShapeLayer    *_s3WaveFills[3];
    CALayer         *_s3StarLayers[18];
    CGPoint         _s3StarPos[18];
    CGFloat         _s3StarSpeed[18];
    UIView          *_s3CaptionPillBg;

    // 款式 ④：3D 全息丝绸莫比乌斯光带 + 晶核浮窗
    UIView          *_s4SilkContainer;
    CAGradientLayer *_s4AmbientBloomLayer;
    CAShapeLayer    *_s4SilkLayers[4];
    UIView          *_s4JewelBadgeView;
    UIView          *_s4JewelDot;
}

- (instancetype)initWithFrame:(CGRect)frame {
    if (self = [super initWithFrame:frame]) {
        self.backgroundColor = [UIColor clearColor];
        self.clipsToBounds = NO;
        AGDeviceMetrics m = agComputeDeviceMetrics();
        _hasDynamicIsland = m.hasDynamicIsland;

        // 1. 款式 ① & ② 胶囊容器
        _pillContainer = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 252, 48)];
        _pillContainer.backgroundColor = [UIColor clearColor];
        _pillContainer.clipsToBounds = YES;
        [self addSubview:_pillContainer];

        _s1CrystalBg = [[AGCardBgCanvasView alloc] initWithFrame:_pillContainer.bounds];
        _s1CrystalBg.cornerRadius = 24.0;
        [_pillContainer addSubview:_s1CrystalBg];

        _s2DropBlackBg = [[UIView alloc] initWithFrame:_pillContainer.bounds];
        _s2DropBlackBg.backgroundColor = [UIColor blackColor];
        _s2DropBlackBg.userInteractionEnabled = NO;
        [_pillContainer addSubview:_s2DropBlackBg];

        _s2BottomBloom = [CAGradientLayer layer];
        _s2BottomBloom.startPoint = CGPointMake(0.0, 0.5);
        _s2BottomBloom.endPoint = CGPointMake(1.0, 0.5);
        [_s2DropBlackBg.layer addSublayer:_s2BottomBloom];

        CALayer *conicWrap = [CALayer layer];
        conicWrap.frame = CGRectMake(0, 0, 252, 54);
        _s2ConicSpinner = [CAGradientLayer layer];
        _s2ConicSpinner.type = kCAGradientLayerConic;
        _s2ConicSpinner.bounds = CGRectMake(0, 0, 300, 300);
        _s2ConicSpinner.position = CGPointMake(126, 25);
        _s2ConicSpinner.startPoint = CGPointMake(0.5, 0.5);
        _s2ConicSpinner.endPoint = CGPointMake(1.0, 0.5);
        [conicWrap addSublayer:_s2ConicSpinner];
        _s2ConicMask = [CAShapeLayer layer];
        _s2ConicMask.fillRule = kCAFillRuleEvenOdd;
        conicWrap.mask = _s2ConicMask;
        [_s2DropBlackBg.layer addSublayer:conicWrap];

        _miniWaveView = [[AGWaveCanvasView alloc] initWithFrame:CGRectMake(40, 4, 168, 44)];
        _miniWaveView.alpha = 0.86;
        [_pillContainer addSubview:_miniWaveView];

        _miniOrbView = [[AGOrbCanvasView alloc] initWithFrame:CGRectMake(8, 8, 32, 32)];
        [_pillContainer addSubview:_miniOrbView];

        // 2. 款式 ③ 无界北极光海浪天际线容器
        _s3HorizonContainer = [[UIView alloc] initWithFrame:CGRectMake(0, 0, m.screenW, 110)];
        _s3HorizonContainer.backgroundColor = [UIColor clearColor];
        _s3HorizonContainer.clipsToBounds = NO;
        [self addSubview:_s3HorizonContainer];

        _s3IslandHaloLayer = [CAGradientLayer layer];
        _s3IslandHaloLayer.type = kCAGradientLayerRadial;
        _s3IslandHaloLayer.startPoint = CGPointMake(0.5, 0.5);
        _s3IslandHaloLayer.endPoint = CGPointMake(1.0, 1.0);
        [_s3HorizonContainer.layer addSublayer:_s3IslandHaloLayer];

        _s3AuroraCurtainLayer = [CAGradientLayer layer];
        _s3AuroraCurtainLayer.type = kCAGradientLayerRadial;
        _s3AuroraCurtainLayer.startPoint = CGPointMake(0.5, 0.5);
        _s3AuroraCurtainLayer.endPoint = CGPointMake(1.0, 1.0);
        [_s3HorizonContainer.layer addSublayer:_s3AuroraCurtainLayer];

        for (int i = 0; i < 3; i++) {
            _s3WaveFills[i] = [CAShapeLayer layer];
            _s3WaveFills[i].strokeColor = [UIColor clearColor].CGColor;
            [_s3HorizonContainer.layer addSublayer:_s3WaveFills[i]];

            _s3WaveStrokes[i] = [CAShapeLayer layer];
            _s3WaveStrokes[i].fillColor = [UIColor clearColor].CGColor;
            _s3WaveStrokes[i].lineWidth = 2.2;
            _s3WaveStrokes[i].lineCap = kCALineCapRound;
            [_s3HorizonContainer.layer addSublayer:_s3WaveStrokes[i]];
        }

        for (int i = 0; i < 18; i++) {
            _s3StarLayers[i] = [CALayer layer];
            CGFloat r = 1.2 + (arc4random_uniform(14) * 0.1);
            _s3StarLayers[i].bounds = CGRectMake(0, 0, r * 2.0, r * 2.0);
            _s3StarLayers[i].cornerRadius = r;
            _s3StarLayers[i].backgroundColor = [UIColor whiteColor].CGColor;
            _s3StarPos[i] = CGPointMake(24.0 + arc4random_uniform((uint32_t)MAX(100, m.screenW - 48)), arc4random_uniform(90));
            _s3StarSpeed[i] = 0.35 + (arc4random_uniform(60) * 0.01);
            [_s3HorizonContainer.layer addSublayer:_s3StarLayers[i]];
        }

        _s3CaptionPillBg = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 230, 28)];
        _s3CaptionPillBg.backgroundColor = [UIColor colorWithRed:0.03 green:0.05 blue:0.14 alpha:0.58];
        _s3CaptionPillBg.layer.cornerRadius = 14.0;
        _s3CaptionPillBg.userInteractionEnabled = NO;
        [_s3HorizonContainer addSubview:_s3CaptionPillBg];

        // 3. 款式 ④ 3D 全息丝绸莫比乌斯光带容器
        _s4SilkContainer = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 288, 76)];
        _s4SilkContainer.backgroundColor = [UIColor clearColor];
        _s4SilkContainer.clipsToBounds = NO;
        [self addSubview:_s4SilkContainer];

        _s4AmbientBloomLayer = [CAGradientLayer layer];
        _s4AmbientBloomLayer.type = kCAGradientLayerRadial;
        _s4AmbientBloomLayer.startPoint = CGPointMake(0.5, 0.5);
        _s4AmbientBloomLayer.endPoint = CGPointMake(1.0, 1.0);
        _s4AmbientBloomLayer.frame = CGRectMake(24, 14, 240, 48);
        [_s4SilkContainer.layer addSublayer:_s4AmbientBloomLayer];

        for (int i = 0; i < 4; i++) {
            _s4SilkLayers[i] = [CAShapeLayer layer];
            _s4SilkLayers[i].lineWidth = 1.35;
            _s4SilkLayers[i].lineCap = kCALineCapRound;
            [_s4SilkContainer.layer addSublayer:_s4SilkLayers[i]];
        }

        _s4JewelBadgeView = [[UIView alloc] initWithFrame:CGRectMake(24, 21, 240, 34)];
        _s4JewelBadgeView.layer.cornerRadius = 17.0;
        _s4JewelBadgeView.layer.borderWidth = 1.1;
        _s4JewelBadgeView.userInteractionEnabled = NO;
        [_s4SilkContainer addSubview:_s4JewelBadgeView];

        _s4JewelDot = [[UIView alloc] initWithFrame:CGRectMake(12, 13, 8, 8)];
        _s4JewelDot.layer.cornerRadius = 4.0;
        _s4JewelDot.backgroundColor = [UIColor whiteColor];
        [_s4JewelBadgeView addSubview:_s4JewelDot];

        // 共用前景动态字幕与关闭按钮
        _captionLabel = [[UILabel alloc] init];
        _captionLabel.textColor = [UIColor whiteColor];
        _captionLabel.font = [UIFont systemFontOfSize:12.5 weight:UIFontWeightBold];
        _captionLabel.textAlignment = NSTextAlignmentLeft;
        _captionLabel.lineBreakMode = NSLineBreakByTruncatingTail;
        _captionLabel.layer.shadowColor = [UIColor blackColor].CGColor;
        _captionLabel.layer.shadowRadius = 4.0;
        _captionLabel.layer.shadowOpacity = 0.85;
        _captionLabel.layer.shadowOffset = CGSizeMake(0, 1);
        _captionLabel.text = @"🎙️ 直接开口说话，轻点展开...";
        [self addSubview:_captionLabel];

        _closeButton = [UIButton buttonWithType:UIButtonTypeCustom];
        _closeButton.frame = CGRectMake(0, 0, 24, 24);
        _closeButton.backgroundColor = [UIColor colorWithRed:0.06 green:0.09 blue:0.22 alpha:0.68];
        _closeButton.layer.cornerRadius = 12.0;
        _closeButton.layer.borderWidth = 1.1;
        [_closeButton setTitle:@"✕" forState:UIControlStateNormal];
        [_closeButton setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
        _closeButton.titleLabel.font = [UIFont systemFontOfSize:10.5 weight:UIFontWeightHeavy];
        [_closeButton addTarget:self action:@selector(handleCloseBtnTapped) forControlEvents:UIControlEventTouchUpInside];
        [self addSubview:_closeButton];

        UITapGestureRecognizer *expandTap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(handleExpandTap:)];
        [self addGestureRecognizer:expandTap];

        if ([self.layer respondsToSelector:@selector(setHitTestsAsOpaque:)]) {
            [self.layer setHitTestsAsOpaque:NO];
        }
        agDisableLayerHitTestingRecursively(_s3HorizonContainer.layer);
        agDisableLayerHitTestingRecursively(_s4SilkContainer.layer);
    }
    return self;
}

- (void)handleCloseBtnTapped {
    if (self.onTapClose) self.onTapClose();
}

- (BOOL)pointInside:(CGPoint)point withEvent:(UIEvent *)event {
    if (self.hidden || self.alpha < 0.05) return NO;
    if (CGRectContainsPoint(CGRectInset(self.closeButton.frame, -8, -8), point)) return YES;
    if (self.styleIndex == 3) {
        // 款式 ③ 极光天际线：仅中间字幕条与关闭钮可点，四周极光海浪 100% 穿透不挡滑动！
        return CGRectContainsPoint(CGRectInset(_s3CaptionPillBg.frame, -10, -8), point);
    } else if (self.styleIndex == 4) {
        // 款式 ④ 全息丝绸：仅中间晶核铭牌与关闭钮可点，外围丝绸光晕 100% 穿透！
        return CGRectContainsPoint(CGRectInset(_s4JewelBadgeView.frame, -8, -6), point);
    }
    return CGRectContainsPoint(self.bounds, point);
}

- (void)handleExpandTap:(UITapGestureRecognizer *)tap {
    CGPoint pt = [tap locationInView:self];
    if (CGRectContainsPoint(CGRectInset(self.closeButton.frame, -8, -8), pt)) {
        [self handleCloseBtnTapped];
        return;
    }
    if (self.onTapExpand) self.onTapExpand();
}

- (void) obtainThemeColors:(UIColor **)outC1 c2:(UIColor **)outC2 c3:(UIColor **)outC3 c4:(UIColor **)outC4 rim:(UIColor **)outRim pillBg:(UIColor **)outPillBg {
    AGVisualTheme th = self.currentTheme;
    if (th == AGVisualThemeLightLuxury) {
        *outC1 = [UIColor colorWithRed:1.00 green:0.90 blue:0.64 alpha:1.0];
        *outC2 = [UIColor colorWithRed:0.90 green:0.56 blue:0.22 alpha:1.0];
        *outC3 = [UIColor colorWithRed:0.72 green:0.38 blue:0.11 alpha:1.0];
        *outC4 = [UIColor whiteColor];
        *outRim = [UIColor colorWithRed:0.99 green:0.86 blue:0.62 alpha:0.92];
        *outPillBg = [UIColor colorWithRed:0.12 green:0.08 blue:0.06 alpha:0.78];
    } else if (th == AGVisualThemeMinimalist) {
        *outC1 = [UIColor colorWithRed:0.88 green:0.96 blue:1.00 alpha:1.0];
        *outC2 = [UIColor colorWithRed:0.22 green:0.66 blue:1.00 alpha:1.0];
        *outC3 = [UIColor colorWithRed:0.55 green:0.38 blue:0.96 alpha:1.0];
        *outC4 = [UIColor whiteColor];
        *outRim = [UIColor colorWithRed:0.82 green:0.94 blue:1.00 alpha:0.95];
        *outPillBg = [UIColor colorWithRed:0.08 green:0.14 blue:0.34 alpha:0.72];
    } else if (th == AGVisualThemeSakura) {
        *outC1 = [UIColor colorWithRed:1.00 green:0.86 blue:0.93 alpha:1.0];
        *outC2 = [UIColor colorWithRed:1.00 green:0.32 blue:0.65 alpha:1.0];
        *outC3 = [UIColor colorWithRed:0.78 green:0.42 blue:0.98 alpha:1.0];
        *outC4 = [UIColor whiteColor];
        *outRim = [UIColor colorWithRed:1.00 green:0.78 blue:0.89 alpha:0.95];
        *outPillBg = [UIColor colorWithRed:0.18 green:0.07 blue:0.14 alpha:0.76];
    } else {
        *outC1 = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:1.0];
        *outC2 = [UIColor colorWithRed:1.00 green:0.16 blue:0.52 alpha:1.0];
        *outC3 = [UIColor colorWithRed:0.54 green:0.25 blue:0.98 alpha:1.0];
        *outC4 = [UIColor colorWithRed:1.00 green:0.91 blue:0.52 alpha:1.0];
        *outRim = [UIColor colorWithRed:0.00 green:0.96 blue:1.00 alpha:0.92];
        *outPillBg = [UIColor colorWithRed:0.05 green:0.09 blue:0.26 alpha:0.76];
    }
}

- (void)refreshStyleAndThemeLayout {
    AGDeviceMetrics m = agComputeDeviceMetrics();
    self.styleIndex = agMiniSummonStyle();
    self.isTopPosition = agMiniSummonIsTop();
    self.currentTheme = agCurrentVisualTheme();
    self.hasDynamicIsland = m.hasDynamicIsland;

    UIColor *c1, *c2, *c3, *c4, *rimCol, *pillBgCol;
    [self obtainThemeColors:&c1 c2:&c2 c3:&c3 c4:&c4 rim:&rimCol pillBg:&pillBgCol];

    [_s1CrystalBg applyTheme:self.currentTheme];
    [_miniOrbView applyTheme:self.currentTheme];
    [_miniWaveView applyTheme:self.currentTheme];
    _closeButton.layer.borderColor = rimCol.CGColor;

    _pillContainer.hidden = !(self.styleIndex == 1 || self.styleIndex == 2);
    _s3HorizonContainer.hidden = (self.styleIndex != 3);
    _s4SilkContainer.hidden = (self.styleIndex != 4);

    if (self.styleIndex == 1 || self.styleIndex == 2) {
        BOOL isStyle2 = (self.styleIndex == 2);
        BOOL isNotchTopMerge = (isStyle2 && self.isTopPosition && !self.hasDynamicIsland);
        CGFloat w = 254.0;
        CGFloat h = isNotchTopMerge ? 56.0 : (isStyle2 ? 50.0 : 48.0);
        CGFloat y = 0.0;
        if (self.isTopPosition) {
            if (isStyle2) {
                y = self.hasDynamicIsland ? 8.0 : 0.0;
            } else {
                y = self.hasDynamicIsland ? 58.0 : (m.safeTop + 4.0);
            }
        } else {
            y = m.screenH - m.bottomRestMargin - h - 4.0;
        }
        self.frame = CGRectMake((m.screenW - w) * 0.5, y, w, h);
        _pillContainer.frame = self.bounds;
        _s1CrystalBg.hidden = isStyle2;
        _s2DropBlackBg.hidden = !isStyle2;

        CGFloat topPad = isNotchTopMerge ? 8.0 : 0.0;
        CGFloat contentH = h - topPad;

        if (!isStyle2) {
            _pillContainer.layer.cornerRadius = h * 0.5;
            _s1CrystalBg.cornerRadius = h * 0.5;
            _s1CrystalBg.frame = _pillContainer.bounds;
            [_s1CrystalBg rebuildStaticGlassShellTextureIfNeeded];
        } else {
            _s2DropBlackBg.frame = _pillContainer.bounds;
            UIRectCorner corners = isNotchTopMerge ? (UIRectCornerBottomLeft | UIRectCornerBottomRight) : UIRectCornerAllCorners;
            UIBezierPath *outerP = [UIBezierPath bezierPathWithRoundedRect:_pillContainer.bounds byRoundingCorners:corners cornerRadii:CGSizeMake(25, 25)];
            CAShapeLayer *clipM = [CAShapeLayer layer];
            clipM.path = outerP.CGPath;
            _pillContainer.layer.mask = clipM;

            UIBezierPath *ringP = [UIBezierPath bezierPathWithRoundedRect:_pillContainer.bounds byRoundingCorners:corners cornerRadii:CGSizeMake(25, 25)];
            UIBezierPath *innerP = [UIBezierPath bezierPathWithRoundedRect:CGRectInset(_pillContainer.bounds, 3.2, 3.2) byRoundingCorners:corners cornerRadii:CGSizeMake(22, 22)];
            [ringP appendPath:innerP];
            ringP.usesEvenOddFillRule = YES;
            _s2ConicMask.path = ringP.CGPath;
            _s2ConicSpinner.colors = @[(__bridge id)c1.CGColor, (__bridge id)c2.CGColor, (__bridge id)c3.CGColor, (__bridge id)c4.CGColor, (__bridge id)c1.CGColor];
            _s2BottomBloom.frame = CGRectMake(-20, h - 18, w + 40, 28);
            _s2BottomBloom.colors = @[(__bridge id)[c1 colorWithAlphaComponent:0.55].CGColor, (__bridge id)[c2 colorWithAlphaComponent:0.55].CGColor, (__bridge id)[c3 colorWithAlphaComponent:0.55].CGColor];
        }
        if (!isStyle2) _pillContainer.layer.mask = nil;

        _miniOrbView.frame = CGRectMake(8, topPad + (contentH - 32.0) * 0.5, 32, 32);
        _miniWaveView.frame = CGRectMake(40, topPad + 2.0, w - 74.0, contentH - 4.0);
        _captionLabel.frame = CGRectMake(46, topPad, w - 80.0, contentH);
        _captionLabel.textAlignment = NSTextAlignmentLeft;
        _closeButton.frame = CGRectMake(w - 31.0, topPad + (contentH - 24.0) * 0.5, 24, 24);
    } else if (self.styleIndex == 3) {
        // 款式 ③：无界北极光海浪天际线 (自动识别顶部/底部 + 灵动岛/刘海)
        CGFloat h = 112.0;
        CGFloat y = self.isTopPosition ? 0.0 : (m.screenH - h);
        self.frame = CGRectMake(0, y, m.screenW, h);
        _s3HorizonContainer.frame = self.bounds;

        if (self.isTopPosition) {
            _s3IslandHaloLayer.hidden = NO;
            CGFloat haloW = self.hasDynamicIsland ? 156.0 : 186.0;
            CGFloat haloY = self.hasDynamicIsland ? 4.0 : -8.0;
            _s3IslandHaloLayer.frame = CGRectMake((m.screenW - haloW) * 0.5, haloY, haloW, 44.0);
            _s3IslandHaloLayer.colors = @[(__bridge id)[UIColor whiteColor].CGColor, (__bridge id)[c1 colorWithAlphaComponent:0.75].CGColor, (__bridge id)[c2 colorWithAlphaComponent:0.42].CGColor, (__bridge id)[UIColor clearColor].CGColor];

            _s3AuroraCurtainLayer.frame = CGRectMake(-m.screenW * 0.15, -26.0, m.screenW * 1.3, 102.0);
            _s3AuroraCurtainLayer.colors = @[(__bridge id)[c1 colorWithAlphaComponent:0.62].CGColor, (__bridge id)[c3 colorWithAlphaComponent:0.42].CGColor, (__bridge id)[UIColor clearColor].CGColor];

            CGFloat capY = self.hasDynamicIsland ? 44.0 : 32.0;
            _s3CaptionPillBg.frame = CGRectMake((m.screenW - 236.0) * 0.5, capY, 236.0, 28.0);
            _captionLabel.frame = CGRectMake((m.screenW - 220.0) * 0.5, capY, 220.0, 28.0);
            _captionLabel.textAlignment = NSTextAlignmentCenter;
            _closeButton.frame = CGRectMake(m.screenW - 38.0, capY + 2.0, 24.0, 24.0);
        } else {
            _s3IslandHaloLayer.hidden = YES;
            _s3AuroraCurtainLayer.frame = CGRectMake(-m.screenW * 0.15, h - 78.0, m.screenW * 1.3, 102.0);
            _s3AuroraCurtainLayer.colors = @[(__bridge id)[c1 colorWithAlphaComponent:0.62].CGColor, (__bridge id)[c3 colorWithAlphaComponent:0.42].CGColor, (__bridge id)[UIColor clearColor].CGColor];

            CGFloat capY = h - 54.0;
            _s3CaptionPillBg.frame = CGRectMake((m.screenW - 236.0) * 0.5, capY, 236.0, 28.0);
            _captionLabel.frame = CGRectMake((m.screenW - 220.0) * 0.5, capY, 220.0, 28.0);
            _captionLabel.textAlignment = NSTextAlignmentCenter;
            _closeButton.frame = CGRectMake(m.screenW - 38.0, capY + 2.0, 24.0, 24.0);
        }
    } else if (self.styleIndex == 4) {
        // 款式 ④：3D 全息丝绸莫比乌斯光带
        CGFloat w = 292.0;
        CGFloat h = 76.0;
        CGFloat y = self.isTopPosition ? (self.hasDynamicIsland ? 48.0 : (m.safeTop - 2.0)) : (m.screenH - m.bottomRestMargin - h + 4.0);
        self.frame = CGRectMake((m.screenW - w) * 0.5, y, w, h);
        _s4SilkContainer.frame = self.bounds;
        _s4AmbientBloomLayer.colors = @[(__bridge id)[c1 colorWithAlphaComponent:0.48].CGColor, (__bridge id)[c2 colorWithAlphaComponent:0.32].CGColor, (__bridge id)[UIColor clearColor].CGColor];

        _s4JewelBadgeView.frame = CGRectMake(22.0, 21.0, w - 44.0, 34.0);
        _s4JewelBadgeView.backgroundColor = pillBgCol;
        _s4JewelBadgeView.layer.borderColor = rimCol.CGColor;
        _s4JewelDot.layer.shadowColor = c1.CGColor;
        _s4JewelDot.layer.shadowRadius = 6.0;
        _s4JewelDot.layer.shadowOpacity = 1.0;

        _captionLabel.frame = CGRectMake(48.0, 21.0, w - 104.0, 34.0);
        _captionLabel.textAlignment = NSTextAlignmentLeft;
        _closeButton.frame = CGRectMake(w - 50.0, 26.0, 24.0, 24.0);
    }
}

- (void)stepAnimationWithPhase:(CGFloat)phase amplitude:(CGFloat)amp {
    if (self.hidden) return;
    UIColor *c1, *c2, *c3, *c4, *rimCol, *pillBgCol;
    [self obtainThemeColors:&c1 c2:&c2 c3:&c3 c4:&c4 rim:&rimCol pillBg:&pillBgCol];

    [CATransaction begin];
    [CATransaction setDisableActions:YES];

    if (self.styleIndex == 1 || self.styleIndex == 2) {
        [_s1CrystalBg stepAnimationWithPhase:phase amplitude:amp];
        [_miniOrbView stepAnimationWithPhase:phase amplitude:amp];
        [_miniWaveView stepAnimationWithPhase:phase amplitude:amp];
        if (self.styleIndex == 2) {
            _s2ConicSpinner.transform = CATransform3DMakeRotation(fmod(phase * 0.55, M_PI * 2.0), 0, 0, 1.0);
        }
    } else if (self.styleIndex == 3) {
        CGFloat w = self.bounds.size.width;
        CGFloat h = self.bounds.size.height;
        NSArray<UIColor *> *wCols = @[c3, c2, c1];
        CGFloat freqs[3] = {1.6, 2.2, 1.9};
        CGFloat speeds[3] = {0.7, -1.1, 1.0};
        CGFloat offs[3] = {0.0, 1.8, 3.4};
        CGFloat baseAmp = (10.0 + amp * 12.0);

        for (int i = 0; i < 3; i++) {
            UIBezierPath *openP = [UIBezierPath bezierPath];
            CGFloat baseY = self.isTopPosition ? (self.hasDynamicIsland ? 62.0 : 50.0) : (h * 0.62);
            for (CGFloat x = 0; x <= w; x += 5.0) {
                CGFloat n = x / MAX(1.0, w);
                CGFloat env = 0.25 + 0.75 * sin(n * M_PI);
                CGFloat y = baseY;
                if (self.isTopPosition) {
                    CGFloat gaussian = exp(-pow((n - 0.5) * (self.hasDynamicIsland ? 4.5 : 3.2), 2.0));
                    CGFloat dip = self.hasDynamicIsland ? (10.0 * gaussian) : (-6.0 * gaussian);
                    y = baseY + dip + sin(n * M_PI * freqs[i] + phase * speeds[i] + offs[i]) * baseAmp * env;
                } else {
                    y = baseY - sin(n * M_PI * freqs[i] + phase * speeds[i] + offs[i]) * baseAmp * env;
                }
                if (x == 0) [openP moveToPoint:CGPointMake(x, y)];
                else [openP addLineToPoint:CGPointMake(x, y)];
            }
            UIBezierPath *closedP = [openP copy];
            if (self.isTopPosition) {
                [closedP addLineToPoint:CGPointMake(w, 0)];
                [closedP addLineToPoint:CGPointMake(0, 0)];
            } else {
                [closedP addLineToPoint:CGPointMake(w, h)];
                [closedP addLineToPoint:CGPointMake(0, h)];
            }
            [closedP closePath];
            _s3WaveStrokes[i].path = openP.CGPath;
            _s3WaveStrokes[i].strokeColor = [wCols[i] colorWithAlphaComponent:0.92].CGColor;
            _s3WaveFills[i].path = closedP.CGPath;
            _s3WaveFills[i].fillColor = [wCols[i] colorWithAlphaComponent:0.20].CGColor;
        }

        for (int i = 0; i < 18; i++) {
            CGPoint p = _s3StarPos[i];
            if (self.isTopPosition) {
                p.y += _s3StarSpeed[i];
                if (p.y > h - 8.0) { p.y = 4.0; p.x = 24.0 + arc4random_uniform((uint32_t)MAX(100, w - 48.0)); }
            } else {
                p.y -= _s3StarSpeed[i];
                if (p.y < 12.0) { p.y = h - 4.0; p.x = 24.0 + arc4random_uniform((uint32_t)MAX(100, w - 48.0)); }
            }
            _s3StarPos[i] = p;
            _s3StarLayers[i].position = p;
            CGFloat twinkle = 0.25 + 0.75 * fabs(sin(phase * 1.6 + i));
            _s3StarLayers[i].opacity = (float)twinkle;
        }
    } else if (self.styleIndex == 4) {
        CGFloat w = self.bounds.size.width;
        CGFloat h = self.bounds.size.height;
        CGFloat midY = h * 0.50;
        NSArray<UIColor *> *sCols = @[c1, c2, c3, c4];
        CGFloat freqs[4] = {1.7, 2.1, 1.4, 2.5};
        CGFloat speeds[4] = {1.05, -1.15, 0.85, -0.95};
        CGFloat amps[4] = {20.0, 17.0, 22.0, 13.0};
        CGFloat offs[4] = {0.0, 1.9, 3.8, 5.1};
        CGFloat ampBoost = 1.0 + amp * 0.45;

        for (int i = 0; i < 4; i++) {
            UIBezierPath *silkP = [UIBezierPath bezierPath];
            for (CGFloat x = 8.0; x <= w - 8.0; x += 5.0) {
                CGFloat n = (x - 8.0) / MAX(1.0, w - 16.0);
                CGFloat env = pow(sin(n * M_PI), 1.45);
                CGFloat y1 = midY - sin(n * M_PI * freqs[i] + phase * speeds[i] + offs[i]) * (amps[i] * ampBoost) * env;
                if (x == 8.0) [silkP moveToPoint:CGPointMake(x, y1)];
                else [silkP addLineToPoint:CGPointMake(x, y1)];
            }
            for (CGFloat x = w - 8.0; x >= 8.0; x -= 5.0) {
                CGFloat n = (x - 8.0) / MAX(1.0, w - 16.0);
                CGFloat env = pow(sin(n * M_PI), 1.45);
                CGFloat y2 = midY + cos(n * M_PI * freqs[i] - phase * speeds[i] * 0.9 + offs[i]) * (amps[i] * 0.62 * ampBoost) * env;
                [silkP addLineToPoint:CGPointMake(x, y2)];
            }
            [silkP closePath];
            _s4SilkLayers[i].path = silkP.CGPath;
            _s4SilkLayers[i].strokeColor = [sCols[i] colorWithAlphaComponent:0.90].CGColor;
            _s4SilkLayers[i].fillColor = [sCols[i] colorWithAlphaComponent:0.24].CGColor;
        }
    }

    [CATransaction commit];
}
@end

// ==================== 4. 带内存静态缓存的 3D 深邃球面镜液态玻璃圆钮渲染器 ====================
static UIImage *agRenderCompleteCircleButtonImage(AGVectorIconType iconType, CGFloat diameter, AGVisualTheme theme, BOOL isActive, NSInteger modeSlot) {
    static NSMutableDictionary<NSString *, UIImage *> *gBtnImageCache = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        gBtnImageCache = [NSMutableDictionary dictionaryWithCapacity:36];
    });

    NSString *cacheKey = [NSString stringWithFormat:@"v63_%ld_%ld_%.1f_%d_%ld", (long)iconType, (long)theme, diameter, isActive ? 1 : 0, (long)modeSlot];
    UIImage *cached = gBtnImageCache[cacheKey];
    if (cached) return cached;

    UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat];
    fmt.scale = [UIScreen mainScreen].scale;
    fmt.opaque = NO;
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(diameter, diameter) format:fmt];
    UIImage *resultImg = [renderer imageWithActions:^(UIGraphicsImageRendererContext * _Nonnull rCtx) {
        CGContextRef ctx = rCtx.CGContext;
        CGRect rect = CGRectMake(0, 0, diameter, diameter);
        UIBezierPath *circle = [UIBezierPath bezierPathWithOvalInRect:CGRectInset(rect, 0.9, 0.9)];
        CGContextSaveGState(ctx);
        [circle addClip];

        CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
        UIColor *iconColor = [UIColor whiteColor];
        UIColor *outerRimColor = [UIColor colorWithWhite:1.0 alpha:0.90];
        UIColor *innerRimColor = [UIColor colorWithWhite:1.0 alpha:0.42];

        if (theme == AGVisualThemeLightLuxury) {
            if (isActive) {
                CGFloat locs[3] = {0.0, 0.52, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.5, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.52), diameter * 0.62,
                                     @[[UIColor whiteColor],
                                       [UIColor colorWithRed:0.99 green:0.88 blue:0.66 alpha:0.96],
                                       [UIColor colorWithRed:0.78 green:0.52 blue:0.26 alpha:0.98]], locs);
                iconColor = [UIColor colorWithRed:0.16 green:0.10 blue:0.04 alpha:1.0];
                outerRimColor = [UIColor whiteColor];
                innerRimColor = [UIColor colorWithRed:1.0 green:0.95 blue:0.82 alpha:0.90];
            } else {
                // 未激活按钮采用深邃黑金玻璃心，告别浅灰塑料感
                CGFloat locs[3] = {0.0, 0.58, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.45, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.5), diameter * 0.68,
                                     @[[UIColor colorWithRed:0.52 green:0.38 blue:0.24 alpha:0.68],
                                       [UIColor colorWithRed:0.10 green:0.07 blue:0.06 alpha:0.86],
                                       [UIColor colorWithRed:0.28 green:0.19 blue:0.12 alpha:0.88]], locs);
                iconColor = [UIColor colorWithRed:1.00 green:0.95 blue:0.86 alpha:0.98];
                outerRimColor = [UIColor colorWithRed:0.99 green:0.86 blue:0.64 alpha:0.88];
                innerRimColor = [UIColor colorWithWhite:1.0 alpha:0.38];
            }
        } else if (theme == AGVisualThemeMinimalist) {
            if (isActive) {
                CGFloat locs[3] = {0.0, 0.52, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.5, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.52), diameter * 0.62,
                                     @[[UIColor whiteColor],
                                       [UIColor colorWithRed:0.32 green:0.68 blue:1.00 alpha:0.92],
                                       [UIColor colorWithRed:0.56 green:0.34 blue:0.96 alpha:0.95]], locs);
                iconColor = [UIColor whiteColor];
                outerRimColor = [UIColor whiteColor];
                innerRimColor = [UIColor colorWithRed:0.85 green:0.95 blue:1.00 alpha:0.92];
            } else {
                // 深海藍宝石镜面内芯 + 冰白双高光环
                CGFloat locs[3] = {0.0, 0.58, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.45, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.5), diameter * 0.68,
                                     @[[UIColor colorWithRed:0.35 green:0.55 blue:0.88 alpha:0.65],
                                       [UIColor colorWithRed:0.08 green:0.14 blue:0.32 alpha:0.82],
                                       [UIColor colorWithRed:0.22 green:0.36 blue:0.68 alpha:0.85]], locs);
                iconColor = [UIColor whiteColor];
                outerRimColor = [UIColor colorWithWhite:1.0 alpha:0.90];
                innerRimColor = [UIColor colorWithRed:0.73 green:0.90 blue:1.00 alpha:0.52];
            }
        } else if (theme == AGVisualThemeSakura) {
            if (isActive) {
                CGFloat locs[3] = {0.0, 0.52, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.5, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.52), diameter * 0.62,
                                     @[[UIColor whiteColor],
                                       [UIColor colorWithRed:1.00 green:0.78 blue:0.88 alpha:0.95],
                                       [UIColor colorWithRed:0.90 green:0.44 blue:0.66 alpha:0.98]], locs);
                iconColor = [UIColor colorWithRed:0.24 green:0.06 blue:0.14 alpha:1.0];
                outerRimColor = [UIColor whiteColor];
                innerRimColor = [UIColor colorWithRed:1.00 green:0.92 blue:0.96 alpha:0.92];
            } else {
                CGFloat locs[3] = {0.0, 0.58, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.45, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.5), diameter * 0.68,
                                     @[[UIColor colorWithRed:0.62 green:0.32 blue:0.48 alpha:0.66],
                                       [UIColor colorWithRed:0.14 green:0.06 blue:0.11 alpha:0.85],
                                       [UIColor colorWithRed:0.38 green:0.16 blue:0.28 alpha:0.88]], locs);
                iconColor = [UIColor colorWithRed:1.00 green:0.94 blue:0.97 alpha:0.98];
                outerRimColor = [UIColor colorWithRed:1.00 green:0.82 blue:0.90 alpha:0.90];
                innerRimColor = [UIColor colorWithWhite:1.0 alpha:0.42];
            }
        } else {
            if (isActive) {
                CGFloat locs[3] = {0.0, 0.52, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.5, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.52), diameter * 0.64,
                                     @[[UIColor whiteColor],
                                       [UIColor colorWithRed:0.00 green:0.92 blue:1.00 alpha:0.92],
                                       [UIColor colorWithRed:0.88 green:0.20 blue:0.78 alpha:0.95]], locs);
                iconColor = [UIColor whiteColor];
                outerRimColor = [UIColor whiteColor];
                innerRimColor = [UIColor colorWithRed:0.65 green:0.96 blue:1.00 alpha:0.92];
            } else {
                CGFloat locs[3] = {0.0, 0.58, 1.0};
                agDrawRadialGradient(ctx, CGPointMake(diameter * 0.45, diameter * 0.22), 1.0, CGPointMake(diameter * 0.5, diameter * 0.5), diameter * 0.68,
                                     @[[UIColor colorWithRed:0.15 green:0.48 blue:0.82 alpha:0.68],
                                       [UIColor colorWithRed:0.05 green:0.08 blue:0.24 alpha:0.86],
                                       [UIColor colorWithRed:0.32 green:0.12 blue:0.56 alpha:0.86]], locs);
                iconColor = [UIColor whiteColor];
                outerRimColor = [UIColor colorWithRed:0.25 green:0.94 blue:1.00 alpha:0.90];
                innerRimColor = [UIColor colorWithWhite:1.0 alpha:0.45];
            }
        }

        // 顶部球面镜月牙高光 + 底部边缘聚光弧
        CGFloat capLocs[2] = {0.0, 1.0};
        agDrawRadialGradient(ctx, CGPointMake(diameter * 0.5, diameter * 0.14), 0.5, CGPointMake(diameter * 0.5, diameter * 0.16), diameter * 0.42,
                             @[[UIColor colorWithWhite:1.0 alpha:(isActive ? 0.88 : 0.55)], [UIColor clearColor]], capLocs);
        agDrawRadialGradient(ctx, CGPointMake(diameter * 0.5, diameter * 0.92), 0.5, CGPointMake(diameter * 0.5, diameter * 0.88), diameter * 0.36,
                             @[[UIColor colorWithWhite:1.0 alpha:(isActive ? 0.88 : 0.35)], [UIColor clearColor]], capLocs);

        CGColorSpaceRelease(space);
        CGContextRestoreGState(ctx);

        [innerRimColor setStroke];
        UIBezierPath *innerCircle = [UIBezierPath bezierPathWithOvalInRect:CGRectInset(rect, 2.4, 2.4)];
        innerCircle.lineWidth = 0.95;
        [innerCircle stroke];

        [outerRimColor setStroke];
        circle.lineWidth = 1.45;
        [circle stroke];

        CGContextSaveGState(ctx);
        CGFloat iconSz = diameter * 0.485;
        CGFloat offset = (diameter - iconSz) / 2.0;
        CGContextTranslateCTM(ctx, offset, offset);
        CGFloat sc = iconSz / 24.0;
        CGContextScaleCTM(ctx, sc, sc);
        [iconColor setStroke];
        [iconColor setFill];

        UIBezierPath *path = [UIBezierPath bezierPath];
        path.lineWidth = 1.95;
        path.lineCapStyle = kCGLineCapRound;
        path.lineJoinStyle = kCGLineJoinRound;

        switch (iconType) {
            case AGVectorIconMicLive: {
                UIBezierPath *cap = [UIBezierPath bezierPathWithRoundedRect:CGRectMake(9.0, 2.5, 6.0, 10.5) cornerRadius:3.0];
                [[iconColor colorWithAlphaComponent:(isActive ? 0.90 : 0.35)] setFill];
                [cap fill];
                [iconColor setFill];
                cap.lineWidth = 1.9;
                [cap stroke];
                [path addArcWithCenter:CGPointMake(12.0, 10.5) radius:6.5 startAngle:0 endAngle:M_PI clockwise:YES];
                [path moveToPoint:CGPointMake(12.0, 17.0)];
                [path addLineToPoint:CGPointMake(12.0, 21.0)];
                [path moveToPoint:CGPointMake(8.5, 21.0)];
                [path addLineToPoint:CGPointMake(15.5, 21.0)];
                [path stroke];
                break;
            }
            case AGVectorIconVideoAI: {
                UIBezierPath *box = [UIBezierPath bezierPathWithRoundedRect:CGRectMake(2.5, 5.5, 13.5, 13.0) cornerRadius:3.5];
                [[iconColor colorWithAlphaComponent:0.24] setFill];
                [box fill];
                [iconColor setFill];
                box.lineWidth = 1.9;
                [box stroke];
                UIBezierPath *lens = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(6.6, 9.4, 5.2, 5.2)];
                lens.lineWidth = 1.7;
                [lens stroke];
                [[UIBezierPath bezierPathWithOvalInRect:CGRectMake(8.2, 11.0, 2.0, 2.0)] fill];
                [path moveToPoint:CGPointMake(16.0, 10.0)];
                [path addLineToPoint:CGPointMake(21.2, 7.2)];
                [path addLineToPoint:CGPointMake(21.2, 16.8)];
                [path addLineToPoint:CGPointMake(16.0, 14.0)];
                [path stroke];
                break;
            }
            case AGVectorIconPureText: {
                UIBezierPath *bub = [UIBezierPath bezierPathWithRoundedRect:CGRectMake(3.5, 4.0, 17.0, 15.0) cornerRadius:7.5];
                [[iconColor colorWithAlphaComponent:0.22] setFill];
                [bub fill];
                [iconColor setFill];
                bub.lineWidth = 1.9;
                [bub stroke];
                [path moveToPoint:CGPointMake(8.2, 9.8)];
                [path addLineToPoint:CGPointMake(14.8, 9.8)];
                [path moveToPoint:CGPointMake(8.2, 13.2)];
                [path addLineToPoint:CGPointMake(12.6, 13.2)];
                [path stroke];
                break;
            }
            case AGVectorIconSendArrow: {
                path.lineWidth = 2.25;
                [path moveToPoint:CGPointMake(12.0, 19.0)];
                [path addLineToPoint:CGPointMake(12.0, 5.2)];
                [path moveToPoint:CGPointMake(6.5, 10.8)];
                [path addLineToPoint:CGPointMake(12.0, 5.0)];
                [path addLineToPoint:CGPointMake(17.5, 10.8)];
                [path stroke];
                break;
            }
            case AGVectorIconTranslate: {
                [path moveToPoint:CGPointMake(4.0, 5.5)];
                [path addLineToPoint:CGPointMake(13.0, 5.5)];
                [path moveToPoint:CGPointMake(8.5, 3.2)];
                [path addLineToPoint:CGPointMake(8.5, 5.5)];
                [path moveToPoint:CGPointMake(5.5, 5.5)];
                [path addQuadCurveToPoint:CGPointMake(11.5, 13.0) controlPoint:CGPointMake(7.5, 10.5)];
                [path moveToPoint:CGPointMake(11.0, 5.5)];
                [path addQuadCurveToPoint:CGPointMake(4.8, 12.8) controlPoint:CGPointMake(9.0, 10.2)];
                [path moveToPoint:CGPointMake(12.8, 19.2)];
                [path addLineToPoint:CGPointMake(16.2, 10.2)];
                [path addLineToPoint:CGPointMake(19.6, 19.2)];
                [path moveToPoint:CGPointMake(13.9, 16.5)];
                [path addLineToPoint:CGPointMake(18.5, 16.5)];
                [path stroke];
                break;
            }
            case AGVectorIconModelHex: {
                [path moveToPoint:CGPointMake(12.0, 2.8)];
                [path addLineToPoint:CGPointMake(19.6, 7.2)];
                [path addLineToPoint:CGPointMake(19.6, 16.2)];
                [path addLineToPoint:CGPointMake(12.0, 20.6)];
                [path addLineToPoint:CGPointMake(4.4, 16.2)];
                [path addLineToPoint:CGPointMake(4.4, 7.2)];
                [path closePath];
                [path stroke];
                UIBezierPath *innerDot = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(9.2, 9.0, 5.6, 5.6)];
                innerDot.lineWidth = 1.8;
                [innerDot stroke];
                break;
            }
            case AGVectorIconCloseCross: {
                path.lineWidth = 2.1;
                [path moveToPoint:CGPointMake(17.0, 7.0)];
                [path addLineToPoint:CGPointMake(7.0, 17.0)];
                [path moveToPoint:CGPointMake(7.0, 7.0)];
                [path addLineToPoint:CGPointMake(17.0, 17.0)];
                [path stroke];
                break;
            }
        }
        CGContextRestoreGState(ctx);
    }];

    if (resultImg) {
        gBtnImageCache[cacheKey] = resultImg;
    }
    return resultImg;
}

static UIImage *agRenderVectorIcon(AGVectorIconType type, CGSize size, UIColor *strokeColor) {
    return agRenderCompleteCircleButtonImage(type, MAX(size.width, size.height), agCurrentVisualTheme(), NO, 0);
}

// ==================== 四大独立模块的开关与配置读写 ====================
static BOOL agTransIsEnabled(void);
static NSString *agTransEndpoint(void);
static NSString *agTransAPIKey(void);
static NSString *agTransModel(void);
static NSArray<NSDictionary *> *agTransCachedModels(void);
static BOOL agTransIsHighAccuracyOCR(void);
static NSTimeInterval agTransScrollDebounceTime(void);
static NSString *agSanitizeOpenAIEndpoint(NSString *raw);

static NSString *agPrefixForTab(AGConfigTab tab) {
    switch (tab) {
        case AGConfigTabNativeLive:  return @"AG_Live";
        case AGConfigTabVideoAI:     return @"AG_Video";
        case AGConfigTabPureText:    return @"AG_Text";
        case AGConfigTabTranslation: return @"AG_Trans";
    }
    return @"AG_Live";
}

static BOOL agIsTabEnabled(AGConfigTab tab) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *key = (tab == AGConfigTabTranslation) ? @"AG_Trans_Enabled" : [NSString stringWithFormat:@"%@_Enabled", agPrefixForTab(tab)];
    NSNumber *val = p[key];
    return val ? [val boolValue] : YES;
}

static BOOL agIsWebSearchEnabled(void) {
    NSDictionary *p = agReadOnlyPrefs();
    NSNumber *val = p[@"AG_WebSearch_Enabled"];
    return val ? [val boolValue] : NO;
}

static NSURLSession *agCreateSessionWithProxy(NSString *proxyStr, id<NSURLSessionDelegate> delegate, NSOperationQueue *queue);

// 全模型通用：iOS 客户端并发实时网页检索 (赋能无自带联网的第三方 API / DeepSeek / 任意中转模型)
static void agGetDeviceMemoryInfo(double *outUsedRAMGB, double *outTotalRAMGB) {
    mach_port_t host_port = mach_host_self();
    mach_msg_type_number_t host_size = sizeof(vm_statistics64_data_t) / sizeof(integer_t);
    vm_size_t pagesize;
    host_page_size(host_port, &pagesize);
    vm_statistics64_data_t vm_stat;
    if (host_statistics64(host_port, HOST_VM_INFO64, (host_info64_t)&vm_stat, &host_size) == KERN_SUCCESS) {
        int64_t mem_used = ((int64_t)vm_stat.active_count + (int64_t)vm_stat.inactive_count + (int64_t)vm_stat.wire_count) * (int64_t)pagesize;
        int64_t mem_total = [NSProcessInfo processInfo].physicalMemory;
        if (outUsedRAMGB) *outUsedRAMGB = (double)mem_used / (1024.0 * 1024.0 * 1024.0);
        if (outTotalRAMGB) *outTotalRAMGB = (double)mem_total / (1024.0 * 1024.0 * 1024.0);
    } else {
        if (outUsedRAMGB) *outUsedRAMGB = 0;
        if (outTotalRAMGB) *outTotalRAMGB = (double)[NSProcessInfo processInfo].physicalMemory / (1024.0 * 1024.0 * 1024.0);
    }
}

// ====== 最终确认替换块 1 开始（对应方案 6：增强天气/汇率/即时卡片联网提取 + 连接复用） ======
static void agFetchRealtimeWebSearchContextForQuery(NSString *query, NSString *proxy, void(^completion)(NSString *searchSummary)) {
    NSString *cleanQ = [query stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    BOOL webEnabled = agIsWebSearchEnabled();
    if (!webEnabled || cleanQ.length < 2) {
        agLiveDiagLog(@"WEB_SEARCH_DIAG", @"Skipped: enabled=%d, queryLen=%lu", webEnabled, (unsigned long)cleanQ.length);
        if (completion) completion(nil);
        return;
    }
    NSString *encodedQ = [cleanQ stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]];
    if (!encodedQ || encodedQ.length == 0) {
        if (completion) completion(nil);
        return;
    }

    NSString *webURLStr = [NSString stringWithFormat:@"https://cn.bing.com/search?q=%@&setlang=zh-cn", encodedQ];
    NSURL *url = [NSURL URLWithString:webURLStr];
    if (!url) {
        if (completion) completion(nil);
        return;
    }

    NSTimeInterval t0 = [NSDate timeIntervalSinceReferenceDate];
    agLiveDiagLog(@"WEB_SEARCH_DIAG", @"Starting universal web search for query='%@', proxy='%@'", cleanQ, proxy ?: @"none");

    static NSURLSession *sSearchSession = nil;
    static NSString *sLastSearchProxy = nil;
    static os_unfair_lock sSearchLock = OS_UNFAIR_LOCK_INIT;
    os_unfair_lock_lock(&sSearchLock);
    NSString *normProxy = proxy ?: @"";
    if (!sSearchSession || ![sLastSearchProxy isEqualToString:normProxy]) {
        if (sSearchSession) [sSearchSession finishTasksAndInvalidate];
        sSearchSession = agCreateSessionWithProxy(normProxy, nil, nil);
        sLastSearchProxy = [normProxy copy];
    }
    NSURLSession *session = sSearchSession;
    os_unfair_lock_unlock(&sSearchLock);

    NSMutableURLRequest *req = [NSMutableURLRequest requestWithURL:url];
    req.HTTPMethod = @"GET";
    req.timeoutInterval = 3.5;
    [req setValue:@"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1" forHTTPHeaderField:@"User-Agent"];
    [req setValue:@"zh-CN,zh;q=0.9,en;q=0.8" forHTTPHeaderField:@"Accept-Language"];

    [[session dataTaskWithRequest:req completionHandler:^(NSData *data, NSURLResponse *resp, NSError *err) {
        NSInteger costMs = (NSInteger)(([NSDate timeIntervalSinceReferenceDate] - t0) * 1000.0);
        NSHTTPURLResponse *httpResp = (NSHTTPURLResponse *)resp;
        NSInteger statusCode = [httpResp isKindOfClass:[NSHTTPURLResponse class]] ? httpResp.statusCode : 0;

        if (err || !data || data.length < 100) {
            agLiveDiagLog(@"WEB_SEARCH_DIAG", @"Failed (%ldms, HTTP %ld): %@", (long)costMs, (long)statusCode, err.localizedDescription ?: @"empty data");
            dispatch_async(dispatch_get_main_queue(), ^{
                if (completion) completion(nil);
            });
            return;
        }
        NSString *html = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
        if (!html) {
            html = [[NSString alloc] initWithData:data encoding:NSASCIIStringEncoding];
        }

        NSMutableArray<NSString *> *snippets = [NSMutableArray array];
        NSMutableSet<NSString *> *seenSnippets = [NSMutableSet set];
        if (html.length > 0) {
            NSRegularExpression *tagStripRe = [NSRegularExpression regularExpressionWithPattern:@"<[^>]+>" options:NSRegularExpressionDotMatchesLineSeparators error:nil];
            NSRegularExpression *scriptStripRe = [NSRegularExpression regularExpressionWithPattern:@"<(?:script|style)[^>]*>.*?</(?:script|style)>" options:NSRegularExpressionDotMatchesLineSeparators | NSRegularExpressionCaseInsensitive error:nil];
            NSString *sanitizedHTML = [scriptStripRe stringByReplacingMatchesInString:html options:0 range:NSMakeRange(0, html.length) withTemplate:@""];

            void (^extractWithPattern)(NSString *, NSUInteger) = ^(NSString *pattern, NSUInteger minLen) {
                if (snippets.count >= 6) return;
                NSRegularExpression *re = [NSRegularExpression regularExpressionWithPattern:pattern options:NSRegularExpressionDotMatchesLineSeparators | NSRegularExpressionCaseInsensitive error:nil];
                NSArray<NSTextCheckingResult *> *matches = [re matchesInString:sanitizedHTML options:0 range:NSMakeRange(0, sanitizedHTML.length)];
                for (NSTextCheckingResult *m in matches) {
                    if (snippets.count >= 6) break;
                    if (m.numberOfRanges > 1) {
                        NSString *raw = [sanitizedHTML substringWithRange:[m rangeAtIndex:1]];
                        NSString *cleanText = [tagStripRe stringByReplacingMatchesInString:raw options:0 range:NSMakeRange(0, raw.length) withTemplate:@" "];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"&quot;" withString:@"\""];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"&amp;" withString:@"&"];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"&nbsp;" withString:@" "];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"&#39;" withString:@"'"];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"&#x27;" withString:@"'"];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"&lt;" withString:@"<"];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"&gt;" withString:@">"];
                        cleanText = [cleanText stringByReplacingOccurrencesOfString:@"\\s+" withString:@" " options:NSRegularExpressionSearch range:NSMakeRange(0, cleanText.length)];
                        cleanText = [cleanText stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
                        if (cleanText.length >= minLen &&
                            ![cleanText containsString:@"JavaScript"] &&
                            ![cleanText containsString:@"Cookie"] &&
                            ![cleanText containsString:@"浙公网安备"] &&
                            ![cleanText containsString:@"沪ICP备"]) {
                            NSString *clipped = (cleanText.length > 180) ? [cleanText substringToIndex:180] : cleanText;
                            if (![seenSnippets containsObject:clipped]) {
                                [seenSnippets addObject:clipped];
                                [snippets addObject:[NSString stringWithFormat:@"- %@", clipped]];
                            }
                        }
                    }
                }
            };

            // 1. 优先提取 Bing 顶部即时问答卡片（天气、实时股价、汇率、百科焦点数值）
            extractWithPattern(@"<div[^>]*class=\"[^\"]*(?:b_focusTextLarge|b_focusTextMedium|b_focusTextSmall|b_factrow|wtr_currTemp|wtr_cond|wtr_high|wtr_low|b_ans)[^\"]*\"[^>]*>(.*?)</div>", 4);
            // 2. 提取搜索结果摘要块 (b_caption / b_algoSlug)
            extractWithPattern(@"<div[^>]*class=\"[^\"]*(?:b_caption|b_algoSlug)[^\"]*\"[^>]*>(.*?)</div>", 12);
            // 3. 常规段落兜底 (<p>)
            extractWithPattern(@"<p[^>]*>(.*?)</p>", 15);
        }

        NSString *finalContext = (snippets.count > 0) ? [snippets componentsJoinedByString:@"\n"] : nil;
        agLiveDiagLog(@"WEB_SEARCH_DIAG", @"Done (%ldms, HTTP %ld): found %lu snippets for '%@'", (long)costMs, (long)statusCode, (unsigned long)snippets.count, cleanQ);
        dispatch_async(dispatch_get_main_queue(), ^{
            if (completion) completion(finalContext);
        });
    }] resume];
}
// ====== 最终确认替换块 1 结束 ======

static NSString *agSanitizeEndpoint(NSString *raw, AGConfigTab tab) {
    NSString *ep = [raw stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    while ([ep hasSuffix:@"/"]) {
        ep = [ep substringToIndex:ep.length - 1];
    }
    if (ep.length < 3 || [ep isEqualToString:@"https:"] || [ep isEqualToString:@"http:"]) {
        return @"https://generativelanguage.googleapis.com";
    }
    if (![ep hasPrefix:@"http://"] && ![ep hasPrefix:@"https://"]) {
        ep = [NSString stringWithFormat:@"https://%@", ep];
    }
    return ep;
}

static NSString *agEndpointForTab(AGConfigTab tab) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *key = [NSString stringWithFormat:@"%@_Endpoint", agPrefixForTab(tab)];
    NSString *ep = [p[key] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (!ep || ep.length < 4) {
        if (tab == AGConfigTabNativeLive) {
            NSString *legacy = p[@"Gemini_Endpoint"];
            if (legacy.length > 5) ep = legacy;
            else ep = @"https://generativelanguage.googleapis.com";
        } else {
            ep = @"https://generativelanguage.googleapis.com";
        }
    }
    return agSanitizeEndpoint(ep, tab);
}

static NSString *agAPIKeyForTab(AGConfigTab tab) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *key = [NSString stringWithFormat:@"%@_APIKey", agPrefixForTab(tab)];
    NSString *val = [p[key] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (!val || val.length == 0) {
        if (tab == AGConfigTabNativeLive) {
            val = [p[@"Gemini_APIKey"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        }
    }
    return val ?: @"";
}

static NSString *agProxyForTab(AGConfigTab tab) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *key = [NSString stringWithFormat:@"%@_ProxyPort", agPrefixForTab(tab)];
    NSString *val = [p[key] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (!val || val.length == 0) {
        if (tab == AGConfigTabNativeLive) {
            val = [p[@"Gemini_ProxyPort"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        }
    }
    return val ?: @"";
}

static NSArray<NSDictionary *> *agCachedModelsForTab(AGConfigTab tab) {
    NSDictionary *p = agReadOnlyPrefs();
    NSString *key = (tab == AGConfigTabTranslation) ? @"AG_Trans_CachedModels" : [NSString stringWithFormat:@"%@_CachedModels", agPrefixForTab(tab)];
    NSArray *arr = p[key];
    if ([arr isKindOfClass:[NSArray class]] && arr.count > 0) {
        return arr;
    }
    return agVerifiedDefaultModelsForTab(tab);
}

static NSString *agModelForTab(AGConfigTab tab) {
    if (tab == AGConfigTabTranslation) {
        return agTransModel();
    }
    NSDictionary *p = agReadOnlyPrefs();
    NSString *key = [NSString stringWithFormat:@"%@_Model", agPrefixForTab(tab)];
    NSString *val = [p[key] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    if (val && val.length > 0) {
        return val;
    }
    NSArray<NSDictionary *> *list = agCachedModelsForTab(tab);
    if (list.count > 0 && list.firstObject[@"id"]) {
        return list.firstObject[@"id"];
    }
    return @"";
}

static BOOL agIsGoogleNativeProtocol(NSString *endpoint, NSString *model) {
    NSString *lowerEP = [endpoint lowercaseString];
    if ([lowerEP containsString:@"googleapis.com"] || [lowerEP containsString:@"v1beta"] || [lowerEP containsString:@"v1alpha"]) {
        if (![lowerEP containsString:@"/v1/chat/completions"] && ![lowerEP containsString:@"openai"]) {
            return YES;
        }
    }
    return NO;
}



static NSURLSession *agCreateSessionWithProxy(NSString *proxyStr, id<NSURLSessionDelegate> delegate, NSOperationQueue *queue) {
    NSString *cleanProxy = [proxyStr stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    NSURLSessionConfiguration *config = [NSURLSessionConfiguration defaultSessionConfiguration];
    config.timeoutIntervalForRequest = 30.0;
    if (cleanProxy.length > 0) {
        NSString *host = @"127.0.0.1";
        NSNumber *portNum = nil;
        if ([cleanProxy containsString:@":"]) {
            NSArray *parts = [cleanProxy componentsSeparatedByString:@":"];
            host = parts.firstObject;
            portNum = @([parts.lastObject integerValue]);
        } else {
            portNum = @([cleanProxy integerValue]);
        }
        if ([portNum integerValue] > 0) {
            config.connectionProxyDictionary = @{
                @"HTTPEnable": @YES, @"HTTPProxy": host, @"HTTPPort": portNum,
                @"HTTPSEnable": @YES, @"HTTPSProxy": host, @"HTTPSPort": portNum
            };
        }
    }
    if (delegate) {
        return [NSURLSession sessionWithConfiguration:config delegate:delegate delegateQueue:(queue ?: [NSOperationQueue mainQueue])];
    }
    return [NSURLSession sessionWithConfiguration:config];
}

static dispatch_queue_t agAudioSerialQueue(void) {
    static dispatch_queue_t q = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        q = dispatch_queue_create("com.custom.geminisiri.audioqueue", DISPATCH_QUEUE_SERIAL);
    });
    return q;
}

static NSString *agExtractTextFromJSON(NSDictionary *dict) {
    if (![dict isKindOfClass:[NSDictionary class]]) return nil;
    NSArray *choices = dict[@"choices"];
    if ([choices isKindOfClass:[NSArray class]] && choices.count > 0) {
        NSDictionary *firstChoice = choices.firstObject;
        if ([firstChoice isKindOfClass:[NSDictionary class]]) {
            id contentVal = firstChoice[@"delta"][@"content"] ?: firstChoice[@"message"][@"content"];
            if ([contentVal isKindOfClass:[NSString class]] && [contentVal length] > 0) {
                return contentVal;
            }
        }
    }
    NSArray *candidates = dict[@"candidates"];
    if ([candidates isKindOfClass:[NSArray class]] && candidates.count > 0) {
        NSDictionary *cand = candidates.firstObject;
        NSArray *parts = [cand isKindOfClass:[NSDictionary class]] ? cand[@"content"][@"parts"] : nil;
        if ([parts isKindOfClass:[NSArray class]] && parts.count > 0) {
            NSMutableString *joined = [NSMutableString string];
            for (NSDictionary *partItem in parts) {
                if (![partItem isKindOfClass:[NSDictionary class]]) continue;
                if ([partItem[@"thought"] boolValue]) continue;
                id tVal = partItem[@"text"];
                if ([tVal isKindOfClass:[NSString class]] && [tVal length] > 0) {
                    [joined appendString:tVal];
                }
            }
            if (joined.length > 0) return joined;
            id fallbackVal = parts.firstObject[@"text"];
            if ([fallbackVal isKindOfClass:[NSString class]]) return fallbackVal;
        }
    }
    return nil;
}

// 生成合法的标准 16kHz 单声道短静音 WAV Base64（用于探测模型是否支持 audio/wav 输入）
// 生成标准 16kHz 单声道短静音 WAV Base64（用于探测 HTTP 模型是否真正支持 audio/wav 输入）
// 判断某模型是否为仅支持 WebSocket (bidiGenerateContent) 而不支持 HTTP generateContent 的模型
// 生成标准 16kHz 单声道静音 WAV Base64（用于探测 HTTP 模型是否支持 audio/wav 输入）
static NSString *agTinyTestWavBase64(void) {
    static NSString *b64Wav = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        uint32_t sampleRate = 16000;
        uint32_t numSamples = 800;
        uint32_t dataSize = numSamples * 2;
        uint32_t fileSize = 36 + dataSize;
        NSMutableData *wav = [NSMutableData dataWithCapacity:44 + dataSize];
        [wav appendBytes:"RIFF" length:4];
        [wav appendBytes:&fileSize length:4];
        [wav appendBytes:"WAVEfmt " length:8];
        uint32_t fmtLen = 16; [wav appendBytes:&fmtLen length:4];
        uint16_t audioFmt = 1; [wav appendBytes:&audioFmt length:2];
        uint16_t channels = 1; [wav appendBytes:&channels length:2];
        [wav appendBytes:&sampleRate length:4];
        uint32_t byteRate = sampleRate * 2; [wav appendBytes:&byteRate length:4];
        uint16_t blockAlign = 2; [wav appendBytes:&blockAlign length:2];
        uint16_t bitsPerSample = 16; [wav appendBytes:&bitsPerSample length:2];
        [wav appendBytes:"data" length:4];
        [wav appendBytes:&dataSize length:4];
        [wav increaseLengthBy:dataSize];
        b64Wav = [wav base64EncodedStringWithOptions:0];
    });
    return b64Wav;
}

static BOOL agIsOneWayAudioModel(NSString *lowerID) {
    return ([lowerID containsString:@"transcribe"] ||
            [lowerID containsString:@"whisper"] ||
            [lowerID containsString:@"paraformer"] ||
            [lowerID containsString:@"sensevoice"] ||
            [lowerID containsString:@"asr"] ||
            [lowerID containsString:@"tts"] ||
            [lowerID containsString:@"cosyvoice"] ||
            [lowerID containsString:@"live-translate"]);
}

static BOOL agIsPureWebSocketOnlyModel(NSString *modelID, NSDictionary *mDict) {
    NSString *lower = [modelID lowercaseString];
    if (agIsOneWayAudioModel(lower)) return NO;
    NSArray *methods = mDict[@"supportedGenerationMethods"];
    if ([methods isKindOfClass:[NSArray class]]) {
        BOOL hasBidi = [methods containsObject:@"bidiGenerateContent"];
        BOOL hasHttpGen = [methods containsObject:@"generateContent"];
        if (hasBidi && !hasHttpGen) return YES;
        if (hasHttpGen && !hasBidi) return NO;
    }
    if ([lower containsString:@"native-audio"] ||
        [lower containsString:@"-live"] ||
        [lower containsString:@"realtime"] ||
        [lower containsString:@"step-1o-audio"] ||
        [lower containsString:@"step-audio"]) {
        return YES;
    }
    return NO;
}

static BOOL agIsWebSocketBidiCapableModel(NSString *modelID, AGConfigTab tab) {
    if (!modelID || modelID.length == 0) return NO;
    if (tab == AGConfigTabPureText || tab == AGConfigTabTranslation) return NO;
    NSString *lower = [modelID lowercaseString];
    if (agIsOneWayAudioModel(lower)) return NO;

    for (NSDictionary *m in agCachedModelsForTab(tab)) {
        if ([m[@"id"] isEqualToString:modelID]) {
            if (m[@"onlyBidi"] != nil && [m[@"onlyBidi"] boolValue]) return YES;
            if (m[@"bidi"] != nil) return [m[@"bidi"] boolValue];
        }
    }
    if ([lower containsString:@"native-audio"] ||
        [lower containsString:@"-live"] ||
        [lower containsString:@"realtime"] ||
        [lower containsString:@"2.0-flash-exp"] ||
        [lower containsString:@"step-1o-audio"] ||
        [lower containsString:@"step-audio"]) {
        return YES;
    }
    return NO;
}

// ==================== 2. 提取模型“最新版本号”评分（保障支持且最新的稳定版本排在最前） ====================
static double agCalculateModelNewestScore(NSString *modelID, NSDictionary *mDict) {
    NSString *lower = [[modelID lowercaseString] stringByReplacingOccurrencesOfString:@"models/" withString:@""];
    double score = 100.0;

    NSRegularExpression *verRe = [NSRegularExpression regularExpressionWithPattern:@"(?:^|-|[a-z])(\\d+)(?:\\.(\\d+))?" options:0 error:nil];
    NSTextCheckingResult *verMatch = [verRe firstMatchInString:lower options:0 range:NSMakeRange(0, lower.length)];
    if (verMatch && verMatch.numberOfRanges > 1) {
        double major = [[lower substringWithRange:[verMatch rangeAtIndex:1]] doubleValue];
        double minor = (verMatch.numberOfRanges > 2 && [verMatch rangeAtIndex:2].location != NSNotFound)
            ? [[lower substringWithRange:[verMatch rangeAtIndex:2]] doubleValue] : 0.0;
        if (major > 0 && major <= 15) {
            score += (major * 120.0 + minor * 18.0);
        }
    }
    if ([lower containsString:@"2026"]) score += 120.0;
    else if ([lower containsString:@"2025"]) score += 50.0;
    if ([lower containsString:@"latest"]) score += 80.0;

    NSNumber *created = mDict[@"created"];
    if ([created isKindOfClass:[NSNumber class]] && [created doubleValue] > 1000000000.0) {
        score += ([created doubleValue] - 1700000000.0) / 4000000.0;
    }
    if ([lower containsString:@"legacy"] || [lower containsString:@"-001"]) score -= 180.0;
    return score;
}

// ==================== 3. 按功能筛选并标注模型能力（不设数量限制） ====================
static BOOL agIsModelCapableForTab(NSString *mID, NSDictionary *mDict, AGConfigTab tab, NSString **outBadgeTitle, BOOL *outSupportsBidi) {
    if (!mID || mID.length == 0) return NO;
    NSString *lower = [mID lowercaseString];
    NSString *shortName = [mID stringByReplacingOccurrencesOfString:@"models/" withString:@""];

    // 剔除非对话类向量、生图、生视频、单向转录与语音合成模型
    if ([lower containsString:@"embedding"] || [lower containsString:@"rerank"] ||
        [lower containsString:@"moderation"] || [lower containsString:@"text-embedding"] ||
        [lower containsString:@"aqa"] || [lower containsString:@"bison"] ||
        [lower containsString:@"gecko"] || [lower containsString:@"imagen"] ||
        [lower containsString:@"dall-e"] || [lower containsString:@"gpt-image"] ||
        [lower containsString:@"veo"] || [lower containsString:@"sora"] ||
        [lower containsString:@"wanx"] || [lower containsString:@"cogview"] ||
        [lower containsString:@"robotics"] || [lower containsString:@"computer-use"] ||
        [lower containsString:@"learnlm"] || agIsOneWayAudioModel(lower)) {
        return NO;
    }

    NSArray *methods = mDict[@"supportedGenerationMethods"];
    BOOL hasBidi = NO;
    BOOL hasHttpGen = YES;
    if ([methods isKindOfClass:[NSArray class]]) {
        hasBidi = [methods containsObject:@"bidiGenerateContent"];
        hasHttpGen = [methods containsObject:@"generateContent"];
        if (!hasBidi && !hasHttpGen) return NO;
    }

    BOOL onlyBidi = agIsPureWebSocketOnlyModel(mID, mDict);
    BOOL isRealtimeBidi = onlyBidi || hasBidi ||
                          [lower containsString:@"2.0-flash-exp"] ||
                          [lower containsString:@"native-audio"] ||
                          [lower containsString:@"-live"] ||
                          [lower containsString:@"realtime"] ||
                          [lower containsString:@"step-1o-audio"];
    if (outSupportsBidi) *outSupportsBidi = isRealtimeBidi;

    // 1. 🎙️ 纯正 Live 与 📹 独立视频 AI：严格只保留支持 WebSocket 双向实时流的模型
    if (tab == AGConfigTabNativeLive || tab == AGConfigTabVideoAI) {
        if (!isRealtimeBidi) return NO;
        // 视频 AI 模式下排除仅支持纯音频、不支持视觉画面的语音模型
        if (tab == AGConfigTabVideoAI && ([lower containsString:@"audio-only"] || [lower containsString:@"step-1o-audio"])) {
            return NO;
        }
        NSString *tag = (tab == AGConfigTabVideoAI) ? @"📹📞[WebSocket实时视频]" : @"🎙️📞[WebSocket实时语音]";
        if (outBadgeTitle) *outBadgeTitle = [NSString stringWithFormat:@"%@ %@", tag, shortName];
        return YES;
    }

    // 2. 💬 纯文本 与 🌐 实时翻译：只要支持 HTTP 对话生成 (非仅限 WebSocket 的模型) 均允许参与测速
    if (onlyBidi || !hasHttpGen) return NO;

    if (tab == AGConfigTabPureText) {
        BOOL isThinking = [lower containsString:@"reasoner"] || [lower containsString:@"thinking"] || [lower containsString:@"-r1"] || [lower hasPrefix:@"o1"] || [lower hasPrefix:@"o3"] || [lower hasPrefix:@"o4"] || [lower containsString:@"qwq"];
        NSString *funcTag = isThinking ? @"🧠[深度思考]" : @"💬[文本对话]";
        if (outBadgeTitle) *outBadgeTitle = [NSString stringWithFormat:@"%@ %@", funcTag, shortName];
        return YES;
    }

    if (outBadgeTitle) *outBadgeTitle = [NSString stringWithFormat:@"⚡🌐[高速翻译] %@", shortName];
    return YES;
}

static NSInteger agTabSupportTier(NSString *badgeTitle, BOOL onlyBidi, BOOL supportsBidi, AGConfigTab tab) {
    if (tab == AGConfigTabNativeLive || tab == AGConfigTabVideoAI) {
        return supportsBidi ? 4 : 1;
    }
    if (tab == AGConfigTabTranslation) {
        if ([badgeTitle containsString:@"⚡"]) return 3;
        if ([badgeTitle containsString:@"🧠"]) return 1;
        return 2;
    }
    return 3;
}

// 新增：全平台 WebSocket 请求构造器 (支持 Google v1beta/v1alpha、OpenAI、阿里 DashScope、智谱 BigModel、通用中转)
static NSMutableURLRequest *agBuildWebSocketRequestForEndpoint(NSString *endpoint, NSString *apiKey, NSString *modelID, BOOL useGoogleV1Alpha, BOOL *outIsGoogleBidi) {
    NSString *cleanEP = [endpoint stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    while ([cleanEP hasSuffix:@"/"]) cleanEP = [cleanEP substringToIndex:cleanEP.length - 1];
    NSString *cleanKey = [apiKey stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    NSString *exactModelID = [modelID stringByReplacingOccurrencesOfString:@"models/" withString:@""];
    NSString *encodedKey = [cleanKey stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]] ?: cleanKey;
    NSString *encodedModel = [exactModelID stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]] ?: exactModelID;

    BOOL isGoogle = agIsGoogleNativeProtocol(cleanEP, modelID);
    if (outIsGoogleBidi) *outIsGoogleBidi = isGoogle;

    NSString *hostBase = [[cleanEP stringByReplacingOccurrencesOfString:@"https://" withString:@"wss://"] stringByReplacingOccurrencesOfString:@"http://" withString:@"ws://"];
    NSString *wsURLStr = nil;

    if (isGoogle) {
        NSString *apiVer = useGoogleV1Alpha ? @"v1alpha" : @"v1beta";
        wsURLStr = [NSString stringWithFormat:@"%@/ws/google.ai.generativelanguage.%@.GenerativeService.BidiGenerateContent?key=%@", hostBase, apiVer, encodedKey];
    } else if ([hostBase containsString:@"dashscope.aliyuncs.com"]) {
        // 阿里云百炼 Qwen-Omni-Realtime 官方 WebSocket 路径
        wsURLStr = [NSString stringWithFormat:@"wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=%@", encodedModel];
    } else if ([hostBase containsString:@"open.bigmodel.cn"]) {
        // 智谱 GLM-Realtime 官方 WebSocket 路径
        wsURLStr = [NSString stringWithFormat:@"wss://open.bigmodel.cn/api/paas/v4/realtime?model=%@", encodedModel];
    } else if ([hostBase hasSuffix:@"/realtime"]) {
        wsURLStr = [NSString stringWithFormat:@"%@?model=%@", hostBase, encodedModel];
    } else if ([hostBase hasSuffix:@"/v1"]) {
        wsURLStr = [NSString stringWithFormat:@"%@/realtime?model=%@", hostBase, encodedModel];
    } else {
        wsURLStr = [NSString stringWithFormat:@"%@/v1/realtime?model=%@", hostBase, encodedModel];
    }

    NSURL *wsURL = [NSURL URLWithString:wsURLStr];
    if (!wsURL) return nil;

    NSMutableURLRequest *wsReq = [NSMutableURLRequest requestWithURL:wsURL];
    wsReq.timeoutInterval = 6.0;
    if (!isGoogle) {
        [wsReq setValue:[NSString stringWithFormat:@"Bearer %@", cleanKey] forHTTPHeaderField:@"Authorization"];
        [wsReq setValue:@"realtime=v1" forHTTPHeaderField:@"OpenAI-Beta"];
    }
    return wsReq;
}

// 新增：真 WebSocket 握手连通性实测器（发送真实 setup / session.update 并验证服务端握手响应）
static void agProbeRealtimeWebSocketModel(NSString *endpoint, NSString *apiKey, NSString *proxy, NSString *modelID, BOOL tryV1Alpha, void(^completion)(BOOL ok, NSInteger latencyMs, NSString *errMsg)) {
    BOOL isGoogle = NO;
    NSMutableURLRequest *wsReq = agBuildWebSocketRequestForEndpoint(endpoint, apiKey, modelID, tryV1Alpha, &isGoogle);
    if (!wsReq) {
        if (completion) completion(NO, 9999, @"WebSocket 地址无效");
        return;
    }

    NSURLSession *session = agCreateSessionWithProxy(proxy ?: @"", nil, nil);
    NSURLSessionWebSocketTask *wsTask = [session webSocketTaskWithRequest:wsReq];
    NSTimeInterval t0 = [NSDate timeIntervalSinceReferenceDate];

    __block BOOL isFinished = NO;
    void (^finishOnce)(BOOL, NSInteger, NSString *) = ^(BOOL ok, NSInteger lat, NSString *msg) {
        @synchronized (wsTask) {
            if (isFinished) return;
            isFinished = YES;
        }
        [wsTask cancelWithCloseCode:NSURLSessionWebSocketCloseCodeNormalClosure reason:nil];
        [session invalidateAndCancel];
        if (!ok && isGoogle && !tryV1Alpha) {
            // Google 模型若在 v1beta 握手被拒，自动用 v1alpha 再实测一次
            agProbeRealtimeWebSocketModel(endpoint, apiKey, proxy, modelID, YES, completion);
            return;
        }
        dispatch_async(dispatch_get_main_queue(), ^{
            if (completion) completion(ok, lat, msg);
        });
    };

    [wsTask resume];

    NSString *rawModel = [modelID stringByReplacingOccurrencesOfString:@"models/" withString:@""];
    NSDictionary *handshakePayload = nil;
    if (isGoogle) {
        handshakePayload = @{
            @"setup": @{
                @"model": [NSString stringWithFormat:@"models/%@", rawModel],
                @"generationConfig": @{ @"responseModalities": @[@"AUDIO"] }
            }
        };
    } else {
        handshakePayload = @{
            @"type": @"session.update",
            @"session": @{ @"modalities": @[@"text", @"audio"] }
        };
    }

    NSData *jsonData = [NSJSONSerialization dataWithJSONObject:handshakePayload options:0 error:nil];
    NSString *jsonStr = [[NSString alloc] initWithData:jsonData encoding:NSUTF8StringEncoding];
    [wsTask sendMessage:[[NSURLSessionWebSocketMessage alloc] initWithString:jsonStr] completionHandler:^(NSError * _Nullable sendErr) {
        if (sendErr) {
            NSInteger lat = (NSInteger)MAX(1.0, ([NSDate timeIntervalSinceReferenceDate] - t0) * 1000.0);
            finishOnce(NO, lat, sendErr.localizedDescription ?: @"握手发送失败");
        }
    }];

    [wsTask receiveMessageWithCompletionHandler:^(NSURLSessionWebSocketMessage * _Nullable message, NSError * _Nullable recvErr) {
        NSInteger lat = (NSInteger)MAX(1.0, ([NSDate timeIntervalSinceReferenceDate] - t0) * 1000.0);
        if (recvErr || !message) {
            finishOnce(NO, lat, recvErr.localizedDescription ?: @"Socket未连接");
            return;
        }
        NSData *msgData = message.data ?: [message.string dataUsingEncoding:NSUTF8StringEncoding];
        NSDictionary *json = msgData ? [NSJSONSerialization JSONObjectWithData:msgData options:0 error:nil] : nil;
        if ([json isKindOfClass:[NSDictionary class]]) {
            if (json[@"error"]) {
                finishOnce(NO, lat, json[@"error"][@"message"] ?: @"服务端拒绝");
                return;
            }
            if (json[@"setupComplete"] != nil ||
                [json[@"type"] isEqualToString:@"session.created"] ||
                [json[@"type"] isEqualToString:@"session.updated"]) {
                finishOnce(YES, lat, nil);
                return;
            }
        }
        finishOnce(NO, lat, @"未收到有效握手确认");
    }];

    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(4.5 * NSEC_PER_SEC)), dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
        finishOnce(NO, 4500, @"WebSocket 握手超时");
    });
}

// 替换原 agProbeModelForTab
static void agProbeModelForTab(AGConfigTab tab, NSString *endpoint, NSString *apiKey, NSString *proxy, NSString *modelID, BOOL onlyBidi, void(^completion)(BOOL ok, NSInteger latencyMs, NSString *errMsg)) {
    NSString *cleanEP = [endpoint stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    while ([cleanEP hasSuffix:@"/"]) cleanEP = [cleanEP substringToIndex:cleanEP.length - 1];
    NSString *cleanKey = [apiKey stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];

    if (cleanEP.length < 5 || cleanKey.length < 4) {
        if (completion) completion(NO, 0, @"未配置 API");
        return;
    }

    // 1. 🎙️ 纯正 Live 与 📹 视频 AI：执行真 WebSocket 握手实测，100% 确定能连上才通过！
    if (onlyBidi || tab == AGConfigTabNativeLive || tab == AGConfigTabVideoAI) {
        if (tab == AGConfigTabPureText || tab == AGConfigTabTranslation) {
            if (completion) completion(NO, 9999, @"仅限实时语音/视频模式");
            return;
        }
        agProbeRealtimeWebSocketModel(cleanEP, cleanKey, proxy, modelID, NO, completion);
        return;
    }

    // 2. 💬 纯文本与 🌐 翻译模型：使用 100% 标准最小化 HTTP 报文（严禁塞入 enable_thinking 等非标字段！）
    NSURLSession *session = agCreateSessionWithProxy(proxy ?: @"", nil, nil);
    BOOL isGoogle = agIsGoogleNativeProtocol(cleanEP, modelID);
    NSMutableURLRequest *req = nil;

    if (isGoogle) {
        NSString *fullM = [modelID hasPrefix:@"models/"] ? modelID : [NSString stringWithFormat:@"models/%@", modelID];
        NSString *urlStr = [NSString stringWithFormat:@"%@/v1beta/%@:generateContent?key=%@", cleanEP, fullM, cleanKey];
        req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
        req.HTTPMethod = @"POST";
        [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];

        NSMutableDictionary *genCfg = [@{
            @"temperature": @0.1,
            @"maxOutputTokens": @96
        } mutableCopy];
        if ([fullM containsString:@"2.5"] || [fullM containsString:@"3."] || [fullM containsString:@"thinking"]) {
            genCfg[@"thinkingConfig"] = @{ @"thinkingBudget": @0 };
        }
        NSDictionary *body = @{
            @"contents": @[ @{ @"role": @"user", @"parts": @[ @{ @"text": @"Hi" } ] } ],
            @"generationConfig": genCfg
        };
        req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
    } else {
        NSString *urlStr = agSanitizeOpenAIEndpoint(cleanEP);
        req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
        req.HTTPMethod = @"POST";
        [req setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];
        [req setValue:[NSString stringWithFormat:@"Bearer %@", cleanKey] forHTTPHeaderField:@"Authorization"];
        NSString *exactM = [modelID stringByReplacingOccurrencesOfString:@"models/" withString:@""];
        NSDictionary *body = @{
            @"model": exactM,
            @"messages": @[ @{ @"role": @"user", @"content": @"Hi" } ],
            @"temperature": @0.1,
            @"max_tokens": @96
        };
        req.HTTPBody = [NSJSONSerialization dataWithJSONObject:body options:0 error:nil];
    }
    req.timeoutInterval = 8.0;

    NSTimeInterval startTime = [NSDate timeIntervalSinceReferenceDate];
    [[session dataTaskWithRequest:req completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
        NSInteger latency = (NSInteger)MAX(1.0, ([NSDate timeIntervalSinceReferenceDate] - startTime) * 1000.0);
        dispatch_async(dispatch_get_main_queue(), ^{
            if (error || !data || data.length == 0) {
                if (completion) completion(NO, latency, @"超时");
                return;
            }
            NSHTTPURLResponse *httpResp = (NSHTTPURLResponse *)response;
            NSDictionary *json = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
            if (([httpResp isKindOfClass:[NSHTTPURLResponse class]] && httpResp.statusCode >= 400) || ([json isKindOfClass:[NSDictionary class]] && json[@"error"])) {
                if (completion) completion(NO, latency, @"不支持该模态");
                return;
            }
            NSString *reply = [agExtractTextFromJSON(json) stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            BOOL hasChoices = ([json[@"choices"] isKindOfClass:[NSArray class]] && [json[@"choices"] count] > 0) ||
                              ([json[@"candidates"] isKindOfClass:[NSArray class]] && [json[@"candidates"] count] > 0);
            if (reply.length > 0 || hasChoices) {
                if (completion) completion(YES, latency, nil);
            } else {
                if (completion) completion(NO, latency, @"无返回");
            }
        });
    }] resume];
}

static void agBenchmarkModelLatency(NSString *endpoint, NSString *apiKey, NSString *proxy, NSString *modelID, void(^completion)(BOOL ok, NSInteger latencyMs, NSString *sampleReply, NSString *errMsg)) {
    agProbeModelForTab(AGConfigTabTranslation, endpoint, apiKey, proxy, modelID, NO, ^(BOOL ok, NSInteger latencyMs, NSString *errMsg) {
        if (completion) completion(ok, latencyMs, ok ? @"OK" : nil, errMsg);
    });
}

// ==================== 5. 云端拉取 + 受控并发实测 +「支持当前功能且最新版本优先」排序 ====================
static void agFetchCloudModelsForTab(AGConfigTab tab, NSString *endpoint, NSString *apiKey, NSString *proxy, void(^completion)(BOOL success, NSArray<NSDictionary *> *models, NSString *errorMsg)) {
    NSString *cleanEP = [endpoint stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    while ([cleanEP hasSuffix:@"/"]) cleanEP = [cleanEP substringToIndex:cleanEP.length - 1];
    NSString *cleanKey = [apiKey stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];

    if (cleanEP.length < 5 || cleanKey.length < 4) {
        if (completion) completion(NO, @[], @"请先填写当前功能的专属 API 地址与 API Key");
        return;
    }

    NSURLSession *session = agCreateSessionWithProxy(proxy, nil, nil);
    BOOL isGoogle = agIsGoogleNativeProtocol(cleanEP, @"");
    NSString *urlStr = nil;
    if (isGoogle) {
        urlStr = [NSString stringWithFormat:@"%@/v1beta/models?pageSize=100&key=%@", cleanEP, cleanKey];
    } else if ([cleanEP containsString:@"dashscope.aliyuncs.com"]) {
        urlStr = @"https://dashscope.aliyuncs.com/compatible-mode/v1/models";
    } else if ([cleanEP containsString:@"open.bigmodel.cn"]) {
        urlStr = @"https://open.bigmodel.cn/api/paas/v4/models";
    } else if ([cleanEP hasSuffix:@"/v1"]) {
        urlStr = [NSString stringWithFormat:@"%@/models", cleanEP];
    } else if ([cleanEP hasSuffix:@"/v1/chat/completions"]) {
        urlStr = [cleanEP stringByReplacingOccurrencesOfString:@"/v1/chat/completions" withString:@"/v1/models"];
    } else {
        urlStr = [NSString stringWithFormat:@"%@/v1/models", cleanEP];
    }

    NSMutableURLRequest *req = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:urlStr]];
    if (!isGoogle) {
        [req setValue:[NSString stringWithFormat:@"Bearer %@", cleanKey] forHTTPHeaderField:@"Authorization"];
    }
    req.HTTPMethod = @"GET";
    req.timeoutInterval = 12.0;

    [[session dataTaskWithRequest:req completionHandler:^(NSData *data, NSURLResponse *resp, NSError *err) {
        NSMutableArray<NSMutableDictionary *> *candidatePool = [NSMutableArray array];
        NSMutableSet *seen = [NSMutableSet set];

        if (!err && data) {
            NSDictionary *json = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
            NSArray *rawModels = json[@"models"] ?: json[@"data"];
            if ([rawModels isKindOfClass:[NSArray class]]) {
                for (NSDictionary *m in rawModels) {
                    if (![m isKindOfClass:[NSDictionary class]]) continue;
                    NSString *mID = m[@"name"] ?: m[@"id"];
                    if (!mID || mID.length == 0 || [seen containsObject:mID]) continue;

                    NSString *badgeTitle = nil;
                    BOOL supportsBidi = NO;
                    if (!agIsModelCapableForTab(mID, m, tab, &badgeTitle, &supportsBidi)) {
                        continue;
                    }

                    BOOL onlyBidi = agIsPureWebSocketOnlyModel(mID, m);
                    [seen addObject:mID];
                    double newestScore = agCalculateModelNewestScore(mID, m);
                    NSInteger supportTier = agTabSupportTier(badgeTitle, onlyBidi, supportsBidi, tab);

                    [candidatePool addObject:[@{
                        @"id": mID,
                        @"title": badgeTitle ?: mID,
                        @"bidi": @(supportsBidi),
                        @"onlyBidi": @(onlyBidi),
                        @"newestScore": @(newestScore),
                        @"supportTier": @(supportTier),
                        @"latencyMs": @9999,
                        @"latencyStr": @"⚡ 可用",
                        @"isUsable": @YES,
                        @"verified": @NO
                    } mutableCopy]];
                }
            }
        }

        // 国内平台防空兜底（当阿里通义千问、智谱、火山豆包、Kimi 未开放通用 models 权限时智能填入官方推荐，包含 WebSocket 实时模型）
        if (candidatePool.count == 0) {
            NSArray *defaults = nil;
            NSString *epLower = [cleanEP lowercaseString];
            if ([epLower containsString:@"dashscope"]) {
                defaults = @[@"qwen-plus", @"qwen-turbo", @"qwen-max", @"qwen2.5-72b-instruct", @"qwen-omni-turbo", @"qwen3-omni-flash-realtime", @"qwen-omni-turbo-realtime"];
            } else if ([epLower containsString:@"bigmodel"]) {
                defaults = @[@"glm-4-flash", @"glm-4-plus", @"glm-4v-plus", @"glm-4-air", @"glm-realtime"];
            } else if ([epLower containsString:@"volces"] || [epLower containsString:@"bytedance"]) {
                defaults = @[@"doubao-pro-32k", @"doubao-lite-32k", @"doubao-vision-pro-32k"];
            } else if ([epLower containsString:@"stepfun"]) {
                defaults = @[@"step-1o-audio"];
            } else if ([epLower containsString:@"moonshot"]) {
                defaults = @[@"moonshot-v1-8k", @"moonshot-v1-32k", @"moonshot-v1-128k"];
            } else if ([epLower containsString:@"deepseek"]) {
                defaults = @[@"deepseek-chat", @"deepseek-reasoner"];
            } else {
                defaults = @[@"step-1o-audio", @"qwen3-omni-flash-realtime", @"glm-realtime"];
            }
            if (defaults.count > 0) {
                for (NSString *dID in defaults) {
                    NSString *badgeTitle = nil;
                    BOOL supportsBidi = NO;
                    if (!agIsModelCapableForTab(dID, @{}, tab, &badgeTitle, &supportsBidi)) continue;
                    BOOL onlyBidi = agIsPureWebSocketOnlyModel(dID, @{});
                    [candidatePool addObject:[@{
                        @"id": dID,
                        @"title": badgeTitle ?: dID,
                        @"bidi": @(supportsBidi),
                        @"onlyBidi": @(onlyBidi),
                        @"newestScore": @1000,
                        @"supportTier": @1,
                        @"latencyMs": @9999,
                        @"latencyStr": @"⚡ 推荐",
                        @"isUsable": @YES,
                        @"verified": @NO
                    } mutableCopy]];
                }
            }
        }

        if (candidatePool.count == 0) {
            dispatch_async(dispatch_get_main_queue(), ^{
                if (completion) completion(NO, @[], @"该 API 未返回符合当前功能的模型");
            });
            return;
        }

        // 先按「支持当前功能等级 (supportTier) 降序 -> 最新稳定版本 (newestScore) 降序」排列
        [candidatePool sortUsingComparator:^NSComparisonResult(NSDictionary *a, NSDictionary *b) {
            NSComparisonResult tierCmp = [b[@"supportTier"] compare:a[@"supportTier"]];
            if (tierCmp != NSOrderedSame) return tierCmp;
            return [b[@"newestScore"] compare:a[@"newestScore"]];
        }];

        // 受控并发（每次最多 4 个连接）对排在最前面的 18 个最新支持模型执行真实连通性测试，其余模型全部保留不限制数量
        NSUInteger probeCount = candidatePool.count;
        dispatch_group_t group = dispatch_group_create();
        dispatch_semaphore_t sem = dispatch_semaphore_create(6);
        dispatch_queue_t probeQueue = dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0);

        for (NSUInteger i = 0; i < probeCount; i++) {
            NSMutableDictionary *cand = candidatePool[i];
            NSString *candID = cand[@"id"];
            BOOL onlyBidi = [cand[@"onlyBidi"] boolValue];
            dispatch_group_enter(group);
            dispatch_async(probeQueue, ^{
                dispatch_semaphore_wait(sem, DISPATCH_TIME_FOREVER);
                agProbeModelForTab(tab, cleanEP, cleanKey, proxy, candID, onlyBidi, ^(BOOL ok, NSInteger latencyMs, NSString *errMsg) {
                    @synchronized (cand) {
                        if (ok) {
                            cand[@"latencyMs"] = @(latencyMs);
                            cand[@"latencyStr"] = onlyBidi ? [NSString stringWithFormat:@"🟢 实时 %ldms", (long)latencyMs] : [NSString stringWithFormat:@"🟢 %ldms", (long)latencyMs];
                            cand[@"isUsable"] = @YES;
                            cand[@"verified"] = @YES;
                        } else {
                            cand[@"latencyMs"] = @99999;
                            cand[@"latencyStr"] = @"❌ 不支持/受限";
                            cand[@"isUsable"] = @NO;
                            cand[@"verified"] = @NO;
                        }
                    }
                    dispatch_semaphore_signal(sem);
                    dispatch_group_leave(group);
                });
            });
        }

        dispatch_group_notify(group, dispatch_get_main_queue(), ^{
            NSMutableArray<NSDictionary *> *usableList = [NSMutableArray array];
            for (NSDictionary *item in candidatePool) {
                if ([item[@"isUsable"] boolValue]) {
                    [usableList addObject:item];
                }
            }

            // 排序：实测验证通过 (verified) 置顶 -> 支持当前功能等级 (supportTier) 降序 -> 最新稳定版本 (newestScore) 降序
            [usableList sortUsingComparator:^NSComparisonResult(NSDictionary *a, NSDictionary *b) {
                BOOL aVer = [a[@"verified"] boolValue];
                BOOL bVer = [b[@"verified"] boolValue];
                if (aVer != bVer) return aVer ? NSOrderedAscending : NSOrderedDescending;

                NSComparisonResult tierCmp = [b[@"supportTier"] compare:a[@"supportTier"]];
                if (tierCmp != NSOrderedSame) return tierCmp;

                NSComparisonResult newCmp = [b[@"newestScore"] compare:a[@"newestScore"]];
                if (newCmp != NSOrderedSame) return newCmp;

                return [a[@"latencyMs"] compare:b[@"latencyMs"]];
            }];

            NSMutableDictionary *p = loadGeminiPrefs();
            NSString *cacheKey = (tab == AGConfigTabTranslation) ? @"AG_Trans_CachedModels" : [NSString stringWithFormat:@"%@_CachedModels", agPrefixForTab(tab)];
            p[cacheKey] = usableList;
            gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });

            if (completion) completion(YES, usableList, nil);
        });
    }] resume];
}

// ==================== 1. 防穿透窗口 ====================
@interface GeminiPassthroughWindow : UIWindow
@property (nonatomic, strong) UIView *capsuleWrapper;
@property (nonatomic, weak) UIView *miniSummonWrapper;
@property (nonatomic, assign) BOOL lockFullScreenTouch;
@end

@implementation GeminiPassthroughWindow
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    if (self.hidden || self.alpha < 0.05) return nil;
    if (self.lockFullScreenTouch) return [super hitTest:point withEvent:event];
    // 灵动小胶囊形态下：除小胶囊自身外，其余全屏区域直接返回 nil，将滑动手势 100% 交还底层 App 与桌面
    if (self.miniSummonWrapper && !self.miniSummonWrapper.hidden && self.miniSummonWrapper.alpha > 0.05) {
        CGPoint mp = [self convertPoint:point toView:self.miniSummonWrapper];
        if ([self.miniSummonWrapper pointInside:mp withEvent:event]) {
            return [self.miniSummonWrapper hitTest:mp withEvent:event] ?: self.miniSummonWrapper;
        }
        return nil;
    }
    if (self.capsuleWrapper && !self.capsuleWrapper.hidden && self.capsuleWrapper.alpha > 0.05) {
        CGPoint p = [self convertPoint:point toView:self.capsuleWrapper];
        if ([self.capsuleWrapper pointInside:p withEvent:event]) {
            return [self.capsuleWrapper hitTest:p withEvent:event] ?: self.capsuleWrapper;
        }
        return nil;
    }
    return nil;
}

- (BOOL)pointInside:(CGPoint)point withEvent:(UIEvent *)event {
    return ([self hitTest:point withEvent:event] != nil);
}

// 允许窗口在锁屏壁纸 (SBCoverSheetWindow) 上方直接渲染显示，解决锁屏呼唤只有震动没有界面的问题
- (BOOL)_canShowWhileLocked {
    return YES;
}

// 关键修复：灵动形态下绝不抢占 KeyWindow（返回 NO），只有展开为完整主界面需要打字时才允许成为 KeyWindow！
- (BOOL)_canBecomeKeyWindow {
    if (self.miniSummonWrapper && !self.miniSummonWrapper.hidden) {
        return NO;
    }
    return YES;
}
@end

// ==================== 全局灵动胶囊反馈悬浮窗 (模块 E1) ====================
@implementation AGGlobalActionPillWindow

+ (instancetype)sharedPill {
    static AGGlobalActionPillWindow *pill = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        CGRect bounds = [UIScreen mainScreen].bounds;
        UIWindowScene *scene = nil;
        if (@available(iOS 13.0, *)) {
            for (UIScene *s in [UIApplication sharedApplication].connectedScenes) {
                if ([s isKindOfClass:[UIWindowScene class]]) { scene = (UIWindowScene *)s; break; }
            }
        }
        if (scene) {
            pill = [[self alloc] initWithWindowScene:scene];
        } else {
            pill = [[self alloc] initWithFrame:bounds];
        }
        pill.frame = bounds;
        pill.windowLevel = UIWindowLevelAlert + 1000;
        pill.backgroundColor = [UIColor clearColor];
        pill.hidden = YES;
        pill.userInteractionEnabled = NO;
        if ([pill respondsToSelector:@selector(_setSecure:)]) {
            [pill _setSecure:YES];
        }
        UIViewController *vc = [[UIViewController alloc] init];
        vc.view.backgroundColor = [UIColor clearColor];
        vc.view.userInteractionEnabled = NO;
        pill.rootViewController = vc;
        [pill setupPillUI];
    });
    return pill;
}

- (BOOL)_canShowWhileLocked {
    return YES;
}

- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    return nil; // 保证100%穿透，不阻断底层任何操作
}

- (void)setupPillUI {
    self.haptic = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleMedium];
    CGFloat screenW = [UIScreen mainScreen].bounds.size.width;
    CGFloat pillW = 280.0;
    CGFloat pillH = 38.0;
    UIBlurEffect *blur = [UIBlurEffect effectWithStyle:UIBlurEffectStyleDark];
    self.blurView = [[UIVisualEffectView alloc] initWithEffect:blur];
    self.blurView.frame = CGRectMake((screenW - pillW) * 0.5, -60.0, pillW, pillH);
    self.blurView.layer.cornerRadius = pillH * 0.5;
    self.blurView.layer.masksToBounds = YES;
    self.blurView.layer.borderWidth = 1.0;
    self.blurView.layer.borderColor = [UIColor colorWithRed:0.25 green:0.85 blue:1.0 alpha:0.45].CGColor;

    self.titleLabel = [[UILabel alloc] initWithFrame:self.blurView.bounds];
    self.titleLabel.textColor = [UIColor whiteColor];
    self.titleLabel.font = [UIFont systemFontOfSize:13.5 weight:UIFontWeightSemibold];
    self.titleLabel.textAlignment = NSTextAlignmentCenter;
    self.titleLabel.adjustsFontSizeToFitWidth = YES;
    self.titleLabel.minimumScaleFactor = 0.8;
    [self.blurView.contentView addSubview:self.titleLabel];
    [self.rootViewController.view addSubview:self.blurView];
}

- (void)showActionPill:(NSString *)message {
    if (!message || message.length == 0) return;
    dispatch_async(dispatch_get_main_queue(), ^{
        [self.haptic impactOccurred];
        self.titleLabel.text = message;
        CGFloat screenW = [UIScreen mainScreen].bounds.size.width;
        CGSize txtSz = [message sizeWithAttributes:@{NSFontAttributeName: self.titleLabel.font}];
        CGFloat pillW = MAX(220.0, MIN(screenW - 40.0, txtSz.width + 44.0));
        CGFloat pillH = 38.0;
        CGFloat targetY = 22.0;

        self.blurView.frame = CGRectMake((screenW - pillW) * 0.5, -60.0, pillW, pillH);
        self.titleLabel.frame = self.blurView.bounds;
        self.hidden = NO;
        self.blurView.alpha = 0.0;
        self.blurView.transform = CGAffineTransformMakeScale(0.85, 0.85);

        [UIView animateWithDuration:0.35 delay:0 usingSpringWithDamping:0.75 initialSpringVelocity:0.8 options:UIViewAnimationOptionCurveEaseOut animations:^{
            self.blurView.alpha = 1.0;
            self.blurView.transform = CGAffineTransformIdentity;
            self.blurView.frame = CGRectMake((screenW - pillW) * 0.5, targetY, pillW, pillH);
        } completion:nil];

        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            [UIView animateWithDuration:0.30 delay:0 options:UIViewAnimationOptionCurveEaseIn animations:^{
                self.blurView.alpha = 0.0;
                self.blurView.frame = CGRectMake((screenW - pillW) * 0.5, -60.0, pillW, pillH);
            } completion:^(BOOL finished) {
                self.hidden = YES;
            }];
        });
    });
}

@end

UIKIT_EXTERN UIImage *_UICreateScreenUIImage(void);

static void agSafeLaunchURL(NSURL *url) {
    if (!url) return;
    // 延迟 0.12s 待悬浮窗隐藏并释放 KeyWindow 后，在后台高优线程发起 LaunchServices 唤醒，彻底杜绝 SpringBoard 主线程 10 秒 XPC 死锁！
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0), ^{
        @try {
            Class wsCls = objc_getClass("LSApplicationWorkspace");
            if (wsCls && [wsCls respondsToSelector:@selector(defaultWorkspace)]) {
                id ws = [wsCls defaultWorkspace];
                if ([ws respondsToSelector:@selector(openSensitiveURL:withOptions:)]) {
                    if ([ws openSensitiveURL:url withOptions:nil]) return;
                }
                if ([ws respondsToSelector:@selector(openURL:)]) {
                    if ([ws openURL:url]) return;
                }
            }
            dispatch_async(dispatch_get_main_queue(), ^{
                [[UIApplication sharedApplication] openURL:url options:@{} completionHandler:nil];
            });
        } @catch (NSException *e) {}
    });
}

// ==================== 微信跨进程自动发消息与系统底层控制核心服务 ====================
static NSString *agGetGlobalSharedDir(void) {
    NSArray *dirs = @[
        agJBRootPath(@"/var/mobile/Library/Preferences"),
        @"/var/jb/var/mobile/Library/Preferences",
        @"/var/mobile/Library/Preferences",
        @"/tmp"
    ];
    for (NSString *d in dirs) {
        if ([[NSFileManager defaultManager] fileExistsAtPath:d] &&
            [[NSFileManager defaultManager] isWritableFileAtPath:d]) {
            return d;
        }
    }
    return @"/tmp";
}

static NSString *agGetWeChatDocumentsDir(void) {
    NSString *bundleID = [[NSBundle mainBundle] bundleIdentifier];
    if ([bundleID isEqualToString:@"com.tencent.xin"]) {
        NSArray *paths = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES);
        return paths.firstObject;
    } else {
        Class proxyCls = objc_getClass("LSApplicationProxy");
        if (proxyCls && [proxyCls respondsToSelector:@selector(applicationProxyForIdentifier:)]) {
            id proxy = [proxyCls applicationProxyForIdentifier:@"com.tencent.xin"];
            if (proxy && [proxy respondsToSelector:@selector(dataContainerURL)]) {
                NSURL *url = [proxy dataContainerURL];
                if (url && url.path) {
                    return [url.path stringByAppendingPathComponent:@"Documents"];
                }
            }
        }
    }
    return nil;
}

static NSString *agGetWeChatSendFilePath(void) {
    NSString *doc = agGetWeChatDocumentsDir();
    if (doc) return [doc stringByAppendingPathComponent:@"ag_wechat_send.json"];
    return [agGetGlobalSharedDir() stringByAppendingPathComponent:@"ag_wechat_send.json"];
}

static NSString *agGetWeChatResultFilePath(void) {
    NSString *doc = agGetWeChatDocumentsDir();
    if (doc) return [doc stringByAppendingPathComponent:@"ag_wechat_result.json"];
    return [agGetGlobalSharedDir() stringByAppendingPathComponent:@"ag_wechat_result.json"];
}

static NSDictionary *agReadJSONFileAtPaths(NSArray<NSString *> *paths) {
    for (NSString *p in paths) {
        if (!p || p.length == 0) continue;
        NSData *data = [NSData dataWithContentsOfFile:p];
        if (data && data.length > 2) {
            NSDictionary *dict = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
            if ([dict isKindOfClass:[NSDictionary class]]) {
                return dict;
            }
        }
        NSDictionary *plistDict = [NSDictionary dictionaryWithContentsOfFile:p];
        if ([plistDict isKindOfClass:[NSDictionary class]]) {
            return plistDict;
        }
    }
    return nil;
}

static void agWriteJSONToSharedPaths(NSDictionary *dict, NSString *fileName, NSString *primaryPath) {
    if (!dict) return;
    NSData *data = [NSJSONSerialization dataWithJSONObject:dict options:0 error:nil];
    if (!data) return;
    NSMutableArray *targets = [NSMutableArray array];
    if (primaryPath.length > 0) [targets addObject:primaryPath];
    [targets addObject:[agGetGlobalSharedDir() stringByAppendingPathComponent:fileName]];
    [targets addObject:[@"/tmp" stringByAppendingPathComponent:fileName]];
    for (NSString *p in targets) {
        [data writeToFile:p atomically:YES];
        chmod([p UTF8String], 0666);
    }
}

static void agRemoveSharedFiles(NSString *fileName, NSString *primaryPath) {
    NSFileManager *fm = [NSFileManager defaultManager];
    if (primaryPath.length > 0) [fm removeItemAtPath:primaryPath error:nil];
    [fm removeItemAtPath:[agGetGlobalSharedDir() stringByAppendingPathComponent:fileName] error:nil];
    [fm removeItemAtPath:[@"/tmp" stringByAppendingPathComponent:fileName] error:nil];
}

static void agWriteWeChatResult(BOOL success, NSString *detail) {
    NSDictionary *res = @{
        @"success": @(success),
        @"detail": detail ?: @"",
        @"timestamp": @([[NSDate date] timeIntervalSince1970])
    };
    agWriteJSONToSharedPaths(res, @"ag_wechat_result.json", agGetWeChatResultFilePath());
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         CFSTR("com.custom.timeguardian.wechat_result"),
                                         NULL, NULL, YES);
}

static void agExecuteWeChatCommandDict(NSDictionary *dict, NSInteger retryCount) {
    if (!dict) return;
    NSString *cmdAction = dict[@"action"] ?: @"send_text";
    NSString *targetName = [dict[@"targetName"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    NSString *content = dict[@"content"] ?: @"";

    dispatch_async(dispatch_get_main_queue(), ^{
        @try {
            Class mmContextCls = objc_getClass("MMContext");
            Class mmServiceCenterCls = objc_getClass("MMServiceCenter");
            Class cContactMgrCls = objc_getClass("CContactMgr");
            Class cMessageMgrCls = objc_getClass("CMessageMgr");
            Class cMessageWrapCls = objc_getClass("CMessageWrap");
            Class sessionMgrCls = objc_getClass("MMNewSessionMgr");

            id ctx = nil;
            if (mmContextCls && [mmContextCls respondsToSelector:@selector(currentContext)]) {
                ctx = ((id(*)(id, SEL))objc_msgSend)(mmContextCls, @selector(currentContext));
            }
            if (!ctx && mmContextCls && [mmContextCls respondsToSelector:@selector(activeUserContext)]) {
                ctx = ((id(*)(id, SEL))objc_msgSend)(mmContextCls, @selector(activeUserContext));
            }
            id sc = (mmServiceCenterCls && [mmServiceCenterCls respondsToSelector:@selector(defaultCenter)]) ? [mmServiceCenterCls defaultCenter] : nil;

            id contactMgr = (ctx && [ctx respondsToSelector:@selector(getService:)]) ? [ctx getService:cContactMgrCls] : nil;
            if (!contactMgr && sc && [sc respondsToSelector:@selector(getService:)]) contactMgr = [sc getService:cContactMgrCls];

            id messageMgr = (ctx && [ctx respondsToSelector:@selector(getService:)]) ? [ctx getService:cMessageMgrCls] : nil;
            if (!messageMgr && sc && [sc respondsToSelector:@selector(getService:)]) messageMgr = [sc getService:cMessageMgrCls];

            if ((!ctx && !sc) || !contactMgr || !messageMgr) {
                if (retryCount < 6) {
                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.7 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                        agExecuteWeChatCommandDict(dict, retryCount + 1);
                    });
                    return;
                }
                agWriteWeChatResult(NO, @"微信后台服务尚未加载完成，请解锁进入微信后重试");
                return;
            }

            // 模式 A：读取微信未读消息汇总
            if ([cmdAction isEqualToString:@"read_unread"]) {
                id sessionMgr = (ctx && [ctx respondsToSelector:@selector(getService:)]) ? [ctx getService:sessionMgrCls] : nil;
                if (!sessionMgr && sc && [sc respondsToSelector:@selector(getService:)]) sessionMgr = [sc getService:sessionMgrCls];
                NSMutableArray *unreadSummaries = [NSMutableArray array];
                if (sessionMgr && [sessionMgr respondsToSelector:@selector(GetSessionCount)] && [sessionMgr respondsToSelector:@selector(GetSessionAtIndex:)]) {
                    NSInteger count = MIN(20, [sessionMgr GetSessionCount]);
                    for (NSInteger i = 0; i < count; i++) {
                        id cellData = [sessionMgr GetSessionAtIndex:i];
                        if (!cellData) continue;
                        NSUInteger unread = 0;
                        @try { unread = [[cellData valueForKey:@"m_uUnReadCount"] unsignedIntegerValue]; } @catch (NSException *e) {}
                        if (unread > 0) {
                            NSString *nick = @"好友";
                            NSString *lastMsg = @"新消息";
                            @try {
                                nick = [cellData valueForKey:@"m_nsNickName"] ?: ([cellData valueForKey:@"m_nsUserName"] ?: @"好友");
                                id msgWrap = [cellData valueForKey:@"m_msgWrap"];
                                if (msgWrap) lastMsg = [msgWrap valueForKey:@"m_nsContent"] ?: @"图片/语音消息";
                            } @catch (NSException *e) {}
                            [unreadSummaries addObject:[NSString stringWithFormat:@"%@(%lu条): %@", nick, (unsigned long)unread, lastMsg]];
                        }
                    }
                }
                if (unreadSummaries.count > 0) {
                    agWriteWeChatResult(YES, [NSString stringWithFormat:@"未读微信：%@", [unreadSummaries componentsJoinedByString:@"；"]]);
                } else {
                    agWriteWeChatResult(YES, @"当前没有未读的微信消息");
                }
                return;
            }

            // 模式 B：搜索联系人（合并全量通讯录列表，彻底修复空数组短路 Bug）
            id targetContact = nil;
            if (targetName.length > 0 && [contactMgr respondsToSelector:@selector(getContactByName:)]) {
                targetContact = [contactMgr getContactByName:targetName];
            }

            if (!targetContact || ![targetContact respondsToSelector:@selector(m_nsUsrName)]) {
                NSMutableArray *allContacts = [NSMutableArray array];
                if ([contactMgr respondsToSelector:@selector(getAllContactList)]) {
                    NSArray *list1 = [contactMgr getAllContactList];
                    if ([list1 isKindOfClass:[NSArray class]]) [allContacts addObjectsFromArray:list1];
                }
                if (allContacts.count == 0 && [contactMgr respondsToSelector:@selector(getContactList:contactType:)]) {
                    NSArray *list2 = [contactMgr getContactList:1 contactType:0xffffffff];
                    if ([list2 isKindOfClass:[NSArray class]]) [allContacts addObjectsFromArray:list2];
                    NSArray *list3 = [contactMgr getContactList:1 contactType:0];
                    if ([list3 isKindOfClass:[NSArray class]]) [allContacts addObjectsFromArray:list3];
                }

                // 若微信刚冷启动，通讯录列表尚未从数据库载入，自动延迟重试
                if (allContacts.count == 0 && retryCount < 6) {
                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.7 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                        agExecuteWeChatCommandDict(dict, retryCount + 1);
                    });
                    return;
                }

                NSString *cleanTarget = [targetName lowercaseString];
                for (id c in allContacts) {
                    @try {
                        NSString *remark = [[c valueForKey:@"m_nsRemark"] lowercaseString];
                        NSString *nick = [[c valueForKey:@"m_nsNickName"] lowercaseString];
                        NSString *alias = [[c valueForKey:@"m_nsAliasName"] lowercaseString];
                        NSString *usr = [[c valueForKey:@"m_nsUsrName"] lowercaseString];
                        if ([remark isEqualToString:cleanTarget] || [nick isEqualToString:cleanTarget] ||
                            [alias isEqualToString:cleanTarget] || [usr isEqualToString:cleanTarget]) {
                            targetContact = c;
                            break;
                        }
                    } @catch (NSException *ex) {}
                }
                if (!targetContact) {
                    for (id c in allContacts) {
                        @try {
                            NSString *remark = [[c valueForKey:@"m_nsRemark"] lowercaseString];
                            NSString *nick = [[c valueForKey:@"m_nsNickName"] lowercaseString];
                            if ((remark.length > 0 && ([remark containsString:cleanTarget] || [cleanTarget containsString:remark])) ||
                                (nick.length > 0 && ([nick containsString:cleanTarget] || [cleanTarget containsString:nick]))) {
                                targetContact = c;
                                break;
                            }
                        } @catch (NSException *ex) {}
                    }
                }
            }

            if (!targetContact) {
                agWriteWeChatResult(NO, [NSString stringWithFormat:@"未在微信通讯录找到「%@」", targetName]);
                return;
            }

            NSString *toUsr = nil;
            @try { toUsr = [targetContact valueForKey:@"m_nsUsrName"]; } @catch (NSException *ex) {}
            if (!toUsr || toUsr.length == 0) {
                agWriteWeChatResult(NO, @"联系人微信 ID 解析失败");
                return;
            }

            // 若指令为直接打开与该好友的聊天界面
            if ([cmdAction isEqualToString:@"open_chat"]) {
                Class logicMgrCls = objc_getClass("MMMsgLogicManager");
                id logicMgr = (ctx && [ctx respondsToSelector:@selector(getService:)]) ? [ctx getService:logicMgrCls] : (logicMgrCls ? [sc getService:logicMgrCls] : nil);
                UIViewController *rootVC = [UIApplication sharedApplication].keyWindow.rootViewController;
                UINavigationController *nav = [rootVC isKindOfClass:[UINavigationController class]] ? (UINavigationController *)rootVC : rootVC.navigationController;
                if ([rootVC isKindOfClass:[UITabBarController class]]) {
                    UIViewController *sel = ((UITabBarController *)rootVC).selectedViewController;
                    if ([sel isKindOfClass:[UINavigationController class]]) nav = (UINavigationController *)sel;
                }
                if (logicMgr && nav && [logicMgr respondsToSelector:@selector(PushOtherBaseMsgControllerByContact:navigationController:animated:)]) {
                    [logicMgr PushOtherBaseMsgControllerByContact:targetContact navigationController:nav animated:YES];
                    agWriteWeChatResult(YES, [NSString stringWithFormat:@"已打开与「%@」的微信对话窗", targetName]);
                    return;
                }
            }

            // 构造消息对象（修复双重 init 导致对象损坏的 Bug）
            id selfContact = [contactMgr respondsToSelector:@selector(getSelfContact)] ? [contactMgr getSelfContact] : nil;
            NSString *fromUsr = nil;
            @try { fromUsr = selfContact ? [selfContact valueForKey:@"m_nsUsrName"] : @""; } @catch (NSException *e) { fromUsr = @""; }

            id msgWrap = [cMessageWrapCls instancesRespondToSelector:@selector(initWithMsgType:)]
                ? [[cMessageWrapCls alloc] initWithMsgType:1]
                : [[cMessageWrapCls alloc] init];
            if (!msgWrap) {
                agWriteWeChatResult(NO, @"微信消息对象初始化失败");
                return;
            }

            [msgWrap setValue:(fromUsr ?: @"") forKey:@"m_nsFromUsr"];
            [msgWrap setValue:toUsr forKey:@"m_nsToUsr"];
            [msgWrap setValue:content forKey:@"m_nsContent"];
            [msgWrap setValue:@((UInt32)time(NULL)) forKey:@"m_uiCreateTime"];
            [msgWrap setValue:@(1) forKey:@"m_uiStatus"];
            [msgWrap setValue:@(1) forKey:@"m_uiMessageType"];

            if ([messageMgr respondsToSelector:@selector(AddMsg:MsgWrap:)]) {
                [messageMgr AddMsg:toUsr MsgWrap:msgWrap];
                NSString *showName = targetName;
                @try {
                    NSString *r = [targetContact valueForKey:@"m_nsRemark"];
                    NSString *n = [targetContact valueForKey:@"m_nsNickName"];
                    if (r.length > 0) showName = r;
                    else if (n.length > 0) showName = n;
                } @catch (NSException *ex) {}
                agWriteWeChatResult(YES, [NSString stringWithFormat:@"已向「%@」发送微信: %@", showName, content]);
            } else {
                agWriteWeChatResult(NO, @"微信 AddMsg 发送接口异常");
            }
        } @catch (NSException *e) {
            agWriteWeChatResult(NO, [NSString stringWithFormat:@"微信执行异常: %@", e.reason ?: @"未知"]);
        }
    });
}

static void agProcessWeChatSendCommand(void) {
    if (![[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.tencent.xin"]) return;
    NSString *mainPath = agGetWeChatSendFilePath();
    NSString *sharedPath = [agGetGlobalSharedDir() stringByAppendingPathComponent:@"ag_wechat_send.json"];
    NSDictionary *dict = agReadJSONFileAtPaths(@[mainPath ?: @"", sharedPath, @"/tmp/ag_wechat_send.json"]);
    if (!dict) return;

    agRemoveSharedFiles(@"ag_wechat_send.json", mainPath);

    NSTimeInterval ts = [dict[@"timestamp"] doubleValue];
    if ([[NSDate date] timeIntervalSince1970] - ts > 35.0) return;

    agExecuteWeChatCommandDict(dict, 0);
}

static void agWeChatDarwinCallback(CFNotificationCenterRef center, void *observer, CFStringRef name, const void *object, CFDictionaryRef userInfo) {
    agProcessWeChatSendCommand();
}

static void initWeChatAngelGuardianService(void) {
    if (![[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.tencent.xin"]) return;
    CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(),
                                    NULL,
                                    agWeChatDarwinCallback,
                                    CFSTR("com.custom.timeguardian.wechat_send"),
                                    NULL,
                                    CFNotificationSuspensionBehaviorDeliverImmediately);
    [[NSNotificationCenter defaultCenter] addObserverForName:UIApplicationDidBecomeActiveNotification
                                                      object:nil
                                                       queue:[NSOperationQueue mainQueue]
                                                  usingBlock:^(NSNotification * _Nonnull note) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            agProcessWeChatSendCommand();
        });
    }];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        agProcessWeChatSendCommand();
    });
}

static void agWeChatResultDarwinCallback(CFNotificationCenterRef center, void *observer, CFStringRef name, const void *object, CFDictionaryRef userInfo) {
    NSString *mainPath = agGetWeChatResultFilePath();
    NSString *sharedPath = [agGetGlobalSharedDir() stringByAppendingPathComponent:@"ag_wechat_result.json"];
    NSDictionary *res = agReadJSONFileAtPaths(@[mainPath ?: @"", sharedPath, @"/tmp/ag_wechat_result.json"]);
    if (res && res[@"detail"]) {
        NSString *detail = res[@"detail"];
        BOOL ok = [res[@"success"] boolValue];
        agRemoveSharedFiles(@"ag_wechat_result.json", mainPath);
        dispatch_async(dispatch_get_main_queue(), ^{
            [[AGGlobalActionPillWindow sharedPill] showActionPill:ok ? [NSString stringWithFormat:@"✅ %@", detail] : [NSString stringWithFormat:@"⚠️ %@", detail]];
        });
    }
}

typedef void (*MRSetVolFunc)(float);
typedef float (*MRGetVolFunc)(void);

static void agAdjustSystemVolume(NSString *mode, float targetLevel) {
    if (targetLevel > 1.0f && targetLevel <= 100.0f) {
        targetLevel = targetLevel / 100.0f;
    }
    dlopen("/System/Library/PrivateFrameworks/Celestial.framework/Celestial", RTLD_LAZY);
    Class avSysCls = objc_getClass("AVSystemController");
    id avsc = (avSysCls && [avSysCls respondsToSelector:@selector(sharedAVSystemController)]) ? [avSysCls sharedAVSystemController] : nil;

    void *h = dlopen("/System/Library/PrivateFrameworks/MediaRemote.framework/MediaRemote", RTLD_NOW);
    MRSetVolFunc setVol = h ? (MRSetVolFunc)dlsym(h, "MRMediaRemoteSetVolume") : NULL;
    MRGetVolFunc getVol = h ? (MRGetVolFunc)dlsym(h, "MRMediaRemoteGetVolume") : NULL;

    float cur = 0.5f;
    if (avsc && [avsc respondsToSelector:@selector(getVolume:forCategory:)]) {
        if (![avsc getVolume:&cur forCategory:@"Audio/Video"]) {
            cur = [AVAudioSession sharedInstance].outputVolume;
        }
    } else if (getVol) {
        cur = getVol();
    }

    float next = cur;
    NSString *cleanMode = [mode lowercaseString];
    if ([cleanMode isEqualToString:@"up"]) {
        next = MIN(1.0f, cur + 0.15f);
    } else if ([cleanMode isEqualToString:@"down"]) {
        next = MAX(0.0f, cur - 0.15f);
    } else if ([cleanMode isEqualToString:@"mute"]) {
        next = 0.0f;
    } else if ([cleanMode isEqualToString:@"max"]) {
        next = 1.0f;
    } else if ([cleanMode isEqualToString:@"unmute"]) {
        next = 0.55f;
    } else if ([cleanMode isEqualToString:@"set"]) {
        next = MAX(0.0f, MIN(1.0f, targetLevel));
    }

    if (avsc && [avsc respondsToSelector:@selector(setVolumeTo:forCategory:)]) {
        [avsc setVolumeTo:next forCategory:@"Audio/Video"];
        [avsc setVolumeTo:next forCategory:@"Ringtone"];
    }
    if (setVol) {
        setVol(next);
    }
    int percent = (int)roundf(next * 100.0f);
    NSString *pillMsg = (next <= 0.01f) ? @"🔇 系统已静音" : [NSString stringWithFormat:@"🔊 系统音量已调节至 %d%%", percent];
    [[AGGlobalActionPillWindow sharedPill] showActionPill:pillMsg];
}

static void agSetLowPowerMode(BOOL enable) {
    dlopen("/System/Library/PrivateFrameworks/CoreDuet.framework/CoreDuet", RTLD_NOW);
    Class bsClass = objc_getClass("_CDBatterySaver");
    if (bsClass) {
        id saver = [bsClass respondsToSelector:@selector(batterySaver)] ? [bsClass performSelector:@selector(batterySaver)] : nil;
        if (saver && [saver respondsToSelector:@selector(setPowerMode:error:)]) {
            typedef BOOL (*SetModeFunc)(id, SEL, long long, void *);
            SetModeFunc setMode = (SetModeFunc)[saver methodForSelector:@selector(setPowerMode:error:)];
            if (setMode) {
                setMode(saver, @selector(setPowerMode:error:), enable ? 1 : 0, NULL);
            }
        }
    }
    [[AGGlobalActionPillWindow sharedPill] showActionPill:enable ? @"🔋 已开启低电量模式" : @"🔋 已关闭低电量模式"];
}

// ====== 顶级触控与看屏打字引擎替换块 1 开始 ======
#include <ifaddrs.h>
#include <arpa/inet.h>

#ifdef __LP64__
typedef double AGIOHIDFloat;
#else
typedef float AGIOHIDFloat;
#endif

typedef CFTypeRef (*AG_IOHIDEventSystemClientCreateFunc)(CFAllocatorRef allocator);
typedef void (*AG_IOHIDEventSystemClientDispatchEventFunc)(CFTypeRef client, CFTypeRef event);
typedef void (*AG_IOHIDEventSystemClientSetMatchingFunc)(CFTypeRef client, CFDictionaryRef match);
typedef CFArrayRef (*AG_IOHIDEventSystemClientCopyServicesFunc)(CFTypeRef client);
typedef CFTypeRef (*AG_IOHIDServiceClientCopyPropertyFunc)(CFTypeRef service, CFStringRef key);
typedef CFTypeRef (*AG_IOHIDServiceClientGetRegistryIDFunc)(CFTypeRef service);
typedef CFTypeRef (*IOHIDEventCreateDigitizerEventFunc)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, AGIOHIDFloat, AGIOHIDFloat, AGIOHIDFloat, AGIOHIDFloat, AGIOHIDFloat, Boolean, Boolean, uint32_t);
typedef CFTypeRef (*IOHIDEventCreateDigitizerFingerEventFunc)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, uint32_t, AGIOHIDFloat, AGIOHIDFloat, AGIOHIDFloat, AGIOHIDFloat, AGIOHIDFloat, Boolean, Boolean, uint32_t);
typedef CFTypeRef (*AG_IOHIDEventCreateKeyboardEventFunc)(CFAllocatorRef, uint64_t, uint16_t, uint16_t, Boolean, uint32_t);
typedef void (*IOHIDEventAppendEventFunc)(CFTypeRef, CFTypeRef, uint32_t);
typedef void (*IOHIDEventSetIntegerValueFunc)(CFTypeRef, uint32_t, CFIndex);
typedef void (*IOHIDEventSetFloatValueFunc)(CFTypeRef, uint32_t, AGIOHIDFloat);
typedef void (*IOHIDEventSetSenderIDFunc)(CFTypeRef, uint64_t);
typedef uint64_t (*AG_IOHIDEventGetSenderIDFunc)(CFTypeRef);
typedef void (*AG_BKSHIDEventSendToFocusedProcessFunc)(CFTypeRef);

static volatile uint64_t gCachedRealTouchScreenSenderID = 0;
static CFTypeRef gSharedTouchHIDClient = NULL;
static volatile BOOL gIsScreenVisionAgentBusy = NO;
static volatile BOOL gIsTouchSynthesizing = NO;

// 从 IOKit 驱动树与 HID 服务双重提取本机真实触摸屏 SenderID（配合 agInSituHIDCallback 真机手指触摸实时更新）
static uint64_t agResolveHardwareTouchScreenSenderID(CFTypeRef hidClient) {
    if (gCachedRealTouchScreenSenderID != 0) {
        return gCachedRealTouchScreenSenderID;
    }

    typedef CFMutableDictionaryRef (*AG_IOServiceMatchingFunc)(const char *name);
    typedef uint32_t (*AG_IOServiceGetMatchingServiceFunc)(uint32_t masterPort, CFDictionaryRef matching);
    typedef int (*AG_IORegistryEntryGetRegistryEntryIDFunc)(uint32_t entry, uint64_t *entryID);
    typedef int (*AG_IOObjectReleaseFunc)(uint32_t object);

    static AG_IOHIDEventSystemClientSetMatchingFunc setMatching = NULL;
    static AG_IOHIDEventSystemClientCopyServicesFunc copyServices = NULL;
    static AG_IOHIDServiceClientCopyPropertyFunc copyProp = NULL;
    static AG_IOHIDServiceClientGetRegistryIDFunc getRegID = NULL;
    static AG_IOServiceMatchingFunc ioMatching = NULL;
    static AG_IOServiceGetMatchingServiceFunc ioGetService = NULL;
    static AG_IORegistryEntryGetRegistryEntryIDFunc ioGetEntryID = NULL;
    static AG_IOObjectReleaseFunc ioRelease = NULL;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        void *ioHandle = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        if (ioHandle) {
            setMatching  = (AG_IOHIDEventSystemClientSetMatchingFunc)dlsym(ioHandle, "IOHIDEventSystemClientSetMatching");
            copyServices = (AG_IOHIDEventSystemClientCopyServicesFunc)dlsym(ioHandle, "IOHIDEventSystemClientCopyServices");
            copyProp     = (AG_IOHIDServiceClientCopyPropertyFunc)dlsym(ioHandle, "IOHIDServiceClientCopyProperty");
            getRegID     = (AG_IOHIDServiceClientGetRegistryIDFunc)dlsym(ioHandle, "IOHIDServiceClientGetRegistryID");
            ioMatching   = (AG_IOServiceMatchingFunc)dlsym(ioHandle, "IOServiceMatching");
            ioGetService = (AG_IOServiceGetMatchingServiceFunc)dlsym(ioHandle, "IOServiceGetMatchingService");
            ioGetEntryID = (AG_IORegistryEntryGetRegistryEntryIDFunc)dlsym(ioHandle, "IORegistryEntryGetRegistryEntryID");
            ioRelease    = (AG_IOObjectReleaseFunc)dlsym(ioHandle, "IOObjectRelease");
        }
    });

    if (hidClient && setMatching && copyServices && getRegID) {
        NSDictionary *matchDict = @{@"PrimaryUsagePage": @(0x0D), @"PrimaryUsage": @(0x04)};
        setMatching(hidClient, (__bridge CFDictionaryRef)matchDict);
        CFArrayRef services = copyServices(hidClient);
        if (services) {
            CFIndex count = CFArrayGetCount(services);
            uint64_t fallbackID = 0;
            for (CFIndex i = 0; i < count; i++) {
                CFTypeRef srv = CFArrayGetValueAtIndex(services, i);
                if (!srv) continue;
                CFTypeRef regObj = getRegID(srv);
                uint64_t sid = 0;
                if (regObj && CFGetTypeID(regObj) == CFNumberGetTypeID()) {
                    CFNumberGetValue((CFNumberRef)regObj, kCFNumberSInt64Type, &sid);
                }
                if (sid != 0) {
                    BOOL isBuiltIn = NO;
                    if (copyProp) {
                        CFTypeRef biObj = copyProp(srv, CFSTR("Built-In"));
                        if (biObj) {
                            if (CFGetTypeID(biObj) == CFBooleanGetTypeID()) isBuiltIn = CFBooleanGetValue((CFBooleanRef)biObj);
                            else if (CFGetTypeID(biObj) == CFNumberGetTypeID()) isBuiltIn = [(__bridge NSNumber *)biObj boolValue];
                            CFRelease(biObj);
                        }
                    }
                    if (isBuiltIn) {
                        gCachedRealTouchScreenSenderID = sid;
                        break;
                    } else if (fallbackID == 0) {
                        fallbackID = sid;
                    }
                }
            }
            if (gCachedRealTouchScreenSenderID == 0 && fallbackID != 0) {
                gCachedRealTouchScreenSenderID = fallbackID;
            }
            CFRelease(services);
        }
        setMatching(hidClient, NULL);
    }

    if (gCachedRealTouchScreenSenderID == 0 && ioMatching && ioGetService && ioGetEntryID && ioRelease) {
        const char *driverNames[] = {"AppleMultitouchDevice", "AppleEmbeddedTouchEEPROM", "IOHIDEventDriver"};
        for (int i = 0; i < 3; i++) {
            uint32_t srv = ioGetService(0, ioMatching(driverNames[i]));
            if (srv != 0) {
                uint64_t eid = 0;
                if (ioGetEntryID(srv, &eid) == 0 && eid != 0) {
                    gCachedRealTouchScreenSenderID = eid;
                    ioRelease(srv);
                    break;
                }
                ioRelease(srv);
            }
        }
    }

    return (gCachedRealTouchScreenSenderID != 0) ? gCachedRealTouchScreenSenderID : 0x8000000817319372ULL;
}

// 100% 硬件穿透水波纹（在手指抬起后才展示，绝不在点击瞬间遮挡 backboardd 命中测试！）
static void agShowTouchRippleAtPoint(CGPoint pt) {
    dispatch_async(dispatch_get_main_queue(), ^{
        AGGlobalActionPillWindow *hostWin = [AGGlobalActionPillWindow sharedPill];
        if (!hostWin || !hostWin.rootViewController || !hostWin.rootViewController.view) return;
        hostWin.hidden = NO;
        agDisableLayerHitTestingRecursively(hostWin.layer);

        UIView *ring = [[UIView alloc] initWithFrame:CGRectMake(pt.x - 18.0, pt.y - 18.0, 36.0, 36.0)];
        ring.backgroundColor = [UIColor colorWithRed:0.15 green:0.92 blue:1.00 alpha:0.26];
        ring.layer.cornerRadius = 18.0;
        ring.layer.borderWidth = 2.0;
        ring.layer.borderColor = [UIColor colorWithRed:0.20 green:0.96 blue:1.00 alpha:0.92].CGColor;
        ring.userInteractionEnabled = NO;
        agDisableLayerHitTestingRecursively(ring.layer);
        ring.transform = CGAffineTransformMakeScale(0.45, 0.45);
        [hostWin.rootViewController.view addSubview:ring];

        [UIView animateWithDuration:0.30 delay:0 options:UIViewAnimationOptionCurveEaseOut | UIViewAnimationOptionAllowUserInteraction animations:^{
            ring.transform = CGAffineTransformMakeScale(1.35, 1.35);
            ring.alpha = 0.0;
        } completion:^(BOOL finished) {
            [ring removeFromSuperview];
        }];
    });
}

static void agSendSynthesizedTouchEventWithRadius(CGPoint pt, BOOL isTouching, uint32_t eventMask, float radiusMM, float pressureVal) {
    static AG_IOHIDEventSystemClientCreateFunc createClient = NULL;
    static AG_IOHIDEventSystemClientDispatchEventFunc dispatchEv = NULL;
    static IOHIDEventCreateDigitizerEventFunc createHand = NULL;
    static IOHIDEventCreateDigitizerFingerEventFunc createFinger = NULL;
    static IOHIDEventAppendEventFunc appendEv = NULL;
    static IOHIDEventSetIntegerValueFunc setIntVal = NULL;
    static IOHIDEventSetFloatValueFunc setFloatVal = NULL;
    static IOHIDEventSetSenderIDFunc setSenderID = NULL;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        void *ioHandle = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        if (ioHandle) {
            createClient = (AG_IOHIDEventSystemClientCreateFunc)dlsym(ioHandle, "IOHIDEventSystemClientCreate");
            dispatchEv   = (AG_IOHIDEventSystemClientDispatchEventFunc)dlsym(ioHandle, "IOHIDEventSystemClientDispatchEvent");
            createHand   = (IOHIDEventCreateDigitizerEventFunc)dlsym(ioHandle, "IOHIDEventCreateDigitizerEvent");
            createFinger = (IOHIDEventCreateDigitizerFingerEventFunc)dlsym(ioHandle, "IOHIDEventCreateDigitizerFingerEvent");
            appendEv     = (IOHIDEventAppendEventFunc)dlsym(ioHandle, "IOHIDEventAppendEvent");
            setIntVal    = (IOHIDEventSetIntegerValueFunc)dlsym(ioHandle, "IOHIDEventSetIntegerValue");
            setFloatVal  = (IOHIDEventSetFloatValueFunc)dlsym(ioHandle, "IOHIDEventSetFloatValue");
            setSenderID  = (IOHIDEventSetSenderIDFunc)dlsym(ioHandle, "IOHIDEventSetSenderID");
            if (createClient) {
                gSharedTouchHIDClient = createClient(kCFAllocatorDefault);
            }
        }
    });
    if (!gSharedTouchHIDClient || !dispatchEv || !createHand || !createFinger || !appendEv) return;

    CGRect sb = [UIScreen mainScreen].bounds;
    AGIOHIDFloat normX = (AGIOHIDFloat)MAX(0.005, MIN(0.995, pt.x / MAX(1.0, sb.size.width)));
    AGIOHIDFloat normY = (AGIOHIDFloat)MAX(0.005, MIN(0.995, pt.y / MAX(1.0, sb.size.height)));
    AGIOHIDFloat pressure = isTouching ? (AGIOHIDFloat)pressureVal : 0.0;
    Boolean rangeAndTouch = isTouching ? true : false;
    uint64_t abTime = mach_absolute_time();

    uint32_t childMask  = (eventMask == 0x04) ? 0x04 : 0x03;
    uint32_t parentMask = (eventMask == 0x04) ? 0x04 : 0x23;

    // 关键：父级 Hand 事件 (transducerType=3, index=0, identity=0) 必须携带真实的 (normX, normY)
    CFTypeRef handEv = createHand(kCFAllocatorDefault, abTime, 3, 0, 0, parentMask, 0, normX, normY, 0.0, pressure, 0.0, rangeAndTouch, rangeAndTouch, 0);
    if (!handEv) return;

    CFTypeRef fingerEv = createFinger(kCFAllocatorDefault, abTime, 1, 2, childMask, normX, normY, 0.0, pressure, 0.0, rangeAndTouch, rangeAndTouch, 0);
    if (fingerEv) {
        if (setFloatVal) {
            AGIOHIDFloat rMaj = isTouching ? (AGIOHIDFloat)MAX(0.036, MIN(0.062, radiusMM * 0.009)) : 0.0;
            setFloatVal(fingerEv, 0xB0014, rMaj);
            setFloatVal(fingerEv, 0xB0015, rMaj * 0.87);
        }
        appendEv(handEv, fingerEv, 0);
        CFRelease(fingerEv);
    }

    if (setIntVal) {
        setIntVal(handEv, 0xB0019, 1); // kIOHIDEventFieldDigitizerIsDisplayIntegrated = 1
        setIntVal(handEv, 0x00004, 1); // kIOHIDEventFieldIsBuiltIn = 1
        setIntVal(handEv, 0xB0007, parentMask);
        setIntVal(handEv, 0xB0008, isTouching ? 1 : 0);
        setIntVal(handEv, 0xB0009, isTouching ? 1 : 0);
    }
    if (setSenderID) {
        uint64_t realSid = agResolveHardwareTouchScreenSenderID(gSharedTouchHIDClient);
        setSenderID(handEv, realSid);
    }

    dispatchEv(gSharedTouchHIDClient, handEv);
    CFRelease(handEv);
}

static void agSendSynthesizedTouchEvent(CGPoint pt, BOOL isTouching, uint32_t eventMask) {
    float radius = 4.85f + ((float)arc4random_uniform(110)) * 0.01f;
    float pressure = 0.25f + ((float)arc4random_uniform(16)) * 0.01f;
    agSendSynthesizedTouchEventWithRadius(pt, isTouching, eventMask, radius, pressure);
}

// 串行防重入点击器（先完成硬件点击按下与抬起，再展示水波纹，确保 100% 穿透点中底层淘宝/设置）
static void agSimulateScreenTapAtPoint(CGPoint pt) {
    dispatch_async(dispatch_get_main_queue(), ^{
        if (gIsTouchSynthesizing) return;
        gIsTouchSynthesizing = YES;

        CGRect sb = [UIScreen mainScreen].bounds;
        CGFloat jx = MAX(-1.5, MIN(1.5, (CGFloat)(agGaussianRandom() * 0.8)));
        CGFloat jy = MAX(-1.5, MIN(1.5, (CGFloat)(agGaussianRandom() * 0.8)));

        CGPoint downPt = CGPointMake(MAX(6.0, MIN(sb.size.width - 6.0, pt.x + jx)),
                                     MAX(6.0, MIN(sb.size.height - 6.0, pt.y + jy)));
        CGPoint movePt = CGPointMake(downPt.x + 0.15, downPt.y + 0.15);
        float baseRadius = 4.75f;
        float basePress  = 0.30f;

        agLiveDiagLog(@"TOUCH_SYNTH", @"Tapping screen at (%.1f, %.1f) with senderID=0x%llx", downPt.x, downPt.y, (unsigned long long)agResolveHardwareTouchScreenSenderID(gSharedTouchHIDClient));

        agSendSynthesizedTouchEventWithRadius(downPt, YES, 0x03, baseRadius, basePress);

        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.025 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            agSendSynthesizedTouchEventWithRadius(movePt, YES, 0x04, baseRadius * 1.05f, basePress * 1.08f);
        });
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.055 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            agSendSynthesizedTouchEventWithRadius(movePt, NO, 0x03, 0.0f, 0.0f);
            agShowTouchRippleAtPoint(downPt); // 抬起手指后再弹水波纹视觉反馈，绝不挡点击！
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.045 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                gIsTouchSynthesizing = NO;
            });
        });
    });
}

static void agSimulateScreenLongPressAtPoint(CGPoint pt, NSTimeInterval duration) {
    dispatch_async(dispatch_get_main_queue(), ^{
        if (gIsTouchSynthesizing) return;
        gIsTouchSynthesizing = YES;
        NSTimeInterval holdDur = MAX(0.6, MIN(3.0, duration));
        agSendSynthesizedTouchEventWithRadius(pt, YES, 0x03, 5.2f, 0.38f);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(holdDur * 0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            agSendSynthesizedTouchEventWithRadius(CGPointMake(pt.x + 0.2, pt.y + 0.2), YES, 0x04, 5.4f, 0.42f);
        });
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(holdDur * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            agSendSynthesizedTouchEventWithRadius(pt, NO, 0x03, 0.0f, 0.0f);
            agShowTouchRippleAtPoint(pt);
            gIsTouchSynthesizing = NO;
        });
    });
}

static void agSimulateScreenSwipe(CGPoint startPt, CGPoint endPt, NSTimeInterval duration) {
    if (gIsTouchSynthesizing) return;
    gIsTouchSynthesizing = YES;

    NSInteger steps = 15;
    NSTimeInterval totalDur = MAX(0.18, duration + ((double)arc4random_uniform(36) - 18.0) * 0.001);
    NSTimeInterval stepTime = totalDur / (double)steps;

    CGFloat midX = (startPt.x + endPt.x) * 0.5 + (((CGFloat)arc4random_uniform(20) - 10.0) + (endPt.y < startPt.y ? 8.0 : -8.0));
    CGFloat midY = (startPt.y + endPt.y) * 0.5 + ((CGFloat)arc4random_uniform(14) - 7.0);
    CGPoint ctrlPt = CGPointMake(midX, midY);

    agSendSynthesizedTouchEvent(startPt, YES, 0x03);
    for (NSInteger i = 1; i <= steps; i++) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(stepTime * i * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            CGFloat rawT = (CGFloat)i / (CGFloat)steps;
            CGFloat t = rawT * rawT * (3.0 - 2.0 * rawT);
            CGFloat u = 1.0 - t;
            CGFloat bx = u * u * startPt.x + 2.0 * u * t * ctrlPt.x + t * t * endPt.x;
            CGFloat by = u * u * startPt.y + 2.0 * u * t * ctrlPt.y + t * t * endPt.y;
            if (i < steps) {
                agSendSynthesizedTouchEvent(CGPointMake(bx, by), YES, 0x04);
            } else {
                agSendSynthesizedTouchEvent(CGPointMake(bx, by), NO, 0x03);
                gIsTouchSynthesizing = NO;
            }
        });
    }
}

static void agDispatchHIDKeyUsage(uint16_t usagePage, uint16_t usage, BOOL isDown) {
    static AG_IOHIDEventCreateKeyboardEventFunc createKeyEv = NULL;
    static AG_IOHIDEventSystemClientDispatchEventFunc dispatchEv = NULL;
    static IOHIDEventSetSenderIDFunc setSenderID = NULL;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        void *ioHandle = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        if (ioHandle) {
            createKeyEv = (AG_IOHIDEventCreateKeyboardEventFunc)dlsym(ioHandle, "IOHIDEventCreateKeyboardEvent");
            dispatchEv  = (AG_IOHIDEventSystemClientDispatchEventFunc)dlsym(ioHandle, "IOHIDEventSystemClientDispatchEvent");
            setSenderID = (IOHIDEventSetSenderIDFunc)dlsym(ioHandle, "IOHIDEventSetSenderID");
        }
    });
    if (!createKeyEv || !dispatchEv || !gSharedTouchHIDClient) return;
    CFTypeRef keyEv = createKeyEv(kCFAllocatorDefault, mach_absolute_time(), usagePage, usage, isDown ? true : false, 0);
    if (keyEv) {
        if (setSenderID) {
            setSenderID(keyEv, agResolveHardwareTouchScreenSenderID(gSharedTouchHIDClient));
        }
        dispatchEv(gSharedTouchHIDClient, keyEv);
        CFRelease(keyEv);
    }
}

static void agInjectTextIntoFocusedInput(NSString *text, BOOL autoSubmit) {
    if (!text || text.length == 0) return;
    dispatch_async(dispatch_get_main_queue(), ^{
        Class kbCls = objc_getClass("UIKeyboardImpl");
        id kb = (kbCls && [kbCls respondsToSelector:@selector(activeInstance)]) ? [kbCls activeInstance] : nil;
        if (kb && [kb respondsToSelector:@selector(insertText:)]) {
            [kb insertText:text];
            if (autoSubmit) [kb insertText:@"\n"];
            [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"⌨️ 已自动输入「%@」", text]];
            return;
        }

        NSString *savedClip = [[UIPasteboard generalPasteboard].string copy];
        [UIPasteboard generalPasteboard].string = text;
        agSendSynthesizedTouchEventWithRadius(CGPointMake(1, 1), NO, 0x03, 0.0f, 0.0f);

        agDispatchHIDKeyUsage(0x07, 0xE3, YES);
        agDispatchHIDKeyUsage(0x07, 0x19, YES);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.035 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            agDispatchHIDKeyUsage(0x07, 0x19, NO);
            agDispatchHIDKeyUsage(0x07, 0xE3, NO);
            [[AGGlobalActionPillWindow sharedPill] showActionPill:[NSString stringWithFormat:@"⌨️ 已为您自动输入「%@」", text]];

            if (autoSubmit) {
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.18 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    agDispatchHIDKeyUsage(0x07, 0x28, YES);
                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.04 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                        agDispatchHIDKeyUsage(0x07, 0x28, NO);
                    });
                });
            }
            if (savedClip && savedClip.length > 0 && ![savedClip isEqualToString:text]) {
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.65 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    if ([[UIPasteboard generalPasteboard].string isEqualToString:text]) {
                        [UIPasteboard generalPasteboard].string = savedClip;
                    }
                });
            }
        });
    });
}

// 安全、零双重释放、零显存残留的截屏函数（纯 ARC @autoreleasepool 管理，彻底杜绝 Double-Free 注销！）
// 安全、零双重释放、零显存残留的截屏函数（截屏瞬间同时隐身灵动小胶囊与顶部提示条，彻底杜绝 OCR 点中插件自身字幕！）
static UIImage *agCaptureSafeScreenBitmapWithMaxEdge(CGFloat maxEdge, UIWindow *overlayToHide) {
    __block UIImage *safeBitmap = nil;
    @autoreleasepool {
        BOOL needHideOverlay = (overlayToHide && !overlayToHide.hidden && overlayToHide.alpha > 0.01);
        CGFloat savedAlpha = needHideOverlay ? overlayToHide.alpha : 1.0;
        if (needHideOverlay) overlayToHide.alpha = 0.0;

        AGGlobalActionPillWindow *pillWin = [AGGlobalActionPillWindow sharedPill];
        BOOL needHidePill = (pillWin && !pillWin.hidden && pillWin.alpha > 0.01);
        CGFloat savedPillAlpha = needHidePill ? pillWin.alpha : 1.0;
        if (needHidePill) pillWin.alpha = 0.0;

        UIImage *rawImg = nil;
        @try {
            rawImg = _UICreateScreenUIImage();
        } @catch (NSException *e) {
            rawImg = nil;
        }
        if (needHideOverlay) overlayToHide.alpha = savedAlpha;
        if (needHidePill) pillWin.alpha = savedPillAlpha;

        if (rawImg && rawImg.size.width > 1.0 && rawImg.size.height > 1.0) {
            CGSize origSz = rawImg.size;
            CGFloat scale = MIN(1.0, maxEdge / MAX(origSz.width, origSz.height));
            CGSize targetSz = CGSizeMake(MAX(1.0, floor(origSz.width * scale)), MAX(1.0, floor(origSz.height * scale)));

            UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat];
            fmt.scale = 1.0;
            fmt.opaque = YES;
            UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:targetSz format:fmt];
            safeBitmap = [renderer imageWithActions:^(UIGraphicsImageRendererContext * _Nonnull ctx) {
                [rawImg drawInRect:CGRectMake(0, 0, targetSz.width, targetSz.height)];
            }];
        }
        rawImg = nil;
    }
    return safeBitmap;
}

// ==================== 🔋 IOKit AppleSmartBattery 超容电池(>100%)与运行内存(RAM)全维度底层硬件探针 ====================
static NSInteger agOfficialFactoryDesignCapacityForMachine(NSString *machine, NSString **outModelName) {
    static NSDictionary<NSString *, NSArray *> *sTable = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sTable = @{
            @"iPhone12,1": @[@"iPhone 11", @3110],
            @"iPhone12,3": @[@"iPhone 11 Pro", @3046],
            @"iPhone12,5": @[@"iPhone 11 Pro Max", @3969],
            @"iPhone12,8": @[@"iPhone SE (2代)", @1821],
            @"iPhone13,1": @[@"iPhone 12 mini", @2227],
            @"iPhone13,2": @[@"iPhone 12", @2815],
            @"iPhone13,3": @[@"iPhone 12 Pro", @2815],
            @"iPhone13,4": @[@"iPhone 12 Pro Max", @3687],
            @"iPhone14,4": @[@"iPhone 13 mini", @2406],
            @"iPhone14,5": @[@"iPhone 13", @3227],
            @"iPhone14,2": @[@"iPhone 13 Pro", @3095],
            @"iPhone14,3": @[@"iPhone 13 Pro Max", @4352],
            @"iPhone14,6": @[@"iPhone SE (3代)", @2018],
            @"iPhone14,7": @[@"iPhone 14", @3279],
            @"iPhone14,8": @[@"iPhone 14 Plus", @4325],
            @"iPhone15,2": @[@"iPhone 14 Pro", @3200],
            @"iPhone15,3": @[@"iPhone 14 Pro Max", @4323],
            @"iPhone15,4": @[@"iPhone 15", @3349],
            @"iPhone15,5": @[@"iPhone 15 Plus", @4383],
            @"iPhone16,1": @[@"iPhone 15 Pro", @3274],
            @"iPhone16,2": @[@"iPhone 15 Pro Max", @4422],
            @"iPhone17,1": @[@"iPhone 16 Pro", @3582],
            @"iPhone17,2": @[@"iPhone 16 Pro Max", @4685],
            @"iPhone17,3": @[@"iPhone 16", @3561],
            @"iPhone17,4": @[@"iPhone 16 Plus", @4674]
        };
    });
    NSArray *entry = sTable[machine ?: @""];
    if (entry) {
        if (outModelName) *outModelName = entry[0];
        return [entry[1] integerValue];
    }
    if (outModelName) *outModelName = machine.length > 0 ? machine : @"iPhone";
    return 0;
}

static NSString *agGetCurrentLocalIPAddress(NSString **outNetType) {
    NSString *wifiIP = nil;
    NSString *cellIP = nil;
    struct ifaddrs *interfaces = NULL;
    if (getifaddrs(&interfaces) == 0) {
        struct ifaddrs *temp = interfaces;
        while (temp != NULL) {
            if (temp->ifa_addr && temp->ifa_addr->sa_family == AF_INET) {
                NSString *ifName = [NSString stringWithUTF8String:temp->ifa_name];
                char addrBuf[INET_ADDRSTRLEN] = {0};
                inet_ntop(AF_INET, &((struct sockaddr_in *)temp->ifa_addr)->sin_addr, addrBuf, sizeof(addrBuf));
                NSString *ip = [NSString stringWithUTF8String:addrBuf];
                if ([ifName isEqualToString:@"en0"] && ![ip hasPrefix:@"169.254"]) {
                    wifiIP = ip;
                } else if ([ifName hasPrefix:@"pdp_ip"] && cellIP == nil) {
                    cellIP = ip;
                }
            }
            temp = temp->ifa_next;
        }
        freeifaddrs(interfaces);
    }
    if (wifiIP.length > 0) {
        if (outNetType) *outNetType = @"Wi-Fi 无线局域网";
        return wifiIP;
    }
    if (cellIP.length > 0) {
        if (outNetType) *outNetType = @"蜂窝移动数据";
        return cellIP;
    }
    if (outNetType) *outNetType = @"未连接网络";
    return @"无IP";
}

static void agCollectRealHardwareAndBatteryTelemetry(NSString **outPillText, NSString **outFullCardText, NSString **outVoiceSpeechText, NSString **outSystemPromptInject) {
    typedef CFMutableDictionaryRef (*AG_IOServiceMatchingFunc)(const char *name);
    typedef uint32_t (*AG_IOServiceGetMatchingServiceFunc)(uint32_t masterPort, CFDictionaryRef matching);
    typedef int (*AG_IORegistryEntryCreateCFPropertiesFunc)(uint32_t entry, CFMutableDictionaryRef *properties, CFAllocatorRef allocator, uint32_t options);
    typedef int (*AG_IOObjectReleaseFunc)(uint32_t object);

    static AG_IOServiceMatchingFunc ioMatching = NULL;
    static AG_IOServiceGetMatchingServiceFunc ioGetService = NULL;
    static AG_IORegistryEntryCreateCFPropertiesFunc ioCreateProps = NULL;
    static AG_IOObjectReleaseFunc ioRelease = NULL;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        void *ioHandle = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        if (ioHandle) {
            ioMatching    = (AG_IOServiceMatchingFunc)dlsym(ioHandle, "IOServiceMatching");
            ioGetService  = (AG_IOServiceGetMatchingServiceFunc)dlsym(ioHandle, "IOServiceGetMatchingService");
            ioCreateProps = (AG_IORegistryEntryCreateCFPropertiesFunc)dlsym(ioHandle, "IORegistryEntryCreateCFProperties");
            ioRelease     = (AG_IOObjectReleaseFunc)dlsym(ioHandle, "IOObjectRelease");
        }
    });

    NSString *machine = agHardwareMachineIdentifier();
    NSString *modelName = nil;
    NSInteger appleOfficialDesignMAH = agOfficialFactoryDesignCapacityForMachine(machine, &modelName);

    UIDevice *dev = [UIDevice currentDevice];
    dev.batteryMonitoringEnabled = YES;
    int uiBatPct = (int)roundf(dev.batteryLevel * 100.0f);
    if (uiBatPct < 0) uiBatPct = 100;

    NSInteger bmsDesignMAH = appleOfficialDesignMAH > 0 ? appleOfficialDesignMAH : 3200;
    NSInteger realMaxMAH = 0;
    NSInteger rawCurrentMAH = 0;
    NSInteger cycleCount = -1;
    NSInteger surfaceHealthPct = -1;
    double tempCelsius = -1.0;
    NSInteger voltageMV = 0;
    NSInteger amperageMA = 0;
    BOOL isCharging = (dev.batteryState == UIDeviceBatteryStateCharging || dev.batteryState == UIDeviceBatteryStateFull);
    BOOL isPluggedIn = (dev.batteryState != UIDeviceBatteryStateUnplugged);

    if (ioMatching && ioGetService && ioCreateProps && ioRelease) {
        CFMutableDictionaryRef matchDict = ioMatching("AppleSmartBattery");
        if (matchDict) {
            uint32_t service = ioGetService(0, matchDict);
            if (service != 0) {
                CFMutableDictionaryRef propsRef = NULL;
                if (ioCreateProps(service, &propsRef, kCFAllocatorDefault, 0) == 0 && propsRef != NULL) {
                    NSDictionary *bat = (NSDictionary *)CFBridgingRelease(propsRef);
                    if ([bat isKindOfClass:[NSDictionary class]]) {
                        NSInteger dCap = [bat[@"DesignCapacity"] integerValue];
                        if (dCap > 800 && dCap < 10000) bmsDesignMAH = dCap;

                        NSInteger rawMax = [bat[@"AppleRawMaxCapacity"] integerValue];
                        NSInteger nomMax = [bat[@"NominalChargeCapacity"] integerValue];
                        NSInteger maxCap = [bat[@"MaxCapacity"] integerValue];
                        NSDictionary *batData = [bat[@"BatteryData"] isKindOfClass:[NSDictionary class]] ? bat[@"BatteryData"] : nil;
                        NSInteger qmaxVal = 0;
                        if (batData) {
                            id qm = batData[@"Qmax"];
                            if ([qm isKindOfClass:[NSNumber class]]) qmaxVal = [qm integerValue];
                            else if ([qm isKindOfClass:[NSArray class]] && [qm count] > 0) qmaxVal = [[qm firstObject] integerValue];
                        }

                        if (rawMax > 800 && rawMax < 12000) realMaxMAH = rawMax;
                        else if (nomMax > 800 && nomMax < 12000) realMaxMAH = nomMax;
                        else if (qmaxVal > 800 && qmaxVal < 12000) realMaxMAH = qmaxVal;
                        else if (maxCap > 800 && maxCap < 12000) realMaxMAH = maxCap;

                        NSInteger rawCur = [bat[@"RawCurrentCapacity"] integerValue];
                        if (rawCur > 0 && rawCur < 12000) rawCurrentMAH = rawCur;

                        if (bat[@"CycleCount"]) cycleCount = [bat[@"CycleCount"] integerValue];
                        else if (batData[@"CycleCount"]) cycleCount = [batData[@"CycleCount"] integerValue];

                        if (bat[@"MaximumCapacityPercent"]) {
                            surfaceHealthPct = [bat[@"MaximumCapacityPercent"] integerValue];
                        } else if (maxCap > 10 && maxCap <= 110) {
                            surfaceHealthPct = maxCap;
                        }

                        NSInteger rawTemp = [bat[@"Temperature"] integerValue];
                        if (rawTemp > 2500 && rawTemp < 3500) {
                            if (rawTemp > 2600 && rawTemp < 3300) tempCelsius = (rawTemp / 100.0);
                            else tempCelsius = (rawTemp - 2731.5) / 10.0;
                        } else if (rawTemp > 500 && rawTemp <= 2500) {
                            tempCelsius = rawTemp / 100.0;
                        }

                        voltageMV = [bat[@"Voltage"] integerValue];
                        if (bat[@"InstantAmperage"]) amperageMA = [bat[@"InstantAmperage"] integerValue];
                        else if (bat[@"Amperage"]) amperageMA = [bat[@"Amperage"] integerValue];

                        if (bat[@"IsCharging"]) isCharging = [bat[@"IsCharging"] boolValue];
                        if (bat[@"ExternalConnected"]) isPluggedIn = [bat[@"ExternalConnected"] boolValue];
                        NSInteger curCapPct = [bat[@"CurrentCapacity"] integerValue];
                        if (curCapPct > 0 && curCapPct <= 100) uiBatPct = (int)curCapPct;
                    }
                }
                ioRelease(service);
            }
        }
    }

    NSInteger baseDesignMAH = (appleOfficialDesignMAH > 0) ? appleOfficialDesignMAH : bmsDesignMAH;
    if (realMaxMAH <= 0) {
        realMaxMAH = (surfaceHealthPct > 0) ? (NSInteger)round((double)baseDesignMAH * surfaceHealthPct / 100.0) : baseDesignMAH;
    }
    if (rawCurrentMAH <= 0) {
        rawCurrentMAH = (NSInteger)round((double)realMaxMAH * uiBatPct / 100.0);
    }

    double realPhysicalHealthPct = ((double)realMaxMAH / (double)MAX(1, baseDesignMAH)) * 100.0;
    double bmsRelativeHealthPct  = ((double)realMaxMAH / (double)MAX(1, bmsDesignMAH)) * 100.0;
    NSInteger extraMAHOverOfficial = realMaxMAH - baseDesignMAH;

    NSString *batteryGradeNote = @"原装正常状态";
    if (realPhysicalHealthPct >= 101.0 && extraMAHOverOfficial >= 30) {
        batteryGradeNote = [NSString stringWithFormat:@"🚀 超容/扩容满血电池 (比官方原厂多出 +%ld mAh)", (long)extraMAHOverOfficial];
    } else if (surfaceHealthPct > 0 && (realPhysicalHealthPct - (double)surfaceHealthPct >= 4.5)) {
        batteryGradeNote = [NSString stringWithFormat:@"💡 移植新电芯状态 (系统表显 %ld%%，底层实测高达 %.1f%%)", (long)surfaceHealthPct, realPhysicalHealthPct];
    } else if (realPhysicalHealthPct >= 99.0) {
        batteryGradeNote = @"🌟 满血巅峰状态";
    } else if (realPhysicalHealthPct < 80.0) {
        batteryGradeNote = @"⚠️ 电池明显老化 (建议更换超容电芯)";
    }

    double watts = (voltageMV > 0 && amperageMA != 0) ? ((double)voltageMV * fabs((double)amperageMA) / 1000000.0) : 0.0;
    NSString *powerFlowStr = isCharging
        ? [NSString stringWithFormat:@"⚡正在充电 (功率 %.1fW, 电流 +%ldmA, 电压 %.2fV)", watts, (long)labs(amperageMA), voltageMV / 1000.0]
        : (isPluggedIn ? @"🔌 已接电源(满电维护)" : [NSString stringWithFormat:@"🔋放电使用中 (功耗 %.1fW, 电流 %ldmA)", watts, (long)amperageMA]);

    double usedRAM = 0.0, totalRAM = 0.0;
    agGetDeviceMemoryInfo(&usedRAM, &totalRAM);
    double freeRAM = MAX(0.05, totalRAM - usedRAM);
    int freeRAMMB = (int)round(freeRAM * 1024.0);
    int ramPct = (totalRAM > 0) ? (int)roundf((usedRAM / totalRAM) * 100.0f) : 0;

    NSUInteger bgAppCount = 0;
    if ([NSThread isMainThread]) {
        @try {
            Class coordCls = objc_getClass("SBMainSwitcherControllerCoordinator");
            id switcher = (coordCls && [coordCls respondsToSelector:@selector(sharedInstance)]) ? [coordCls sharedInstance] : nil;
            if (switcher && [switcher respondsToSelector:@selector(recentAppLayouts)]) {
                bgAppCount = [[switcher recentAppLayouts] count];
            }
        } @catch (NSException *e) {}
    }

    NSDictionary *fs = [[NSFileManager defaultManager] attributesOfFileSystemForPath:NSHomeDirectory() error:nil];
    double freeROM = [fs[NSFileSystemFreeSize] doubleValue] / (1024.0 * 1024.0 * 1024.0);
    double totalROM = [fs[NSFileSystemSize] doubleValue] / (1024.0 * 1024.0 * 1024.0);

    NSString *netType = nil;
    NSString *localIP = agGetCurrentLocalIPAddress(&netType);
    int brightPct = (int)roundf([UIScreen mainScreen].brightness * 100.0f);
    int volPct = (int)roundf([AVAudioSession sharedInstance].outputVolume * 100.0f);

    NSDictionary *prefs = agReadOnlyPrefs();
    BOOL locActive = [prefs[@"AG_LocSpoof_Active"] boolValue];
    BOOL shieldOn  = [prefs[@"AG_AntiDet_ShieldEnabled"] boolValue];
    NSString *locPlace = locActive ? (prefs[@"AG_LocSpoof_Name"] ?: @"已开启虚拟位置") : @"真实硬件 GPS";

    NSString *tempStr = (tempCelsius > 0) ? [NSString stringWithFormat:@"%.1f°C", tempCelsius] : @"正常";
    NSString *cycleStr = (cycleCount >= 0) ? [NSString stringWithFormat:@"%ld 次", (long)cycleCount] : @"未读取";
    NSString *surfStr = (surfaceHealthPct > 0) ? [NSString stringWithFormat:@"%ld%%", (long)surfaceHealthPct] : @"100%";

    if (outPillText) {
        *outPillText = [NSString stringWithFormat:@"📊运存%.2fG/%.0fG(余%dMB)｜🔋电量%d%%｜健康度%.1f%%",
                        usedRAM, totalRAM, freeRAMMB, uiBatPct, realPhysicalHealthPct];
    }

    if (outFullCardText) {
        NSMutableString *card = [NSMutableString string];
        [card appendFormat:@"📱 【%@ 底层硬件与运行内存体检报告】\\n", modelName];
        [card appendFormat:@"• 📊 运行内存 (RAM)：已用 %.2fG / 总计 %.1fG (占用 %d%%) ｜ 剩余可用 %.2fG (%d MB)\\n", usedRAM, totalRAM, ramPct, freeRAM, freeRAMMB];
        [card appendFormat:@"• 🗂️ 后台与存储：后台运行 %lu 款应用 ｜ 机身存储剩余 %.1fG / %.0fG\\n", (unsigned long)bgAppCount, freeROM, totalROM];
        [card appendFormat:@"• 🔋 实时电量：%d%%（当前剩余 %ld mAh / 实测满电 %ld mAh）\\n", uiBatPct, (long)rawCurrentMAH, (long)realMaxMAH];
        [card appendFormat:@"• ❤️ 真实物理健康度：%.1f%%（苹果官方原厂设计 %ld mAh", realPhysicalHealthPct, (long)baseDesignMAH];
        if (bmsDesignMAH != baseDesignMAH) {
            [card appendFormat:@"，排线标称 %ld mAh 占比 %.1f%%", (long)bmsDesignMAH, bmsRelativeHealthPct];
        }
        [card appendFormat:@"，系统表显 %@）\\n", surfStr];
        [card appendFormat:@"• 🏷️ 电芯状态鉴定：%@\\n", batteryGradeNote];
        [card appendFormat:@"• 🔄 充电循环次数：%@ ｜ 🌡️ 电池物理温度：%@\\n", cycleStr, tempStr];
        [card appendFormat:@"• ⚡ 充放电状态：%@\\n", powerFlowStr];
        [card appendFormat:@"• 📶 网络与状态：%@ (IP: %@) ｜ 音量 %d%% ｜ 亮度 %d%% ｜ 定位：%@%@",
         netType, localIP, volPct, brightPct, locPlace, (locActive && shieldOn ? @"(🛡️防检测已开)" : @"")];
        *outFullCardText = card;
    }

    if (outVoiceSpeechText) {
        NSString *ramSpeech = [NSString stringWithFormat:@"当前总运行内存 %.0f GB，已使用 %.2f GB，占用率 %d%%，剩余可用运行内存 %.2f GB（约 %d 兆）",
                               totalRAM, usedRAM, ramPct, freeRAM, freeRAMMB];
        if (realPhysicalHealthPct > 100.5 && extraMAHOverOfficial >= 20) {
            *outVoiceSpeechText = [NSString stringWithFormat:@"已读取底层硬件数据：%@。当前电量 %d%%，剩余 %ld 毫安时。检测到您更换了超容电池，官方原厂容量 %ld 毫安时，实测满电容量高达 %ld 毫安时，真实物理健康度 %.1f%%！已循环 %@，温度 %@，剩余机身存储 %.1f GB。",
                                   ramSpeech, uiBatPct, (long)rawCurrentMAH, (long)baseDesignMAH, (long)realMaxMAH, realPhysicalHealthPct, cycleStr, tempStr, freeROM];
        } else {
            *outVoiceSpeechText = [NSString stringWithFormat:@"已读取底层硬件数据：%@。当前电量 %d%%，剩余 %ld 毫安时，实测最大容量 %ld 毫安时，真实物理健康度 %.1f%%，已循环 %@，温度 %@，剩余机身存储 %.1f GB。",
                                   ramSpeech, uiBatPct, (long)rawCurrentMAH, (long)realMaxMAH, realPhysicalHealthPct, cycleStr, tempStr, freeROM];
        }
    }

    if (outSystemPromptInject) {
        *outSystemPromptInject = [NSString stringWithFormat:
            @"\\n【本机 IOKit AppleSmartBattery 与运行内存实时真实数据（提示：若用户在询问手机状态时将“电池健康度”口误说成“电子健康度/看健康度”，请汇报以下本机实测数据；但如果用户明确在问医院就诊的“电子健康卡/医保卡”或医学体检指标，请正常回答医疗问题，切勿混淆）】\\n"
            @"- 机型：%@ (iOS %@)\\n"
            @"- 运行内存 RAM：总计 %.2fG，已用 %.2fG (%d%%)，剩余可用 %.2fG (%d MB)，后台应用 %lu 个\\n"
            @"- 存储 ROM：剩余 %.1fG/%.0fG\\n"
            @"- 当前电量：%d%% (实时剩余容量：%ld mAh)\\n"
            @"- 底层库仑计实测满电容量：%ld mAh (苹果官方原厂容量：%ld mAh，排线标称：%ld mAh)\\n"
            @"- 真实物理电池健康度（未封顶）：%.1f%% (系统表显：%@，状态：%@)\\n"
            @"- 循环次数：%@ | 电池温度：%@ | 充放电：%@\\n"
            @"- 网络：%@ (IP：%@) | 音量：%d%% | 亮度：%d%% | 定位：%@\\n",
            modelName, [[UIDevice currentDevice] systemVersion],
            totalRAM, usedRAM, ramPct, freeRAM, freeRAMMB, (unsigned long)bgAppCount,
            freeROM, totalROM,
            uiBatPct, (long)rawCurrentMAH,
            (long)realMaxMAH, (long)baseDesignMAH, (long)bmsDesignMAH,
            realPhysicalHealthPct, surfStr, batteryGradeNote,
            cycleStr, tempStr, powerFlowStr,
            netType, localIP, volPct, brightPct, locPlace];
    }
}

// ==================== 🕵️‍♂️ 四级深度崩溃取证：准确真凶(.dylib + Sileo插件名) & 重点怀疑对象定位引擎 ====================
static os_unfair_lock gCrashCacheLock = OS_UNFAIR_LOCK_INIT;
static NSString *gCachedCrashPillStr = nil;
static NSString *gCachedCrashCardStr = nil;
static NSString *gCachedCrashSpeechStr = nil;

static NSString *agRespringLedgerFilePath(void) {
    return @"/var/mobile/Library/Preferences/ag_respring_ledger.json";
}

static NSArray<NSString *> *agDynamicLibrariesDirs(void) {
    return @[
        agJBRootPath(@"/Library/MobileSubstrate/DynamicLibraries"),
        @"/var/jb/Library/MobileSubstrate/DynamicLibraries",
        @"/Library/MobileSubstrate/DynamicLibraries"
    ];
}

// 根据 .dylib 文件名反查 dpkg 数据库，获取用户在 Sileo / Zebra 商店里看到的真实插件名称
static NSString *agResolveHumanPluginNameForDylib(NSString *dylibName) {
    if (!dylibName || dylibName.length == 0) return @"未知插件";
    static NSMutableDictionary<NSString *, NSString *> *sDylibNameCache = nil;
    static os_unfair_lock sCacheLock = OS_UNFAIR_LOCK_INIT;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sDylibNameCache = [NSMutableDictionary dictionary];
    });

    NSString *cleanDylib = [dylibName lastPathComponent];
    os_unfair_lock_lock(&sCacheLock);
    NSString *cached = sDylibNameCache[cleanDylib];
    os_unfair_lock_unlock(&sCacheLock);
    if (cached) return cached;

    NSArray<NSString *> *dpkgBaseDirs = @[
        agJBRootPath(@"/Library/dpkg"),
        @"/var/jb/Library/dpkg",
        @"/Library/dpkg"
    ];
    NSFileManager *fm = [NSFileManager defaultManager];
    NSString *resolvedResult = cleanDylib;

    for (NSString *baseDir in dpkgBaseDirs) {
        NSString *infoDir = [baseDir stringByAppendingPathComponent:@"info"];
        NSArray<NSString *> *files = [fm contentsOfDirectoryAtPath:infoDir error:nil];
        if (!files) continue;
        NSString *matchedPkgID = nil;
        for (NSString *file in files) {
            if (![file hasSuffix:@".list"]) continue;
            NSString *listPath = [infoDir stringByAppendingPathComponent:file];
            NSString *content = [NSString stringWithContentsOfFile:listPath encoding:NSUTF8StringEncoding error:nil];
            if (content && [content containsString:cleanDylib]) {
                matchedPkgID = [file substringToIndex:file.length - 5];
                break;
            }
        }
        if (matchedPkgID) {
            NSString *statusPath = [baseDir stringByAppendingPathComponent:@"status"];
            NSString *statusContent = [NSString stringWithContentsOfFile:statusPath encoding:NSUTF8StringEncoding error:nil];
            if (statusContent) {
                NSString *searchKey = [NSString stringWithFormat:@"Package: %@\n", matchedPkgID];
                NSRange pkgRange = [statusContent rangeOfString:searchKey];
                if (pkgRange.location != NSNotFound) {
                    NSString *sub = [statusContent substringFromIndex:pkgRange.location];
                    NSRange endBlock = [sub rangeOfString:@"\n\n"];
                    if (endBlock.location != NSNotFound) sub = [sub substringToIndex:endBlock.location];
                    for (NSString *line in [sub componentsSeparatedByString:@"\n"]) {
                        if ([line hasPrefix:@"Name: "]) {
                            NSString *pkgHumanName = [[line substringFromIndex:6] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
                            if (pkgHumanName.length > 0) {
                                resolvedResult = [NSString stringWithFormat:@"%@ (%@)", pkgHumanName, cleanDylib];
                                break;
                            }
                        }
                    }
                }
            }
            break;
        }
    }

    os_unfair_lock_lock(&sCacheLock);
    sDylibNameCache[cleanDylib] = resolvedResult;
    os_unfair_lock_unlock(&sCacheLock);
    return resolvedResult;
}

static BOOL agIsHookLoaderOrSystemImage(NSString *pathOrName) {
    if (!pathOrName || pathOrName.length == 0) return YES;
    NSString *lower = [pathOrName lowercaseString];
    if ([lower hasPrefix:@"/system/"] || [lower hasPrefix:@"/usr/lib/system/"] ||
        [lower hasPrefix:@"/usr/lib/libobjc"] || [lower hasPrefix:@"/usr/lib/swift/"] ||
        [lower hasPrefix:@"/usr/lib/libc++"] ||
        ([lower hasPrefix:@"/private/preboot/"] && ![lower containsString:@"dynamiclibraries"] && ![lower containsString:@"tweakinject"])) {
        return YES;
    }
    NSArray<NSString *> *loaders = @[
        @"ellekit", @"libsubstitute", @"substrateinserter", @"mobilesubstrate",
        @"libhooker", @"libblackjack", @"cydiasubstrate", @"choicy.dylib",
        @"libroothide", @"opainject", @"oldabi", @"cephei"
    ];
    for (NSString *ld in loaders) {
        if ([lower containsString:ld]) return YES;
    }
    return NO;
}

static BOOL agIsThirdPartyTweakImage(NSString *path, NSString *name) {
    NSString *pLower = [path ?: @"" lowercaseString];
    NSString *nLower = [name ?: @"" lowercaseString];
    if (![nLower hasSuffix:@".dylib"] && ![pLower hasSuffix:@".dylib"]) return NO;
    if (agIsHookLoaderOrSystemImage(pLower) || agIsHookLoaderOrSystemImage(nLower)) return NO;
    if ([pLower containsString:@"dynamiclibraries"] ||
        [pLower containsString:@"tweakinject"] ||
        [pLower containsString:@"/var/jb/"] ||
        [pLower containsString:@".jbroot"] ||
        [pLower containsString:@"procursus"]) {
        return YES;
    }
    return NO;
}

// 第 2 级深度追凶：提取崩溃报错(asi)中的异常类名或方法名，在所有已安装 .dylib 二进制文件中做特征码扫描定位真凶
static NSString *agScanDylibsForCrashingSymbolInASI(NSString *asiDesc) {
    if (!asiDesc || asiDesc.length < 6) return nil;
    NSMutableArray<NSString *> *candidateSymbols = [NSMutableArray array];

    NSRegularExpression *objcRe = [NSRegularExpression regularExpressionWithPattern:@"[-+]\[([A-Za-z0-9_]+)\s+([A-Za-z0-9_:]+)\]" options:0 error:nil];
    NSArray<NSTextCheckingResult *> *matches = [objcRe matchesInString:asiDesc options:0 range:NSMakeRange(0, asiDesc.length)];
    for (NSTextCheckingResult *m in matches) {
        if (m.numberOfRanges >= 3) {
            NSString *clsName = [asiDesc substringWithRange:[m rangeAtIndex:1]];
            NSString *selName = [asiDesc substringWithRange:[m rangeAtIndex:2]];
            if (selName.length >= 5 && ![selName isEqualToString:@"length"] && ![selName isEqualToString:@"count"] && ![selName isEqualToString:@"objectAtIndex:"] && ![selName isEqualToString:@"objectForKeyedSubscript:"]) {
                [candidateSymbols addObject:selName];
            }
            if (clsName.length >= 4 && ![clsName hasPrefix:@"NS"] && ![clsName hasPrefix:@"__NS"] && ![clsName hasPrefix:@"UI"] && ![clsName hasPrefix:@"_UI"] && ![clsName hasPrefix:@"SB"] && ![clsName hasPrefix:@"CA"]) {
                [candidateSymbols addObject:clsName];
            }
        }
    }
    if (candidateSymbols.count == 0) return nil;

    NSFileManager *fm = [NSFileManager defaultManager];
    for (NSString *dir in agDynamicLibrariesDirs()) {
        NSArray<NSString *> *files = [fm contentsOfDirectoryAtPath:dir error:nil];
        if (!files) continue;
        for (NSString *file in files) {
            if (![file hasSuffix:@".dylib"] || agIsHookLoaderOrSystemImage(file)) continue;
            NSString *fullPath = [dir stringByAppendingPathComponent:file];
            NSData *dylibData = [NSData dataWithContentsOfFile:fullPath options:NSDataReadingMappedIfSafe error:nil];
            if (!dylibData || dylibData.length < 100) continue;

            for (NSString *sym in candidateSymbols) {
                NSData *symBytes = [sym dataUsingEncoding:NSUTF8StringEncoding];
                if (symBytes.length >= 4) {
                    NSRange found = [dylibData rangeOfData:symBytes options:0 range:NSMakeRange(0, dylibData.length)];
                    if (found.location != NSNotFound) {
                        return [NSString stringWithFormat:@"%@ [二进制特征命中符号: %@]", agResolveHumanPluginNameForDylib(file), sym];
                    }
                }
            }
        }
    }
    return nil;
}

// 第 4 级嫌疑排查：查找在崩溃发生时间之前最近刚安装或更新的越狱插件
static NSString *agFindRecentlyModifiedTweakBeforeDate(NSDate *crashDate) {
    NSFileManager *fm = [NSFileManager defaultManager];
    NSString *newestDylib = nil;
    NSDate *newestDate = nil;
    NSTimeInterval crashTs = crashDate ? [crashDate timeIntervalSince1970] : [[NSDate date] timeIntervalSince1970];

    for (NSString *dir in agDynamicLibrariesDirs()) {
        NSArray<NSString *> *files = [fm contentsOfDirectoryAtPath:dir error:nil];
        if (!files) continue;
        for (NSString *file in files) {
            if (![file hasSuffix:@".dylib"] || agIsHookLoaderOrSystemImage(file)) continue;
            NSString *fullPath = [dir stringByAppendingPathComponent:file];
            NSDictionary *attrs = [fm attributesOfItemAtPath:fullPath error:nil];
            NSDate *modDate = attrs[NSFileModificationDate];
            if (modDate && [modDate timeIntervalSince1970] <= crashTs + 60.0) {
                if (!newestDate || [modDate compare:newestDate] == NSOrderedDescending) {
                    newestDate = modDate;
                    newestDylib = file;
                }
            }
        }
    }
    if (newestDylib) {
        NSDateFormatter *df = [[NSDateFormatter alloc] init];
        df.dateFormat = @"MM-dd HH:mm";
        return [NSString stringWithFormat:@"%@ (最近安装/变动于 %@)", agResolveHumanPluginNameForDylib(newestDylib), [df stringFromDate:newestDate]];
    }
    return nil;
}

// 核心取证分析器（在 @autoreleasepool 内运行，兼容 iOS 14 文本与 iOS 15-17 JSON .ips，区分准确真凶与重点怀疑对象）
static void agAnalyzeRecentCrashesAndResprings(NSString **outPillText, NSString **outCardReport, NSString **outVoiceSpeech) {
    @autoreleasepool {
        NSFileManager *fm = [NSFileManager defaultManager];
        NSTimeInterval now = [[NSDate date] timeIntervalSince1970];
        NSTimeInterval sevenDaysAgo = now - 7.0 * 86400.0;

        NSUInteger ledgerCount = 0;
        NSData *ledgerData = [NSData dataWithContentsOfFile:agRespringLedgerFilePath()];
        if (ledgerData) {
            NSArray *arr = [NSJSONSerialization JSONObjectWithData:ledgerData options:0 error:nil];
            if ([arr isKindOfClass:[NSArray class]]) {
                for (NSNumber *ts in arr) {
                    if ([ts isKindOfClass:[NSNumber class]] && [ts doubleValue] >= sevenDaysAgo) {
                        ledgerCount++;
                    }
                }
            }
        }

        NSArray<NSString *> *crashDirs = @[
            @"/var/mobile/Library/Logs/CrashReporter",
            @"/var/mobile/Library/Logs/CrashReporter/Retired",
            @"/private/var/mobile/Library/Logs/CrashReporter",
            @"/private/var/logs/CrashReporter"
        ];

        NSMutableArray<NSDictionary *> *crashEvents = [NSMutableArray array];
        NSMutableSet<NSString *> *seenFiles = [NSMutableSet set];

        for (NSString *dir in crashDirs) {
            NSArray<NSString *> *files = [fm contentsOfDirectoryAtPath:dir error:nil];
            if (!files) continue;
            for (NSString *fname in files) {
                if ([seenFiles containsObject:fname]) continue;
                if (![fname hasSuffix:@".ips"] && ![fname hasSuffix:@".crash"]) continue;

                NSString *lowerF = [fname lowercaseString];
                BOOL isSpringBoard = ([lowerF hasPrefix:@"springboard"] || [lowerF hasPrefix:@"backboardd"]);
                BOOL isKernelPanic = ([lowerF hasPrefix:@"panic"] || [lowerF hasPrefix:@"resetcounter"]);
                if (!isSpringBoard && !isKernelPanic) continue;

                NSString *fullPath = [dir stringByAppendingPathComponent:fname];
                NSDictionary *attrs = [fm attributesOfItemAtPath:fullPath error:nil];
                NSDate *modDate = attrs[NSFileModificationDate] ?: attrs[NSFileCreationDate];
                if (!modDate || [modDate timeIntervalSince1970] < sevenDaysAgo) continue;

                [seenFiles addObject:fname];
                [crashEvents addObject:@{
                    @"path": fullPath,
                    @"fname": fname,
                    @"date": modDate,
                    @"isSB": @(isSpringBoard),
                    @"isPanic": @(isKernelPanic)
                }];
            }
        }

        [crashEvents sortUsingComparator:^NSComparisonResult(NSDictionary *a, NSDictionary *b) {
            return [b[@"date"] compare:a[@"date"]];
        }];

        NSDateFormatter *df = [[NSDateFormatter alloc] init];
        df.dateFormat = @"MM月dd日 HH:mm:ss";

        NSUInteger sbCrashCount = 0;
        NSUInteger panicCount = 0;
        NSMutableArray<NSDictionary *> *parsedRecords = [NSMutableArray array];

        for (NSDictionary *ev in crashEvents) {
            if ([ev[@"isSB"] boolValue]) sbCrashCount++;
            if ([ev[@"isPanic"] boolValue]) panicCount++;
            if (parsedRecords.count >= 5) continue;

            NSDate *evDate = ev[@"date"];
            NSString *timeStr = [df stringFromDate:evDate];
            if ([ev[@"isPanic"] boolValue]) {
                NSString *recentSuspect = agFindRecentlyModifiedTweakBeforeDate(evDate);
                [parsedRecords addObject:@{
                    @"time": timeStr,
                    @"type": @"⚠️ 整机死机重启 (Kernel Panic)",
                    @"verdictLabel": @"🔍 重点怀疑对象",
                    @"plugin": recentSuspect ?: @"底层内核驱动或硬件看门狗超时",
                    @"reason": @"内核恐慌(Panic)或主线程长时间无响应触发整机重启"
                }];
                continue;
            }

            NSString *rawContent = [NSString stringWithContentsOfFile:ev[@"path"] encoding:NSUTF8StringEncoding error:nil];
            if (!rawContent || rawContent.length < 20) continue;

            NSString *confirmedCulprit = nil; // 🎯 准确真凶
            NSString *primeSuspect     = nil; // 🔍 重点怀疑对象
            NSString *humanReason      = @"桌面进程异常中断导致自动注销";
            NSString *asiFullString    = @"";

            NSRange firstNewline = [rawContent rangeOfString:@"\n"];
            NSString *bodyStr = (firstNewline.location != NSNotFound && firstNewline.location < 600)
                ? [rawContent substringFromIndex:firstNewline.location + 1]
                : rawContent;
            NSDictionary *ipsJSON = [NSJSONSerialization JSONObjectWithData:[bodyStr dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];

            if ([ipsJSON isKindOfClass:[NSDictionary class]]) {
                NSDictionary *exc  = ipsJSON[@"exception"];
                NSDictionary *term = ipsJSON[@"termination"];
                NSDictionary *asi  = ipsJSON[@"asi"];
                NSString *excType  = [exc isKindOfClass:[NSDictionary class]] ? (exc[@"type"] ?: @"") : @"";
                NSString *excSig   = [exc isKindOfClass:[NSDictionary class]] ? (exc[@"signal"] ?: @"") : @"";
                NSString *termInd  = [term isKindOfClass:[NSDictionary class]] ? (term[@"indicator"] ?: @"") : @"";
                NSNumber *termCode = [term isKindOfClass:[NSDictionary class]] ? term[@"code"] : nil;

                if ([asi isKindOfClass:[NSDictionary class]]) {
                    asiFullString = [asi description] ?: @"";
                }
                if ([termInd containsString:@"8badf00d"] || (termCode && [termCode unsignedLongLongValue] == 0x8badf00dULL)) {
                    humanReason = @"主线程死锁卡住超过 10 秒 (0x8badf00d 看门狗强制注销)";
                } else if (asiFullString.length > 0) {
                    if ([asiFullString containsString:@"unrecognized selector"]) {
                        humanReason = @"插件调用了不存在的方法 (unrecognized selector 闪退)";
                    } else if ([asiFullString containsString:@"NSRangeException"] || [asiFullString containsString:@"bounds"]) {
                        humanReason = @"插件数组越界异常 (NSRangeException)";
                    } else if ([asiFullString containsString:@"NSInvalidArgumentException"]) {
                        humanReason = @"插件传入非法空参数异常 (NSInvalidArgumentException)";
                    } else if ([asiFullString containsString:@"CALayer"] || [asiFullString containsString:@"UIView"]) {
                        humanReason = @"插件在子线程违规操作 UI 界面引发崩溃";
                    }
                } else if ([excType containsString:@"EXC_BAD_ACCESS"] || [excSig containsString:@"SIGSEGV"] || [excSig containsString:@"SIGBUS"]) {
                    humanReason = [NSString stringWithFormat:@"内存野指针或非法地址访问崩溃 (%@)", excSig.length > 0 ? excSig : @"EXC_BAD_ACCESS"];
                } else if ([excType containsString:@"EXC_RESOURCE"]) {
                    humanReason = @"CPU 或运行内存占用超标被系统保护性注销";
                } else if (excType.length > 0) {
                    humanReason = [NSString stringWithFormat:@"异常信号中断 (%@ %@)", excType, excSig];
                }

                NSArray *usedImages = ipsJSON[@"usedImages"];
                if ([usedImages isKindOfClass:[NSArray class]]) {
                    // 【第 1 级 · 🎯 准确真凶】：异常抛出栈 lastExceptionBacktrace 直接命中
                    NSArray *lebFrames = ipsJSON[@"lastExceptionBacktrace"];
                    if ([lebFrames isKindOfClass:[NSArray class]]) {
                        for (NSUInteger fIdx = 0; fIdx < lebFrames.count; fIdx++) {
                            NSDictionary *frame = lebFrames[fIdx];
                            if (![frame isKindOfClass:[NSDictionary class]] || frame[@"imageIndex"] == nil) continue;
                            NSUInteger imgIdx = [frame[@"imageIndex"] unsignedIntegerValue];
                            if (imgIdx < usedImages.count) {
                                NSDictionary *img = usedImages[imgIdx];
                                NSString *imgPath = img[@"path"] ?: @"";
                                NSString *imgName = img[@"name"] ?: [imgPath lastPathComponent];
                                if (agIsThirdPartyTweakImage(imgPath, imgName)) {
                                    if (fIdx <= 12) {
                                        confirmedCulprit = [NSString stringWithFormat:@"%@ [异常栈第%lu帧铁证]", agResolveHumanPluginNameForDylib(imgName), (unsigned long)fIdx];
                                    } else if (!primeSuspect) {
                                        primeSuspect = [NSString stringWithFormat:@"%@ [深层异常栈第%lu帧]", agResolveHumanPluginNameForDylib(imgName), (unsigned long)fIdx];
                                    }
                                    if (confirmedCulprit) break;
                                }
                            }
                        }
                    }

                    // 【第 1 级 & 第 3 级】：崩溃线程 faultingThread 栈顶前 10 帧(准确真凶) vs 深层第 11+ 帧(重点怀疑对象)
                    NSArray *threads = ipsJSON[@"threads"];
                    NSUInteger faultIdx = [ipsJSON[@"faultingThread"] unsignedIntegerValue];
                    if (!confirmedCulprit && [threads isKindOfClass:[NSArray class]] && faultIdx < threads.count) {
                        NSDictionary *faultThread = threads[faultIdx];
                        NSArray *frames = faultThread[@"frames"];
                        if ([frames isKindOfClass:[NSArray class]]) {
                            for (NSUInteger fIdx = 0; fIdx < frames.count; fIdx++) {
                                NSDictionary *frame = frames[fIdx];
                                if (![frame isKindOfClass:[NSDictionary class]] || frame[@"imageIndex"] == nil) continue;
                                NSUInteger imgIdx = [frame[@"imageIndex"] unsignedIntegerValue];
                                if (imgIdx < usedImages.count) {
                                    NSDictionary *img = usedImages[imgIdx];
                                    NSString *imgPath = img[@"path"] ?: @"";
                                    NSString *imgName = img[@"name"] ?: [imgPath lastPathComponent];
                                    if (agIsThirdPartyTweakImage(imgPath, imgName)) {
                                        if (fIdx <= 10) {
                                            confirmedCulprit = [NSString stringWithFormat:@"%@ [崩溃栈第%lu帧直接触发]", agResolveHumanPluginNameForDylib(imgName), (unsigned long)fIdx];
                                            break;
                                        } else if (!primeSuspect) {
                                            primeSuspect = [NSString stringWithFormat:@"%@ [位于深层调用栈第%lu帧]", agResolveHumanPluginNameForDylib(imgName), (unsigned long)fIdx];
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 【第 2 级 · 🎯 准确真凶】：若栈顶全是系统库，通过 ASI 报错类名/方法名对 DynamicLibraries 进行二进制特征扫描
                    if (!confirmedCulprit && asiFullString.length > 0) {
                        NSString *binHit = agScanDylibsForCrashingSymbolInASI(asiFullString);
                        if (binHit) {
                            confirmedCulprit = binHit;
                        }
                    }

                    // 【第 3 级 · 🔍 重点怀疑对象】：扫描崩溃瞬间并发运行的其他活跃子线程
                    if (!confirmedCulprit && !primeSuspect && [threads isKindOfClass:[NSArray class]]) {
                        for (NSUInteger tIdx = 0; tIdx < threads.count; tIdx++) {
                            if (tIdx == faultIdx) continue;
                            NSDictionary *th = threads[tIdx];
                            NSArray *frames = [th isKindOfClass:[NSDictionary class]] ? th[@"frames"] : nil;
                            if (![frames isKindOfClass:[NSArray class]]) continue;
                            for (NSUInteger fIdx = 0; fIdx < MIN((NSUInteger)12, frames.count); fIdx++) {
                                NSDictionary *frame = frames[fIdx];
                                if (![frame isKindOfClass:[NSDictionary class]] || frame[@"imageIndex"] == nil) continue;
                                NSUInteger imgIdx = [frame[@"imageIndex"] unsignedIntegerValue];
                                if (imgIdx < usedImages.count) {
                                    NSDictionary *img = usedImages[imgIdx];
                                    NSString *imgPath = img[@"path"] ?: @"";
                                    NSString *imgName = img[@"name"] ?: [imgPath lastPathComponent];
                                    if (agIsThirdPartyTweakImage(imgPath, imgName)) {
                                        primeSuspect = [NSString stringWithFormat:@"%@ [崩溃瞬间在子线程#%lu并发运行]", agResolveHumanPluginNameForDylib(imgName), (unsigned long)tIdx];
                                        break;
                                    }
                                }
                            }
                            if (primeSuspect) break;
                        }
                    }
                }
            } else {
                // 兼容 iOS 14 纯文本格式 .ips
                NSRegularExpression *dylibRe = [NSRegularExpression regularExpressionWithPattern:@"([A-Za-z0-9_\\-\\+]+\\.dylib)" options:0 error:nil];
                NSArray<NSTextCheckingResult *> *matches = [dylibRe matchesInString:rawContent options:0 range:NSMakeRange(0, MIN((NSUInteger)30000, rawContent.length))];
                for (NSTextCheckingResult *m in matches) {
                    NSString *dName = [rawContent substringWithRange:[m rangeAtIndex:1]];
                    if (!agIsHookLoaderOrSystemImage(dName) && ![dName hasPrefix:@"lib"]) {
                        confirmedCulprit = [NSString stringWithFormat:@"%@ [调用栈直接命中]", agResolveHumanPluginNameForDylib(dName)];
                        break;
                    }
                }
            }

            // 【第 4 级 · 🔍 怀疑对象】：若调用栈与二进制符号均未直接露头，排查崩溃发生前最近安装/更新的插件
            if (!confirmedCulprit && !primeSuspect) {
                primeSuspect = agFindRecentlyModifiedTweakBeforeDate(evDate);
            }

            NSString *verdictTitle = confirmedCulprit ? @"🎯 准确真凶" : @"🔍 重点怀疑对象";
            NSString *finalPlugin  = confirmedCulprit ?: (primeSuspect ?: @"未发现越狱插件介入 (纯系统原生异常)");

            [parsedRecords addObject:@{
                @"time": timeStr,
                @"type": @"💥 SpringBoard 桌面异常注销",
                @"verdictLabel": verdictTitle,
                @"plugin": finalPlugin,
                @"reason": humanReason
            }];
        }

        NSUInteger totalResprings = MAX(ledgerCount, sbCrashCount);
        NSMutableString *card = [NSMutableString string];
        [card appendString:@"🕵️‍♂️ 【近 7 天手机注销/死机与肇事插件取证报告】\n"];
        [card appendFormat:@"• 📊 本周统计：桌面共启动/注销 %lu 次（其中异常崩溃注销 %lu 次，整机死机重启 %lu 次）\n",
         (unsigned long)totalResprings, (unsigned long)sbCrashCount, (unsigned long)panicCount];

        NSString *pillOut = nil;
        NSString *speechOut = nil;

        if (parsedRecords.count == 0) {
            [card appendString:@"• ✅ 诊断结论：近 7 天内未发现任何由越狱插件引起的 SpringBoard 崩溃或死机记录，系统运行非常稳定！"];
            pillOut = [NSString stringWithFormat:@"✅ 近7天无插件崩溃记录 (正常启动%lu次)", (unsigned long)totalResprings];
            speechOut = [NSString stringWithFormat:@"已为您排查近 7 天的系统底层崩溃案卷：这周桌面共正常启动 %lu 次，没有发生任何由越狱插件引起的异常崩溃或死机现象，运行非常稳定。", (unsigned long)totalResprings];
        } else {
            for (NSUInteger i = 0; i < parsedRecords.count; i++) {
                NSDictionary *rec = parsedRecords[i];
                [card appendFormat:@"\n%lu️⃣ 【%@】%@\n", (unsigned long)(i + 1), rec[@"time"], rec[@"type"]];
                [card appendFormat:@"   %@：%@\n", rec[@"verdictLabel"], rec[@"plugin"]];
                [card appendFormat:@"   📌 崩溃原因：%@\n", rec[@"reason"]];
            }
            NSDictionary *latest = parsedRecords.firstObject;
            pillOut = [NSString stringWithFormat:@"🕵️‍♂️近7天崩溃%lu次｜%@｜%@:%@",
                       (unsigned long)(sbCrashCount + panicCount), latest[@"time"], latest[@"verdictLabel"], latest[@"plugin"]];
            speechOut = [NSString stringWithFormat:@"已为您查出近 7 天的崩溃取证报告：本周共发生桌面异常崩溃 %lu 次，整机死机重启 %lu 次。最近一次发生在 %@，%@是：%@，具体原因是：%@。完整时间清单已显示在屏幕上。",
                         (unsigned long)sbCrashCount, (unsigned long)panicCount, latest[@"time"], [latest[@"verdictLabel"] substringFromIndex:2], latest[@"plugin"], latest[@"reason"]];
        }

        os_unfair_lock_lock(&gCrashCacheLock);
        gCachedCrashPillStr   = [pillOut copy];
        gCachedCrashCardStr   = [card copy];
        gCachedCrashSpeechStr = [speechOut copy];
        os_unfair_lock_unlock(&gCrashCacheLock);

        if (outPillText)    *outPillText    = pillOut;
        if (outCardReport)  *outCardReport  = card;
        if (outVoiceSpeech) *outVoiceSpeech = speechOut;
    }
}

static NSString *agGetCachedCrashSpeechSummary(void) {
    os_unfair_lock_lock(&gCrashCacheLock);
    NSString *s = [gCachedCrashSpeechStr copy];
    os_unfair_lock_unlock(&gCrashCacheLock);
    return s;
}

// 每次 SpringBoard 启动后第 3 秒在独立后台队列记录账本并预热一次崩溃取证缓存（平时呼出助手 0 磁盘读取、0 卡顿）
static void agRecordSpringBoardBootEventAndWarmupCache(void) {
    if (!agIsSpringBoardProcess()) return;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3.0 * NSEC_PER_SEC)), dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_LOW, 0), ^{
            @autoreleasepool {
                NSTimeInterval now = [[NSDate date] timeIntervalSince1970];
                NSMutableArray<NSNumber *> *bootList = [NSMutableArray array];
                NSData *data = [NSData dataWithContentsOfFile:agRespringLedgerFilePath()];
                if (data) {
                    NSArray *saved = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
                    if ([saved isKindOfClass:[NSArray class]]) {
                        for (NSNumber *ts in saved) {
                            if ([ts isKindOfClass:[NSNumber class]] && (now - [ts doubleValue] <= 7.0 * 86400.0)) {
                                [bootList addObject:ts];
                            }
                        }
                    }
                }
                [bootList addObject:@(now)];
                NSData *outData = [NSJSONSerialization dataWithJSONObject:bootList options:0 error:nil];
                if (outData) {
                    [outData writeToFile:agRespringLedgerFilePath() atomically:YES];
                }
                agAnalyzeRecentCrashesAndResprings(nil, nil, nil);
            }
        });
    });
}

