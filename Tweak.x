static NSString *geminiPrefsFilePath(void) {
    return [agSharedBaseDir() stringByAppendingPathComponent:@"com.custom.geminisirioverlay.plist"];
}

static __thread BOOL sIsInternalPrefsFileRead = NO;

static void reloadGeminiPrefsCache(void) {
    NSArray<NSString *> *paths = @[
        agJBRootPath(@"/var/mobile/Library/Preferences/com.custom.geminisirioverlay.plist"),
        @"/var/jb/var/mobile/Library/Preferences/com.custom.geminisirioverlay.plist",
        @"/var/mobile/Library/Preferences/com.custom.geminisirioverlay.plist"
    ];
    NSMutableDictionary *merged = [NSMutableDictionary dictionary];
    NSDate *newestDate = nil;
    NSDictionary *newestDict = nil;

    for (NSString *p in paths) {
        NSDictionary *d = [NSDictionary dictionaryWithContentsOfFile:p];
        if ([d isKindOfClass:[NSDictionary class]] && d.count > 0) {
            [merged addEntriesFromDictionary:d];
            NSDictionary *attrs = [[NSFileManager defaultManager] attributesOfItemAtPath:p error:nil];
            NSDate *modDate = attrs[NSFileModificationDate];
            if (!newestDate || (modDate && [modDate compare:newestDate] == NSOrderedDescending)) {
                newestDate = modDate;
                newestDict = d;
            }
        }
    }
    if (newestDict) {
        [merged addEntriesFromDictionary:newestDict];
    }

    // 仅当进程无法读取磁盘 plist (newestDict == nil，如受沙盒限制的第三方 App) 时，才用内核寄存器状态填充；
    // SpringBoard 与 Preferences 永远以磁盘最新 plist 为唯一权威源，杜绝定时器旧状态反向覆盖关闭指令！
    if (!newestDict) {
        BOOL kActive = NO, kShield = NO;
        NSInteger kScope = 0, kWiFi = 0;
        double kLat = 0.0, kLon = 0.0;
        if (agReadSpoofStateFromKernel(&kActive, &kScope, &kShield, &kWiFi, &kLat, &kLon, NULL, NULL, NULL)) {
            merged[@"AG_LocSpoof_Active"] = @(kActive);
            merged[@"AG_LocSpoof_ScopeMode"] = @(kScope);
            merged[@"AG_AntiDet_ShieldEnabled"] = @(kShield);
            merged[@"AG_AntiDet_HideSimFlag"] = @(kShield);
            merged[@"AG_AntiDet_WiFiMode"] = @(kWiFi);
            if (fabs(kLat) > 0.001 || fabs(kLon) > 0.001) {
                merged[@"AG_LocSpoof_Lat"] = @(kLat);
                merged[@"AG_LocSpoof_Lon"] = @(kLon);
            }
        }
    }

    os_unfair_lock_lock(&gPrefsLock);
    gCachedPrefs = [merged mutableCopy];
    os_unfair_lock_unlock(&gPrefsLock);
}

static NSDictionary *agReadOnlyPrefs(void) {
    os_unfair_lock_lock(&gPrefsLock);
    NSDictionary *snap = gCachedPrefs ? [gCachedPrefs copy] : nil;
    os_unfair_lock_unlock(&gPrefsLock);
    if (!snap) {
        reloadGeminiPrefsCache();
        os_unfair_lock_lock(&gPrefsLock);
        snap = gCachedPrefs ? [gCachedPrefs copy] : @{};
        os_unfair_lock_unlock(&gPrefsLock);
    }
    return snap;
}

static NSMutableDictionary *loadGeminiPrefs(void) {
    NSDictionary *ro = agReadOnlyPrefs();
    return [ro mutableCopy] ?: [NSMutableDictionary dictionary];
}

static BOOL gIsSavingFromSettingsUI = NO;

static void agSyncDynamicTweakFilterPlist(BOOL isActive, NSInteger scopeMode, NSArray<NSString *> *targetApps) {
    NSString *myBID = [[NSBundle mainBundle] bundleIdentifier];
    if (![myBID isEqualToString:@"com.apple.springboard"] && ![myBID isEqualToString:@"com.apple.Preferences"]) {
        return;
    }
    Dl_info selfInfo;
    if (dladdr((const void *)&agSyncDynamicTweakFilterPlist, &selfInfo) == 0 || !selfInfo.dli_fname) {
        return;
    }
    NSString *dylibPath = [NSString stringWithUTF8String:selfInfo.dli_fname];
    NSString *plistPath = [[dylibPath stringByDeletingPathExtension] stringByAppendingPathExtension:@"plist"];
    if (![[NSFileManager defaultManager] fileExistsAtPath:plistPath]) {
        return;
    }

    NSDictionary *filterDict = nil;
    if (!isActive) {
        // 虚拟定位总开关关闭时：仅注入桌面、设置与微信，从其他所有软件内存中物理消失，100% 保留其他全部功能
        filterDict = @{
            @"Filter": @{
                @"Bundles": @[
                    @"com.apple.springboard",
                    @"com.apple.Preferences",
                    @"com.tencent.xin"
                ]
            }
        };
    } else if (scopeMode == 1) {
        // 白名单模式：仅注入桌面、设置、微信 + 用户勾选的目标软件（未勾选的软件彻底不注入）
        NSMutableArray<NSString *> *bundles = [NSMutableArray arrayWithObjects:
            @"com.apple.springboard",
            @"com.apple.Preferences",
            @"com.tencent.xin",
            nil];
        if ([targetApps isKindOfClass:[NSArray class]]) {
            for (NSString *bid in targetApps) {
                if ([bid isKindOfClass:[NSString class]] && bid.length > 0 && ![bundles containsObject:bid]) {
                    [bundles addObject:bid];
                }
            }
        }
        filterDict = @{
            @"Filter": @{
                @"Bundles": bundles
            }
        };
    } else {
        filterDict = @{
            @"Filter": @{
                @"Bundles": @[
                    @"com.apple.UIKit"
                ]
            }
        };
    }

    NSData *plistData = [NSPropertyListSerialization dataWithPropertyList:filterDict
                                                                   format:NSPropertyListXMLFormat_v1_0
                                                                  options:0
                                                                    error:nil];
    if (plistData) {
        chmod([plistPath UTF8String], 0666);
        [plistData writeToFile:plistPath atomically:NO];
    }
}

static void saveGeminiPrefs(NSDictionary *dict) {
    if (!dict) return;
    NSMutableDictionary *mutableCopy = [dict mutableCopy];
    BOOL isActive = [mutableCopy[@"AG_LocSpoof_Active"] boolValue];

    // 铁律：一旦虚拟定位总开关关闭，防检测与伪装 Wi-Fi 强制同步清零关闭！
    if (!isActive) {
        mutableCopy[@"AG_LocSpoof_IsMoving"] = @NO;
        mutableCopy[@"AG_AntiDet_ShieldEnabled"] = @NO;
        mutableCopy[@"AG_AntiDet_HideSimFlag"] = @NO;
        mutableCopy[@"AG_AntiDet_WiFiMode"] = @0;
        mutableCopy[@"AG_AntiDet_MotionSync"] = @NO;
        mutableCopy[@"AG_AntiDet_HideHookPtr"] = @NO;
        mutableCopy[@"AG_LocSpoof_JitterEnabled"] = @NO;
    }

    NSDictionary *immutableCopy = [mutableCopy copy];
    os_unfair_lock_lock(&gPrefsLock);
    gCachedPrefs = [immutableCopy mutableCopy];
    os_unfair_lock_unlock(&gPrefsLock);

    NSInteger scopeMode = immutableCopy[@"AG_LocSpoof_ScopeMode"] ? [immutableCopy[@"AG_LocSpoof_ScopeMode"] integerValue] : 0;
    NSInteger moveMode  = immutableCopy[@"AG_LocSpoof_MoveMode"] ? [immutableCopy[@"AG_LocSpoof_MoveMode"] integerValue] : 0;
    BOOL shieldOn = isActive ? ((immutableCopy[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [immutableCopy[@"AG_AntiDet_ShieldEnabled"] boolValue]) : NO;
    NSInteger wifiMode = shieldOn ? (immutableCopy[@"AG_AntiDet_WiFiMode"] ? [immutableCopy[@"AG_AntiDet_WiFiMode"] integerValue] : 1) : 0;
    if (shieldOn && wifiMode == 0) wifiMode = 1;
    BOOL isMoving = isActive ? [immutableCopy[@"AG_LocSpoof_IsMoving"] boolValue] : NO;
    double wgsLat = [immutableCopy[@"AG_LocSpoof_Lat"] doubleValue];
    double wgsLon = [immutableCopy[@"AG_LocSpoof_Lon"] doubleValue];
    NSArray *targetApps = [immutableCopy[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? immutableCopy[@"AG_LocSpoof_TargetApps"] : @[];

    agPublishSpoofStateToKernel(isActive, scopeMode, moveMode, shieldOn, wifiMode, isMoving, wgsLat, wgsLon, -1.0, 0.0, targetApps);
    agPublishCustomWiFiToKernel(immutableCopy[@"AG_AntiDet_FakeSSID"], immutableCopy[@"AG_AntiDet_FakeBSSID"]);
    agSyncDynamicTweakFilterPlist(isActive, scopeMode, targetApps);

    static dispatch_once_t sCleanGlobalPrefsToken;
    dispatch_once(&sCleanGlobalPrefsToken, ^{
        CFPreferencesSetValue(CFSTR("AG_LocSpoof_GlobalSharedDict"), NULL, kCFPreferencesAnyApplication, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(kCFPreferencesAnyApplication, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    });

    NSArray<NSString *> *writePaths = @[
        agJBRootPath(@"/var/mobile/Library/Preferences/com.custom.geminisirioverlay.plist"),
        @"/var/jb/var/mobile/Library/Preferences/com.custom.geminisirioverlay.plist",
        @"/var/mobile/Library/Preferences/com.custom.geminisirioverlay.plist"
    ];
    [[NSFileManager defaultManager] removeItemAtPath:@"/tmp/com.custom.geminisirioverlay.plist" error:nil];
    for (NSString *wp in writePaths) {
        NSString *dir = [wp stringByDeletingLastPathComponent];
        if ([[NSFileManager defaultManager] fileExistsAtPath:dir]) {
            [immutableCopy writeToFile:wp atomically:YES];
            chmod([wp UTF8String], 0644);
        }
    }

    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
                                         (__bridge CFStringRef)kAGPrefsChangedNotification,
                                         NULL, NULL, YES);
}

static void _old_unused_saveGeminiPrefs(NSDictionary *dict) {
    saveGeminiPrefs(dict);
}

typedef NS_ENUM(uint8_t, AGDiagStepID) {
    AGDiagStep_None             = 0,
    AGDiagStep_CtorEnter        = 1,  // 进入 %ctor
    AGDiagStep_SyncBegin        = 2,  // 进入 agSyncClientHooksWithCurrentState
    AGDiagStep_ObjCTableBackup  = 3,  // 备份 ObjC 原生方法表
    AGDiagStep_LogosInit        = 4,  // 执行 %init(StealthLocationClientHooks)
    AGDiagStep_DynMethodsLookup = 5,  // 解析动态无符号方法 (clientLocation/sourceInfo)
    AGDiagStep_IMPSwitch        = 6,  // 切换 ObjC 方法 IMP 指针
    AGDiagStep_CHookDladdr      = 7,  // MSHookFunction(dladdr)
    AGDiagStep_CHookDyldName    = 8,  // MSHookFunction(_dyld_get_image_name)
    AGDiagStep_CHookWiFi        = 9,  // MSHookFunction(CNCopyCurrentNetworkInfo)
    AGDiagStep_SyncSuccess      = 10, // Hook 挂载全部成功完成
    AGDiagStep_CallCoord        = 11, // 调用 [CLLocation coordinate]
    AGDiagStep_CallClientLoc    = 12, // 调用 [CLLocation clientLocation]
    AGDiagStep_CallMgrLoc       = 13, // 调用 [CLLocationManager location]
    AGDiagStep_CallSourceInfo   = 14, // 调用 [CLLocation sourceInformation]
    AGDiagStep_CallWiFiDict     = 15, // 调用虚拟 Wi-Fi 字典
    AGDiagStep_CallHotspot      = 16, // 调用 NEHotspotNetwork
    AGDiagStep_CallDistance     = 17, // 调用 distanceFromLocation:
    AGDiagStep_ObjCException    = 90  // 捕获到 Objective-C NSException 崩溃
};

static volatile uint8_t gCurrentClientStepID = AGDiagStep_None;

static const char *agDiagStepName(uint8_t stepID) {
    switch (stepID) {
        case AGDiagStep_CtorEnter:        return "1:CTOR_ENTER";
        case AGDiagStep_SyncBegin:        return "2:SYNC_BEGIN";
        case AGDiagStep_ObjCTableBackup:  return "3:OBJC_TABLE_BACKUP";
        case AGDiagStep_LogosInit:        return "4:LOGOS_INIT";
        case AGDiagStep_DynMethodsLookup: return "5:DYN_METHODS_LOOKUP";
        case AGDiagStep_IMPSwitch:        return "6:IMP_SWITCH";
        case AGDiagStep_CHookDladdr:      return "7:C_HOOK_DLADDR";
        case AGDiagStep_CHookDyldName:    return "8:C_HOOK_DYLD_NAME";
        case AGDiagStep_CHookWiFi:        return "9:C_HOOK_WIFI";
        case AGDiagStep_SyncSuccess:      return "10:SYNC_SUCCESS";
        case AGDiagStep_CallCoord:        return "11:CALL_COORD";
        case AGDiagStep_CallClientLoc:    return "12:CALL_CLIENT_LOC";
        case AGDiagStep_CallMgrLoc:       return "13:CALL_MGR_LOC";
        case AGDiagStep_CallSourceInfo:   return "14:CALL_SOURCE_INFO";
        case AGDiagStep_CallWiFiDict:     return "15:CALL_WIFI_DICT";
        case AGDiagStep_CallHotspot:      return "16:CALL_HOTSPOT";
        case AGDiagStep_CallDistance:     return "17:CALL_DISTANCE";
        case AGDiagStep_ObjCException:    return "90:OBJC_NS_EXCEPTION";
        default:                          return "0:UNKNOWN";
    }
}

