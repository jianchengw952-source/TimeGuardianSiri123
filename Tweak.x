typedef NS_ENUM(NSInteger, AGConfigTab) {
    AGConfigTabNativeLive  = 0, // 🎙️ 纯正 Live 实时语音交流
    AGConfigTabVideoAI     = 1, // 📹 独立视频 AI 实时摄像头+语音交流
