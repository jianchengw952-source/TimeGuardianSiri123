// 运行时 XOR 字符串解码器（消除 Mach-O __cstring 与 __objc_methname 中的敏感定位特征词）
static inline NSString *agDecodeObfuscatedCStr(const uint8_t *encBytes, size_t len, uint8_t key) {
    char buf[128];
    if (len >= sizeof(buf)) len = sizeof(buf) - 1;
    for (size_t i = 0; i < len; i++) {
        buf[i] = (char)(encBytes[i] ^ key);
    }
    buf[len] = '\0';
    return [NSString stringWithUTF8String:buf];
}

static inline SEL agDecodeSelector(const uint8_t *encBytes, size_t len, uint8_t key) {
    NSString *s = agDecodeObfuscatedCStr(encBytes, len, key);
    return s ? NSSelectorFromString(s) : NULL;
}


static NSString * const kAGLocTickUIUpdateNotification = @"com.custom.geminisirioverlay.locTickUI";

static BOOL agIsOutOfChina(double lat, double lon) {
    return (lon < 72.004 || lon > 137.8347 || lat < 0.8293 || lat > 55.8271);
}

static double agTransformLat(double x, double y) {
    double ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * sqrt(fabs(x));
    ret += (20.0 * sin(6.0 * x * M_PI) + 20.0 * sin(2.0 * x * M_PI)) * 2.0 / 3.0;
    ret += (20.0 * sin(y * M_PI) + 40.0 * sin(y / 3.0 * M_PI)) * 2.0 / 3.0;
    ret += (160.0 * sin(y / 12.0 * M_PI) + 320.0 * sin(y * M_PI / 30.0)) * 2.0 / 3.0;
    return ret;
}

static double agTransformLon(double x, double y) {
    double ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * sqrt(fabs(x));
    ret += (20.0 * sin(6.0 * x * M_PI) + 20.0 * sin(2.0 * x * M_PI)) * 2.0 / 3.0;
    ret += (20.0 * sin(x * M_PI) + 40.0 * sin(x / 3.0 * M_PI)) * 2.0 / 3.0;
    ret += (150.0 * sin(x / 12.0 * M_PI) + 300.0 * sin(x / 30.0 * M_PI)) * 2.0 / 3.0;
    return ret;
}

static CLLocationCoordinate2D agWGS84ToGCJ02(double wgsLat, double wgsLon) {
    if (agIsOutOfChina(wgsLat, wgsLon)) return CLLocationCoordinate2DMake(wgsLat, wgsLon);
    const double a = 6378245.0;
    const double ee = 0.00669342162296594323;
    double dLat = agTransformLat(wgsLon - 105.0, wgsLat - 35.0);
    double dLon = agTransformLon(wgsLon - 105.0, wgsLat - 35.0);
    double radLat = wgsLat / 180.0 * M_PI;
    double magic = sin(radLat);
    magic = 1 - ee * magic * magic;
    double sqrtMagic = sqrt(magic);
    dLat = (dLat * 180.0) / ((a * (1 - ee)) / (magic * sqrtMagic) * M_PI);
    dLon = (dLon * 180.0) / (a / sqrtMagic * cos(radLat) * M_PI);
    return CLLocationCoordinate2DMake(wgsLat + dLat, wgsLon + dLon);
}

static CLLocationCoordinate2D agGCJ02ToWGS84Exact(double gcjLat, double gcjLon) {
    if (agIsOutOfChina(gcjLat, gcjLon)) return CLLocationCoordinate2DMake(gcjLat, gcjLon);
    double wgsLat = gcjLat, wgsLon = gcjLon;
    for (int i = 0; i < 6; i++) {
        CLLocationCoordinate2D currGCJ = agWGS84ToGCJ02(wgsLat, wgsLon);
        double dLat = currGCJ.latitude - gcjLat;
        double dLon = currGCJ.longitude - gcjLon;
        wgsLat -= dLat;
        wgsLon -= dLon;
        if (fabs(dLat) < 1e-8 && fabs(dLon) < 1e-8) break;
    }
    return CLLocationCoordinate2DMake(wgsLat, wgsLon);
}

static CLLocationCoordinate2D agBD09ToWGS84Exact(double bdLat, double bdLon) {
    double x = bdLon - 0.0065, y = bdLat - 0.006;
    double z = sqrt(x * x + y * y) - 0.00002 * sin(y * M_PI * 3000.0 / 180.0);
    double theta = atan2(y, x) - 0.000003 * cos(x * M_PI * 3000.0 / 180.0);
    double gcjLon = z * cos(theta);
    double gcjLat = z * sin(theta);
    return agGCJ02ToWGS84Exact(gcjLat, gcjLon);
}

// 基础虚拟定位判定（纯 C 内核共享内存读取，0 磁盘 I/O，0 死锁，未开定位时 0.001ms 极速返回 NO）
static BOOL agIsCurrentProcessTargetedForLocSpoof(void) {
    static NSString *sBundleID = nil;
    static BOOL sIsExcludedProcess = NO;
    static BOOL sIsAppleSystemDaemon = NO;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sBundleID = [[NSBundle mainBundle] bundleIdentifier] ?: @"";
        NSString *lowerBID = [sBundleID lowercaseString];
        NSString *execPath = [[[NSBundle mainBundle] executablePath] lowercaseString] ?: @"";
        if (sBundleID.length == 0 ||
            [execPath containsString:@".appex/"] ||
            [sBundleID isEqualToString:@"com.apple.springboard"] ||
            [sBundleID isEqualToString:@"com.apple.Preferences"] ||
            [sBundleID hasPrefix:@"com.apple.WebKit"] ||
            [sBundleID hasPrefix:@"com.apple.locationd"] ||
            [lowerBID containsString:@"tunnel"] ||
            [lowerBID containsString:@"networkextension"] ||
            [lowerBID containsString:@"shadowrocket"] ||
            [lowerBID containsString:@"quantumult"] ||
            [lowerBID containsString:@"surge"] ||
            [lowerBID containsString:@"clash"] ||
            [lowerBID containsString:@"stash"] ||
            [lowerBID containsString:@"loon"] ||
            [lowerBID containsString:@"singbox"] ||
            [lowerBID containsString:@"v2ray"] ||
            [lowerBID containsString:@"vpn"]) {
            sIsExcludedProcess = YES;
        }
        sIsAppleSystemDaemon = ([sBundleID hasPrefix:@"com.apple."] &&
                                ![sBundleID isEqualToString:@"com.apple.Maps"] &&
                                ![sBundleID isEqualToString:@"com.apple.weather"] &&
                                ![sBundleID isEqualToString:@"com.apple.camera"] &&
                                ![sBundleID isEqualToString:@"com.apple.findmy"]);
    });

    if (sIsExcludedProcess) return NO;

    BOOL kActive = NO, kMatch = NO;
    NSInteger kScope = 0;
    if (agReadSpoofStateFromKernel(&kActive, &kScope, NULL, NULL, NULL, NULL, NULL, NULL, &kMatch)) {
        if (!kActive) return NO;
        if (kScope == 0) return !sIsAppleSystemDaemon;
        if (kScope == 1) return kMatch;
        return (!kMatch && !sIsAppleSystemDaemon);
    }
    // 若内核寄存器尚未写入，直接安全返回 NO，严禁在第三方 App 内触发磁盘 plist 读取或 CFPreferences IPC！
    return NO;
}

// 独立防检测护盾总门禁：仅当【虚拟定位开启且命中当前 App】且【防检测开关开启】时才返回 YES！
// 关闭防检测开关时立即返回 NO，确保不开启防检测时只做纯粹的坐标定位，绝不干预任何网络与传感器！
static BOOL agIsAntiDetectionShieldActive(void);
static inline BOOL agIsAntiDetectionShieldEnabled(void) {
    return agIsAntiDetectionShieldActive();
}
static BOOL agIsAntiDetectionShieldActive(void) {
    if (!agIsCurrentProcessTargetedForLocSpoof()) return NO;
    BOOL kActive = NO, kShield = NO;
    if (agReadSpoofStateFromKernel(&kActive, NULL, &kShield, NULL, NULL, NULL, NULL, NULL, NULL)) {
        return (kActive && kShield);
    }
    return NO;
}

// 返回值：0 = 不干预(透传真实网络)，1 = 伪装为 5G 蜂窝流量(隐藏真实家庭 Wi-Fi 防止 BSSID 穿帮)，2 = 返回用户指定的公司真实 Wi-Fi
static __attribute__((unused)) NSInteger agResolveSpoofedWiFiAction(NSString **outSSID, NSString **outBSSID) {
    if (!agIsAntiDetectionShieldActive()) return 0;

    NSInteger wifiMode = 1;
    double lat = 0.0, lon = 0.0;
    BOOL shieldOn = NO;
    if (!agReadSpoofStateFromKernel(NULL, NULL, &shieldOn, &wifiMode, &lat, &lon, NULL, NULL, NULL) || !shieldOn) {
        return 0;
    }
    if (wifiMode == 0) return 0;

    if (wifiMode == 2) {
        NSDictionary *p = agReadOnlyPrefs();
        NSString *customSSID  = [p[@"AG_AntiDet_FakeSSID"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        NSString *customBSSID = [p[@"AG_AntiDet_FakeBSSID"] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if (customSSID.length > 0 && customBSSID.length > 0) {
            if (outSSID)  *outSSID  = customSSID;
            if (outBSSID) *outBSSID = [customBSSID lowercaseString];
            return 2;
        }
    }
    // 默认防检测模式(wifiMode == 1)：向钉钉/飞书/企微隐藏当前连接的家庭/异地 Wi-Fi，伪装为纯 5G 蜂窝网络打卡，零 BSSID 破绽
    return 1;
}

static const void * const kAGHardwareCleanLocationKey = &kAGHardwareCleanLocationKey;
static const void * const kAGAppCreatedCustomLocationKey = &kAGAppCreatedCustomLocationKey;
static const void * const kAGFixedTimestampKey = &kAGFixedTimestampKey;
static __thread BOOL sIsCreatingInternalSpoofLocation = NO;

// ==================== 零崩溃 AssociatedObject 标记与纯 C 零递归定位状态源 ====================
static inline void agMarkAppCustomLocationPtr(id obj) {
    if (!obj || sIsCreatingInternalSpoofLocation) return;
    objc_setAssociatedObject(obj, kAGAppCreatedCustomLocationKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static inline void agUnmarkAppCustomLocationPtr(id obj) {
    // 由 Objective-C Runtime 在对象释放时自动安全清理，无需在 -dealloc 中手动加锁移除
}

static inline BOOL agIsAppCustomLocationPtr(id obj) {
    if (!obj) return NO;
    return [objc_getAssociatedObject(obj, kAGAppCreatedCustomLocationKey) boolValue];
}

static inline BOOL agIsInAppCustomConstructedLocation(CLLocation *loc) {
    return agIsAppCustomLocationPtr(loc);
}

static inline CLLocationCoordinate2D agConvertWGS84ForCurrentApp(double wgsLat, double wgsLon) {
    return CLLocationCoordinate2DMake(wgsLat, wgsLon);
}

static inline void agMarkCleanLocationPtr(id loc) {
    if (!loc) return;
    objc_setAssociatedObject(loc, kAGHardwareCleanLocationKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static inline BOOL agIsCleanLocationPtr(id loc) {
    if (!loc) return NO;
    return [objc_getAssociatedObject(loc, kAGHardwareCleanLocationKey) boolValue];
}

static inline BOOL agIsCleanSpoofedLocation(CLLocation *loc) {
    return agIsCleanLocationPtr(loc);
}

// 计算 EGM96/EGM2008 地球重力场大地水准面差距 N = ellipsoidalAltitude - altitude
static __attribute__((unused)) double agGeoidSeparationForCoord(double lat, double lon) {
    double radLat = lat * M_PI / 180.0;
    double radLon = lon * M_PI / 180.0;
    return -12.4 * sin(radLat * 1.8) + 9.6 * cos(radLon * 1.3) + 4.2 * sin(radLat + radLon);
}

// 禁用会导致 arm64/arm64e 内存错位踩坏指针的裸结构体强写，所有防检测字段均由 Hook 方法安全提供
static void agSanitizeCLLocationInternalStruct(CLLocation *loc, double orthoAlt, double course, double speed) {
    (void)loc; (void)orthoAlt; (void)course; (void)speed;
}

// 根据虚拟坐标智能匹配真实区域海拔基准（零磁盘 I/O）
static double agEstimatedBaseAltitudeForCoord(double lat, double lon) {
    if (lat >= 18.0 && lat <= 20.5 && lon >= 108.5 && lon <= 111.5) return 14.2;   // 海南（海口/三亚/临高）
    if (lat >= 22.0 && lat <= 23.8 && lon >= 112.5 && lon <= 114.6) return 17.6;   // 珠三角（广州/深圳/香港）
    if (lat >= 30.0 && lat <= 32.2 && lon >= 119.8 && lon <= 122.2) return 6.8;    // 长三角（上海/杭州/苏州）
    if (lat >= 39.4 && lat <= 40.5 && lon >= 115.8 && lon <= 117.2) return 43.5;   // 北京
    if (lat >= 30.2 && lat <= 31.0 && lon >= 103.6 && lon <= 104.5) return 502.0;  // 成都
    if (lat >= 29.1 && lat <= 30.1 && lon >= 106.0 && lon <= 107.0) return 246.0;  // 重庆
    if (lat >= 24.6 && lat <= 25.4 && lon >= 102.4 && lon >= 103.1) return 1891.0; // 昆明
    if (lat >= 26.2 && lat <= 26.9 && lon >= 106.3 && lon <= 107.0) return 1074.0; // 贵阳
    if (lat >= 34.0 && lat <= 34.6 && lon >= 108.6 && lon <= 109.3) return 405.0;  // 西安
    if (lat >= 29.4 && lat <= 30.0 && lon >= 90.8  && lon <= 91.5)  return 3652.0; // 拉萨
    double pseudoTerrain = 22.0 + 18.0 * sin(lat * 0.17) + 14.0 * cos(lon * 0.13);
    return MAX(5.0, pseudoTerrain);
}

// Ornstein-Uhlenbeck (OU) 均值回归平滑状态
static double sOUDriftLatM = 0.0;
static double sOUDriftLonM = 0.0;
static double sOUDriftAltM = 0.0;
static double sOUSmoothHAcc = 4.6;
static double sOUSmoothVAcc = 3.4;

static double agGaussianRandom(void) {
    double u1 = ((double)arc4random_uniform(9998) + 1.0) / 10000.0;
    double u2 = ((double)arc4random_uniform(9998) + 1.0) / 10000.0;
    return sqrt(-2.0 * log(u1)) * cos(2.0 * M_PI * u2);
}

static void agStepKalmanSmoothDrift(BOOL enableJitter, double *ioLat, double *ioLon, double *outAlt, double *outHAcc, double *outVAcc) {
    double baseAlt = agEstimatedBaseAltitudeForCoord(*ioLat, *ioLon);
    if (!enableJitter) {
        if (outAlt)  *outAlt  = baseAlt;
        if (outHAcc) *outHAcc = 5.0;
        if (outVAcc) *outVAcc = 3.5;
        return;
    }
    sOUDriftLatM = sOUDriftLatM * 0.78 + agGaussianRandom() * 0.22;
    sOUDriftLonM = sOUDriftLonM * 0.78 + agGaussianRandom() * 0.22;
    sOUDriftAltM = sOUDriftAltM * 0.84 + agGaussianRandom() * 0.14;
    sOUDriftLatM = MAX(-0.95, MIN(0.95, sOUDriftLatM));
    sOUDriftLonM = MAX(-0.95, MIN(0.95, sOUDriftLonM));
    sOUDriftAltM = MAX(-1.10, MIN(1.10, sOUDriftAltM));

    sOUSmoothHAcc = sOUSmoothHAcc * 0.82 + 4.65 * 0.18 + agGaussianRandom() * 0.18;
    sOUSmoothVAcc = sOUSmoothVAcc * 0.84 + 3.40 * 0.16 + agGaussianRandom() * 0.14;
    sOUSmoothHAcc = MAX(3.4, MIN(7.8, sOUSmoothHAcc));
    sOUSmoothVAcc = MAX(2.5, MIN(6.2, sOUSmoothVAcc));

    double degPerMeter = 1.0 / 111320.0;
    *ioLat += sOUDriftLatM * degPerMeter;
    *ioLon += sOUDriftLonM * degPerMeter / MAX(0.2, cos((*ioLat) * M_PI / 180.0));
    if (outAlt)  *outAlt  = baseAlt + sOUDriftAltM;
    if (outHAcc) *outHAcc = sOUSmoothHAcc;
    if (outVAcc) *outVAcc = sOUSmoothVAcc;
}

// 构造 iOS 15 ~ iOS 17 全字段硬件级 CLLocation（修复静止时 course 恒为 0.0° 正北与速度恒为 0.0 的风控破绽）
static CLLocation *agCreateHardwareGradeLocation(CLLocationCoordinate2D coord, double alt, double hAcc, double vAcc, double course, double speed) {
    BOOL shieldOn = NO;
    agReadSpoofStateFromKernel(NULL, NULL, &shieldOn, NULL, NULL, NULL, NULL, NULL, NULL);

    double validCourse = course;
    double validSpeed  = (speed >= 0.0) ? speed : 0.0;
    double spdAcc = (validSpeed > 0.1) ? (0.26 + ((double)arc4random_uniform(14)) * 0.01) : (0.18 + ((double)arc4random_uniform(8)) * 0.01);
    double crsAcc = (validCourse >= 0.0) ? (14.5 + ((double)arc4random_uniform(80)) * 0.1) : -1.0;

    if (shieldOn && validSpeed < 0.1 && validCourse < 0.0) {
        if (fabs(sOUDriftLatM) > 0.08 || fabs(sOUDriftLonM) > 0.08) {
            double rad = atan2(sOUDriftLonM, sOUDriftLatM);
            validCourse = fmod((rad * 180.0 / M_PI) + 360.0, 360.0);
            crsAcc = 24.0 + ((double)arc4random_uniform(90)) * 0.1;
            validSpeed = 0.02 + ((double)arc4random_uniform(5)) * 0.01;
        } else {
            validCourse = -1.0;
            crsAcc = -1.0;
            validSpeed = 0.0;
        }
    } else if (!shieldOn && validCourse < 0.0) {
        validCourse = -1.0;
        crsAcc = -1.0;
    }

    NSDate *now = [NSDate date];
    sIsCreatingInternalSpoofLocation = YES;
    CLLocation *loc = nil;
    if (@available(iOS 13.4, *)) {
        if ([CLLocation instancesRespondToSelector:@selector(initWithCoordinate:altitude:horizontalAccuracy:verticalAccuracy:course:courseAccuracy:speed:speedAccuracy:timestamp:)]) {
            loc = [[CLLocation alloc] initWithCoordinate:coord
                                                altitude:alt
                                      horizontalAccuracy:hAcc
                                        verticalAccuracy:vAcc
                                                  course:validCourse
                                          courseAccuracy:crsAcc
                                                   speed:validSpeed
                                           speedAccuracy:spdAcc
                                               timestamp:now];
        }
    }
    if (!loc) {
        loc = [[CLLocation alloc] initWithCoordinate:coord
                                            altitude:alt
                                  horizontalAccuracy:hAcc
                                    verticalAccuracy:vAcc
                                              course:validCourse
                                               speed:validSpeed
                                           timestamp:now];
    }
    sIsCreatingInternalSpoofLocation = NO;

    if (loc) {
        agMarkCleanLocationPtr(loc);
    }
    return loc;
}

static void agSpringBoardLocAppHookLogCallback(CFNotificationCenterRef center, void *observer, CFStringRef name, const void *object, CFDictionaryRef userInfo) {
    (void)center; (void)observer; (void)name; (void)object; (void)userInfo;
}

// ==================== 核心引擎：AGLocationSpoofManager (仅 SpringBoard 唯一主控，彻底根除双进程互相覆盖) ====================
@interface AGLocationSpoofManager : NSObject
@property (nonatomic, strong) id simManager;

@property (nonatomic, strong) CLGeocoder *geocoder;
@property (nonatomic, strong) NSTimer *jitterTimer;
@property (nonatomic, assign) BOOL isSpoofingActive;
@property (nonatomic, assign) CLLocationCoordinate2D baseWGS84Coord;
@property (nonatomic, assign) CLLocationCoordinate2D currentWGS84Coord;
@property (nonatomic, assign) CLLocationCoordinate2D targetWalkWGS84Coord;
@property (nonatomic, assign) BOOL isRouteMoving;
@property (nonatomic, assign) double remainingDistanceMeters;
@property (nonatomic, assign) double moveSpeedMetersPerSec;
@property (nonatomic, assign) double currentCourse;
@property (nonatomic, copy) NSString *currentPlaceName;
@property (nonatomic, strong) dispatch_queue_t simDaemonQueue;
@property (nonatomic, assign) BOOL isDaemonSimRunning;
@property (nonatomic, strong) CLLocation *cachedTickLocation;

+ (instancetype)sharedSpoofer;
- (NSDictionary<NSString *, NSArray<NSNumber *> *> *)builtinFamousLandmarksGCJ02;
- (CLLocation *)constructRealisticSpoofedLocation;
- (void)pinLocationWithCoordinate:(CLLocationCoordinate2D)coord coordSystem:(NSString *)sysType placeName:(NSString *)placeName;
- (void)teleportImmediatelyToCurrentTarget;
- (void)resolvePlaceAndPin:(NSString *)placeQuery completion:(void(^)(BOOL ok, NSString *summary))completion;
- (void)startCruisingToPlace:(NSString *)destQuery speed:(double)speedMps completion:(void(^)(BOOL ok, NSString *summary))completion;
- (void)stopAndResetToRealLocation;
- (void)syncMasterStateFromPrefsAndRestartTimer;
- (void)applyPreferencesAndRestartTimerIfNeeded;
- (void)enableAttendanceStealthPreset;
- (void)pushSimulatedLocationToDaemonWithCourse:(double)course speed:(double)speed forceRestart:(BOOL)forceRestart;
@end

static void agSpringBoardMasterSyncCallback(CFNotificationCenterRef center, void *observer, CFStringRef name, const void *object, CFDictionaryRef userInfo) {
    dispatch_async(dispatch_get_main_queue(), ^{
        [[AGLocationSpoofManager sharedSpoofer] syncMasterStateFromPrefsAndRestartTimer];
    });
}

@implementation AGLocationSpoofManager

+ (instancetype)sharedSpoofer {
    static AGLocationSpoofManager *sInstance = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        sInstance = [[self alloc] init];
    });
    return sInstance;
}

- (instancetype)init {
    if (self = [super init]) {
        _simDaemonQueue = dispatch_queue_create("com.angelguardian.locsim.daemon", DISPATCH_QUEUE_SERIAL);
        _currentCourse = -1.0;

        BOOL isSB = [[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.apple.springboard"];
        if (isSB) {
            CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(),
                                            (__bridge const void *)(self),
                                            agSpringBoardLocAppHookLogCallback,
                                            (__bridge CFStringRef)kAGLocAppHookLogNotification,
                                            NULL,
                                            CFNotificationSuspensionBehaviorDeliverImmediately);
            CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(),
                                            (__bridge const void *)(self),
                                            agSpringBoardMasterSyncCallback,
                                            (__bridge CFStringRef)kAGLocMasterSyncNotification,
                                            NULL,
                                            CFNotificationSuspensionBehaviorDeliverImmediately);
        }

        NSDictionary *p = isSB ? agReadOnlyPrefs() : @{};
        BOOL autoRestore = (p[@"AG_LocSpoof_AutoRestore"] == nil) ? YES : [p[@"AG_LocSpoof_AutoRestore"] boolValue];
        NSInteger scopeMode = p[@"AG_LocSpoof_ScopeMode"] ? [p[@"AG_LocSpoof_ScopeMode"] integerValue] : 0;
        NSInteger moveMode  = p[@"AG_LocSpoof_MoveMode"] ? [p[@"AG_LocSpoof_MoveMode"] integerValue] : 0;
        BOOL shieldOn = (p[@"AG_AntiDet_ShieldEnabled"] == nil) ? NO : [p[@"AG_AntiDet_ShieldEnabled"] boolValue];
        NSInteger wifiMode = shieldOn ? (p[@"AG_AntiDet_WiFiMode"] ? [p[@"AG_AntiDet_WiFiMode"] integerValue] : 1) : 0;
        NSArray *targetApps = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];

        if (isSB && [p[@"AG_LocSpoof_Active"] boolValue] && autoRestore) {
            double savedLat = [p[@"AG_LocSpoof_Lat"] doubleValue];
            double savedLon = [p[@"AG_LocSpoof_Lon"] doubleValue];
            double targetLat = p[@"AG_LocSpoof_TargetLat"] ? [p[@"AG_LocSpoof_TargetLat"] doubleValue] : savedLat;
            double targetLon = p[@"AG_LocSpoof_TargetLon"] ? [p[@"AG_LocSpoof_TargetLon"] doubleValue] : savedLon;
            BOOL wasMoving = [p[@"AG_LocSpoof_IsMoving"] boolValue];
            NSString *savedName = p[@"AG_LocSpoof_Name"] ?: @"已存位置";

            if (fabs(savedLat) > 0.01 || fabs(savedLon) > 0.01) {
                _baseWGS84Coord = CLLocationCoordinate2DMake(savedLat, savedLon);
                _currentWGS84Coord = _baseWGS84Coord;
                _targetWalkWGS84Coord = CLLocationCoordinate2DMake(targetLat, targetLon);
                _currentPlaceName = savedName;
                _isSpoofingActive = YES;

                double remDist = hypot((targetLat - savedLat) * 111320.0, (targetLon - savedLon) * 111320.0 * cos(savedLat * M_PI / 180.0));
                if (wasMoving && remDist > 2.0) {
                    _isRouteMoving = YES;
                    _remainingDistanceMeters = remDist;
                    _moveSpeedMetersPerSec = (moveMode == 2) ? 12.5 : 1.5;
                } else {
                    _isRouteMoving = NO;
                    _remainingDistanceMeters = 0.0;
                }

                agPublishSpoofStateToKernel(YES, scopeMode, moveMode, shieldOn, wifiMode, _isRouteMoving, savedLat, savedLon, -1.0, (_isRouteMoving ? _moveSpeedMetersPerSec : 0.0), targetApps);

                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                        [self applyPreferencesAndRestartTimerIfNeeded];
                    [self pushSimulatedLocationToDaemonWithCourse:self.currentCourse speed:(self.isRouteMoving ? self.moveSpeedMetersPerSec : 0.0) forceRestart:YES];
                });
            } else {
                agPublishSpoofStateToKernel(NO, scopeMode, moveMode, shieldOn, 0, NO, 0.0, 0.0, -1.0, 0.0, targetApps);
            }
        } else if (isSB) {
            // 关键修复：开机时若虚拟定位为关闭状态，同步向内核写入 isActive=NO 并强制清空 locationd 可能残留的模拟队列
            agPublishSpoofStateToKernel(NO, scopeMode, moveMode, NO, 0, NO, 0.0, 0.0, -1.0, 0.0, targetApps);
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                if (![agReadOnlyPrefs()[@"AG_LocSpoof_Active"] boolValue]) {
                    [self pushSimulatedLocationToDaemonWithCourse:-1.0 speed:0.0 forceRestart:YES];
                }
            });
        }
    }
    return self;
}


- (void)syncMasterStateFromPrefsAndRestartTimer {
    reloadGeminiPrefsCache();
    NSDictionary *p = agReadOnlyPrefs();
    BOOL active = [p[@"AG_LocSpoof_Active"] boolValue];
    NSInteger scopeMode = p[@"AG_LocSpoof_ScopeMode"] ? [p[@"AG_LocSpoof_ScopeMode"] integerValue] : 0;
    NSInteger moveMode  = p[@"AG_LocSpoof_MoveMode"] ? [p[@"AG_LocSpoof_MoveMode"] integerValue] : 0;
    NSArray *targetApps = [p[@"AG_LocSpoof_TargetApps"] isKindOfClass:[NSArray class]] ? p[@"AG_LocSpoof_TargetApps"] : @[];
    // 关键修复：由拥有完整 Rootless 权限的 SpringBoard 实时更新动态注入过滤器 plist，确保关闭定位或未勾选钉钉时彻底不注入钉钉进程
    agSyncDynamicTweakFilterPlist(active, scopeMode, targetApps);
    if (!active) {
        self.isSpoofingActive = NO;
        self.isRouteMoving = NO;
        self.remainingDistanceMeters = 0.0;
        self.cachedTickLocation = nil;
        [self.jitterTimer invalidate];
        self.jitterTimer = nil;
        agPublishSpoofStateToKernel(NO, scopeMode, moveMode, NO, 0, NO, 0.0, 0.0, -1.0, 0.0, targetApps);
        [self pushSimulatedLocationToDaemonWithCourse:-1.0 speed:0.0 forceRestart:YES];
        return;
    }

    double lat = [p[@"AG_LocSpoof_Lat"] doubleValue];
    double lon = [p[@"AG_LocSpoof_Lon"] doubleValue];
    double targetLat = p[@"AG_LocSpoof_TargetLat"] ? [p[@"AG_LocSpoof_TargetLat"] doubleValue] : lat;
    double targetLon = p[@"AG_LocSpoof_TargetLon"] ? [p[@"AG_LocSpoof_TargetLon"] doubleValue] : lon;
    BOOL moving = [p[@"AG_LocSpoof_IsMoving"] boolValue];
    moveMode = [p[@"AG_LocSpoof_MoveMode"] integerValue];

    self.currentPlaceName = p[@"AG_LocSpoof_Name"] ?: @"指定位置";
    self.baseWGS84Coord = CLLocationCoordinate2DMake(lat, lon);
    self.currentWGS84Coord = self.baseWGS84Coord;
    self.targetWalkWGS84Coord = CLLocationCoordinate2DMake(targetLat, targetLon);
    self.isRouteMoving = moving;
    self.moveSpeedMetersPerSec = (moveMode == 2) ? 12.5 : 1.5;
    if (moving) {
        double dLat = targetLat - lat;
        double dLon = targetLon - lon;
        self.remainingDistanceMeters = hypot(dLat * 111320.0, dLon * 111320.0 * cos(lat * M_PI / 180.0));
    } else {
        self.remainingDistanceMeters = 0.0;
    }
    self.isSpoofingActive = YES;
    self.cachedTickLocation = nil;


    [self applyPreferencesAndRestartTimerIfNeeded];
    [self pushSimulatedLocationToDaemonWithCourse:self.currentCourse speed:(moving ? self.moveSpeedMetersPerSec : 0.0) forceRestart:YES];
}

