    msTitleLbl.font = [UIFont boldSystemFontOfSize:13.0];
    [miniSummonCard addSubview:msTitleLbl];

    UISegmentedControl *styleSeg = [[UISegmentedControl alloc] initWithItems:@[@"①水晶胶囊", @"②极光水滴", @"③极光天际", @"④全息丝绸", @"大界面"]];
    styleSeg.frame = CGRectMake(12, 34, cardW - 24, 30);
    NSInteger savedStyle = agMiniSummonStyle();
    styleSeg.selectedSegmentIndex = (savedStyle >= 1 && savedStyle <= 4) ? (savedStyle - 1) : 4;
    [styleSeg addTarget:self action:@selector(onMiniSummonStyleChanged:) forControlEvents:UIControlEventValueChanged];
    [miniSummonCard addSubview:styleSeg];

    UISegmentedControl *posSeg = [[UISegmentedControl alloc] initWithItems:@[@"👇 停在底部悬浮", @"👆 停在顶部 (自动适配灵动岛/刘海)"]];
    posSeg.frame = CGRectMake(12, 72, cardW - 24, 30);
    posSeg.selectedSegmentIndex = agMiniSummonIsTop() ? 1 : 0;
    [posSeg addTarget:self action:@selector(onMiniSummonPosChanged:) forControlEvents:UIControlEventValueChanged];
    [miniSummonCard addSubview:posSeg];

    y += 124.0;

    UILabel *tabHeader = [[UILabel alloc] initWithFrame:CGRectMake(pad + 4, y, cardW, 20)];
    tabHeader.text = @"🛠️ 四大独立功能模块 (独立 API·手风琴折叠)：";
    tabHeader.textColor = [UIColor colorWithWhite:0.86 alpha:1.0];
    tabHeader.font = [UIFont boldSystemFontOfSize:12.5];
    [self.scrollView addSubview:tabHeader];
    y += 26.0;

    self.accordionContainerView = [[UIView alloc] initWithFrame:CGRectMake(0, y, w, 0)];
    [self.scrollView addSubview:self.accordionContainerView];

    [self reloadSettingsLayoutAnimated:NO];
}

- (void)globalControlChanged {
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"Gemini_Enabled"] = @(self.masterEnableSwitch.isOn);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
}

- (void)webSearchControlChanged {
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_WebSearch_Enabled"] = @(self.webSearchEnableSwitch.isOn);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
    UISwitch *bottomWebSw = (UISwitch *)[self.view viewWithTag:96014];
    if (bottomWebSw) bottomWebSw.on = self.webSearchEnableSwitch.isOn;
}

// 构建四大独立功能模块的手风琴抽屉卡片 (每个模块拥有完全独立的开关、API 地址、API Key、代理与模型列表)
- (UIView *)buildIndependentModuleAccordionCardForTab:(AGConfigTab)tab originY:(CGFloat)y width:(CGFloat)cardW {
    BOOL isEnabled = agIsTabEnabled(tab);
    BOOL isExpanded = isEnabled && (self.expandedModuleTab == (NSInteger)tab);

    NSString *iconTitle = @"";
    NSString *subDesc   = @"";
    UIColor *accentCol  = nil;
    switch (tab) {
        case AGConfigTabNativeLive:
            iconTitle = @"🎙️ 纯正 Live 实时语音";
            subDesc   = @"独立 API · WebSocket 全双工语音通话";
            accentCol = [UIColor colorWithRed:0.25 green:0.68 blue:1.00 alpha:1.0];
            break;
        case AGConfigTabVideoAI:
            iconTitle = @"📹 独立视频 AI 视觉";
            subDesc   = @"独立 API · 实时镜头画面 + 语音交互";
            accentCol = [UIColor colorWithRed:0.18 green:0.86 blue:0.65 alpha:1.0];
            break;
        case AGConfigTabPureText:
            iconTitle = @"💬 纯文本打字交流";
            subDesc   = @"独立 API · 支持任意 OpenAI/DeepSeek/中转";
            accentCol = [UIColor colorWithRed:0.62 green:0.45 blue:1.00 alpha:1.0];
            break;
        case AGConfigTabTranslation:
            iconTitle = @"🌐 实时字幕与翻译";
            subDesc   = @"独立 API · 原位跟随翻译与同传听译";
            accentCol = [UIColor colorWithRed:0.96 green:0.62 blue:0.24 alpha:1.0];
            break;
    }

    CGFloat headerH = 60.0;
    CGFloat bodyH   = isExpanded ? 296.0 : 0.0;
    UIView *card = [[UIView alloc] initWithFrame:CGRectMake(16, y, cardW, headerH + bodyH)];
    card.backgroundColor = [UIColor colorWithRed:0.13 green:0.12 blue:0.22 alpha:1.0];
    card.layer.cornerRadius = 16.0;
    card.layer.masksToBounds = YES;
    card.layer.borderWidth = isExpanded ? 1.2 : 0.5;
    card.layer.borderColor = isExpanded ? [accentCol colorWithAlphaComponent:0.65].CGColor : [UIColor colorWithWhite:1.0 alpha:0.14].CGColor;

    // 1. 模块卡片头部（点击头部可展开/收起该模块的专属 API 配置）
    UIButton *headerTapBtn = [UIButton buttonWithType:UIButtonTypeCustom];
    headerTapBtn.frame = CGRectMake(0, 0, cardW - 76, headerH);
    headerTapBtn.tag = 9100 + tab;
    [headerTapBtn addTarget:self action:@selector(onModuleHeaderTapped:) forControlEvents:UIControlEventTouchUpInside];
    [card addSubview:headerTapBtn];

    UILabel *titleLbl = [[UILabel alloc] initWithFrame:CGRectMake(16, 10, cardW - 96, 22)];
    titleLbl.text = iconTitle;
    titleLbl.font = [UIFont systemFontOfSize:15.5 weight:UIFontWeightBold];
    titleLbl.textColor = [UIColor whiteColor];
    [card addSubview:titleLbl];

    NSString *curModel = [agModelForTab(tab) stringByReplacingOccurrencesOfString:@"models/" withString:@""];
    if (curModel.length == 0) curModel = @"未选择模型";
    UILabel *statusLbl = [[UILabel alloc] initWithFrame:CGRectMake(16, 33, cardW - 96, 18)];
    statusLbl.text = isEnabled
        ? [NSString stringWithFormat:@"%@ · %@ %@", subDesc, curModel, (isExpanded ? @"▴ 收起配置" : @"▾ 点击配置 API")]
        : @"已关闭 (开启开关即可配置该功能专属 API 与模型)";
    statusLbl.font = [UIFont systemFontOfSize:11.5 weight:UIFontWeightMedium];
    statusLbl.textColor = isEnabled ? accentCol : [UIColor colorWithWhite:0.55 alpha:1.0];
    [card addSubview:statusLbl];

    // 右侧独立功能启用开关
    UISwitch *enableSw = [[UISwitch alloc] init];
    enableSw.on = isEnabled;
    enableSw.onTintColor = accentCol;
    enableSw.tag = 9200 + tab;
    enableSw.center = CGPointMake(cardW - 38, headerH * 0.5);
    [enableSw addTarget:self action:@selector(onModuleEnableSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    [card addSubview:enableSw];

    // 2. 若当前模块处于展开状态，渲染该模块专属的独立 API 地址、API Key、代理端口与模型选择区
    if (isExpanded) {
        UIView *sep = [[UIView alloc] initWithFrame:CGRectMake(16, headerH, cardW - 32, 0.5)];
        sep.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.10];
        [card addSubview:sep];

        CGFloat innerY = headerH + 12.0;
        CGFloat fieldW = cardW - 32.0;

        // (a) 专属 API 接口地址 (Endpoint)
        UILabel *epTitle = [[UILabel alloc] initWithFrame:CGRectMake(16, innerY, fieldW, 18)];
        epTitle.text = @"🔗 专属 API 接口地址 (Endpoint)：";
        epTitle.font = [UIFont systemFontOfSize:12.0 weight:UIFontWeightSemibold];
        epTitle.textColor = [UIColor colorWithWhite:0.75 alpha:1.0];
        [card addSubview:epTitle];
        innerY += 20.0;

        UITextField *epField = [[UITextField alloc] initWithFrame:CGRectMake(16, innerY, fieldW, 34)];
        epField.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.08];
        epField.layer.cornerRadius = 8.0;
        epField.textColor = [UIColor whiteColor];
        epField.font = [UIFont systemFontOfSize:13.0];
        epField.leftView = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 10, 10)];
        epField.leftViewMode = UITextFieldViewModeAlways;
        epField.clearButtonMode = UITextFieldViewModeWhileEditing;
        epField.delegate = self;
        epField.placeholder = @"例如 https://generativelanguage.googleapis.com 或任意第三方地址";
        epField.text = agEndpointForTab(tab);
        epField.tag = 9300 + tab;
        epField.secureTextEntry = NO;
        epField.keyboardType = UIKeyboardTypeDefault;
        [epField addTarget:self action:@selector(onModuleTextFieldEdited:) forControlEvents:UIControlEventEditingDidEnd];
        [card addSubview:epField];
        innerY += 42.0;

        // (b) 专属 API Key
        UILabel *keyTitle = [[UILabel alloc] initWithFrame:CGRectMake(16, innerY, fieldW, 18)];
        keyTitle.text = @"🔑 专属 API Key (与其它模块互不干扰)：";
        keyTitle.font = [UIFont systemFontOfSize:12.0 weight:UIFontWeightSemibold];
        keyTitle.textColor = [UIColor colorWithWhite:0.75 alpha:1.0];
        [card addSubview:keyTitle];
        innerY += 20.0;

        UITextField *keyField = [[UITextField alloc] initWithFrame:CGRectMake(16, innerY, fieldW, 34)];
        keyField.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.08];
        keyField.layer.cornerRadius = 8.0;
        keyField.textColor = [UIColor whiteColor];
        keyField.font = [UIFont systemFontOfSize:13.0];
        keyField.leftView = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 10, 10)];
        keyField.leftViewMode = UITextFieldViewModeAlways;
        keyField.clearButtonMode = UITextFieldViewModeWhileEditing;
        keyField.secureTextEntry = NO;
        keyField.keyboardType = UIKeyboardTypeDefault;
        keyField.delegate = self;
        keyField.placeholder = @"填入该功能模块专用的 API Key";
        keyField.text = agAPIKeyForTab(tab);
        keyField.tag = 9400 + tab;
        [keyField addTarget:self action:@selector(onModuleTextFieldEdited:) forControlEvents:UIControlEventEditingDidEnd];
        [card addSubview:keyField];
        innerY += 42.0;

        // (c) 专属本地代理端口 (可选)
        UILabel *proxyTitle = [[UILabel alloc] initWithFrame:CGRectMake(16, innerY, fieldW * 0.55, 18)];
        proxyTitle.text = @"🌐 代理端口 (选填，如 7890)：";
        proxyTitle.font = [UIFont systemFontOfSize:12.0 weight:UIFontWeightSemibold];
        proxyTitle.textColor = [UIColor colorWithWhite:0.75 alpha:1.0];
        [card addSubview:proxyTitle];

        UITextField *proxyField = [[UITextField alloc] initWithFrame:CGRectMake(16, innerY + 20.0, fieldW * 0.48, 34)];
        proxyField.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.08];
        proxyField.layer.cornerRadius = 8.0;
        proxyField.textColor = [UIColor whiteColor];
        proxyField.font = [UIFont systemFontOfSize:13.0];
        proxyField.leftView = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 10, 10)];
        proxyField.leftViewMode = UITextFieldViewModeAlways;
        proxyField.delegate = self;
        proxyField.secureTextEntry = NO;
        proxyField.keyboardType = UIKeyboardTypeDefault;
        proxyField.placeholder = @"直连留空，或填 7890";
        proxyField.text = agProxyForTab(tab);
        proxyField.tag = 9500 + tab;
        [proxyField addTarget:self action:@selector(onModuleTextFieldEdited:) forControlEvents:UIControlEventEditingDidEnd];
        [card addSubview:proxyField];

        // (d) 刷新并测速拉取该模块云端可用模型按钮
        UIButton *fetchModelsBtn = [UIButton buttonWithType:UIButtonTypeSystem];
        fetchModelsBtn.frame = CGRectMake(16 + fieldW * 0.52, innerY + 20.0, fieldW * 0.48, 34);
        fetchModelsBtn.backgroundColor = [accentCol colorWithAlphaComponent:0.18];
        fetchModelsBtn.layer.cornerRadius = 8.0;
        fetchModelsBtn.layer.borderWidth = 1.0;
        fetchModelsBtn.layer.borderColor = accentCol.CGColor;
        [fetchModelsBtn setTitle:@"⚡ 刷新/测试模型" forState:UIControlStateNormal];
        [fetchModelsBtn setTitleColor:accentCol forState:UIControlStateNormal];
        fetchModelsBtn.titleLabel.font = [UIFont systemFontOfSize:12.5 weight:UIFontWeightBold];
        fetchModelsBtn.tag = 9600 + tab;
        [fetchModelsBtn addTarget:self action:@selector(onModuleFetchModelsTapped:) forControlEvents:UIControlEventTouchUpInside];
        [card addSubview:fetchModelsBtn];
        innerY += 64.0;

        // (e) 当前选中模型与点击切换按钮
        UIButton *selectModelBtn = [UIButton buttonWithType:UIButtonTypeSystem];
        selectModelBtn.frame = CGRectMake(16, innerY, fieldW, 38);
        selectModelBtn.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.08];
        selectModelBtn.layer.cornerRadius = 10.0;
        [selectModelBtn setTitle:[NSString stringWithFormat:@"🤖 当前模型：%@  (点击切换 ▾)", curModel] forState:UIControlStateNormal];
        [selectModelBtn setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
        selectModelBtn.titleLabel.font = [UIFont systemFontOfSize:13.0 weight:UIFontWeightSemibold];
        selectModelBtn.tag = 9700 + tab;
        [selectModelBtn addTarget:self action:@selector(onModuleSelectModelTapped:) forControlEvents:UIControlEventTouchUpInside];
        [card addSubview:selectModelBtn];
    }

    return card;
}

// 点击模块卡片头部：展开当前模块配置，自动折叠其他模块
- (void)onModuleHeaderTapped:(UIButton *)sender {
    AGConfigTab tab = (AGConfigTab)(sender.tag - 9100);
    if (!agIsTabEnabled(tab)) {
        return;
    }
    if (self.expandedModuleTab == (NSInteger)tab) {
        self.expandedModuleTab = -1; // 再次点击则收起
    } else {
        self.expandedModuleTab = (NSInteger)tab; // 展开当前模块并自动折叠其他模块
    }
    [self reloadSettingsLayoutAnimated:YES];
}

// 切换某个功能模块的独立开关：打开开关时自动展开该模块的 API 设置，关闭开关时立即折叠隐藏！
- (void)onModuleEnableSwitchChanged:(UISwitch *)sender {
    AGConfigTab tab = (AGConfigTab)(sender.tag - 9200);
    NSMutableDictionary *p = loadGeminiPrefs();
    NSString *enableKey = (tab == AGConfigTabTranslation) ? @"AG_Trans_Enabled" : [NSString stringWithFormat:@"%@_Enabled", agPrefixForTab(tab)];
    p[enableKey] = @(sender.isOn);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });

    if (sender.isOn) {
        self.expandedModuleTab = (NSInteger)tab; // 打开功能瞬间自动展开其专属 API 设置
    } else if (self.expandedModuleTab == (NSInteger)tab) {
        self.expandedModuleTab = -1;             // 关闭功能瞬间立即收起隐藏
    }
    [self reloadSettingsLayoutAnimated:YES];
}

// 保存各模块各自独立的 Endpoint / APIKey / ProxyPort
- (void)onModuleTextFieldEdited:(UITextField *)tf {
    NSInteger tag = tf.tag;
    AGConfigTab tab = (AGConfigTab)(tag % 100);
    NSString *prefix = agPrefixForTab(tab);
    NSString *val = [tf.text stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] ?: @"";

    NSMutableDictionary *p = loadGeminiPrefs();
    if (tag >= 9300 && tag < 9400) {
        p[[NSString stringWithFormat:@"%@_Endpoint", prefix]] = val;
    } else if (tag >= 9400 && tag < 9500) {
        p[[NSString stringWithFormat:@"%@_APIKey", prefix]] = val;
    } else if (tag >= 9500 && tag < 9600) {
        p[[NSString stringWithFormat:@"%@_ProxyPort", prefix]] = val;
    }
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
}

- (void)onModuleFetchModelsTapped:(UIButton *)sender {
    AGConfigTab tab = (AGConfigTab)(sender.tag - 9600);
    [self.view endEditing:YES];

    NSString *ep = agEndpointForTab(tab);
    NSString *key = agAPIKeyForTab(tab);
    NSString *proxy = agProxyForTab(tab);

    if (key.length < 4) {
        UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"未填写 API Key"
                                                                       message:@"请先填写该模块的 API Key 再刷新模型"
                                                                preferredStyle:UIAlertControllerStyleAlert];
        [alert addAction:[UIAlertAction actionWithTitle:@"好" style:UIAlertActionStyleDefault handler:nil]];
        [self presentViewController:alert animated:YES completion:nil];
        return;
    }

    [sender setTitle:@"⏳ 测速中..." forState:UIControlStateNormal];
    sender.enabled = NO;

    agFetchCloudModelsForTab(tab, ep, key, proxy, ^(BOOL success, NSArray<NSDictionary *> *models, NSString *errorMsg) {
        sender.enabled = YES;
        [sender setTitle:@"⚡ 刷新/测试模型" forState:UIControlStateNormal];

        if (success && models.count > 0) {
            NSMutableDictionary *p = loadGeminiPrefs();
            NSString *prefix = agPrefixForTab(tab);
            p[[NSString stringWithFormat:@"%@_CachedModels", prefix]] = models;
            NSString *firstID = models.firstObject[@"id"];
            if (firstID.length > 0) {
                p[[NSString stringWithFormat:@"%@_Model", prefix]] = firstID;
            }
            gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });

            [self reloadSettingsLayoutAnimated:NO];

            UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"刷新成功"
                                                                           message:[NSString stringWithFormat:@"已拉取并精选 %lu 款可用模型，已优选：%@", (unsigned long)models.count, firstID]
                                                                    preferredStyle:UIAlertControllerStyleAlert];
            [alert addAction:[UIAlertAction actionWithTitle:@"确定" style:UIAlertActionStyleDefault handler:nil]];
            [self presentViewController:alert animated:YES completion:nil];
        } else {
            UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"获取模型失败"
                                                                           message:(errorMsg ?: @"未能获取到该模块可用模型，请检查接口地址与 Key")
                                                                    preferredStyle:UIAlertControllerStyleAlert];
            [alert addAction:[UIAlertAction actionWithTitle:@"确定" style:UIAlertActionStyleDefault handler:nil]];
            [self presentViewController:alert animated:YES completion:nil];
        }
    });
}

- (void)onModuleSelectModelTapped:(UIButton *)sender {
    AGConfigTab tab = (AGConfigTab)(sender.tag - 9700);
    [self.view endEditing:YES];

    NSArray<NSDictionary *> *models = agCachedModelsForTab(tab);
    if (models.count == 0) {
        [self onModuleFetchModelsTapped:sender];
        return;
    }

    UIAlertController *sheet = [UIAlertController alertControllerWithTitle:@"选择可用模型"
                                                                   message:@"请选择该功能模块使用的 AI 模型："
                                                            preferredStyle:UIAlertControllerStyleActionSheet];

    NSString *curModel = agModelForTab(tab);
    for (NSDictionary *m in models) {
        NSString *mID = m[@"id"] ?: @"";
        NSString *title = m[@"title"] ?: mID;
        NSString *latStr = m[@"latencyStr"] ?: @"";
        NSString *btnTitle = (latStr.length > 0) ? [NSString stringWithFormat:@"%@ (%@)", title, latStr] : title;
        if ([mID isEqualToString:curModel]) {
            btnTitle = [NSString stringWithFormat:@"✓ %@", btnTitle];
        }

        [sheet addAction:[UIAlertAction actionWithTitle:btnTitle style:UIAlertActionStyleDefault handler:^(UIAlertAction * _Nonnull action) {
            NSMutableDictionary *p = loadGeminiPrefs();
            NSString *prefix = agPrefixForTab(tab);
            p[[NSString stringWithFormat:@"%@_Model", prefix]] = mID;
            gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
            [self reloadSettingsLayoutAnimated:NO];
        }]];
    }

    [sheet addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];
    if (sheet.popoverPresentationController) {
        sheet.popoverPresentationController.sourceView = sender;
        sheet.popoverPresentationController.sourceRect = sender.bounds;
    }
    [self presentViewController:sheet animated:YES completion:nil];
}

- (void)reloadSettingsLayoutAnimated:(BOOL)animated {
    void (^layoutBlock)(void) = ^{
        for (UIView *sub in self.accordionContainerView.subviews) {
            [sub removeFromSuperview];
        }

        CGFloat cardW = self.view.bounds.size.width - 32.0;
        CGFloat currentY = 0.0;
        AGConfigTab tabs[4] = { AGConfigTabNativeLive, AGConfigTabVideoAI, AGConfigTabPureText, AGConfigTabTranslation };
        for (int i = 0; i < 4; i++) {
            UIView *card = [self buildIndependentModuleAccordionCardForTab:tabs[i] originY:currentY width:cardW];
            [self.accordionContainerView addSubview:card];
            currentY += card.frame.size.height + 12.0;
        }

        CGRect f = self.accordionContainerView.frame;
        f.size.height = currentY;
        self.accordionContainerView.frame = f;

        CGFloat totalH = f.origin.y + currentY + 40.0;
        self.scrollView.contentSize = CGSizeMake(self.view.bounds.size.width, totalH);
    };

    if (animated) {
        [UIView animateWithDuration:0.28 delay:0 usingSpringWithDamping:0.86 initialSpringVelocity:0.2 options:UIViewAnimationOptionCurveEaseInOut animations:layoutBlock completion:nil];
    } else {
        layoutBlock();
    }
}

- (BOOL)textFieldShouldReturn:(UITextField *)textField {
    [textField resignFirstResponder];
    [self onModuleTextFieldEdited:textField];
    return YES;
}

- (void)saveAndDismissTapped {
    [self.view endEditing:YES];
    [self globalControlChanged];
    [self dismissViewControllerAnimated:YES completion:nil];
}

- (void)agRefreshThemeCardsSelectionState {
    AGVisualTheme cur = agCurrentVisualTheme();
    NSArray *statusNames = @[@"当前：1. 轻奢 (高定黑金琉璃)", @"当前：2. 简约 (超折射液态玻璃)", @"当前：3. 炫酷 (全息流光液态玻璃)", @"当前：4. 樱花 (粉晶琉璃液态玻璃)"];
    UILabel *st = (UILabel *)[self.view viewWithTag:97509];
    if (st) st.text = (cur >= 0 && cur < statusNames.count) ? statusNames[cur] : @"";
    for (int i = 0; i < 4; i++) {
        UIButton *card = (UIButton *)[self.view viewWithTag:97501 + i];
        if (!card) continue;
        if (i == cur) {
            card.backgroundColor = [UIColor colorWithRed:0.0 green:0.96 blue:1.0 alpha:0.16];
            card.layer.borderColor = [UIColor colorWithRed:0.0 green:0.96 blue:1.0 alpha:1.0].CGColor;
        } else {
            card.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.04];
            card.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.12].CGColor;
        }
    }
}

- (void)agSelectThemeCardTapped:(UIButton *)sender {
    NSInteger idx = sender.tag - 97501;
    if (idx < 0 || idx > 3) return;
    NSMutableDictionary *p = loadGeminiPrefs();
    p[@"AG_Visual_Theme"] = @(idx);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(p);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
    [self agRefreshThemeCardsSelectionState];
    if ([[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.apple.springboard"]) {
        [[GeminiAssistantManager sharedManager] updateHeaderBadges];
    }
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), CFSTR("com.angelguardian.prefsChanged"), NULL, NULL, YES);
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)kAGPrefsChangedNotification, NULL, NULL, YES);
}

- (void)onMarqueeSwitchChanged:(UISwitch *)sender {
    NSMutableDictionary *prefs = loadGeminiPrefs();
    prefs[@"AG_Marquee_Enabled"] = @(sender.isOn);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(prefs);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
    reloadGeminiPrefsCache();
    if ([[[NSBundle mainBundle] bundleIdentifier] isEqualToString:@"com.apple.springboard"]) {
        GeminiAssistantManager *mgr = [GeminiAssistantManager sharedManager];
        if (mgr.edgeGlowContainer) {
            mgr.edgeGlowContainer.hidden = !sender.isOn;
        }
    }
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), CFSTR("com.angelguardian.prefsChanged"), NULL, NULL, YES);
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)kAGPrefsChangedNotification, NULL, NULL, YES);
}

- (void)onMiniSummonStyleChanged:(UISegmentedControl *)seg {
    NSInteger idx = seg.selectedSegmentIndex;
    NSInteger styleVal = (idx >= 0 && idx <= 3) ? (idx + 1) : 0;
    NSMutableDictionary *prefs = loadGeminiPrefs();
    prefs[@"AG_MiniSummon_Style"] = @(styleVal);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(prefs);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
    reloadGeminiPrefsCache();
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)kAGPrefsChangedNotification, NULL, NULL, YES);
}

- (void)onMiniSummonPosChanged:(UISegmentedControl *)seg {
    NSMutableDictionary *prefs = loadGeminiPrefs();
    prefs[@"AG_MiniSummon_Position"] = @(seg.selectedSegmentIndex);
    gIsSavingFromSettingsUI = YES;
    saveGeminiPrefs(prefs);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gIsSavingFromSettingsUI = NO;
    });
    reloadGeminiPrefsCache();
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)kAGPrefsChangedNotification, NULL, NULL, YES);
}

@end

// ==================== 4. 手机《设置》入口 + 桌面拦截钩子 (严格分组隔离，严禁注入第三方 App) ====================
%group PreferencesOnlyHooks
%hook UINavigationController
- (void)viewDidAppear:(BOOL)animated {
    %orig(animated);
    NSString *bundleID = [[NSBundle mainBundle] bundleIdentifier];
    if ([bundleID isEqualToString:@"com.apple.Preferences"]) {
        UIViewController *topVC = self.topViewController;
        if (topVC && ![topVC isKindOfClass:[AngelGuardianSettingsViewController class]] && topVC.navigationItem && !topVC.navigationItem.rightBarButtonItem) {
            UIBarButtonItem *btn = [[UIBarButtonItem alloc] initWithTitle:@"✨天使守护" style:UIBarButtonItemStyleDone target:self action:@selector(angelGuardianOpenPrefsModal)];
            btn.tintColor = [UIColor colorWithRed:0.55 green:0.36 blue:0.96 alpha:1.0];
            topVC.navigationItem.rightBarButtonItem = btn;
        }
    }
}

%new
- (void)angelGuardianOpenPrefsModal {
    AngelGuardianSettingsViewController *vc = [[AngelGuardianSettingsViewController alloc] init];
    UINavigationController *nav = [[UINavigationController alloc] initWithRootViewController:vc];
    nav.navigationBar.barStyle = UIBarStyleBlack;
    nav.navigationBar.tintColor = [UIColor whiteColor];
    nav.modalPresentationStyle = UIModalPresentationPageSheet;
    [self presentViewController:nav animated:YES completion:nil];
}
%end
%end // end group PreferencesOnlyHooks

%group SpringBoardCoreHooks
%hook SBLockHardwareButtonActions
- (void)performLongPressActions {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        [GeminiAssistantManager sharedManager].isInvocationFromPowerButton = YES;
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return;
    }
    %orig;
}
%end

%hook SBHomeHardwareButtonActions
- (void)performLongPressActions {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        [GeminiAssistantManager sharedManager].isInvocationFromPowerButton = NO;
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return;
    }
    %orig;
}
%end

%hook SBAssistantController
- (void)_activateSiriWithContext:(id)context {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        [GeminiAssistantManager sharedManager].isInvocationFromPowerButton = NO;
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return;
    }
    %orig(context);
}
- (void)_activateSiriForPPTWithOptions:(id)arg1 {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return;
    }
    %orig(arg1);
}
- (void)handleSiriButtonDownEventFromSource:(NSInteger)source activationEvent:(NSInteger)event {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return;
    }
    %orig(source, event);
}
- (BOOL)activateIgnoringTouches:(BOOL)arg1 {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return NO;
    }
    return %orig(arg1);
}
%end

%hook SiriPresentationSpringBoardMainScreenViewController
- (BOOL)_canShowWhileLocked {
    return YES;
}
- (void)viewDidLoad {
    %orig;
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        self.view.hidden = YES;
        self.view.alpha = 0.0;
        self.view.backgroundColor = [UIColor clearColor];
    }
}
- (void)requestSiriPresentation:(id)arg1 withOptions:(id)arg2 {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        if ([self respondsToSelector:@selector(dismissSiriViewController:withReason:)]) {
            [self dismissSiriViewController:nil withReason:0];
        } else if ([self respondsToSelector:@selector(dismissSiriViewController:)]) {
            [self dismissSiriViewController:nil];
        }
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return;
    }
    %orig(arg1, arg2);
}
- (void)_activateSiriWithContext:(id)context {
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
        return;
    }
    %orig(context);
}
- (void)viewWillAppear:(BOOL)animated {
    %orig(animated);
    if ([[GeminiAssistantManager sharedManager] isTweakEnabled]) {
        self.view.hidden = YES;
        self.view.alpha = 0.0;
        self.view.backgroundColor = [UIColor clearColor];
        if ([self respondsToSelector:@selector(dismissSiriViewController:withReason:)]) {
            [self dismissSiriViewController:nil withReason:0];
        } else if ([self respondsToSelector:@selector(dismissSiriViewController:)]) {
            [self dismissSiriViewController:nil];
        }
        agWakeScreenBacklightIfNeeded();
        [[GeminiAssistantManager sharedManager] triggerFromSystemHook];
    }
}
%end
%end // end group SpringBoardCoreHooks
